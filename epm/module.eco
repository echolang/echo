/*
 * epm - Echo's package manager.
 *
 * Resolves, fetches and vendors. It never compiles anything. It writes a
 * module.eco only as a whole new file (`epm init`) or as the one
 * #[requires:] / #[depends:] line `epm add` was asked for.
 *
 * Bootstrap is a path, so epm never needs itself.
 */

#[module: "epm"]
#[version: "0.1.0"]
#[epm::license: "MIT"]
#[epm::description: "a package manager for Echo"]

#[sources: "src/**/*.eco"]
#[cc: sources "c/common.c"]
#[if: os == windows]
#[cc: sources "c/win32.c"]
#[else]
#[cc: sources "c/posix.c"]
#[end]

#[depends: "../../echolibs/libjson"]
#[depends: "../../echolibs/libcurl"]
#[depends: "../../echolibs/libcommand"]

// release builds pass --define static_curl and --link search:<prefix>/lib.
// the archive still needs zlib and a TLS stack; those names are not on
// libcurl's dynamic manifest, so they do not collide.
#[if: static_curl]
#[if: os == linux]
#[link: lib "z"]
#[link: lib "dl"]
#[end]
#[if: os == darwin]
#[link: lib "z"]
#[link: framework "Security"]
#[link: framework "CoreFoundation"]
#[link: framework "CoreServices"]
#[link: framework "SystemConfiguration"]
#[end]
#[if: os == windows]
#[link: lib "ws2_32"]
#[link: lib "crypt32"]
#[link: lib "advapi32"]
#[link: lib "bcrypt"]
#[link: lib "normaliz"]
#[link: lib "wldap32"]
#[link: lib "secur32"]
#[link: lib "iphlpapi"]
#[end]
#[end]

#[target: exe { name: "epm", entry: "src/main.eco" }]

#[target: test] {
    #[sources: "tests/*.eco"]
}
