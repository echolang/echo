/**
 * Page layout: wrapping, columns, headings, SGR stripping. The help page
 * says what to draw; this file draws it.
 */

namespace epm::cli;

public function strip_sgr(const string& $text) : string
{
    string $out = '';
    usize $i = 0;

    while ($i < $text->size()) {
        if ($text->byte($i) == 27) {
            $i = $i + 1;

            if ($i < $text->size() && $text->byte($i) == 91) {
                $i = $i + 1;

                while ($i < $text->size()) {
                    uint8 $b = $text->byte($i);
                    $i = $i + 1;

                    if ($b == 109) {
                        break;
                    }
                }

                continue;
            }

            continue;
        }

        $out->append($text->sub($i, 1));
        $i = $i + 1;
    }

    return $out;
}

function write_heading(
    string& $out,
    const string& $text,
    const TerminalCapabilities& $caps
) : void
{
    string $line = '';
    int32 $visible = 0;

    if ($caps->unicode) {
        $line->append(styled('▌', SGR_SECONDARY, $caps->color));
        $line->append(' ');
        $visible = 2;
    }

    $line->append(styled($text, SGR_BOLD, $caps->color));
    $visible = $visible + text_width($text);

    int32 $width = page_width($caps);

    if ($caps->unicode && $visible + 3 < $width) {
        string $rule = ' ';
        int32 $i = $visible + 1;

        while ($i < $width - 1) {
            $rule->append('─');
            $i = $i + 1;
        }

        $line->append(styled($rule, SGR_DIM, $caps->color));
    }

    $out->append($line);
    $out->append("\n");
}

function write_row(
    string& $out,
    const string& $spelling,
    int32 $spelling_width,
    const string& $summary,
    const string& $marker,
    int32 $column,
    const TerminalCapabilities& $caps
) : void
{
    int32 $width = page_width($caps);
    int32 $visible = $spelling_width;
    string $line = $spelling;

    if ($visible + 1 > $column) {
        $out->append($line);
        $out->append("\n");
        $line = '';
        $visible = 0;
    }

    $line->append(spaces($column - $visible));
    $visible = $column;

    string $marked = '';

    if (!$marker->empty()) {
        $marked = "({$marker})";
    }

    int32 $room = 8;

    if ($width > $column + 8) {
        $room = $width - $column;
    }

    int32 $reserved = 0;

    if (!$marked->empty()) {
        $reserved = text_width($marked) + 2;
    }

    bool $align = !$marked->empty()
        && $room > $reserved
        && text_width($summary) <= $room - $reserved;

    string $rest = $summary;

    if (!$align && !$marked->empty()) {
        $rest = "{$summary} {$marked}";
    }

    bool $first = true;

    while (true) {
        usize $take = $rest->size();

        if ($take > $room) {
            usize $space = last_space_before($rest, $room);

            if ($space > 0 && $space < $rest->size()) {
                $take = $space;
            }
            else {
                $take = $room;
            }
        }

        $line->append($rest->sub(0, $take));
        $visible = $visible + i32_of($take);

        if ($first && $align) {
            $line->append(spaces($width - $visible - text_width($marked)));
            $line->append(styled($marked, SGR_DIM, $caps->color));
        }

        $out->append($line);
        $out->append("\n");

        if ($take >= $rest->size()) {
            break;
        }

        $rest = $rest->sub($take, $rest->size() - $take);
        $rest = ltrim($rest);

        if ($rest->empty()) {
            break;
        }

        $line = spaces($column);
        $visible = $column;
        $first = false;
    }
}

function write_wrapped(
    string& $out,
    const string& $text,
    int32 $indent,
    const TerminalCapabilities& $caps
) : void
{
    string $margin = spaces($indent);
    int32 $width = page_width($caps);
    usize $line_start = 0;
    bool $first = true;
    bool $previous_indented = false;

    while ($line_start <= $text->size()) {
        usize $line_end = $text->find("\n");

        if ($line_start > 0) {
            $line_end = find_from($text, 10, $line_start);
        }
        else {
            $line_end = find_from($text, 10, 0);
        }

        if ($line_end > $text->size()) {
            $line_end = $text->size();
        }

        string $line = $text->sub($line_start, $line_end - $line_start);
        bool $indented = !$line->empty() && $line->byte(0) == 32;

        if (!$first && !($indented && $previous_indented)) {
            $out->append("\n");
        }

        $first = false;
        $previous_indented = $indented;

        usize $hang_at = first_non_space($line);
        int32 $hang = 0;

        if ($hang_at < $line->size()) {
            $hang = i32_of($hang_at);
        }

        usize $at = 0;

        while ($at < $line->size()) {
            int32 $margin_width = $indent;

            if ($at > 0) {
                $margin_width = $indent + $hang;
            }

            int32 $usable = 8;

            if ($width > $margin_width + 8) {
                $usable = $width - $margin_width;
            }

            usize $take = $line->size() - $at;

            if ($take > $usable) {
                usize $space = last_space_before($line->sub($at, $line->size() - $at), $usable);

                if ($space > 0 && $space < $take) {
                    $take = $space;
                }
                else {
                    $take = $usable;
                }
            }

            $out->append($margin);

            if ($at > 0) {
                $out->append(spaces($hang));
            }

            $out->append($line->sub($at, $take));
            $out->append("\n");
            $at = $at + $take;

            while ($at < $line->size() && $line->byte($at) == 32) {
                $at = $at + 1;
            }
        }

        if ($line_end == $text->size()) {
            break;
        }

        $line_start = $line_end + 1;
    }
}

function page_width(const TerminalCapabilities& $caps) : int32
{
    if ($caps->width == 0) {
        return 80;
    }

    if ($caps->width > 100) {
        return 100;
    }

    return $caps->width;
}

function text_width(const string& $s) : int32
{
    return i32_of($s->size());
}

function i32_of(usize $n) : int32
{
    int32 $i = 0;
    usize $u = 0;

    while ($u < $n) {
        $i = $i + 1;
        $u = $u + 1;
    }

    return $i;
}

function spaces(int32 $n) : string
{
    string $out = '';
    int32 $i = 0;

    while ($i < $n) {
        $out->append(' ');
        $i = $i + 1;
    }

    return $out;
}

private function last_space_before(const string& $s, usize $end) : usize
{
    usize $limit = $end;

    if ($limit > $s->size()) {
        $limit = $s->size();
    }

    usize $i = $limit;

    while ($i > 0) {
        $i = $i - 1;

        if ($s->byte($i) == 32) {
            return $i;
        }
    }

    return $s->size();
}

private function first_non_space(const string& $s) : usize
{
    usize $i = 0;

    while ($i < $s->size()) {
        if ($s->byte($i) != 32) {
            return $i;
        }

        $i = $i + 1;
    }

    return $s->size();
}

private function ltrim(const string& $s) : string
{
    usize $i = first_non_space($s);

    if ($i == 0) {
        return $s;
    }

    if ($i >= $s->size()) {
        return '';
    }

    return $s->sub($i, $s->size() - $i);
}

private function find_from(const string& $s, uint8 $byte, usize $start) : usize
{
    usize $i = $start;

    while ($i < $s->size()) {
        if ($s->byte($i) == $byte) {
            return $i;
        }

        $i = $i + 1;
    }

    return $s->size();
}
