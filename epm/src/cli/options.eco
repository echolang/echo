/**
 * What is an option, and which commands accept it. One row per flag; parse,
 * usage, the page and every refusal read this. Adding a flag is adding a row.
 */

namespace epm::cli;

public const VERSION = '0.1.0';

public enum Subcommand
{
    case none;
    case install;
    case add;
    case remove;
    case update;
    case verify;
    case tree;
}

public enum Opt
{
    case help;
    case version;
    case color;
    case module;
    case git;
    case path;
    case range;
}

public enum OptionArity
{
    case flag;
    case value;
}

public enum OptionCategory
{
    case inputs;
    case general;
}

public enum ExclusionGroup
{
    case none;
    case origin;
}

public struct OptionValue
{
    string $name;
    string $summary;
    string $description;

    constructor(string $name, string $summary, string $description)
    {
        $this->name = $name;
        $this->summary = $summary;
        $this->description = $description;
    }
}

public struct Option
{
    Opt $id;
    string $name;
    string $alias;
    string $shorthand;
    OptionArity $arity;
    OptionCategory $category;
    int32 $subcommands;
    ExclusionGroup $exclusion;
    string $metavar;
    string $fallback;
    string $summary;
    string $description;
    array<OptionValue> $values;

    constructor(
        Opt $id,
        string $name,
        string $alias,
        string $shorthand,
        OptionArity $arity,
        OptionCategory $category,
        int32 $subcommands,
        ExclusionGroup $exclusion,
        string $metavar,
        string $fallback,
        string $summary,
        string $description,
        array<OptionValue> $values
    )
    {
        $this->id = $id;
        $this->name = $name;
        $this->alias = $alias;
        $this->shorthand = $shorthand;
        $this->arity = $arity;
        $this->category = $category;
        $this->subcommands = $subcommands;
        $this->exclusion = $exclusion;
        $this->metavar = $metavar;
        $this->fallback = $fallback;
        $this->summary = $summary;
        $this->description = $description;
        $this->values = $values;
    }
}

public struct SubcommandInfo
{
    Subcommand $id;
    string $name;
    int32 $bit;
    string $summary;
    string $description;
    string $positional;
    string $positional_summary;
    string $positional_description;
    int32 $min_positionals;
    int32 $max_positionals;

    constructor(
        Subcommand $id,
        string $name,
        int32 $bit,
        string $summary,
        string $description,
        string $positional,
        string $positional_summary,
        string $positional_description,
        int32 $min_positionals,
        int32 $max_positionals
    )
    {
        $this->id = $id;
        $this->name = $name;
        $this->bit = $bit;
        $this->summary = $summary;
        $this->description = $description;
        $this->positional = $positional;
        $this->positional_summary = $positional_summary;
        $this->positional_description = $positional_description;
        $this->min_positionals = $min_positionals;
        $this->max_positionals = $max_positionals;
    }
}

public const ACCEPTS_INSTALL = 1;
public const ACCEPTS_ADD = 2;
public const ACCEPTS_REMOVE = 4;
public const ACCEPTS_UPDATE = 8;
public const ACCEPTS_VERIFY = 16;
public const ACCEPTS_TREE = 32;
public const ACCEPTS_ALL = 63;

public function bit_of(Subcommand $id) : int32
{
    if ($id == Subcommand::install) {
        return ACCEPTS_INSTALL;
    }

    if ($id == Subcommand::add) {
        return ACCEPTS_ADD;
    }

    if ($id == Subcommand::remove) {
        return ACCEPTS_REMOVE;
    }

    if ($id == Subcommand::update) {
        return ACCEPTS_UPDATE;
    }

    if ($id == Subcommand::verify) {
        return ACCEPTS_VERIFY;
    }

    if ($id == Subcommand::tree) {
        return ACCEPTS_TREE;
    }

    return 0;
}

public function subcommand_table() : array<SubcommandInfo>
{
    array<SubcommandInfo> $rows = array<SubcommandInfo>();
    $rows[] = SubcommandInfo(
        Subcommand::install,
        'install',
        ACCEPTS_INSTALL,
        'apply epm.lock.json to vendor/',
        'Apply the lock file to vendor/. A first install with no lock file does an update.\nAfter this, echoc build needs no flags: vendor/ is on disk and the compiler finds it.',
        '',
        '',
        '',
        0,
        0
    );
    $rows[] = SubcommandInfo(
        Subcommand::add,
        'add',
        ACCEPTS_ADD,
        'require a package, or depend on a path',
        'Add a package to this module. --git writes a #[requires:] line and resolves it.\n--path writes #[depends:] and stops there: a library that is already on disk is a path, not a package.\nThey are alternatives, not a pair.',
        '[<name>]',
        'the package name, or omitted when --path names a module',
        'With --git the name is required and becomes the vendor/ directory.\nWith --path it is optional: the module.eco at that path already has a name, and a written one must match.',
        0,
        1
    );
    $rows[] = SubcommandInfo(
        Subcommand::remove,
        'remove',
        ACCEPTS_REMOVE,
        'drop a required package',
        'Delete the #[requires:] line for this name and re-resolve. Path dependencies are #[depends:] and are edited by hand.',
        '<name>',
        'the package to drop',
        'The name as it appears in #[requires:], which is also the directory under vendor/.',
        1,
        1
    );
    $rows[] = SubcommandInfo(
        Subcommand::update,
        'update',
        ACCEPTS_UPDATE,
        're-resolve within the declared ranges',
        'Re-resolve the graph within the ranges the manifest declares, rewrite the lock, and vendor what changed.\nA name narrows the work: that package is re-resolved and everything else is held at the locked version.',
        '[<name>]',
        're-resolve only this package',
        'Omit it and every requirement is re-resolved. Write one and the others stay pinned.',
        0,
        1
    );
    $rows[] = SubcommandInfo(
        Subcommand::verify,
        'verify',
        ACCEPTS_VERIFY,
        'lock satisfies the manifest; vendor/ matches the lock',
        'Check that every requirement is locked inside its range, and that vendor/ holds the locked rev.',
        '',
        '',
        '',
        0,
        0
    );
    $rows[] = SubcommandInfo(
        Subcommand::tree,
        'tree',
        ACCEPTS_TREE,
        'the resolved graph',
        'Print the locked graph, roots first, each package with the rev that was vendored.',
        '',
        '',
        '',
        0,
        0
    );
    return $rows;
}

public function subcommand_for_word(const string& $word) : SubcommandInfo?
{
    array<SubcommandInfo> $rows = subcommand_table();
    usize $i = 0;

    while ($i < $rows->count()) {
        if ($rows[$i]->name == $word) {
            return $rows[$i];
        }

        $i = $i + 1;
    }

    return null;
}

public function subcommand_info(Subcommand $id) : SubcommandInfo
{
    array<SubcommandInfo> $rows = subcommand_table();
    usize $i = 0;

    while ($i < $rows->count()) {
        if ($rows[$i]->id == $id) {
            return $rows[$i];
        }

        $i = $i + 1;
    }

    return $rows[0];
}

public function command_line_options() : array<Option>
{
    array<Option> $rows = array<Option>();
    array<OptionValue> $none = array<OptionValue>();

    array<OptionValue> $colors = array<OptionValue>();
    $colors[] = OptionValue('auto', 'a terminal, and nothing else', 'Colour a terminal and leave a pipe alone.');
    $colors[] = OptionValue('always', 'even into a file or a pipe', 'Put escape sequences in the stream, which is what a renderer downstream wants.');
    $colors[] = OptionValue('never', 'never', 'No escape sequences, even on a terminal.');

    $rows[] = Option(
        Opt::module,
        'module',
        '',
        'm',
        OptionArity::value,
        OptionCategory::inputs,
        ACCEPTS_ALL,
        ExclusionGroup::none,
        '<manifest>',
        '',
        'the project, a file or a directory holding one',
        'The module.eco this command is about, or the directory that holds one:\n  epm install -m ../app\n  epm add lib --git https://example.com/lib.git -m app/module.eco\nOmitted, epm walks up from the working directory until it finds a module.eco. Stated, that walk does not happen: the path must name the file or a directory that already holds one.',
        $none
    );
    $rows[] = Option(
        Opt::git,
        'git',
        '',
        '',
        OptionArity::value,
        OptionCategory::inputs,
        ACCEPTS_ADD,
        ExclusionGroup::origin,
        '<url>',
        '',
        'fetch this remote into vendor/',
        'The git remote to fetch. Writes source: git "..." on the #[requires:] line.\nepm lists tags, picks a version in range, and vendors the tree:\n  epm add lib --git https://github.com/echolang/libcurl --range ^0.1\nA GitHub remote lists tags and reads module.eco over HTTP; every other host uses git. Checkout is always git.',
        $none
    );
    $rows[] = Option(
        Opt::path,
        'path',
        '',
        '',
        OptionArity::value,
        OptionCategory::inputs,
        ACCEPTS_ADD,
        ExclusionGroup::origin,
        '<dir>',
        '',
        'already on disk, writes #[depends:]',
        'A library that is already on disk. Writes #[depends:] and stops: nothing is fetched, nothing is locked.\n  epm add --path ../../echolibs/libjson\nThe name is optional. The module.eco at that path already has one, and a written name must match.',
        $none
    );
    $rows[] = Option(
        Opt::range,
        'range',
        '',
        '',
        OptionArity::value,
        OptionCategory::inputs,
        ACCEPTS_ADD,
        ExclusionGroup::none,
        '<range>',
        '*',
        'the versions this project will accept',
        'A semver range. Defaults to *, every release:\n  epm add lib --git https://example.com/lib.git --range ^0.2\nv1 understands 1.2.3, ^1.2.3, ~1.2.3, >=1.2.3 and *.\n--version is epm\'s own version, the way echoc --version is. This is the package range.',
        $none
    );
    $rows[] = Option(
        Opt::help,
        'help',
        '',
        'h',
        OptionArity::flag,
        OptionCategory::general,
        ACCEPTS_ALL,
        ExclusionGroup::none,
        '',
        '',
        'print this page, or one option in full',
        'Print a page. Which page depends on what you put around it:\n  epm --help\n  epm add --help\n  epm add --help git\nThe last form is where the prose lives: the compact page has one line per option, and the paragraphs, the values and the gotchas are one command further in.\nThe option name goes in bare, without its dashes, and a short spelling works too: \'epm add --help m\' is the --module page.',
        $none
    );
    $rows[] = Option(
        Opt::version,
        'version',
        '',
        'v',
        OptionArity::flag,
        OptionCategory::general,
        ACCEPTS_ALL,
        ExclusionGroup::none,
        '',
        '',
        'print the version',
        'Print the version this epm was built as, and exit:\n  epm --version',
        $none
    );
    $rows[] = Option(
        Opt::color,
        'color',
        'colour',
        '',
        OptionArity::value,
        OptionCategory::general,
        ACCEPTS_ALL,
        ExclusionGroup::none,
        '<auto|always|never>',
        'auto',
        'colourise the page and refusals',
        'Colourise the help page and the argv refusals:\n  epm --color always --help\n\'always\' puts escape sequences into a file or a pipe, which is what a renderer downstream wants. \'never\' is the other direction, and \'auto\' colours a terminal and nothing else.\nNO_COLOR, CLICOLOR_FORCE and TERM=dumb are honoured, so a machine that has already said how it feels about colour does not need this flag at all.',
        $colors
    );
    return $rows;
}

public function option_for_long(const string& $name) : Option?
{
    array<Option> $rows = command_line_options();
    usize $i = 0;

    while ($i < $rows->count()) {
        if ($rows[$i]->name == $name || $rows[$i]->alias == $name) {
            return $rows[$i];
        }

        $i = $i + 1;
    }

    return null;
}

public function option_for_short(const string& $ch) : Option?
{
    if ($ch->size() != 1) {
        return null;
    }

    array<Option> $rows = command_line_options();
    usize $i = 0;

    while ($i < $rows->count()) {
        if ($rows[$i]->shorthand == $ch) {
            return $rows[$i];
        }

        $i = $i + 1;
    }

    return null;
}

public function option_takes_a_value(const Option& $option) : bool
{
    return $option->arity == OptionArity::value;
}

public function option_flag_names(const Option& $option) : string
{
    string $names = '';

    if (!$option->shorthand->empty()) {
        $names = "-{$option->shorthand}, ";
    }

    $names->append("--{$option->name}");

    if (!$option->alias->empty()) {
        $names->append(", --{$option->alias}");
    }

    return $names;
}

public function option_spelling(const Option& $option) : string
{
    string $names = option_flag_names($option);

    if ($option->metavar->empty()) {
        return $names;
    }

    return "{$names} {$option->metavar}";
}

public function page_spelling(const Option& $option) : string
{
    string $names = option_flag_names($option);

    if ($option->metavar->empty()) {
        return $names;
    }

    return "{$names} {$option->metavar}";
}

public function option_value_list(const Option& $option) : string
{
    return join_value_names($option, '|');
}

public function option_value_csv(const Option& $option) : string
{
    return join_value_names($option, ', ');
}

private function join_value_names(const Option& $option, const string& $sep) : string
{
    string $joined = '';
    usize $i = 0;

    while ($i < $option->values->count()) {
        if ($i > 0) {
            $joined->append($sep);
        }

        $joined->append($option->values[$i]->name);
        $i = $i + 1;
    }

    return $joined;
}

public function command_word_list() : string
{
    array<SubcommandInfo> $rows = subcommand_table();
    string $joined = '';
    usize $i = 0;
    usize $n = $rows->count();

    while ($i < $n) {
        if ($i > 0) {
            if ($i + 1 == $n) {
                $joined->append(' or ');
            }
            else {
                $joined->append(', ');
            }
        }

        $joined->append("'{$rows[$i]->name}'");
        $i = $i + 1;
    }

    return $joined;
}

public function subject_name(Subcommand $id) : string
{
    if ($id == Subcommand::none) {
        return 'epm';
    }

    return subcommand_info($id)->name;
}

public function category_heading(OptionCategory $category) : string
{
    if ($category == OptionCategory::inputs) {
        return 'What it works on';
    }

    return 'General';
}

public function exclusion_group_name(ExclusionGroup $group) : string
{
    if ($group == ExclusionGroup::origin) {
        return 'origin';
    }

    return '';
}

public function usage_of(Subcommand $id) : string
{
    SubcommandInfo $info = subcommand_info($id);
    string $line = "epm {$info->name} [options]";

    if (!$info->positional->empty()) {
        $line->append(" {$info->positional}");
    }

    return $line;
}
