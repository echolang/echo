/**
 * What this terminal can do, and the SGR sequences the page draws with.
 * Colour and unicode fail apart; width 0 means "assume 80, do not trust ioctl".
 */

namespace epm::cli;

use epm::sys;
use std::env;

public enum ColorChoice
{
    case auto;
    case always;
    case never;
}

public enum TerminalStream
{
    case stdout;
    case stderr;
}

public struct TerminalCapabilities
{
    bool $color;
    bool $unicode;
    int32 $width;
    bool $interactive;

    constructor(bool $color, bool $unicode, int32 $width, bool $interactive)
    {
        $this->color = $color;
        $this->unicode = $unicode;
        $this->width = $width;
        $this->interactive = $interactive;
    }
}

public function plain_terminal() : TerminalCapabilities
{
    return TerminalCapabilities(false, false, 0, false);
}

public function resolve_terminal(
    ColorChoice $color,
    TerminalStream $stream
) : TerminalCapabilities
{
    int32 $fd = 2;

    if ($stream == TerminalStream::stdout) {
        $fd = 1;
    }

    bool $tty = sys::epm_isatty($fd) == 1;
    bool $use_color = false;

    if ($color == ColorChoice::always) {
        $use_color = true;
    }
    else if ($color == ColorChoice::never) {
        $use_color = false;
    }
    else {
        $use_color = environment_allows_color($tty);
    }

    bool $unicode = false;

    if ($tty) {
        $unicode = environment_allows_unicode();
    }

    int32 $width = 0;

    if ($tty) {
        $width = terminal_width($fd);
    }

    return TerminalCapabilities($use_color, $unicode, $width, $tty);
}

public function color_choice_named(const string& $word) : ColorChoice?
{
    if ($word == 'auto') {
        return ColorChoice::auto;
    }

    if ($word == 'always') {
        return ColorChoice::always;
    }

    if ($word == 'never') {
        return ColorChoice::never;
    }

    return null;
}

public function styled(const string& $text, const string& $sgr, bool $color) : string
{
    if (!$color || $text->empty()) {
        return $text;
    }

    return "{$sgr}{$text}\x1b[0m";
}

public const SGR_RESET = "\x1b[0m";
public const SGR_DIM = "\x1b[2m";
public const SGR_BOLD = "\x1b[1m";
public const SGR_ERROR = "\x1b[1;31m";
public const SGR_INFO = "\x1b[1;34m";
public const SGR_SECONDARY = "\x1b[1;36m";

private function environment_allows_color(bool $tty) : bool
{
    string $nocolor = env_text('NO_COLOR');

    if (!$nocolor->empty()) {
        return false;
    }

    string $force = env_text('CLICOLOR_FORCE');

    if (!$force->empty() && $force != '0') {
        return true;
    }

    if (env_text('TERM') == 'dumb') {
        return false;
    }

    return $tty;
}

private function environment_allows_unicode() : bool
{
    if (!env_text('WT_SESSION')->empty()) {
        return true;
    }

    return locale_is_utf8();
}

private function locale_is_utf8() : bool
{
    if (env_mentions('LC_ALL', 'UTF-8') || env_mentions('LC_ALL', 'utf8')) {
        return true;
    }

    if (env_mentions('LC_CTYPE', 'UTF-8') || env_mentions('LC_CTYPE', 'utf8')) {
        return true;
    }

    if (env_mentions('LANG', 'UTF-8') || env_mentions('LANG', 'utf8')) {
        return true;
    }

    return false;
}

private function env_mentions(const string& $key, const string& $needle) : bool
{
    return env_text($key)->contains($needle);
}

private function env_text(const string& $key) : string
{
    string::view $value = guard env::var($key) else {
        return '';
    }

    return str::from($value);
}

private function terminal_width(int32 $fd) : int32
{
    string $columns = env_text('COLUMNS');

    if (!$columns->empty()) {
        int32 $n = parse_columns($columns);

        if ($n > 0) {
            return $n;
        }
    }

    return columns_of($fd);
}

private function columns_of(int32 $fd) : int32
{
    int32 $n = sys::epm_columns($fd);

    if ($n <= 0) {
        return 0;
    }

    return $n;
}

private function parse_columns(const string& $s) : int32
{
    if ($s->empty()) {
        return 0;
    }

    int32 $n = 0;
    usize $i = 0;

    while ($i < $s->size()) {
        uint8 $b = $s->byte($i);

        if ($b < 48 || $b > 57) {
            return 0;
        }

        int32 $digit = 0;
        uint8 $zero = 48;

        while ($zero < $b) {
            $digit = $digit + 1;
            $zero = $zero + 1;
        }

        $n = $n * 10 + $digit;
        $i = $i + 1;
    }

    return $n;
}
