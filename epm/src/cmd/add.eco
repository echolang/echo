namespace epm::cmd;

use command;
use epm::cli::{App, start_from_cli, work_context};
use epm::manifest;
use epm::sys;
use epm::util;
use std::env;
use std::io;

public function add(const App& $app, const command::Parsed& $cli) : int32
{
    command::CLIContext $ctx = work_context($app, $cli);
    string $name = '';

    if ($cli->positionals->count() > 0) {
        $name = $cli->positionals[0];
    }

    if ($cli->stated($app->path)) {
        return add_path($name, $cli->value($app->path), $app, $cli, $ctx);
    }

    if ($name->empty() || !$cli->stated($app->git)) {
        $ctx->printError("'add' needs a name and '--git', or '--path'");
        return 1;
    }

    if (!manifest::usable_name($name)) {
        $ctx->printError("'{$name}' is not a usable package name");
        return 1;
    }

    if (util::parse_range($cli->value($app->range)) == null) {
        $ctx->printError("'{$cli->value($app->range)}' is not a version range");
        return 1;
    }

    string $start = guard start_from_cli($app, $cli) else ($e) {
        $ctx->printError($e);
        return 1;
    }

    string $mod = guard manifest::find_module($start) else {
        $ctx->printError('no module.eco here or above');
        return 1;
    }

    string $before = guard io::readfile($mod) else ($e) {
        $ctx->printError("cannot read {$mod}: {$e}");
        return 1;
    }

    manifest::Requirement $req = manifest::Requirement(
        $name,
        $cli->value($app->range),
        manifest::Origin::git($cli->value($app->git)),
        ''
    );
    bool $added = guard manifest::add_line($mod, $req) else ($e) {
        $ctx->printError($e);
        return 1;
    }

    $ctx->line("added {$name} to {$mod}");
    int32 $code = update_at(sys::dirname($mod), '', $ctx);

    if ($code != 0) {
        result<usize, io::ioerror> $restored = io::writefile($mod, $before);

        if ($restored->failed()) {
            $ctx->printError("update failed, and the original {$mod} could not be restored");
        }
    }

    return $code;
}

private function add_path(
    const string& $name,
    const string& $path,
    const App& $app,
    const command::Parsed& $cli,
    command::CLIContext $ctx
) : int32
{
    string $start = guard start_from_cli($app, $cli) else ($e) {
        $ctx->printError($e);
        return 1;
    }

    string $mod = guard manifest::find_module($start) else {
        $ctx->printError('no module.eco here or above');
        return 1;
    }

    string $probe = $path;

    if (!sys::is_absolute($probe)) {
        $probe = sys::join(env::cwd(), $path);
    }

    string $lib = $probe;

    if (sys::is_file($probe) && sys::basename($probe) == 'module.eco') {
        $lib = sys::dirname($probe);
    }

    string $lib_mod = sys::join($lib, 'module.eco');

    if (!sys::is_file($lib_mod)) {
        $ctx->printError("no module.eco at {$lib}");
        return 1;
    }

    manifest::Manifest $lib_man = guard manifest::load($lib_mod) else ($e) {
        $ctx->printError($e);
        return 1;
    }

    if (!$name->empty() && $name != $lib_man->name) {
        $ctx->printError("'{$name}' does not match module '{$lib_man->name}' at {$path}");
        return 1;
    }

    bool $added = guard manifest::add_depend_line($mod, $path) else ($e) {
        $ctx->printError($e);
        return 1;
    }

    $ctx->line("depends {$lib_man->name} -> {$path}");
    return 0;
}

public function remove(const App& $app, const command::Parsed& $cli) : int32
{
    command::CLIContext $ctx = work_context($app, $cli);
    string $name = $cli->positionals[0];
    string $start = guard start_from_cli($app, $cli) else ($e) {
        $ctx->printError($e);
        return 1;
    }

    string $mod = guard manifest::find_module($start) else {
        $ctx->printError('no module.eco here or above');
        return 1;
    }

    string $before = guard io::readfile($mod) else ($e) {
        $ctx->printError("cannot read {$mod}: {$e}");
        return 1;
    }

    if (!manifest::remove_line($mod, $name)->failed()) {
        $ctx->line("removed {$name}");
        int32 $code = update_at(sys::dirname($mod), '', $ctx);

        if ($code != 0) {
            result<usize, io::ioerror> $restored = io::writefile($mod, $before);

            if ($restored->failed()) {
                $ctx->printError("update failed, and the original {$mod} could not be restored");
            }
        }

        return $code;
    }

    if (!manifest::remove_depend_line($mod, $name)->failed()) {
        $ctx->line("removed path depend {$name}");
        return 0;
    }

    manifest::Manifest $man = guard manifest::load($mod) else ($e) {
        $ctx->printError($e);
        return 1;
    }

    usize $i = 0;

    while ($i < $man->depends->count()) {
        string $depend = $man->depends[$i];
        string $probe = $depend;

        if (!sys::is_absolute($probe)) {
            $probe = sys::join(sys::dirname($mod), $depend);
        }

        string $lib_mod = sys::join($probe, 'module.eco');

        if (sys::is_file($lib_mod)) {
            manifest::Manifest $dep = guard manifest::load($lib_mod) else {
                $i = $i + 1;
                continue;
            }

            if ($dep->name == $name) {
                bool $gone = guard manifest::remove_depend_line($mod, $depend) else ($e) {
                    $ctx->printError($e);
                    return 1;
                }

                $ctx->line("removed path depend {$name} -> {$depend}");
                return 0;
            }
        }

        $i = $i + 1;
    }

    $ctx->printError("'{$name}' is not required and is not a path depend");
    return 1;
}
