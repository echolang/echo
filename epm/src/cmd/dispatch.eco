/**
 * The command, already parsed. Help and version never reach here.
 */

namespace epm::cmd;

use command;
use epm::cli;
use epm::manifest;
use std::env;

public function dispatch(const cli::App& $app, const command::Parsed& $cli) : int32
{
    if ($cli->command->id == $app->init->id) {
        return init($app, $cli);
    }

    if ($cli->command->id == $app->install->id) {
        return install($app, $cli);
    }

    if ($cli->command->id == $app->add->id) {
        return add($app, $cli);
    }

    if ($cli->command->id == $app->remove->id) {
        return remove($app, $cli);
    }

    if ($cli->command->id == $app->update->id) {
        return update($app, $cli);
    }

    if ($cli->command->id == $app->verify->id) {
        return verify($app, $cli);
    }

    if ($cli->command->id == $app->tree->id) {
        return tree($app, $cli);
    }

    command::CLIContext $err = cli::work_context($app, $cli);
    $err->printError('No command given.');
    return 1;
}

function project() : result<manifest::Manifest, string>
{
    return project_at(env::cwd());
}

function project_at(const string& $start) : result<manifest::Manifest, string>
{
    string $mod = guard manifest::find_module($start) else {
        return .error("no module.eco here or above");
    }

    return manifest::load($mod);
}
