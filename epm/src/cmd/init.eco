/**
 * `epm init`: ask, then write. `--yes` skips the asking.
 */

namespace epm::cmd;

use epm::cli;
use epm::scaffold;
use epm::sys;
use std::env;
use std::io;

public function init(const cli::CommandLine& $cli) : int32
{
    return init_at($cli, env::cwd());
}

public function init_at(const cli::CommandLine& $cli, const string& $parent) : int32
{
    if ($cli->stated_yes) {
        return init_yes($cli, $parent);
    }

    if (!cli::capabilities_for($cli, cli::TerminalStream::stdin)->interactive) {
        cli::report(
            "init is a wizard and this is not a terminal. Write 'epm init <name> --yes' to take the defaults."
        );
        return 1;
    }

    return init_wizard($cli, $parent);
}

function init_yes(const cli::CommandLine& $cli, const string& $parent) : int32
{
    if ($cli->positionals->count() == 0) {
        cli::report("'init --yes' needs a module name.");
        return 1;
    }

    return write_recipe($cli, scaffold::default_recipe($cli->positionals[0]), $parent);
}

function init_wizard(const cli::CommandLine& $cli, const string& $parent) : int32
{
    cli::TerminalCapabilities $caps = cli::capabilities_for($cli, cli::TerminalStream::stdout);
    scaffold::Recipe $recipe = guard collect_recipe($cli, $caps->color) else ($e) {
        cli::report($e);
        return 1;
    }

    string $shown = sys::join(sys::join($parent, $recipe->name), 'module.eco');
    io::println('');
    io::println("About to write to {$shown}:");
    io::println('');
    io::print(scaffold::manifest_text($recipe));
    io::println('');

    bool $ok = guard ask_bool('Is this OK?', $caps->color) else ($e) {
        cli::report($e);
        return 1;
    }

    if (!$ok) {
        cli::report('init cancelled.');
        return 1;
    }

    return write_recipe($cli, $recipe, $parent);
}

function write_recipe(
    const cli::CommandLine& $cli,
    const scaffold::Recipe& $recipe,
    const string& $parent
) : int32
{
    result<string, string> $got = scaffold::apply($recipe, $parent);

    if ($got->failed()) {
        cli::report($got->failure());
        return 1;
    }

    print_created($cli, $recipe);
    return 0;
}

function print_created(const cli::CommandLine& $cli, const scaffold::Recipe& $recipe) : void
{
    cli::TerminalCapabilities $caps = cli::capabilities_for($cli, cli::TerminalStream::stdout);
    string $mark = cli::styled('created', cli::SGR_SUCCESS, $caps->color);
    io::println("{$mark} {$recipe->name}/");

    array<scaffold::File> $tree = scaffold::files($recipe);
    usize $i = 0;

    while ($i < $tree->count()) {
        io::println("  {$tree[$i]->rel}");
        $i = $i + 1;
    }

    io::println('');

    if ($recipe->kind == scaffold::Kind::exe) {
        print_hint('echoc run', $caps);
    }

    print_hint('echoc build', $caps);

    if ($recipe->tests) {
        print_hint('echoc test', $caps);
    }
}

function print_hint(const string& $line, const cli::TerminalCapabilities& $caps) : void
{
    string $hint = cli::styled($line, cli::SGR_DIM, $caps->color);
    io::println("  {$hint}");
}

function collect_recipe(const cli::CommandLine& $cli, bool $color) : result<scaffold::Recipe, string>
{
    string $seed = '';

    if ($cli->positionals->count() > 0) {
        $seed = $cli->positionals[0];
    }

    string $name = guard ask_name($seed, $color) else ($e) {
        return .error($e);
    }

    string $description = guard ask_text('description', '', $color) else ($e) {
        return .error($e);
    }

    string $license = guard ask_license($color) else ($e) {
        return .error($e);
    }

    scaffold::Kind $kind = guard ask_kind($color) else ($e) {
        return .error($e);
    }

    bool $tests = guard ask_bool('tests', $color) else ($e) {
        return .error($e);
    }

    bool $readme = guard ask_bool('readme', $color) else ($e) {
        return .error($e);
    }

    return .ok(scaffold::Recipe($name, $description, $license, $kind, $tests, $readme));
}

function ask_name(const string& $seed, bool $color) : result<string, string>
{
    while (true) {
        string $got = guard ask('module name', $seed, $color) else ($e) {
            return .error($e);
        }

        if (scaffold::usable_project_name($got)) {
            return .ok($got);
        }

        if ($got->empty()) {
            cli::report('a module name is required.');
        }
        else {
            cli::report("'{$got}' is not a usable module name.");
        }
    }
}

function ask_text(
    const string& $label,
    const string& $default,
    bool $color
) : result<string, string>
{
    while (true) {
        string $got = guard ask($label, $default, $color) else ($e) {
            return .error($e);
        }

        if (scaffold::attribute_text_ok($got)) {
            return .ok($got);
        }

        cli::report('a description cannot contain a quote or a newline');
    }
}

function ask_license(bool $color) : result<string, string>
{
    while (true) {
        string $got = guard ask('license', 'MIT', $color) else ($e) {
            return .error($e);
        }

        if ($got == '-') {
            return .ok('');
        }

        if (scaffold::attribute_text_ok($got) && !$got->empty()) {
            return .ok($got);
        }

        cli::report('a license cannot contain a quote or a newline');
    }
}

function ask_kind(bool $color) : result<scaffold::Kind, string>
{
    while (true) {
        string $got = guard ask('kind', 'exe', $color) else ($e) {
            return .error($e);
        }

        scaffold::Kind $kind = guard scaffold::kind_named($got) else {
            cli::report("kind is 'exe' or 'lib'.");
            continue;
        }

        return .ok($kind);
    }
}

function ask_bool(const string& $label, bool $color) : result<bool, string>
{
    while (true) {
        string $got = guard ask($label, 'yes', $color) else ($e) {
            return .error($e);
        }

        bool $v = guard yes_named($got) else {
            cli::report("write 'yes' or 'no'.");
            continue;
        }

        return .ok($v);
    }
}

function yes_named(const string& $word) : bool?
{
    string $low = str::lower($word);

    if ($low == 'yes' || $low == 'y') {
        return true;
    }

    if ($low == 'no' || $low == 'n') {
        return false;
    }

    return null;
}

function ask(
    const string& $label,
    const string& $default,
    bool $color
) : result<string, string>
{
    io::print($label);
    io::print(':');

    if (!$default->empty()) {
        io::print(' ');
        io::print(cli::styled("({$default})", cli::SGR_DIM, $color));
    }

    io::print(' ');
    io::stdout->flush();

    string $line = guard io::readline() else {
        return .error('init cancelled.');
    }

    string $got = str::trim($line);

    if ($got->empty()) {
        return .ok($default);
    }

    return .ok($got);
}
