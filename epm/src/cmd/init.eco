/**
 * `epm init`: ask, then write. `--yes` skips the asking.
 */

namespace epm::cmd;

use command;
use command::element;
use epm::cli;
use epm::scaffold;
use epm::sys;
use std::env;

public function init(const cli::App& $app, const command::Parsed& $cli) : int32
{
    return init_at($app, $cli, env::cwd());
}

public function init_at(
    const cli::App& $app,
    const command::Parsed& $cli,
    const string& $parent
) : int32
{
    command::CLIContext $ctx = .from($cli, $app->cmd, .stderr);

    if ($cli->stated($app->yes)) {
        return init_yes($cli, $parent, $ctx);
    }

    command::TerminalCapabilities $in = command::capabilitiesFor(
        $cli,
        $app->cmd,
        .stdin
    );

    if (!$in->interactive) {
        $ctx->printError(
            "init is a wizard and this is not a terminal. Write 'epm init <name> --yes' to take the defaults."
        );
        return 1;
    }

    return init_wizard($cli, $parent, $ctx);
}

function init_yes(
    const command::Parsed& $cli,
    const string& $parent,
    command::CLIContext $ctx
) : int32
{
    if ($cli->positionals->count() == 0) {
        $ctx->printError("'init --yes' needs a module name.");
        return 1;
    }

    return write_recipe($ctx, scaffold::default_recipe($cli->positionals[0]), $parent);
}

function init_wizard(
    const command::Parsed& $cli,
    const string& $parent,
    command::CLIContext $ctx
) : int32
{
    $ctx->beginStepper('init');

    scaffold::Recipe $recipe = collect_recipe($cli, $ctx);

    string $shown = sys::join(sys::join($parent, $recipe->name), 'module.eco');
    $ctx->print(element::noteFrame(
        $ctx->channel(),
        "About to write to {$shown}",
        scaffold::manifest_text($recipe)
    ));

    bool $ok = element::confirm($ctx, 'Write this module?');

    if (!$ok) {
        $ctx->printError('init cancelled.');
        $ctx->endStepper('Nothing was written.');
        return 1;
    }

    if (!write_files($ctx, $recipe, $parent)) {
        $ctx->endStepper('Nothing was written.');
        return 1;
    }

    $ctx->endStepper("created {$recipe->name}/");
    print_created($ctx, $recipe);
    return 0;
}

function write_recipe(
    command::CLIContext $ctx,
    const scaffold::Recipe& $recipe,
    const string& $parent
) : int32
{
    if (!write_files($ctx, $recipe, $parent)) {
        return 1;
    }

    print_created($ctx, $recipe);
    return 0;
}

function write_files(
    command::CLIContext $ctx,
    const scaffold::Recipe& $recipe,
    const string& $parent
) : bool
{
    element::Spinner $spin = $ctx->create<element::Spinner>();
    $spin->start('writing files');

    result<string, string> $got = scaffold::apply($recipe, $parent);

    if ($got->failed()) {
        $spin->fail($got->failure());
        return false;
    }

    int32 $n = scaffold::files($recipe)->count() as int32;
    $spin->succeed("wrote {$n} files");
    return true;
}

function print_created(command::CLIContext $ctx, const scaffold::Recipe& $recipe) : void
{
    element::Tree $t = $ctx->create<element::Tree>("{$recipe->name}/");
    array<scaffold::File> $files = scaffold::files($recipe);
    usize $i = 0;

    while ($i < $files->count()) {
        $t->root->children[] = element::Node($files[$i]->rel);
        $i = $i + 1;
    }

    $t->display();

    if ($recipe->kind == scaffold::Kind::exe) {
        print_hint($ctx, 'echoc run');
    }

    print_hint($ctx, 'echoc build');

    if ($recipe->tests) {
        print_hint($ctx, 'echoc test');
    }
}

function print_hint(command::CLIContext $ctx, const string& $line) : void
{
    $ctx->line(command::styled("  {$line}", command::SGR_DIM, $ctx->caps->color));
}

function collect_recipe(
    const command::Parsed& $cli,
    command::CLIContext $ctx
) : scaffold::Recipe
{
    string $seed = '';

    if ($cli->positionals->count() > 0) {
        $seed = $cli->positionals[0];
    }

    string $name = ask_name($ctx, $seed);
    string $description = ask_text($ctx, 'description', '');
    string $license = ask_license($ctx);
    scaffold::Kind $kind = ask_kind($ctx);
    bool $tests = element::confirm($ctx, 'tests');
    bool $readme = element::confirm($ctx, 'readme');

    return scaffold::Recipe($name, $description, $license, $kind, $tests, $readme);
}

function ask_name(command::CLIContext $ctx, const string& $seed) : string
{
    while (true) {
        element::Text $p = $ctx->create<element::Text>('module name');

        if (!$seed->empty()) {
            $p->hint($seed);
            $p->otherwise($seed);
        }

        string $got = $p->ask();

        if (scaffold::usable_project_name($got)) {
            return $got;
        }

        if ($got->empty()) {
            $ctx->printError('a module name is required.');
        }
        else {
            $ctx->printError("'{$got}' is not a usable module name.");
        }
    }
}

function ask_text(
    command::CLIContext $ctx,
    const string& $label,
    const string& $default
) : string
{
    while (true) {
        element::Text $p = $ctx->create<element::Text>($label);
        $p->require(false);

        if (!$default->empty()) {
            $p->hint($default);
            $p->otherwise($default);
        }

        string $got = $p->ask();

        if (scaffold::attribute_text_ok($got)) {
            return $got;
        }

        $ctx->printError('a description cannot contain a quote or a newline');
    }
}

function ask_license(command::CLIContext $ctx) : string
{
    while (true) {
        element::Text $p = $ctx->create<element::Text>('license');
        $p->hint('MIT');
        $p->otherwise('MIT');
        string $got = $p->ask();

        if ($got == '-') {
            return '';
        }

        if (scaffold::attribute_text_ok($got) && !$got->empty()) {
            return $got;
        }

        $ctx->printError('a license cannot contain a quote or a newline');
    }
}

function ask_kind(command::CLIContext $ctx) : scaffold::Kind
{
    array<string> $choices = array<string>();
    $choices[] = 'exe';
    $choices[] = 'lib';
    array<string> $got = element::select($ctx, 'kind', $choices);
    scaffold::Kind $kind = guard scaffold::kind_named($got[0]) else {
        die("unexpected kind '{$got[0]}'");
    }

    return $kind;
}
