namespace epm::cmd;

use epm::cli::{CommandLine, report, start_from_cli};
use epm::lock;
use epm::manifest;
use epm::sys;
use epm::util;
use std::io;

public function verify(const CommandLine& $cli) : int32
{
    string $start = guard start_from_cli($cli) else ($e) {
        report($e);
        return 1;
    }

    return verify_at($start);
}

public function verify_at(const string& $start) : int32
{
    manifest::Manifest $man = guard project_at($start) else ($e) {
        report($e);
        return 1;
    }

    string $root = sys::dirname($man->path);
    string $vendor = sys::join($root, 'vendor');
    string $lock_path = lock::path_beside($man->path);

    if (!sys::is_file($lock_path)) {
        report('no epm.lock.json - run `epm update`');
        return 1;
    }

    lock::Lock $lock = guard lock::load($lock_path) else ($e) {
        report($e);
        return 1;
    }

    array<manifest::Requirement> $need = manifest::all_requires($man);
    int32 $failed = 0;
    usize $i = 0;

    while ($i < $need->count()) {
        manifest::Requirement $req = $need[$i];
        lock::Entry $have = guard $lock->find($req->name) else {
            report("'{$req->name}' is required but not locked");
            $failed = $failed + 1;
            $i = $i + 1;
            continue;
        }

        util::Range $range = guard util::parse_range($req->version) else {
            report("'{$req->version}' is not a version range");
            $failed = $failed + 1;
            $i = $i + 1;
            continue;
        }

        util::Version $ver = guard util::parse_version($have->version) else {
            report("lock has a broken version for {$req->name}");
            $failed = $failed + 1;
            $i = $i + 1;
            continue;
        }

        if (!util::satisfies($ver, $range)) {
            report("'{$req->name}' @{$have->version} does not satisfy {$req->version}");
            $failed = $failed + 1;
        }

        $i = $i + 1;
    }

    $i = 0;

    while ($i < $lock->packages->count()) {
        lock::Entry $e = $lock->packages[$i];
        string $dir = sys::join($vendor, $e->name);

        if (!sys::is_dir($dir)) {
            report("missing vendor/{$e->name}");
            $failed = $failed + 1;
        }
        else if ($e->sha256->empty()) {
            report("lock entry '{$e->name}' has no sha256 - run `epm update`");
            $failed = $failed + 1;
        }
        else if (sys::tree_sha256($dir) != $e->sha256) {
            report("sha256 mismatch for {$e->name}");
            $failed = $failed + 1;
        }
        else {
            io::println("ok {$e->name}@{$e->version}");
        }

        $i = $i + 1;
    }

    if ($failed > 0) {
        return 1;
    }

    return 0;
}

public function tree(const CommandLine& $cli) : int32
{
    string $start = guard start_from_cli($cli) else ($e) {
        report($e);
        return 1;
    }

    return tree_at($start);
}

public function tree_at(const string& $start) : int32
{
    manifest::Manifest $man = guard project_at($start) else ($e) {
        report($e);
        return 1;
    }

    string $lock_path = lock::path_beside($man->path);
    lock::Lock $lock = guard lock::load($lock_path) else ($e) {
        report($e);
        return 1;
    }

    if ($lock->packages->count() == 0) {
        io::println('(empty - run `epm update`)');
        return 0;
    }

    usize $i = 0;

    while ($i < $man->requires->count()) {
        print_node($man->requires[$i]->name, $lock, 0);
        $i = $i + 1;
    }

    $i = 0;

    while ($i < $man->scoped->count()) {
        print_node($man->scoped[$i]->req->name, $lock, 0);
        $i = $i + 1;
    }

    return 0;
}

private function print_node(const string& $name, const lock::Lock& $lock, int32 $depth) : void
{
    if ($depth > 32) {
        return;
    }

    usize $n = $depth;
    string $pad = str::repeat('  ', $n);
    lock::Entry? $e = $lock->find($name);

    if ($e == null) {
        io::println("{$pad}{$name}  (missing)");
        return;
    }

    lock::Entry $have = guard $e else {
        return;
    }

    io::println("{$pad}{$have->name}@{$have->version}  {$have->rev}");

    usize $i = 0;

    while ($i < $have->requires->count()) {
        print_node($have->requires[$i], $lock, $depth + 1);
        $i = $i + 1;
    }
}
