/**
 * epm.lock.json. JSON, so libjson is the only serializer epm links.
 * No absolute paths. lockVersion 1 loads and is rewritten as 2; anything else is refused.
 */

namespace epm::lock;

use epm::manifest;
use epm::manifest::Origin;
use epm::sys;
use std::io;

public const LOCK_VERSION = 2;

public struct Entry
{
    string $name;
    string $version;
    Origin $origin;
    string $rev;
    string $sha256;
    array<string> $requires;

    constructor(string $name, string $version, Origin $origin, string $rev, string $sha256)
    {
        $this->name = $name;
        $this->version = $version;
        $this->origin = $origin;
        $this->rev = $rev;
        $this->sha256 = $sha256;
        $this->requires = array<string>();
    }
}

public struct Lock
{
    array<Entry> $packages;
    int64 $version;

    constructor()
    {
        $this->packages = array<Entry>();
        $this->version = LOCK_VERSION;
    }

    const function find(const string& $name) : Entry?
    {
        usize $i = 0;

        while ($i < $this->packages->count()) {
            if ($this->packages[$i]->name == $name) {
                return $this->packages[$i];
            }

            $i = $i + 1;
        }

        return null;
    }
}

public function path_beside(const string& $manifest) : string
{
    return sys::join(sys::dirname($manifest), 'epm.lock.json');
}

/**
 * The tree hash this lock version stored. Version 1 is path, newline, body;
 * version 2 tags files and links. Asked of a vendored tree before a format
 * bump rewrites the lock, so the old hash is actually checked.
 */
public function tree_hash(const string& $root, int64 $version) : string
{
    if ($version < LOCK_VERSION) {
        return sys::tree_sha256_v1($root);
    }

    return sys::tree_sha256($root);
}

/**
 * Whether this lock version can be checked against `$root`. Version 1
 * followed directory links and skipped dangling ones; a link to a file
 * hashes the same under both walks.
 */
public function tree_is_checkable(const string& $root, int64 $version) : bool
{
    if ($version >= LOCK_VERSION) {
        return true;
    }

    return !sys::tree_has_v1_uncheckable_link($root);
}

public function load(const string& $path) : result<Lock, string>
{
    if (!sys::is_file($path)) {
        return .ok(Lock());
    }

    string $text = guard io::readfile($path) else ($e) {
        return .error("cannot read {$path}: {$e}");
    }

    json::Value $root = guard json::parse($text) else ($e) {
        return .error("{$path} is not JSON: {$e}");
    }

    int64 $ver = $root['lockVersion']->asInt() ?? 0;

    if ($ver < 1 || $ver > LOCK_VERSION) {
        return .error("{$path} has lockVersion {$ver}, expected 1 or 2");
    }

    Lock $lock = Lock();
    $lock->version = $ver;
    array<json::Value> $pkgs = guard $root['packages']->asArray() else {
        return .ok($lock);
    }

    usize $i = 0;

    while ($i < $pkgs->count()) {
        json::Value $one = $pkgs[$i];
        string $name = $one['name']->asStr() ?? '';
        string $kind = $one['source']['kind']->asStr() ?? '';
        string $url = $one['source']['url']->asStr() ?? '';

        if ($name->empty()) {
            $i = $i + 1;
            continue;
        }

        if ($kind != 'git') {
            return .error("{$path}: package '{$name}' has source kind '{$kind}', expected git");
        }

        string $rev = $one['rev']->asStr() ?? '';
        string $sha = $one['sha256']->asStr() ?? '';

        // **a lock is input like any other file in a repository.** the name becomes vendor/<name>,
        // the url and rev go to git. a lock that names `/` or `../x`, or hands git an option, is refused first
        string $refused = refusal_of($name, $url, $rev, $sha);

        if (!$refused->empty()) {
            return .error("{$path}: package '{$name}' {$refused}");
        }

        Entry $e = Entry(
            $name,
            $one['version']->asStr() ?? '',
            Origin::git($url),
            $rev,
            $sha
        );

        array<json::Value> $reqs = $one['requires']->asArray() ?? array<json::Value>();

        usize $j = 0;

        while ($j < $reqs->count()) {
            string $n = $reqs[$j]->asStr() ?? '';

            if (!$n->empty()) {
                $e->requires[] = $n;
            }

            $j = $j + 1;
        }

        $lock->packages[] = $e;
        $i = $i + 1;
    }

    return .ok($lock);
}

public function save(const string& $path, const Lock& $lock) : result<bool, string>
{
    json::Value $root = json::object();
    $root['lockVersion'] = json::int(LOCK_VERSION);

    json::Value $pkgs = json::arr();
    usize $i = 0;

    while ($i < $lock->packages->count()) {
        Entry $e = $lock->packages[$i];
        json::Value $one = json::object();
        $one['name'] = json::str($e->name);
        $one['version'] = json::str($e->version);

        json::Value $src = json::object();
        $src['kind'] = json::str($e->origin->kind);
        $src['url'] = json::str($e->origin->locator);
        $one['source'] = $src;
        $one['rev'] = json::str($e->rev);
        $one['sha256'] = json::str($e->sha256);

        json::Value $reqs = json::arr();
        usize $j = 0;

        while ($j < $e->requires->count()) {
            $reqs[] = json::str($e->requires[$j]);
            $j = $j + 1;
        }

        $one['requires'] = $reqs;
        $pkgs[] = $one;
        $i = $i + 1;
    }

    $root['packages'] = $pkgs;

    result<usize, io::ioerror> $wrote = io::writefile($path, json::pretty($root));

    if ($wrote->failed()) {
        return .error("cannot write {$path}");
    }

    return .ok(true);
}

private function refusal_of(
    const string& $name,
    const string& $url,
    const string& $rev,
    const string& $sha
) : string
{
    if (!manifest::usable_name($name)) {
        return 'has a name that is not a package name';
    }

    if (!$url->empty() && !manifest::usable_url($url)) {
        return "has url '{$url}', which epm will not hand to git";
    }

    if (!manifest::usable_rev($rev)) {
        return "has rev '{$rev}', which epm will not hand to git";
    }

    if (!is_sha256_hex($sha)) {
        return "has sha256 '{$sha}', which is not a sha256";
    }

    return '';
}

// empty, for an entry nothing has hashed yet, or 64 lowercase hex digits
private function is_sha256_hex(const string& $sha) : bool
{
    if ($sha->empty()) {
        return true;
    }

    if ($sha->size() != 64) {
        return false;
    }

    usize $i = 0;

    while ($i < $sha->size()) {
        uint8 $b = $sha->byte($i);

        if (!(($b >= 48 && $b <= 57) || ($b >= 97 && $b <= 102))) {
            return false;
        }

        $i = $i + 1;
    }

    return true;
}
