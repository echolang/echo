/*
 * epm <command> [args]
 *
 * The entry file. Parse first: --help and --version are answers, not exits
 * inside the parser, and a refusal is drawn here so it can take the colour
 * the invocation asked for.
 */

use command;
use epm::cli;
use epm::cmd::dispatch;
use std::env;
use std::io;

cli::App $app = cli::App();
command::Outcome $r = $app->cmd->parse(env::argv());

if ($r->error != null) {
    command::Error $e = $r->error ?? .noCommand;
    command::CLIContext $err = .from($r->parsed, $app->cmd, .stderr);
    $err->print(command::renderError($e, $app->cmd, $r->parsed, $err));
    env::exit(1);
}

if ($r->parsed->wantsVersion) {
    io::println(command::renderVersion($app->cmd));
    env::exit(0);
}

if ($r->parsed->wantsHelp) {
    command::CLIContext $out = .from($r->parsed, $app->cmd, .stdout);
    $out->print(command::renderHelp($app->cmd, $r->parsed, $out));
    env::exit(0);
}

int32 $code = dispatch($app, $r->parsed);
env::exit($code);
