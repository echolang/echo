/**
 * Read a module.eco through `echoc -p manifest`. One grammar, one implementation.
 */

namespace epm::manifest;

use epm::sys;
use std::env;

public struct Requirement
{
    string $name;
    string $version;
    Origin $origin;
    string $rev;

    constructor(string $name, string $version, Origin $origin, string $rev)
    {
        $this->name = $name;
        $this->version = $version;
        $this->origin = $origin;
        $this->rev = $rev;
    }
}

/**
 * What `#[target:]` named. the same closed spellings `echoc -p manifest` emits.
 */
public enum TargetKind
{
    case exe;
    // `test` is a keyword, so this is `#[target: test]`
    case testScope;
    case lib;
}

// unknown JSON is not a lib scope, so a nested walk skips it
function target_kind_of(const string& $spelled) : TargetKind
{
    if ($spelled == 'lib') {
        return .lib;
    }

    if ($spelled == 'test') {
        return .testScope;
    }

    return .exe;
}

public struct ScopedRequirement
{
    string $target;
    TargetKind $kind;
    Requirement $req;

    constructor(string $target, TargetKind $kind, Requirement $req)
    {
        $this->target = $target;
        $this->kind = $kind;
        $this->req = $req;
    }
}

public struct ScopedDepend
{
    string $target;
    TargetKind $kind;
    string $path;

    constructor(string $target, TargetKind $kind, string $path)
    {
        $this->target = $target;
        $this->kind = $kind;
        $this->path = $path;
    }
}

public struct Manifest
{
    string $name;
    string $version;
    string $path;
    array<Requirement> $requires;
    array<ScopedRequirement> $scoped;
    array<string> $depends;
    array<ScopedDepend> $scoped_depends;

    // exe targets this module offers: `public: true`
    array<string> $public_targets;

    // a hook's `#[requires:]`: vendored like the module's, never compiled into it
    array<Requirement> $hook_requires;

    // a hook's `#[depends:]`, as written. walked from the root only
    array<string> $hook_depends;

    constructor(string $name, string $version, string $path)
    {
        $this->name = $name;
        $this->version = $version;
        $this->path = $path;
        $this->requires = array<Requirement>();
        $this->scoped = array<ScopedRequirement>();
        $this->depends = array<string>();
        $this->scoped_depends = array<ScopedDepend>();
        $this->public_targets = array<string>();
        $this->hook_requires = array<Requirement>();
        $this->hook_depends = array<string>();
    }

    const function offers(const string& $target) : bool
    {
        usize $i = 0;

        while ($i < $this->public_targets->count()) {
            if ($this->public_targets[$i] == $target) {
                return true;
            }

            $i = $i + 1;
        }

        return false;
    }
}

/**
 * Requires inside an offered target's scope. vendored only for a package
 * the project requires directly: a transitive package's tools are unreachable.
 */
public function tool_requires(const Manifest& $m) : array<Requirement>
{
    array<Requirement> $out = array<Requirement>();
    usize $i = 0;

    while ($i < $m->scoped->count()) {
        if ($m->offers($m->scoped[$i]->target)) {
            $out[] = $m->scoped[$i]->req;
        }

        $i = $i + 1;
    }

    return $out;
}

/**
 * File-scope plus `lib` scopes. The compiler's graph follows the same cut.
 */
public function library_requires(const Manifest& $m) : array<Requirement>
{
    array<Requirement> $out = array<Requirement>();
    usize $i = 0;

    while ($i < $m->requires->count()) {
        $out[] = $m->requires[$i];
        $i = $i + 1;
    }

    $i = 0;

    while ($i < $m->scoped->count()) {
        if ($m->scoped[$i]->kind == TargetKind::lib) {
            $out[] = $m->scoped[$i]->req;
        }

        $i = $i + 1;
    }

    return $out;
}

// the root's own: file-scope, every target scope. hooks sit on all_requires
function program_requires(const Manifest& $m) : array<Requirement>
{
    array<Requirement> $out = array<Requirement>();
    usize $i = 0;

    while ($i < $m->requires->count()) {
        $out[] = $m->requires[$i];
        $i = $i + 1;
    }

    $i = 0;

    while ($i < $m->scoped->count()) {
        $out[] = $m->scoped[$i]->req;
        $i = $i + 1;
    }

    return $out;
}

public function all_requires(const Manifest& $m) : array<Requirement>
{
    array<Requirement> $out = program_requires($m);
    usize $i = 0;

    while ($i < $m->hook_requires->count()) {
        $out[] = $m->hook_requires[$i];
        $i = $i + 1;
    }

    return $out;
}

/**
 * The module.eco a `#[depends:]` names, relative to the manifest that wrote it.
 * A directory or the file itself, matching echoc.
 */
public function depend_module(const string& $from_manifest, const string& $spelled) : result<string, string>
{
    string $probe = $spelled;

    if (!sys::is_absolute($probe)) {
        $probe = sys::join(sys::dirname($from_manifest), $spelled);
    }

    if (sys::is_file($probe) && sys::basename($probe) == 'module.eco') {
        return .ok($probe);
    }

    string $mod = sys::join($probe, 'module.eco');

    if (sys::is_file($mod)) {
        return .ok($mod);
    }

    return .error("cannot load path dependency '{$spelled}' from {$from_manifest}");
}

public function name_seen(const array<string>& $seen, const string& $name) : bool
{
    usize $i = 0;

    while ($i < $seen->count()) {
        if ($seen[$i] == $name) {
            return true;
        }

        $i = $i + 1;
    }

    return false;
}

function append_copy(const array<Requirement>& $from, array<Requirement>& $into) : void
{
    usize $i = 0;

    while ($i < $from->count()) {
        $into[] = $from[$i];
        $i = $i + 1;
    }
}

function append_library(const Manifest& $m, array<Requirement>& $into) : void
{
    append_copy(library_requires($m), $into);
}

function append_tools(const Manifest& $m, array<Requirement>& $into) : void
{
    append_copy(tool_requires($m), $into);
}

function walk_depend_path(
    const Manifest& $from,
    const string& $spelled,
    array<string>& $seen,
    array<Requirement>& $into,
    int32 $depth
) : result<bool, string>
{
    string $path = guard depend_module($from->path, $spelled) else ($e) {
        return .error($e);
    }

    Manifest $dep = guard load($path) else ($e) {
        return .error($e);
    }

    if (name_seen($seen, $dep->name)) {
        return .ok(true);
    }

    $seen[] = $dep->name;
    append_library($dep, $into);
    bool $ok = guard walk_depends($dep, $seen, $into, $depth + 1) else ($e) {
        return .error($e);
    }

    return .ok(true);
}

// nested only: file-scope plus lib-scoped depends. consumer edges are load_directs
function walk_depends(
    const Manifest& $man,
    array<string>& $seen,
    array<Requirement>& $into,
    int32 $depth
) : result<bool, string>
{
    if ($depth > 32) {
        return .error('path dependency walk is too deep');
    }

    usize $i = 0;

    while ($i < $man->depends->count()) {
        bool $ok = guard walk_depend_path(
            $man, $man->depends[$i], $seen, $into, $depth
        ) else ($e) {
            return .error($e);
        }

        $i = $i + 1;
    }

    $i = 0;

    while ($i < $man->scoped_depends->count()) {
        if ($man->scoped_depends[$i]->kind != TargetKind::lib) {
            $i = $i + 1;
            continue;
        }

        bool $ok = guard walk_depend_path(
            $man, $man->scoped_depends[$i]->path, $seen, $into, $depth
        ) else ($e) {
            return .error($e);
        }

        $i = $i + 1;
    }

    return .ok(true);
}

function load_direct(
    const Manifest& $root,
    const string& $spelled,
    array<string>& $seen,
    array<Manifest>& $directs
) : result<bool, string>
{
    string $path = guard depend_module($root->path, $spelled) else ($e) {
        return .error($e);
    }

    Manifest $dep = guard load($path) else ($e) {
        return .error($e);
    }

    if (name_seen($seen, $dep->name)) {
        return .ok(true);
    }

    $seen[] = $dep->name;
    $directs[] = $dep;
    return .ok(true);
}

// the root's own edges: file-scope, every target, hooks. names here are the direct set
function load_directs(
    const Manifest& $root,
    array<string>& $seen
) : result<array<Manifest>, string>
{
    array<Manifest> $directs = array<Manifest>();
    usize $i = 0;

    while ($i < $root->depends->count()) {
        bool $ok = guard load_direct($root, $root->depends[$i], $seen, $directs) else ($e) {
            return .error($e);
        }

        $i = $i + 1;
    }

    $i = 0;

    while ($i < $root->scoped_depends->count()) {
        bool $ok = guard load_direct(
            $root, $root->scoped_depends[$i]->path, $seen, $directs
        ) else ($e) {
            return .error($e);
        }

        $i = $i + 1;
    }

    $i = 0;

    while ($i < $root->hook_depends->count()) {
        bool $ok = guard load_direct($root, $root->hook_depends[$i], $seen, $directs) else ($e) {
            return .error($e);
        }

        $i = $i + 1;
    }

    return .ok($directs);
}

/**
 * Root requires, plus every `#[requires:]` on a reachable `#[depends:]` module.
 * Path modules stay out of vendor/; only their git requires are solve roots.
 */
public function reachable_requires(const Manifest& $root) : result<array<Requirement>, string>
{
    array<Requirement> $out = all_requires($root);
    array<string> $seen = array<string>();
    $seen[] = $root->name;
    array<Manifest> $directs = guard load_directs($root, $seen) else ($e) {
        return .error($e);
    }

    usize $i = 0;

    while ($i < $directs->count()) {
        append_library($directs[$i], $out);
        append_tools($directs[$i], $out);
        bool $ok = guard walk_depends($directs[$i], $seen, $out, 1) else ($e) {
            return .error($e);
        }

        $i = $i + 1;
    }

    return .ok($out);
}

public function find_module(const string& $start) : string?
{
    string $dir = $start;

    while (true) {
        string $here = sys::join($dir, 'module.eco');

        if (sys::is_file($here)) {
            return $here;
        }

        string $parent = sys::dirname($dir);

        if ($parent == $dir) {
            return null;
        }

        $dir = $parent;
    }
}

/**
 * Which echoc this process should shell out to.
 *
 * A non-empty $from_env is ECHOC and wins. Otherwise the echoc sitting
 * next to this binary, which is where the installer puts it. A bare
 * `echoc` is PATH.
 */
public function echoc_from(const string& $exe_dir, const string& $from_env) : string
{
    if (!$from_env->empty()) {
        return $from_env;
    }

    string $sibling = sys::join($exe_dir, sys::host_exe('echoc'));

    if (sys::is_file($sibling)) {
        return $sibling;
    }

    return sys::host_exe('echoc');
}

public function echoc_bin() : result<string, string>
{
    std::fs::path $exe = guard env::exe() else ($e) {
        return .error($e->message());
    };

    return .ok(echoc_from(sys::dirname($exe), str::from(env::var('ECHOC', ''))));
}

public function load(const string& $path) : result<Manifest, string>
{
    string $bin = try echoc_bin();
    array<string> $argv = array<string>();
    $argv[] = $bin;
    $argv[] = 'build';
    $argv[] = '-p';
    $argv[] = 'manifest';
    $argv[] = '-m';
    $argv[] = $path;
    sys::Run $ran = sys::run($argv);

    if (!$ran->ok()) {
        return .error("echoc -p manifest failed:\n{$ran->err}{$ran->out}");
    }

    json::Value $root = guard json::parse($ran->out) else ($e) {
        return .error("echoc -p manifest was not JSON: {$e}");
    }

    Manifest $m = Manifest(
        $root['name']->asStr() ?? '',
        $root['version']->asStr() ?? '',
        $path
    );

    array<json::Value> $deps = $root['depends']->asArray() ?? array<json::Value>();
    usize $di = 0;

    while ($di < $deps->count()) {
        string $d = $deps[$di]->asStr() ?? '';

        if (!$d->empty()) {
            $m->depends[] = $d;
        }

        $di = $di + 1;
    }

    take_requires($root['requires'], $m->requires);

    array<json::Value> $targets = $root['targets']->asArray() ?? array<json::Value>();
    usize $ti = 0;

    while ($ti < $targets->count()) {
        string $tname = $targets[$ti]['name']->asStr() ?? '';

        if ($targets[$ti]['public']->asBool() ?? false) {
            $m->public_targets[] = $tname;
        }

        TargetKind $tkind = target_kind_of($targets[$ti]['kind']->asStr() ?? '');
        array<Requirement> $scoped = array<Requirement>();
        take_requires($targets[$ti]['requires'], $scoped);
        usize $si = 0;

        while ($si < $scoped->count()) {
            $m->scoped[] = ScopedRequirement($tname, $tkind, $scoped[$si]);
            $si = $si + 1;
        }

        array<json::Value> $tdeps = $targets[$ti]['depends']->asArray() ?? array<json::Value>();
        usize $tdi = 0;

        while ($tdi < $tdeps->count()) {
            string $td = $tdeps[$tdi]->asStr() ?? '';

            if (!$td->empty()) {
                $m->scoped_depends[] = ScopedDepend($tname, $tkind, $td);
            }

            $tdi = $tdi + 1;
        }

        $ti = $ti + 1;
    }

    array<json::Value> $hooks = $root['hooks']->asArray() ?? array<json::Value>();
    usize $hi = 0;

    while ($hi < $hooks->count()) {
        take_requires($hooks[$hi]['requires'], $m->hook_requires);

        array<json::Value> $hdeps = $hooks[$hi]['depends']->asArray() ?? array<json::Value>();
        usize $hdi = 0;

        while ($hdi < $hdeps->count()) {
            string $hd = $hdeps[$hdi]->asStr() ?? '';

            if (!$hd->empty()) {
                $m->hook_depends[] = $hd;
            }

            $hdi = $hdi + 1;
        }

        $hi = $hi + 1;
    }

    return .ok($m);
}

private function take_requires(json::Value $node, array<Requirement>& $into) : void
{
    array<json::Value> $items = $node->asArray() ?? array<json::Value>();

    usize $i = 0;

    while ($i < $items->count()) {
        json::Value $one = $items[$i];
        string $name = $one['name']->asStr() ?? '';
        string $version = $one['version']->asStr() ?? '';
        string $rev = $one['rev']->asStr() ?? '';
        Origin $origin = origin_from_json($one['source']);

        if (!$name->empty()) {
            $into[] = Requirement($name, $version, $origin, $rev);
        }

        $i = $i + 1;
    }
}

function origin_from_json(json::Value $node) : Origin
{
    string $kind = $node['kind']->asStr() ?? 'git';
    string $url = $node['url']->asStr() ?? '';
    return Origin($kind, $url);
}

public function usable_name(const string& $name) : bool
{
    if ($name->empty() || $name->contains('\\') || sys::is_absolute($name)) {
        return false;
    }

    int32 $components = 0;
    usize $start = 0;
    usize $i = 0;

    while ($i <= $name->size()) {
        bool $cut = $i == $name->size();

        if (!$cut && $name->byte($i) == 47) {
            $cut = true;
        }

        if ($cut) {
            usize $len = $i - $start;

            if ($len == 0) {
                return false;
            }

            string $part = $name->sub($start, $len);

            if ($part == '.' || $part == '..' || $part->contains(':')) {
                return false;
            }

            $components = $components + 1;

            if ($components > 8) {
                return false;
            }

            $start = $i + 1;
        }

        if ($i == $name->size()) {
            break;
        }

        $i = $i + 1;
    }

    return $components >= 1;
}

/**
 * The directory below `$outer` that `$name` names, or '' when `$name` is
 * not inside it. Whole segments only: `lib/sub` is inside `lib`, `libs` is not.
 */
public function inner_path(const string& $outer, const string& $name) : string
{
    usize $cut = $outer->size();

    if ($outer->empty() || $name->size() <= $cut + 1 || !$name->starts($outer) || $name->byte($cut) != 47) {
        return '';
    }

    return $name->sub($cut + 1, $name->size() - $cut - 1);
}
