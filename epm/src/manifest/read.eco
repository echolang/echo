/**
 * Read a module.eco through `echoc -p manifest`. One grammar, one implementation.
 */

namespace epm::manifest;

use epm::sys;
use std::env;

public struct Requirement
{
    string $name;
    string $version;
    Origin $origin;
    string $rev;

    constructor(string $name, string $version, Origin $origin, string $rev)
    {
        $this->name = $name;
        $this->version = $version;
        $this->origin = $origin;
        $this->rev = $rev;
    }
}

public struct ScopedRequirement
{
    string $target;
    Requirement $req;

    constructor(string $target, Requirement $req)
    {
        $this->target = $target;
        $this->req = $req;
    }
}

public struct ScopedDepend
{
    string $target;
    string $path;

    constructor(string $target, string $path)
    {
        $this->target = $target;
        $this->path = $path;
    }
}

public struct Manifest
{
    string $name;
    string $version;
    string $path;
    array<Requirement> $requires;
    array<ScopedRequirement> $scoped;
    array<string> $depends;
    array<ScopedDepend> $scoped_depends;

    constructor(string $name, string $version, string $path)
    {
        $this->name = $name;
        $this->version = $version;
        $this->path = $path;
        $this->requires = array<Requirement>();
        $this->scoped = array<ScopedRequirement>();
        $this->depends = array<string>();
        $this->scoped_depends = array<ScopedDepend>();
    }
}

public function all_requires(const Manifest& $m) : array<Requirement>
{
    array<Requirement> $out = array<Requirement>();
    usize $i = 0;

    while ($i < $m->requires->count()) {
        $out[] = $m->requires[$i];
        $i = $i + 1;
    }

    $i = 0;

    while ($i < $m->scoped->count()) {
        $out[] = $m->scoped[$i]->req;
        $i = $i + 1;
    }

    return $out;
}

/**
 * The module.eco a `#[depends:]` names, relative to the manifest that wrote it.
 * A directory or the file itself, matching echoc.
 */
public function depend_module(const string& $from_manifest, const string& $spelled) : result<string, string>
{
    string $probe = $spelled;

    if (!sys::is_absolute($probe)) {
        $probe = sys::join(sys::dirname($from_manifest), $spelled);
    }

    if (sys::is_file($probe) && sys::basename($probe) == 'module.eco') {
        return .ok($probe);
    }

    string $mod = sys::join($probe, 'module.eco');

    if (sys::is_file($mod)) {
        return .ok($mod);
    }

    return .error("cannot load path dependency '{$spelled}' from {$from_manifest}");
}

public function name_seen(const array<string>& $seen, const string& $name) : bool
{
    usize $i = 0;

    while ($i < $seen->count()) {
        if ($seen[$i] == $name) {
            return true;
        }

        $i = $i + 1;
    }

    return false;
}

function append_requires(const Manifest& $m, array<Requirement>& $into) : void
{
    array<Requirement> $more = all_requires($m);
    usize $i = 0;

    while ($i < $more->count()) {
        $into[] = $more[$i];
        $i = $i + 1;
    }
}

function walk_depend_path(
    const Manifest& $from,
    const string& $spelled,
    array<string>& $seen,
    array<Requirement>& $into,
    int32 $depth
) : result<bool, string>
{
    string $path = guard depend_module($from->path, $spelled) else ($e) {
        return .error($e);
    }

    Manifest $dep = guard load($path) else ($e) {
        return .error($e);
    }

    if (name_seen($seen, $dep->name)) {
        return .ok(true);
    }

    $seen[] = $dep->name;
    append_requires($dep, $into);
    bool $ok = guard walk_depends($dep, $seen, $into, $depth + 1) else ($e) {
        return .error($e);
    }

    return .ok(true);
}

function walk_depends(
    const Manifest& $man,
    array<string>& $seen,
    array<Requirement>& $into,
    int32 $depth
) : result<bool, string>
{
    if ($depth > 32) {
        return .error('path dependency walk is too deep');
    }

    usize $i = 0;

    while ($i < $man->depends->count()) {
        bool $ok = guard walk_depend_path($man, $man->depends[$i], $seen, $into, $depth) else ($e) {
            return .error($e);
        }

        $i = $i + 1;
    }

    $i = 0;

    while ($i < $man->scoped_depends->count()) {
        bool $ok = guard walk_depend_path(
            $man, $man->scoped_depends[$i]->path, $seen, $into, $depth
        ) else ($e) {
            return .error($e);
        }

        $i = $i + 1;
    }

    return .ok(true);
}

/**
 * Root requires, plus every `#[requires:]` on a reachable `#[depends:]` module.
 * Path modules stay out of vendor/; only their git requires are solve roots.
 */
public function reachable_requires(const Manifest& $root) : result<array<Requirement>, string>
{
    array<Requirement> $out = all_requires($root);
    array<string> $seen = array<string>();
    $seen[] = $root->name;
    bool $ok = guard walk_depends($root, $seen, $out, 0) else ($e) {
        return .error($e);
    }

    return .ok($out);
}

public function find_module(const string& $start) : string?
{
    string $dir = $start;

    while (true) {
        string $here = sys::join($dir, 'module.eco');

        if (sys::is_file($here)) {
            return $here;
        }

        string $parent = sys::dirname($dir);

        if ($parent == $dir) {
            return null;
        }

        $dir = $parent;
    }
}

/**
 * Which echoc this process should shell out to.
 *
 * A non-empty $from_env is ECHOC and wins. Otherwise the echoc sitting
 * next to this binary, which is where the installer puts it. A bare
 * `echoc` is PATH.
 */
public function echoc_from(const string& $exe_dir, const string& $from_env) : string
{
    if (!$from_env->empty()) {
        return $from_env;
    }

    string $sibling = sys::join($exe_dir, sys::host_exe('echoc'));

    if (sys::is_file($sibling)) {
        return $sibling;
    }

    return sys::host_exe('echoc');
}

public function echoc_bin() : string
{
    return echoc_from(sys::dirname(env::exe()), str::from(env::var('ECHOC', '')));
}

public function load(const string& $path) : result<Manifest, string>
{
    string $bin = echoc_bin();
    array<string> $argv = array<string>();
    $argv[] = $bin;
    $argv[] = 'build';
    $argv[] = '-p';
    $argv[] = 'manifest';
    $argv[] = '-m';
    $argv[] = $path;
    sys::Run $ran = sys::run($argv);

    if (!$ran->ok()) {
        return .error("echoc -p manifest failed:\n{$ran->err}{$ran->out}");
    }

    json::Value $root = guard json::parse($ran->out) else ($e) {
        return .error("echoc -p manifest was not JSON: {$e}");
    }

    Manifest $m = Manifest(
        $root['name']->asStr() ?? '',
        $root['version']->asStr() ?? '',
        $path
    );

    array<json::Value> $deps = $root['depends']->asArray() ?? array<json::Value>();
    usize $di = 0;

    while ($di < $deps->count()) {
        string $d = $deps[$di]->asStr() ?? '';

        if (!$d->empty()) {
            $m->depends[] = $d;
        }

        $di = $di + 1;
    }

    take_requires($root['requires'], $m->requires);

    array<json::Value> $targets = $root['targets']->asArray() ?? array<json::Value>();
    usize $ti = 0;

    while ($ti < $targets->count()) {
        string $tname = $targets[$ti]['name']->asStr() ?? '';
        array<Requirement> $scoped = array<Requirement>();
        take_requires($targets[$ti]['requires'], $scoped);
        usize $si = 0;

        while ($si < $scoped->count()) {
            $m->scoped[] = ScopedRequirement($tname, $scoped[$si]);
            $si = $si + 1;
        }

        array<json::Value> $tdeps = $targets[$ti]['depends']->asArray() ?? array<json::Value>();
        usize $tdi = 0;

        while ($tdi < $tdeps->count()) {
            string $td = $tdeps[$tdi]->asStr() ?? '';

            if (!$td->empty()) {
                $m->scoped_depends[] = ScopedDepend($tname, $td);
            }

            $tdi = $tdi + 1;
        }

        $ti = $ti + 1;
    }

    return .ok($m);
}

private function take_requires(json::Value $node, array<Requirement>& $into) : void
{
    array<json::Value> $items = $node->asArray() ?? array<json::Value>();

    usize $i = 0;

    while ($i < $items->count()) {
        json::Value $one = $items[$i];
        string $name = $one['name']->asStr() ?? '';
        string $version = $one['version']->asStr() ?? '';
        string $rev = $one['rev']->asStr() ?? '';
        Origin $origin = origin_from_json($one['source']);

        if (!$name->empty()) {
            $into[] = Requirement($name, $version, $origin, $rev);
        }

        $i = $i + 1;
    }
}

function origin_from_json(json::Value $node) : Origin
{
    string $kind = $node['kind']->asStr() ?? 'git';
    string $url = $node['url']->asStr() ?? '';
    return Origin($kind, $url);
}

public function usable_name(const string& $name) : bool
{
    if ($name->empty() || $name->contains('\\')) {
        return false;
    }

    int32 $components = 0;
    usize $start = 0;
    usize $i = 0;

    while ($i <= $name->size()) {
        bool $cut = $i == $name->size();

        if (!$cut && $name->byte($i) == 47) {
            $cut = true;
        }

        if ($cut) {
            usize $len = $i - $start;

            if ($len == 0) {
                return false;
            }

            string $part = $name->sub($start, $len);

            if ($part == '.' || $part == '..') {
                return false;
            }

            $components = $components + 1;

            if ($components > 8) {
                return false;
            }

            $start = $i + 1;
        }

        if ($i == $name->size()) {
            break;
        }

        $i = $i + 1;
    }

    return $components >= 1;
}
