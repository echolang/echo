/**
 * Pick one version per package name. Two versions of one package cannot
 * coexist, so "no version satisfies everyone" is a routine outcome and the
 * conflict message is the feature.
 *
 * Pending ranges for the same name are intersected before a version is
 * chosen. A failed subtree restores `$picked` to the count it had before
 * the attempt, not by a single pop. An already-picked version is checked
 * against a new range; the pick is not rewritten.
 *
 * Manifests are fetched when a release is tried, not before. A package inside
 * another (nested.eco) is solved as the outer one: its range joins the outer
 * range, and its own module.eco is read at the outer release's rev.
 */

namespace epm::resolve;

use epm::fetch;
use epm::manifest::{Requirement, Origin};
use epm::util::{Version, Range, intersect, satisfies, parse_range};

/**
 * What one directory inside a release requires: a package inside it.
 */
public struct Sub
{
    string $path;
    array<Requirement> $requires;

    constructor(string $path, array<Requirement> $requires)
    {
        $this->path = $path;
        $this->requires = $requires;
    }
}

public struct Release
{
    Version $version;
    string $tag;
    string $rev;
    array<Requirement> $requires;

    // what this release's public tools need. part of the solve
    // only when the project requires this package directly
    array<Requirement> $tool_requires;
    bool $hydrated;

    // the packages inside this release read so far
    array<Sub> $subs;

    constructor(Version $version, string $tag, string $rev)
    {
        $this->version = $version;
        $this->tag = $tag;
        $this->rev = $rev;
        $this->requires = array<Requirement>();
        $this->tool_requires = array<Requirement>();
        $this->hydrated = false;
        $this->subs = array<Sub>();
    }
}

public struct Package
{
    string $name;
    Origin $origin;
    array<Release> $releases;

    constructor(string $name, Origin $origin)
    {
        $this->name = $name;
        $this->origin = $origin;
        $this->releases = array<Release>();
    }
}

public struct Choice
{
    string $name;
    Version $version;
    Origin $origin;
    string $tag;
    string $rev;
    array<string> $requires;
    string $why;

    // directories of this package that are packages someone asked for
    array<string> $paths;

    constructor(
        string $name,
        Version $version,
        Origin $origin,
        string $tag,
        string $rev,
        string $why
    )
    {
        $this->name = $name;
        $this->version = $version;
        $this->origin = $origin;
        $this->tag = $tag;
        $this->rev = $rev;
        $this->requires = array<string>();
        $this->why = $why;
        $this->paths = array<string>();
    }

    // an independent copy: assign() snapshots the prefix this way, so a failed
    // step can put the earlier picks back without sharing their arrays
    constructor(const Choice& $other)
    {
        $this->name = $other->name;
        $this->version = $other->version;
        $this->origin = $other->origin;
        $this->tag = $other->tag;
        $this->rev = $other->rev;
        $this->requires = $other->requires->clone();
        $this->why = $other->why;
        $this->paths = $other->paths->clone();
    }
}

public struct World
{
    array<Package> $catalog;

    constructor()
    {
        $this->catalog = array<Package>();
    }

    const function package_of(const string& $name) : Package?
    {
        usize $i = 0;

        while ($i < $this->catalog->count()) {
            if ($this->catalog[$i]->name == $name) {
                return $this->catalog[$i];
            }

            $i = $i + 1;
        }

        return null;
    }

    const function index_of(const string& $name) : usize
    {
        usize $i = 0;

        while ($i < $this->catalog->count()) {
            if ($this->catalog[$i]->name == $name) {
                return $i;
            }

            $i = $i + 1;
        }

        return $this->catalog->count();
    }
}

struct Need
{
    Requirement $req;
    string $who;

    // the project asked for it itself, which is what makes the package's public tools reachable
    bool $direct;

    // the directory of the package that was asked for, '' for the package itself
    string $path;

    constructor(Requirement $req, string $who, bool $direct = false, string $path = '')
    {
        $this->req = $req;
        $this->who = $who;
        $this->direct = $direct;
        $this->path = $path;
    }
}

public function solve(
    const array<Requirement>& $roots,
    World& $world
) : result<array<Choice>, string>
{
    array<Need> $pending = array<Need>();

    foreach (fold($roots, $world) as const &$f) {
        $pending[] = Need($f->req, 'the project', true, $f->path);
    }

    array<Choice> $picked = array<Choice>();
    string $err = '';

    if (!assign($pending, $world, $picked, $err)) {
        return .error($err);
    }

    string $split = split_package($picked);

    if (!$split->empty()) {
        return .error($split);
    }

    return .ok($picked);
}

/**
 * Two picks where one is a directory of the other's checkout: the inner one
 * was required before anything named the package it is in, so it was not
 * folded into it. Refused rather than vendored twice.
 */
private function split_package(const array<Choice>& $picked) : string
{
    foreach ($picked as const &$outer) {
        foreach ($picked as const &$inner) {
            if ($outer->origin->same($inner->origin) && !inner_path($outer->name, $inner->name)->empty()) {
                return "'{$inner->name}' is inside '{$outer->name}' ({$outer->origin->spelling()}) - require '{$outer->name}' beside it, in the same module.eco";
            }
        }
    }

    return '';
}

/**
 * One step of the search. A failed step puts the prefix back from a
 * whole-Choice snapshot.
 */
private function assign(
    const array<Need>& $pending,
    World& $world,
    array<Choice>& $picked,
    string& $err
) : bool
{
    array<Choice> $had = snapshot($picked);

    if (assign_step($pending, $world, $picked, $err)) {
        return true;
    }

    revert($picked, $had);
    return false;
}

private function assign_step(
    const array<Need>& $given,
    World& $world,
    array<Choice>& $picked,
    string& $err
) : bool
{
    if ($given->count() == 0) {
        return true;
    }

    // grows: a package asked for inside one already picked brings what it requires
    array<Need> $pending = $given;
    usize $i = 0;

    while ($i < $pending->count()) {
        usize $at = picked_index($picked, $pending[$i]->req->name);

        if ($at != $picked->count()) {
            if (!accept_more($pending[$i], $picked, $err)) {
                return false;
            }

            string $path = $pending[$i]->path;

            if (!$path->empty() && !epm::manifest::name_seen($picked[$at]->paths, $path)) {
                array<Need> $more = guard inside_picked($world, $picked[$at], $path, $err) else {
                    return false;
                }

                $picked[$at]->paths[] = $path;

                foreach ($more as const &$m) {
                    if (!epm::manifest::name_seen($picked[$at]->requires, $m->req->name)) {
                        $picked[$at]->requires[] = $m->req->name;
                    }

                    $pending[] = $m;
                }
            }
        }

        $i = $i + 1;
    }

    usize $head = $pending->count();
    bool $found = false;

    while ($head > 0) {
        $head = $head - 1;

        if (picked_index($picked, $pending[$head]->req->name) == $picked->count()) {
            $found = true;
            break;
        }
    }

    if (!$found) {
        return true;
    }

    string $name = $pending[$head]->req->name;
    Range $range = guard parse_need($pending[$head], $err) else {
        return false;
    }

    string $why = "{$pending[$head]->who} asked for {$pending[$head]->req->version}";
    $i = 0;

    while ($i < $pending->count()) {
        if ($pending[$i]->req->name == $name) {
            Range $extra = guard parse_need($pending[$i], $err) else {
                return false;
            }

            Range $both = guard intersect($range, $extra) else {
                $err = "cannot satisfy '{$name}': {$why}, {$pending[$i]->who} wants {$pending[$i]->req->version}";
                return false;
            }

            $range = $both;
        }

        $i = $i + 1;
    }

    array<Need> $rest = array<Need>();
    array<string> $paths = array<string>();
    bool $direct = false;
    $i = 0;

    while ($i < $pending->count()) {
        if ($pending[$i]->req->name != $name) {
            $rest[] = $pending[$i];
        }
        else {
            if ($pending[$i]->direct) {
                $direct = true;
            }

            if (!$pending[$i]->path->empty() && !epm::manifest::name_seen($paths, $pending[$i]->path)) {
                $paths[] = $pending[$i]->path;
            }
        }

        $i = $i + 1;
    }

    usize $pkg = $world->index_of($name);

    if ($pkg == $world->catalog->count()) {
        $err = "{$pending[$head]->who} requires '{$name}', and no versions of it are known";
        return false;
    }

    usize $v = 0;
    bool $in_range = false;
    bool $readable = false;

    while ($v < $world->catalog[$pkg]->releases->count()) {
        if (!satisfies($world->catalog[$pkg]->releases[$v]->version, $range)) {
            $v = $v + 1;
            continue;
        }

        $in_range = true;

        if (!hydrate($world, $pkg, $v, $err)) {
            $v = $v + 1;
            continue;
        }

        // the packages asked for inside this one: a release without one of them is not a candidate
        array<Need> $inner = array<Need>();
        bool $has_all = true;

        foreach ($paths as const &$path) {
            array<Need> $got = guard sub_needs($world, $pkg, $v, $path, $err) else {
                $has_all = false;
                break;
            }

            foreach ($got as const &$g) {
                $inner[] = $g;
            }
        }

        if (!$has_all) {
            $v = $v + 1;
            continue;
        }

        $readable = true;
        Release $rel = $world->catalog[$pkg]->releases[$v];
        usize $at = $picked->count();
        Choice $choice = Choice(
            $name,
            $rel->version,
            $world->catalog[$pkg]->origin,
            $rel->tag,
            $rel->rev,
            $why
        );

        // a direct package's public tools are runnable by the project, so what they need is part of
        // recorded on the choice like any other requirement, so the lock says why it is there
        array<Requirement> $needs = $rel->requires;

        if ($direct) {
            if (!list_all($rel->tool_requires, $world, $err)) {
                return false;
            }

            foreach ($rel->tool_requires as const &$tool) {
                $needs[] = $tool;
            }
        }

        array<Need> $more = needs_of($needs, $name, $world);

        foreach ($inner as const &$n) {
            $more[] = $n;
        }

        // carbon and a driver inside it often require the same packages
        foreach ($more as const &$m) {
            if (!epm::manifest::name_seen($choice->requires, $m->req->name)) {
                $choice->requires[] = $m->req->name;
            }
        }

        $choice->paths = $paths;
        $picked[] = $choice;

        array<Need> $next = array<Need>();
        usize $r = 0;

        while ($r < $rest->count()) {
            $next[] = $rest[$r];
            $r = $r + 1;
        }

        foreach ($more as const &$m) {
            $next[] = $m;
        }

        if (assign($next, $world, $picked, $err)) {
            return true;
        }

        restore($picked, $at);
        $v = $v + 1;
    }

    if (!$in_range) {
        $err = "no version of '{$name}' satisfies {$pending[$head]->who}'s range {$pending[$head]->req->version}";
    }
    else if (!$readable) {
        string $detail = $err;
        $err = "no version of '{$name}' has a readable module.eco in range {$pending[$head]->req->version}";

        if (!$detail->empty()) {
            $err = "{$err}:\n{$detail}";
        }
    }

    return false;
}

private function hydrate(
    World& $world,
    usize $pkg,
    usize $rel_i,
    string& $err
) : bool
{
    if ($world->catalog[$pkg]->releases[$rel_i]->hydrated) {
        return true;
    }

    Origin $origin = $world->catalog[$pkg]->origin;
    fetch::Source $src = fetch::source_for($origin);
    string $tag = $world->catalog[$pkg]->releases[$rel_i]->tag;
    string $rev = $world->catalog[$pkg]->releases[$rel_i]->rev;
    epm::manifest::Manifest $man = guard $src->fetch_manifest($tag, $rev, '') else ($e) {
        $err = $e;
        return false;
    }

    array<Requirement> $reqs = $man->requires;

    if (!list_all($reqs, $world, $err)) {
        return false;
    }

    // recorded, not listed: listing fetches tags, and a transitive package's tools are never in the solve
    $world->catalog[$pkg]->releases[$rel_i]->requires = $reqs;
    $world->catalog[$pkg]->releases[$rel_i]->tool_requires = epm::manifest::tool_requires($man);
    $world->catalog[$pkg]->releases[$rel_i]->hydrated = true;
    return true;
}

// a package inside another is listed as the one it is in
private function list_all(const array<Requirement>& $reqs, World& $world, string& $err) : bool
{
    foreach (fold($reqs, $world) as const &$f) {
        bool $listed = guard ensure_listed($f->req, $world) else ($e) {
            $err = $e;
            return false;
        }
    }

    return true;
}

// one manifest's requirements as needs of `$who`, each on the package it sits in
private function needs_of(const array<Requirement>& $reqs, const string& $who, const World& $world) : array<Need>
{
    array<Need> $out = array<Need>();

    foreach (fold($reqs, $world) as const &$f) {
        $out[] = Need($f->req, $who, false, $f->path);
    }

    return $out;
}

/**
 * What the package at `$path` inside a release requires, as needs. Its
 * module.eco is read at the release's rev, once.
 */
private function sub_needs(
    World& $world,
    usize $pkg,
    usize $rel_i,
    const string& $path,
    string& $err
) : array<Need>?
{
    string $name = $world->catalog[$pkg]->name;
    string $who = "{$name}/{$path}";

    foreach ($world->catalog[$pkg]->releases[$rel_i]->subs as const &$s) {
        if ($s->path == $path) {
            return needs_of($s->requires, $who, $world);
        }
    }

    fetch::Source $src = fetch::source_for($world->catalog[$pkg]->origin);
    string $tag = $world->catalog[$pkg]->releases[$rel_i]->tag;
    string $rev = $world->catalog[$pkg]->releases[$rel_i]->rev;
    string $ver = $world->catalog[$pkg]->releases[$rel_i]->version->spelling();
    epm::manifest::Manifest $man = guard $src->fetch_manifest($tag, $rev, $path) else ($e) {
        $err = "{$name} {$ver} has no package at {$path}: {$e}";
        return null;
    }

    if (!list_all($man->requires, $world, $err)) {
        return null;
    }

    $world->catalog[$pkg]->releases[$rel_i]->subs[] = Sub($path, $man->requires);
    return needs_of($man->requires, $who, $world);
}

// sub_needs for a package that is already picked: the release it was picked at
private function inside_picked(
    World& $world,
    const Choice& $choice,
    const string& $path,
    string& $err
) : array<Need>?
{
    usize $pkg = $world->index_of($choice->name);

    if ($pkg == $world->catalog->count()) {
        $err = "'{$choice->name}' was picked but is not listed";
        return null;
    }

    usize $v = 0;

    while ($v < $world->catalog[$pkg]->releases->count()) {
        if ($world->catalog[$pkg]->releases[$v]->tag == $choice->tag) {
            return sub_needs($world, $pkg, $v, $path, $err);
        }

        $v = $v + 1;
    }

    $err = "'{$choice->name}' {$choice->tag} was picked but is not listed";
    return null;
}

private function accept_more(
    const Need& $need,
    array<Choice>& $picked,
    string& $err
) : bool
{
    usize $at = picked_index($picked, $need->req->name);
    Range $extra = guard parse_need($need, $err) else {
        return false;
    }

    if (!satisfies($picked[$at]->version, $extra)) {
        string $have = $picked[$at]->version->spelling();
        string $reason = $picked[$at]->why;
        $err = "cannot satisfy '{$need->req->name}': {$need->who} wants {$need->req->version}, already picked {$have} ({$reason})";
        return false;
    }

    return true;
}

private function parse_need(const Need& $need, string& $err) : Range?
{
    Range $range = guard parse_range($need->req->version) else {
        $err = "{$need->who} asked for {$need->req->name} @{$need->req->version}, which is not a range";
        return null;
    }

    return $range;
}

private function picked_index(const array<Choice>& $picked, const string& $name) : usize
{
    usize $i = 0;

    while ($i < $picked->count()) {
        if ($picked[$i]->name == $name) {
            return $i;
        }

        $i = $i + 1;
    }

    return $picked->count();
}

private function restore(array<Choice>& $picked, usize $at) : void
{
    while ($picked->count() > $at) {
        $picked->pop();
    }
}

private function snapshot(const array<Choice>& $picked) : array<Choice>
{
    array<Choice> $out = array<Choice>();

    foreach ($picked as const &$c) {
        $out[] = Choice($c);
    }

    return $out;
}

private function revert(array<Choice>& $picked, const array<Choice>& $had) : void
{
    while ($picked->count() > $had->count()) {
        $picked->pop();
    }

    usize $i = 0;

    while ($i < $had->count()) {
        $picked[$i] = Choice($had[$i]);
        $i = $i + 1;
    }
}
