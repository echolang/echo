/**
 * Files and directories the stdlib does not cover: listing, mkdir -p, rm -r,
 * and "is this a directory".
 */

namespace epm::sys;

public function exists(const string& $path) : bool
{
    int32 $k = epm_kind($path->cstr());

    if ($k > 0) {
        return true;
    }

    return false;
}

public function is_dir(const string& $path) : bool
{
    return epm_kind($path->cstr()) == 2;
}

public function is_file(const string& $path) : bool
{
    return epm_kind($path->cstr()) == 1;
}

/**
 * Whether the path itself is a symbolic link (a reparse point on Windows),
 * wherever it points. is_dir and is_file follow one. Anything that removes or
 * walks a tree it did not create asks this first.
 */
public function is_link(const string& $path) : bool
{
    return epm_is_link($path->cstr()) == 1;
}

/** A link's target as written, or '' when it cannot be read. */
public function link_target(const string& $path) : string
{
    string $buf = '';
    $buf->reserve(4096);
    ptr<uint8> $slot = $buf->spare();

    if (epm_readlink($path->cstr(), $slot, 4096) < 0) {
        return '';
    }

    return str::from($slot);
}

public function mkdir(const string& $path) : bool
{
    return epm_mkdir($path->cstr()) == 0;
}

public function mkdir_p(const string& $path) : bool
{
    if ($path->empty() || $path == '.') {
        return true;
    }

    if (is_dir($path)) {
        return true;
    }

    string $parent = dirname($path);

    if ($parent != $path) {
        if (!mkdir_p($parent)) {
            return false;
        }
    }

    return mkdir($path);
}

public function rmdir(const string& $path) : bool
{
    return epm_rmdir($path->cstr()) == 0;
}

public function rename(const string& $from, const string& $to) : bool
{
    return epm_rename($from->cstr(), $to->cstr()) == 0;
}

public function readdir(const string& $path) : array<string>
{
    array<string> $names = array<string>();
    ptr<uint8> $dir = epm_opendir($path->cstr());

    if ($dir:$ == null) {
        return $names;
    }

    string $buf = '';
    $buf->reserve(512);
    ptr<uint8> $slot = $buf->spare();

    int32 $got = epm_readdir($dir, $slot, 512);

    while ($got == 1) {
        $names[] = str::from($slot);
        $got = epm_readdir($dir, $slot, 512);
    }

    epm_closedir($dir);
    return $names;
}

public function remove_all(const string& $path) : bool
{
    // **the link, never what it points at.** epm_kind follows one, and a directory reached through it
    // would be emptied: a vendored `home -> $HOME` made `epm update` delete a home directory
    if (is_link($path)) {
        if (epm_unlink($path->cstr()) == 0) {
            return true;
        }

        // a directory link or a junction on Windows is removed as a directory, which removes the link
        return rmdir($path);
    }

    int32 $k = epm_kind($path->cstr());

    if ($k == 0) {
        return true;
    }

    if ($k == 1) {
        return epm_unlink($path->cstr()) == 0;
    }

    array<string> $kids = readdir($path);
    usize $i = 0;

    while ($i < $kids->count()) {
        if (!remove_all(join($path, $kids[$i]))) {
            return false;
        }

        $i = $i + 1;
    }

    return rmdir($path);
}

public function sha256_hex(const string& $data) : string
{
    ptr<uint8> $h = epm_sha256_new();

    if ($h:$ == null) {
        return '';
    }

    epm_sha256_update($h, $data->cstr(), $data->size());

    string $raw = '';
    $raw->reserve(32);
    ptr<uint8> $out = $raw->spare();
    epm_sha256_final($h, $out);
    $raw->commit(32);

    return hex_of($raw);
}

/**
 * The tree hash a current lock stores: a type tag, the relative path, a NUL,
 * then the file body or the link target, and a newline.
 */
public function tree_sha256(const string& $root) : string
{
    return hash_tree($root, 2);
}

/**
 * The tree hash lockVersion 1 stored: each file is its relative path, a
 * newline, then its body. The walk is collect_files, which does not follow
 * links, so this does not reproduce a version 1 lock of a tree that had a
 * directory or dangling link. A link to a file hashes the same. The gate
 * is lock::tree_is_checkable; a match is rewritten as 2.
 */
public function tree_sha256_v1(const string& $root) : string
{
    return hash_tree($root, 1);
}

/**
 * Whether the walk that hashes a tree recorded a symbolic link.
 */
public function tree_contains_link(const string& $root) : bool
{
    array<string> $files = array<string>();
    collect_files($root, '', $files);
    usize $i = 0;

    while ($i < $files->count()) {
        string $rel = $files[$i];
        string $here = $root;

        if (!$rel->empty()) {
            $here = join($root, $rel);
        }

        if (is_link($here)) {
            return true;
        }

        $i = $i + 1;
    }

    return false;
}

/**
 * A directory link or a dangling one. Version 1 followed directories and
 * skipped dangling entries; a link to a file hashes the same, because
 * readfile follows it.
 */
public function tree_has_v1_uncheckable_link(const string& $root) : bool
{
    array<string> $files = array<string>();
    collect_files($root, '', $files);
    usize $i = 0;

    while ($i < $files->count()) {
        string $rel = $files[$i];
        string $here = $root;

        if (!$rel->empty()) {
            $here = join($root, $rel);
        }

        if (is_link($here) && !is_file($here)) {
            return true;
        }

        $i = $i + 1;
    }

    return false;
}

private function hash_tree(const string& $root, int64 $version) : string
{
    array<string> $files = array<string>();
    collect_files($root, '', $files);
    sort_strings($files);

    ptr<uint8> $h = epm_sha256_new();

    if ($h:$ == null) {
        return '';
    }

    usize $i = 0;

    while ($i < $files->count()) {
        string $rel = $files[$i];
        string $here = $root;

        if (!$rel->empty()) {
            $here = join($root, $rel);
        }

        if ($version < 2) {
            string $body = std::io::readfile($here)->or('');
            epm_sha256_update($h, $rel->cstr(), $rel->size());
            epm_sha256_update($h, str::from('\n')->cstr(), 1);
            epm_sha256_update($h, $body->cstr(), $body->size());
        }
        else {
            // a type tag so a symlink `home -> /etc` cannot hash equal to a file named `home -> /etc`
            if (is_link($here)) {
                string $target = link_target($here);
                epm_sha256_update($h, str::from('L')->cstr(), 1);
                epm_sha256_update($h, $rel->cstr(), $rel->size());
                epm_sha256_update($h, str::from('\0')->cstr(), 1);
                epm_sha256_update($h, $target->cstr(), $target->size());
            }
            else {
                string $body = std::io::readfile($here)->or('');
                epm_sha256_update($h, str::from('F')->cstr(), 1);
                epm_sha256_update($h, $rel->cstr(), $rel->size());
                epm_sha256_update($h, str::from('\0')->cstr(), 1);
                epm_sha256_update($h, $body->cstr(), $body->size());
            }

            epm_sha256_update($h, str::from('\n')->cstr(), 1);
        }

        $i = $i + 1;
    }

    string $raw = '';
    $raw->reserve(32);
    ptr<uint8> $out = $raw->spare();
    epm_sha256_final($h, $out);
    $raw->commit(32);

    return hex_of($raw);
}

private function collect_files(const string& $root, const string& $rel, array<string>& $into) : void
{
    string $here = $root;

    if (!$rel->empty()) {
        $here = join($root, $rel);
    }

    // a link is hashed as what it says, and never followed: following one would hash whatever it
    // points at outside the tree, and a link that points back inside would make the walk endless
    if (is_link($here)) {
        $into[] = $rel;
        return;
    }

    if (is_file($here)) {
        $into[] = $rel;
        return;
    }

    if (!is_dir($here)) {
        return;
    }

    // `ecobuild/` is not the package: hashing it made every build a tampered tree
    if (!$rel->empty() && is_build_dir($here)) {
        return;
    }

    array<string> $kids = readdir($here);
    usize $i = 0;

    while ($i < $kids->count()) {
        string $name = $kids[$i];

        if ($name == '.git') {
            $i = $i + 1;
            continue;
        }

        string $child = $name;

        if (!$rel->empty()) {
            $child = join($rel, $name);
        }

        collect_files($root, $child, $into);
        $i = $i + 1;
    }
}

/**
 * Removes every directory under `$root` that carries echoc's build marker.
 *
 * Called on a tree straight after it is fetched, before it is hashed. tree_sha256
 * skips a marked directory, so a package that arrived with one could mark `src/`
 * and take it out of the hash. Removing them first means every marked directory
 * is one this machine's echoc made.
 */
public function remove_build_dirs(const string& $root) : bool
{
    if (is_link($root) || !is_dir($root)) {
        return true;
    }

    if (is_build_dir($root)) {
        return remove_all($root);
    }

    array<string> $kids = readdir($root);
    usize $i = 0;

    while ($i < $kids->count()) {
        if ($kids[$i] != '.git' && !remove_build_dirs(join($root, $kids[$i]))) {
            return false;
        }

        $i = $i + 1;
    }

    return true;
}

/**
 * Whether a directory is one echoc made for its artifacts. Asked of the marker echoc writes into every
 * build directory rather than of the name, because `#[build_dir:]` can call one anything.
 */
private function is_build_dir(const string& $directory) : bool
{
    string $tag = std::io::readfile(join($directory, 'CACHEDIR.TAG'))->or('');

    return $tag->contains('# echoc-build-directory');
}

private function hex_of(const string& $raw) : string
{
    string $digits = '0123456789abcdef';
    string $out = '';
    $out->reserve($raw->size() * 2);

    usize $i = 0;

    while ($i < $raw->size()) {
        uint8 $b = $raw->byte($i);
        int32 $wide = $b;
        usize $hi = ($wide >> 4) & 15;
        usize $lo = $wide & 15;
        $out->append($digits->sub($hi, 1));
        $out->append($digits->sub($lo, 1));
        $i = $i + 1;
    }

    return $out;
}

private function sort_strings(array<string>& $items) : void
{
    usize $n = $items->count();

    if ($n < 2) {
        return;
    }

    usize $i = 1;

    while ($i < $n) {
        string $held = $items[$i];
        usize $j = $i;

        while ($j > 0) {
            if (!before($held, $items[$j - 1])) {
                break;
            }

            $items[$j] = $items[$j - 1];
            $j = $j - 1;
        }

        $items[$j] = $held;
        $i = $i + 1;
    }
}

private function before(const string& $a, const string& $b) : bool
{
    usize $n = $a->size();

    if ($b->size() < $n) {
        $n = $b->size();
    }

    usize $i = 0;

    while ($i < $n) {
        uint8 $ca = $a->byte($i);
        uint8 $cb = $b->byte($i);

        if ($ca < $cb) {
            return true;
        }

        if ($ca > $cb) {
            return false;
        }

        $i = $i + 1;
    }

    return $a->size() < $b->size();
}
