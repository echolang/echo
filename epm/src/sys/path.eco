/**
 * Path joining and splitting, over `std::fs::path`. Callers still pass and
 * receive `string`; the spelling lives in the standard library.
 */

namespace epm::sys;

public function is_absolute(const std::fs::path& $path) : bool
{
    return $path->is_absolute();
}

public function join(const std::fs::path& $a, const std::fs::path& $b) : string
{
    return ($a / $b)->string();
}

public function host_exe(const string& $name) : string
{
#[if: os == windows]
    string $exe = "{$name}.exe";
    return $exe->clone();
#[else]
    return $name;
#[end]
}

public function basename(const std::fs::path& $path) : string
{
    return $path->basename();
}

public function dirname(const std::fs::path& $path) : string
{
    return $path->dirname()->string();
}
