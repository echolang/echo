use command;
use epm::cli;

struct Got
{
    cli::App $app;
    command::Parsed $parsed;
}

function parse_outcome(const array<string>& $words) : command::Outcome
{
    cli::App $app = cli::App();
    array<string> $argv = array<string>();
    $argv[] = 'epm';
    usize $i = 0;

    while ($i < $words->count()) {
        $argv[] = $words[$i];
        $i = $i + 1;
    }

    return $app->cmd->parse($argv);
}

function parse_ok(const array<string>& $words) : Got
{
    cli::App $app = cli::App();
    array<string> $argv = array<string>();
    $argv[] = 'epm';
    usize $i = 0;

    while ($i < $words->count()) {
        $argv[] = $words[$i];
        $i = $i + 1;
    }

    command::Outcome $r = $app->cmd->parse($argv);
    assert($r->error == null);
    return Got($app, $r->parsed);
}

function parse_err(const array<string>& $words) : string
{
    command::Outcome $r = parse_outcome($words);

    if ($r->error != null) {
        command::Error $e = $r->error ?? .noCommand;
        return $e->message();
    }

    return '';
}

function words() : array<string>
{
    return array<string>();
}

function words1(const string& $a) : array<string>
{
    array<string> $w = array<string>();
    $w[] = $a;
    return $w;
}

function words2(const string& $a, const string& $b) : array<string>
{
    array<string> $w = words1($a);
    $w[] = $b;
    return $w;
}

function words3(const string& $a, const string& $b, const string& $c) : array<string>
{
    array<string> $w = words2($a, $b);
    $w[] = $c;
    return $w;
}

function words4(const string& $a, const string& $b, const string& $c, const string& $d) : array<string>
{
    array<string> $w = words3($a, $b, $c);
    $w[] = $d;
    return $w;
}

function blockHas(const command::Block& $b, const string& $needle) : bool
{
    foreach ($b->rows as $row) {
        if ($row->contains($needle)) {
            return true;
        }

        if (command::stripSgr($row)->contains($needle)) {
            return true;
        }
    }

    return false;
}

function stripped(const command::Block& $b) : command::Block
{
    $out = command::Block();

    foreach ($b->rows as $row) {
        $out->push(command::stripSgr($row));
    }

    return $out;
}

test no_command_is_a_refusal
{
    string $err = parse_err(words());
    assert($err == 'No command given.');
}

test unknown_command_names_the_list
{
    string $err = parse_err(words1('compile'));
    assert($err->contains("'compile' is not a command."));
    assert($err->contains("'install'"));
    assert($err->contains("'add'"));
}

test unknown_option
{
    string $err = parse_err(words2('install', '--foo'));
    assert($err == "Unknown option '--foo'.");
}

test install_does_not_take_git
{
    string $err = parse_err(words3('install', '--git', 'https://example.com/x'));
    assert($err == "'install' does not take '--git'.");
}

test help_short_circuits_a_missing_name
{
    Got $got = parse_ok(words2('remove', '--help'));
    assert($got->parsed->wantsHelp);
    assert($got->parsed->command->id == $got->app->remove->id);
}

test version_short_circuits
{
    Got $got = parse_ok(words1('--version'));
    assert($got->parsed->wantsVersion);
}

test help_then_command_is_that_page
{
    Got $got = parse_ok(words2('--help', 'add'));
    assert($got->parsed->wantsHelp);
    assert($got->parsed->command->id == $got->app->add->id);
}

test add_help_git_names_the_option
{
    Got $got = parse_ok(words3('add', '--help', 'git'));
    assert($got->parsed->wantsHelp);
    assert($got->parsed->helpTopicId >= 0);
    assert($got->parsed->helpTopic == 'git');
}

test add_help_unknown_word_is_still_help
{
    Got $got = parse_ok(words3('add', '--help', 'libjson'));
    assert($got->parsed->wantsHelp);
    assert($got->parsed->helpTopicId < 0);
}

test install_help_git_is_refused
{
    string $err = parse_err(words3('install', '--help', 'git'));
    assert($err == "'install' does not take '--git'.");
}

test range_equals_form
{
    Got $got = parse_ok(words4('add', 'lib', '--git', 'https://example.com/lib.git'));
    assert($got->parsed->value($got->app->git) == 'https://example.com/lib.git');
    assert($got->parsed->value($got->app->range) == '*');

    array<string> $w = words3('add', 'lib', '--git');
    $w[] = 'https://example.com/lib.git';
    $w[] = '--range=^0.2';
    $got = parse_ok($w);
    assert($got->parsed->value($got->app->range) == '^0.2');
    assert($got->parsed->positionals[0] == 'lib');
}

test flag_after_the_name
{
    array<string> $w = words2('add', 'lib');
    $w[] = '--git';
    $w[] = 'https://example.com/lib.git';
    Got $got = parse_ok($w);
    assert($got->parsed->value($got->app->git) == 'https://example.com/lib.git');
    assert($got->parsed->positionals[0] == 'lib');
}

test git_and_path_are_one_question
{
    array<string> $w = words3('add', '--git', 'https://example.com/x');
    $w[] = '--path';
    $w[] = '../lib';
    string $err = parse_err($w);
    assert($err->contains('--git'));
    assert($err->contains('--path'));
    assert($err->contains('two answers to one question'));
}

test git_needs_a_value_not_another_flag
{
    string $err = parse_err(words3('add', '--git', '--path'));
    assert($err == "'--git' needs a value, and '--path' is an option.");
}

test install_refuses_a_leftover_word
{
    string $err = parse_err(words2('install', 'libjson'));
    assert($err == "'install' takes no positional arguments.");
}

test separator_is_refused
{
    array<string> $w = words1('install');
    $w[] = '--';
    $w[] = 'x';
    string $err = parse_err($w);
    assert($err == "'install' does not take '--'.");
}

test clustered_short_is_refused
{
    string $err = parse_err(words2('install', '-hv'));
    assert($err->contains('A short option is one character'));
}

test colour_alias
{
    Got $got = parse_ok(words3('install', '--colour', 'never'));
    assert($got->parsed->value($got->app->cmd->color) == 'never');
}

test unknown_color_value
{
    string $err = parse_err(words3('install', '--color', 'purple'));
    assert($err->contains("Unknown '--color' value 'purple'"));
    assert($err->contains('auto, always, never'));
}

test overview_page_lists_commands
{
    Got $got = parse_ok(words1('--help'));
    command::Block $page = command::renderHelp($got->app->cmd, $got->parsed, command::plain());
    assert(blockHas($page, 'Usage'));
    assert(blockHas($page, 'init'));
    assert(blockHas($page, 'install'));
    assert(blockHas($page, 'add'));
    assert(blockHas($page, 'remove'));
    assert(blockHas($page, 'update'));
    assert(blockHas($page, 'verify'));
    assert(blockHas($page, 'tree'));
    assert(blockHas($page, '--help'));
    assert(blockHas($page, '--version'));
}

test add_help_git_is_that_option
{
    Got $got = parse_ok(words3('add', '--help', 'git'));
    command::Block $page = command::renderHelp($got->app->cmd, $got->parsed, command::plain());
    assert(blockHas($page, '--git'));
    assert(blockHas($page, 'GitHub'));
    assert(!blockHas($page, '--path writes'));
}

test refusal_shape
{
    cli::App $app = cli::App();
    command::Error $e = .noCommand;
    command::Parsed $p = command::Parsed();
    command::Block $page = command::renderError($e, $app->cmd, $p, command::plain());
    assert(blockHas($page, 'error: No command given.'));
    assert(blockHas($page, 'Usage'));
    assert(blockHas($page, "Run 'epm --help'"));
}

test init_parses
{
    Got $got = parse_ok(words1('init'));
    assert($got->parsed->command->id == $got->app->init->id);
    assert(!$got->parsed->stated($got->app->yes));
}

test init_yes_sets_the_flag
{
    Got $got = parse_ok(words3('init', 'greet', '--yes'));
    assert($got->parsed->stated($got->app->yes));
    assert($got->parsed->positionals[0] == 'greet');

    $got = parse_ok(words3('init', '-y', 'greet'));
    assert($got->parsed->stated($got->app->yes));
    assert($got->parsed->positionals[0] == 'greet');
}

test init_takes_at_most_one_name
{
    string $err = parse_err(words3('init', 'a', 'b'));
    assert($err == "'init' takes too many positional arguments.");
}

test init_does_not_take_module
{
    string $err = parse_err(words3('init', '-m', 'app'));
    assert($err == "'init' does not take '-m, --module'.");
}

test install_does_not_take_yes
{
    string $err = parse_err(words2('install', '--yes'));
    assert($err == "'install' does not take '-y, --yes'.");
}

test module_before_the_command_is_refused
{
    string $err = parse_err(words3('-m', 'app', 'install'));
    assert($err == "'epm' does not take '-m, --module'.");
}

test init_help_describes_the_wizard
{
    Got $got = parse_ok(words2('init', '--help'));
    command::Block $page = command::renderHelp($got->app->cmd, $got->parsed, command::plain());
    assert(blockHas($page, 'init'));
    assert(blockHas($page, 'wizard'));
    assert(blockHas($page, '--yes'));
    assert(blockHas($page, '[<name>]'));
}

test init_help_yes_is_that_option
{
    Got $got = parse_ok(words3('init', '--help', 'yes'));
    command::Block $page = command::renderHelp($got->app->cmd, $got->parsed, command::plain());
    assert(blockHas($page, '--yes'));
    assert(blockHas($page, 'epm init greet --yes'));
    assert(blockHas($page, 'Accepted by: init.'));
}

test coloured_page_minus_escapes_is_the_plain_page
{
    Got $got = parse_ok(words1('--help'));
    command::Block $plain = command::renderHelp($got->app->cmd, $got->parsed, command::plain());
    command::TerminalCapabilities $color = command::TerminalCapabilities(true, false, 80, true);
    command::Block $drawn = command::renderHelp($got->app->cmd, $got->parsed, $color);
    assert(blockHas($drawn, "\x1b["));
    assert(stripped($drawn) == $plain);
}

test version_text
{
    cli::App $app = cli::App();
    assert(command::renderVersion($app->cmd) == '0.1.0');
}
