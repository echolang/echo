use epm::manifest;
use epm::scratch;
use epm::sys;

test find_module_walks_up
{
    string $root = scratch::dir('find');
    scratch::file($root, 'module.eco', "#[module: \"app\"]\n");
    string $deep = sys::join($root, 'src/nested');
    assert(sys::mkdir_p($deep));
    string $found = guard manifest::find_module($deep);
    assert($found == sys::join($root, 'module.eco'));
    scratch::gone($root);
}

test find_module_at_the_manifest_dir
{
    string $root = scratch::dir('find-here');
    string $mod = scratch::file($root, 'module.eco', "#[module: \"app\"]\n");
    string $found = guard manifest::find_module($root);
    assert($found == $mod);
    scratch::gone($root);
}

test find_module_misses_when_there_is_none
{
    string $root = scratch::dir('find-none');
    assert(manifest::find_module($root) == null);
    scratch::gone($root);
}

test load_reads_epm_itself
{
    manifest::Manifest $m = guard manifest::load('module.eco');
    assert($m->name == 'epm');
    assert($m->version == '0.1.0');
    assert($m->depends->count() >= 2);
    bool $json = false;
    bool $curl = false;
    usize $i = 0;

    while ($i < $m->depends->count()) {
        if ($m->depends[$i]->contains('libjson')) {
            $json = true;
        }

        if ($m->depends[$i]->contains('libcurl')) {
            $curl = true;
        }

        $i = $i + 1;
    }

    assert($json);
    assert($curl);
}

test load_reads_libjson_by_path
{
    manifest::Manifest $m = guard manifest::load('../../echolibs/libjson/module.eco');
    assert($m->name == 'libjson');
}

test load_reads_libcurl_by_path
{
    manifest::Manifest $m = guard manifest::load('../../echolibs/libcurl/module.eco');
    assert($m->name == 'libcurl');
}

test load_reads_requires
{
    string $dir = scratch::dir('load-req');
    scratch::file($dir, 'src/dummy.eco', "echo 1;\n");
    string $mod = scratch::file(
        $dir,
        'module.eco',
        "#[module: \"app\"]\n#[version: \"0.3.1\"]\n#[requires: \"libcurl\" { version: \"^0.1\", source: git \"https://x\" }]\n#[sources: \"src/*.eco\"]\n"
    );
    manifest::Manifest $m = guard manifest::load($mod);
    assert($m->name == 'app');
    assert($m->version == '0.3.1');
    assert($m->requires->count() == 1);
    assert($m->requires[0]->name == 'libcurl');
    assert($m->requires[0]->version == '^0.1');
    assert($m->requires[0]->origin->kind == 'git');
    assert($m->requires[0]->origin->locator == 'https://x');
    scratch::gone($dir);
}

test load_keeps_target_requires_apart
{
    string $dir = scratch::dir('load-scoped');
    scratch::file($dir, 'src/dummy.eco', "echo 1;\n");
    scratch::file($dir, 'tests/dummy.eco', "echo 1;\n");
    string $mod = scratch::file(
        $dir,
        'module.eco',
        "#[module: \"app\"]\n#[version: \"0.1.0\"]\n#[requires: \"lib\" { version: \"^1\", source: git \"https://x\" }]\n#[sources: \"src/*.eco\"]\n#[target: test] {\n    #[sources: \"tests/*.eco\"]\n    #[requires: \"mock\" { version: \"*\", source: git \"https://y\" }]\n}\n"
    );
    manifest::Manifest $m = guard manifest::load($mod);
    assert($m->requires->count() == 1);
    assert($m->requires[0]->name == 'lib');
    assert($m->scoped->count() == 1);
    assert($m->scoped[0]->req->name == 'mock');
    assert($m->scoped[0]->target == 'tests');
    array<manifest::Requirement> $all = manifest::all_requires($m);
    assert($all->count() == 2);
    scratch::gone($dir);
}

test load_of_garbage_fails
{
    string $dir = scratch::dir('load-bad');
    string $mod = scratch::file($dir, 'module.eco', "this is not a manifest\n");
    assert(manifest::load($mod)->failed());
    scratch::gone($dir);
}

test echoc_from_uses_env
{
    string $dir = scratch::dir('echoc-env');
    scratch::file($dir, 'echoc', '');
    assert(manifest::echoc_from($dir, '/other/echoc') == '/other/echoc');
    scratch::gone($dir);
}

test echoc_from_uses_sibling
{
    string $dir = scratch::dir('echoc-sib');
    string $sib = scratch::file($dir, 'echoc', '');
    assert(manifest::echoc_from($dir, '') == $sib);
    scratch::gone($dir);
}

test echoc_from_falls_back_to_path
{
    string $dir = scratch::dir('echoc-path');
    assert(manifest::echoc_from($dir, '') == 'echoc');
    scratch::gone($dir);
}

test echoc_bin_is_not_empty
{
    assert(!manifest::echoc_bin()->empty());
}

test depend_module_resolves_a_directory
{
    string $lib = scratch::dir('dep-mod-lib');
    string $lib_mod = scratch::file($lib, 'module.eco', "#[module: \"lib\"]\n#[sources: \"src/*.eco\"]\n");
    scratch::file($lib, 'src/dummy.eco', "echo 1;\n");
    string $app = scratch::dir('dep-mod-app');
    string $app_mod = scratch::file($app, 'module.eco', "#[module: \"app\"]\n");
    string $got = guard manifest::depend_module($app_mod, $lib);
    assert($got == $lib_mod);
    scratch::gone($lib);
    scratch::gone($app);
}

test depend_module_resolves_the_file
{
    string $lib = scratch::dir('dep-file-lib');
    string $lib_mod = scratch::file($lib, 'module.eco', "#[module: \"lib\"]\n#[sources: \"src/*.eco\"]\n");
    scratch::file($lib, 'src/dummy.eco', "echo 1;\n");
    string $app = scratch::dir('dep-file-app');
    string $app_mod = scratch::file($app, 'module.eco', "#[module: \"app\"]\n");
    string $got = guard manifest::depend_module($app_mod, $lib_mod);
    assert($got == $lib_mod);
    scratch::gone($lib);
    scratch::gone($app);
}

test depend_module_misses
{
    string $app = scratch::dir('dep-miss-app');
    string $app_mod = scratch::file($app, 'module.eco', "#[module: \"app\"]\n");
    assert(manifest::depend_module($app_mod, './nope')->failed());
    scratch::gone($app);
}

test reachable_requires_collects_a_path_dep
{
    string $lib = scratch::dir('reach-lib');
    scratch::file($lib, 'src/dummy.eco', "echo 1;\n");
    scratch::file(
        $lib,
        'module.eco',
        "#[module: \"visu\"]\n#[version: \"0.1.0\"]\n#[requires: \"leaf\" { version: \"^1.0\", source: git \"https://x\" }]\n#[sources: \"src/*.eco\"]\n"
    );
    string $app = scratch::dir('reach-app');
    scratch::file($app, 'src/dummy.eco', "echo 1;\n");
    string $mod = scratch::file(
        $app,
        'module.eco',
        "#[module: \"app\"]\n#[version: \"0.1.0\"]\n#[depends: \"{$lib}\"]\n#[sources: \"src/*.eco\"]\n"
    );
    manifest::Manifest $m = guard manifest::load($mod);
    array<manifest::Requirement> $need = guard manifest::reachable_requires($m);
    assert($need->count() == 1);
    assert($need[0]->name == 'leaf');
    assert($need[0]->version == '^1.0');
    scratch::gone($lib);
    scratch::gone($app);
}

test reachable_requires_is_empty_without_requires
{
    string $lib = scratch::dir('reach-empty-lib');
    scratch::file($lib, 'src/dummy.eco', "echo 1;\n");
    scratch::file(
        $lib,
        'module.eco',
        "#[module: \"empty\"]\n#[version: \"0.1.0\"]\n#[sources: \"src/*.eco\"]\n"
    );
    string $app = scratch::dir('reach-empty-app');
    scratch::file($app, 'src/dummy.eco', "echo 1;\n");
    string $mod = scratch::file(
        $app,
        'module.eco',
        "#[module: \"app\"]\n#[version: \"0.1.0\"]\n#[depends: \"{$lib}\"]\n#[sources: \"src/*.eco\"]\n"
    );
    manifest::Manifest $m = guard manifest::load($mod);
    array<manifest::Requirement> $need = guard manifest::reachable_requires($m);
    assert($need->count() == 0);
    scratch::gone($lib);
    scratch::gone($app);
}

test reachable_requires_survives_a_cycle
{
    string $root = scratch::dir('reach-cycle');
    string $a = sys::join($root, 'a');
    string $b = sys::join($root, 'b');
    assert(sys::mkdir_p($a));
    assert(sys::mkdir_p($b));
    scratch::file($a, 'src/dummy.eco', "echo 1;\n");
    scratch::file($b, 'src/dummy.eco', "echo 1;\n");
    scratch::file(
        $a,
        'module.eco',
        "#[module: \"ca\"]\n#[version: \"0.1.0\"]\n#[depends: \"../b\"]\n#[sources: \"src/*.eco\"]\n"
    );
    scratch::file(
        $b,
        'module.eco',
        "#[module: \"cb\"]\n#[version: \"0.1.0\"]\n#[depends: \"../a\"]\n#[sources: \"src/*.eco\"]\n"
    );
    manifest::Manifest $m = guard manifest::load(sys::join($a, 'module.eco'));
    array<manifest::Requirement> $need = guard manifest::reachable_requires($m);
    assert($need->count() == 0);
    scratch::gone($root);
}

test load_keeps_target_depends_apart
{
    string $lib = scratch::dir('load-tdep-lib');
    scratch::file($lib, 'src/dummy.eco', "echo 1;\n");
    scratch::file($lib, 'module.eco', "#[module: \"tdep\"]\n#[sources: \"src/*.eco\"]\n");
    string $dir = scratch::dir('load-tdep');
    scratch::file($dir, 'src/dummy.eco', "echo 1;\n");
    scratch::file($dir, 'tests/dummy.eco', "echo 1;\n");
    string $mod = scratch::file(
        $dir,
        'module.eco',
        "#[module: \"app\"]\n#[version: \"0.1.0\"]\n#[sources: \"src/*.eco\"]\n#[target: test] {\n    #[sources: \"tests/*.eco\"]\n    #[depends: \"{$lib}\"]\n}\n"
    );
    manifest::Manifest $m = guard manifest::load($mod);
    assert($m->depends->count() == 0);
    assert($m->scoped_depends->count() == 1);
    assert($m->scoped_depends[0]->path == $lib);
    assert($m->scoped_depends[0]->target == 'tests');
    scratch::gone($lib);
    scratch::gone($dir);
}

test reachable_requires_collects_a_target_depend
{
    string $lib = scratch::dir('reach-tdep-lib');
    scratch::file($lib, 'src/dummy.eco', "echo 1;\n");
    scratch::file(
        $lib,
        'module.eco',
        "#[module: \"tdep\"]\n#[version: \"0.1.0\"]\n#[requires: \"leaf\" { version: \"^1.0\", source: git \"https://x\" }]\n#[sources: \"src/*.eco\"]\n"
    );
    string $app = scratch::dir('reach-tdep-app');
    scratch::file($app, 'src/dummy.eco', "echo 1;\n");
    scratch::file($app, 'tests/dummy.eco', "echo 1;\n");
    string $mod = scratch::file(
        $app,
        'module.eco',
        "#[module: \"app\"]\n#[version: \"0.1.0\"]\n#[sources: \"src/*.eco\"]\n#[target: test] {\n    #[sources: \"tests/*.eco\"]\n    #[depends: \"{$lib}\"]\n}\n"
    );
    manifest::Manifest $m = guard manifest::load($mod);
    array<manifest::Requirement> $need = guard manifest::reachable_requires($m);
    assert($need->count() == 1);
    assert($need[0]->name == 'leaf');
    assert($need[0]->version == '^1.0');
    scratch::gone($lib);
    scratch::gone($app);
}
