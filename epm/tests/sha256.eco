use epm::lock;
use epm::scratch;
use epm::sys;

test sha256_of_abc
{
    string $hex = sys::sha256_hex('abc');
    assert($hex == 'ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad');
}

test sha256_of_empty
{
    string $hex = sys::sha256_hex('');
    assert($hex == 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855');
}

test sha256_of_the_quick_brown_fox
{
    string $hex = sys::sha256_hex('The quick brown fox jumps over the lazy dog');
    assert($hex == 'd7a8fbb307d7809469ca9abcb0082e4f8d5651e46d3cdb762d02d0bf37c9e592');
}

test an_empty_tree_hashes_like_empty_input
{
    string $root = scratch::dir('tree-empty');
    string $hex = sys::tree_sha256($root);
    assert($hex == 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855');
    scratch::gone($root);
}

test tree_hash_is_stable
{
    string $root = scratch::dir('tree-stable');
    scratch::file($root, 'b.txt', 'B');
    scratch::file($root, 'a.txt', 'A');
    string $first = sys::tree_sha256($root);
    string $second = sys::tree_sha256($root);
    assert($first == $second);
    assert($first->size() == 64);
    scratch::gone($root);
}

test tree_hash_changes_when_a_file_does
{
    string $root = scratch::dir('tree-change');
    scratch::file($root, 'a.txt', 'A');
    string $before = sys::tree_sha256($root);
    scratch::write(sys::join($root, 'a.txt'), 'B');
    string $after = sys::tree_sha256($root);
    assert($before != $after);
    scratch::gone($root);
}

test tree_hash_ignores_dot_git
{
    string $root = scratch::dir('tree-git');
    scratch::file($root, 'a.txt', 'A');
    string $before = sys::tree_sha256($root);
    scratch::file($root, '.git/HEAD', 'ref: refs/heads/main');
    string $after = sys::tree_sha256($root);
    assert($before == $after);
    scratch::gone($root);
}

test tree_hash_ignores_an_echoc_build_directory
{
    string $root = scratch::dir('tree-ecobuild');
    scratch::file($root, 'module.eco', '#[module: "x"]');
    string $before = sys::tree_sha256($root);
    scratch::file($root, 'ecobuild/CACHEDIR.TAG', "Signature: 8a477f597d28d172789f06886806bc55\n# echoc-build-directory\n");
    scratch::file($root, 'ecobuild/x-0123.o', 'object bytes');
    string $after = sys::tree_sha256($root);
    assert($before == $after);
    scratch::gone($root);
}

test tree_hash_keeps_a_directory_that_is_only_named_like_one
{
    string $root = scratch::dir('tree-not-ecobuild');
    scratch::file($root, 'module.eco', '#[module: "x"]');
    string $before = sys::tree_sha256($root);
    scratch::file($root, 'ecobuild/notes.txt', 'source, not output');
    string $after = sys::tree_sha256($root);
    assert($before != $after);
    scratch::gone($root);
}

test tree_hash_includes_the_relative_path
{
    string $left = scratch::dir('tree-path-l');
    string $right = scratch::dir('tree-path-r');
    scratch::file($left, 'a.txt', 'same');
    scratch::file($right, 'b.txt', 'same');
    assert(sys::tree_sha256($left) != sys::tree_sha256($right));
    scratch::gone($left);
    scratch::gone($right);
}

test tree_hash_v1_differs_from_v2_on_a_file
{
    string $root = scratch::dir('tree-v1-v2');
    scratch::file($root, 'a.txt', 'A');
    string $v1 = sys::tree_sha256_v1($root);
    string $v2 = sys::tree_sha256($root);
    assert($v1->size() == 64);
    assert($v2->size() == 64);
    assert($v1 != $v2);
    scratch::gone($root);
}

test tree_hash_v1_is_path_newline_body
{
    string $root = scratch::dir('tree-v1-pin');
    scratch::file($root, 'a.txt', 'A');
    assert(sys::tree_sha256_v1($root) == sys::sha256_hex("a.txt\nA"));
    scratch::gone($root);
}

test tree_hash_v1_concatenates_sorted_entries
{
    string $root = scratch::dir('tree-v1-two');
    scratch::file($root, 'b.txt', 'B');
    scratch::file($root, 'a.txt', 'A');
    assert(sys::tree_sha256_v1($root) == sys::sha256_hex("a.txt\nAb.txt\nB"));
    scratch::gone($root);
}

test tree_hash_v1_is_stable
{
    string $root = scratch::dir('tree-v1-stable');
    scratch::file($root, 'b.txt', 'B');
    scratch::file($root, 'a.txt', 'A');
    string $first = sys::tree_sha256_v1($root);
    string $second = sys::tree_sha256_v1($root);
    assert($first == $second);
    scratch::gone($root);
}

test tree_hash_v1_changes_when_a_file_does
{
    string $root = scratch::dir('tree-v1-change');
    scratch::file($root, 'a.txt', 'A');
    string $before = sys::tree_sha256_v1($root);
    scratch::write(sys::join($root, 'a.txt'), 'B');
    string $after = sys::tree_sha256_v1($root);
    assert($before != $after);
    scratch::gone($root);
}

test an_empty_tree_hashes_the_same_in_v1_and_v2
{
    string $root = scratch::dir('tree-v1-empty');
    assert(sys::tree_sha256_v1($root) == sys::tree_sha256($root));
    scratch::gone($root);
}

test tree_contains_link_is_false_for_plain_files
{
    string $root = scratch::dir('tree-no-link');
    scratch::file($root, 'a.txt', 'A');
    assert(!sys::tree_contains_link($root));
    assert(!sys::tree_has_v1_uncheckable_link($root));
    scratch::gone($root);
}

#[if: os != windows]
test a_directory_symlink_is_a_link_in_the_tree
{
    string $root = scratch::dir('tree-dir-link');
    string $outside = sys::join($root, 'outside');
    string $tree = sys::join($root, 'tree');
    assert(sys::mkdir_p($outside));
    assert(sys::mkdir_p($tree));
    scratch::file($outside, 'keep.txt', 'B');
    scratch::file($tree, 'a.txt', 'A');

    array<string> $ln = array<string>();
    $ln[] = 'ln';
    $ln[] = '-s';
    $ln[] = $outside;
    $ln[] = sys::join($tree, 'link');
    assert(sys::run($ln)->ok());

    assert(sys::tree_contains_link($tree));
    assert(sys::tree_has_v1_uncheckable_link($tree));
    assert(!lock::tree_is_checkable($tree, 1));
    // old walk followed the link and hashed link/keep.txt; this walk records `link` with an empty body
    assert(sys::tree_sha256_v1($tree) != sys::sha256_hex("a.txt\nAlink/keep.txt\nB"));
    scratch::gone($root);
}

test a_dangling_symlink_is_a_link_in_the_tree
{
    string $root = scratch::dir('tree-dangling');
    array<string> $ln = array<string>();
    $ln[] = 'ln';
    $ln[] = '-s';
    $ln[] = 'missing';
    $ln[] = sys::join($root, 'gone');
    assert(sys::run($ln)->ok());

    assert(sys::tree_contains_link($root));
    assert(sys::tree_has_v1_uncheckable_link($root));
    assert(!lock::tree_is_checkable($root, 1));
    // old walk skipped a dangling link; this walk records it with an empty body
    assert(sys::tree_sha256_v1($root) != sys::sha256_hex(''));
    scratch::gone($root);
}

test a_file_symlink_hashes_the_same_as_the_old_walk
{
    string $root = scratch::dir('tree-file-link');
    scratch::file($root, 'a.txt', 'A');

    array<string> $ln = array<string>();
    $ln[] = 'ln';
    $ln[] = '-s';
    $ln[] = 'a.txt';
    $ln[] = sys::join($root, 'LICENSE');
    assert(sys::run($ln)->ok());

    assert(sys::tree_contains_link($root));
    assert(!sys::tree_has_v1_uncheckable_link($root));
    assert(lock::tree_is_checkable($root, 1));
    assert(sys::tree_sha256_v1($root) == sys::sha256_hex("LICENSE\nAa.txt\nA"));
    scratch::gone($root);
}
#[end]
