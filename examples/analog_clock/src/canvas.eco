/*
 * The character grid the clock is drawn into, and the one interesting decision in this example.
 *
 * The dial is drawn with Unicode glyphs, which are two and three bytes each in UTF-8 - so a cell
 * cannot be a byte of output. **A cell holds a glyph id, and ids become bytes only when the frame is
 * serialised.** One rule keeps that from turning into a table nobody can read:
 *
 *     an id below 32 is one of this example's own glyphs; an id of 32 or above is that ASCII byte.
 *
 * So `48 + $digit` is still a digit and `32` is still a space, and the readout below can stay plain
 * arithmetic.
 *
 * The grid is `array<array<uint8>>` - one array per row. Nothing in here computes `$y * $width + $x`,
 * which is what lets every walk over it be a `foreach` over a thing rather than over a number.
 */

namespace clock;

// the glyphs. **constants, not functions and not variables**: a constant has no storage anywhere and is
// copied into each use site, which is exactly what a name for `1` should be. a file-scope *variable*
// would be a different thing entirely - a top-level statement in a module that is not the entry module
// never runs, so it would be read before it was ever written
const uint8 GLYPH_EMPTY = 0;
const uint8 GLYPH_RING = 1;
const uint8 GLYPH_HOUR_MARK = 2;
const uint8 GLYPH_QUARTER_MARK = 3;
const uint8 GLYPH_HOUR_HAND = 4;
const uint8 GLYPH_MINUTE_HAND = 5;
const uint8 GLYPH_SECOND_HAND = 6;
const uint8 GLYPH_PIN = 7;

function append_glyph(string& $out, uint8 $id) : void
{
    if ($id == GLYPH_EMPTY) { $out->append(' '); return; }
    if ($id == GLYPH_RING) { $out->append('·'); return; }
    if ($id == GLYPH_HOUR_MARK) { $out->append('●'); return; }
    if ($id == GLYPH_QUARTER_MARK) { $out->append('◆'); return; }
    if ($id == GLYPH_HOUR_HAND) { $out->append('█'); return; }
    if ($id == GLYPH_MINUTE_HAND) { $out->append('▒'); return; }
    if ($id == GLYPH_SECOND_HAND) { $out->append('•'); return; }
    if ($id == GLYPH_PIN) { $out->append('┼'); return; }

    // anything else is its own ASCII byte
    $out->push($id);
}

// **Borrowed everywhere, never copied.** A `Canvas` owns its rows, and a struct is copied field by
// field - so handing one around by value would duplicate every buffer pointer in it and free them
// twice. It is built once, as a local, and every function that draws takes a `Canvas&`.
struct Canvas
{
    // nothing outside these braces reads any of this: a caller asks for a frame, or plots a point and
    // lets `set` clip it
    private usize $width;
    private usize $height;
    private array<array<uint8>> $rows;

    constructor(usize $width, usize $height)
    {
        $this->width = $width;
        $this->height = $height;

        // there is no fill constructor and no fixed-size array, so each row is pushed cell by cell into
        // a buffer sized up front. `arr::room` is that in one call
        $this->rows = arr::room<array<uint8>>($height);

        foreach (0 .. $height as $y) {
            array<uint8> $row = arr::room<uint8>($width);

            foreach (0 .. $width as $x) {
                $row[] = GLYPH_EMPTY;
            }

            // **`mv`, because a row owns an allocation.** a plain `push($row)` copies it - a second
            // buffer, filled from the first, and the first freed at the end of the turn
            $this->rows->push(mv $row);
        }
    }

    // no index anywhere: the rows are borrowed to be written through, and so are their cells
    function fill(uint8 $id) : void
    {
        foreach ($this->rows as &$row) {
            foreach ($row as &$cell) {
                $cell = $id;
            }
        }
    }

    // out of range is a no-op rather than an error - a hand at the edge of the dial rounds outside it,
    // and clipping here keeps every caller free of bounds checks.
    //
    // the coordinates are `int32` rather than `usize` precisely so they *can* be negative: `plot` rounds
    // a `float64` that lands off the dial in either direction, and a `usize` would have wrapped it to an
    // enormous positive one that the two upper bounds then let through.
    //
    // the tests are one per `if` because `&&` does not short-circuit yet.
    function set(int32 $x, int32 $y, uint8 $id) : void
    {
        if ($x < 0) { return; }
        if ($y < 0) { return; }
        if ($x >= $this->width) { return; }
        if ($y >= $this->height) { return; }

        $this->rows[$y][$x] = $id;
    }

    // the geometry is all in floats, so this is where it lands on a cell. assigning a `float64` to an
    // `int32` truncates towards zero, hence the `round` - the only float to int cast the language has
    // is the implicit one at a typed destination
    function plot(float64 $x, float64 $y, uint8 $id) : void
    {
        int32 $cx = std::math::round($x);
        int32 $cy = std::math::round($y);

        $this->set($cx, $cy, $id);
    }

    // the one walk here that still counts, and it counts because the index means two things: which byte
    // of the text, and which column it lands in
    function write_text(int32 $x, int32 $y, string& $text) : void
    {
        foreach (0 .. $text->size() as $i) {
            $this->set($x + $i, $y, $text->byte($i));
        }
    }

    // the whole picture as one string. `print` takes one `string`, so a frame has to arrive in a
    // single statement - printing cell by cell would flicker and cost a write syscall per glyph.
    //
    // the row terminator is `std::io::NEWLINE`, not a hardcoded LF: a Windows console treats a lone
    // `\n` as "down one row, same column". homing the cursor stays in `main.eco` so a frame is still
    // a picture anybody can compare
    function to_frame() : string
    {
        string $out = '';
        $out->reserve($this->width * $this->height * 3 + $this->height * std::io::NEWLINE->size());

        // `const &$row` borrows the row without copying it and says out loud that nothing here writes
        // one. a plain `$row` would be a copy of an owning array, per row, per frame
        foreach ($this->rows as const &$row) {
            foreach ($row as $cell) {
                append_glyph(&$out, $cell);
            }

            $out->append(std::io::NEWLINE);
        }

        return $out;
    }
}
