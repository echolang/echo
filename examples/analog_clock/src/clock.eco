/*
 * Where the time comes from, and where the program waits.
 *
 * The stdlib has neither, so both are libc through `extern`. That is the intended shape: a binding is
 * a declaration, not a wrapper the compiler has to know about.
 */

namespace clock;

// C's `struct tm`, as far as we read it. The nine leading fields are `int` on every platform we
// build for, so the offsets line up; libc's own `tm_gmtoff` and `tm_zone` follow the ones declared
// here and are simply not spelled out.
//
// **This is only ever read.** `localtime` hands back a pointer into libc's own static storage, so
// nothing of ours writes through it and the fields left undeclared cannot be overrun. A binding that
// asked libc to *fill* a `tm` of ours would have to declare all of them.
struct tm
{
    int32 $sec;
    int32 $min;
    int32 $hour;
    int32 $mday;
    int32 $mon;
    int32 $year;
    int32 $wday;
    int32 $yday;
    int32 $isdst;
}

extern {
    function time as c_time(ptr<int64> $out) : int64;
    function localtime as c_localtime(ptr<int64> $t) : ptr<tm>;
    function usleep as c_usleep(uint32 $usec) : int32;
}

// the time of day, and nothing else - the rest of the program never sees a `tm`
struct Time
{
    int32 $hour;
    int32 $minute;
    int32 $second;
}

function now() : Time
{
    int64 $epoch = 0;
    c_time(&$epoch);

    // `->` reaches through the pointer directly; a plain read of `$raw` would deref it and copy the
    // whole struct out of libc's storage
    ptr<tm> $raw = c_localtime(&$epoch);

    return Time($raw->hour, $raw->min, $raw->sec);
}

function sleep_ms(uint32 $ms) : void
{
    c_usleep($ms * 1000);
}

// -- reading a time off the command line ---------------------------------------------------------
//
// `HH:MM:SS` draws that one frame and exits: the live clock is a different picture every second, and a
// fixed time is the one way to look at the drawing twice and compare. Anything else runs the clock.
//
// The parse is `two_digits` in reverse - `48` is `'0'`, so a digit is its byte minus 48 - and it is
// the same shape for the same reason: the standard library has no int-to-string and no string-to-int.
// Nothing here validates beyond the shape, because a malformed argument draws a wrong clock and that
// is the whole of the damage.
function time_from_args(Time& $out) : bool
{
    if (std::env::argc() < 2) {
        return false;
    }

    // a view, not a `string`: it borrows the bytes libc already holds, so reading an argument costs
    // no allocation at all. `$size` is a property rather than a method - a view is two public words
    string::view $spec = std::env::arg(1);

    if ($spec->size != 8) {
        return false;
    }

    $out->hour = two_digits_at($spec, 0);
    $out->minute = two_digits_at($spec, 3);
    $out->second = two_digits_at($spec, 6);

    return true;
}

#[inline]
function two_digits_at(string::view $s, usize $at) : int32
{
    int32 $tens = $s->byte($at) - 48;
    int32 $ones = $s->byte($at + 1) - 48;

    return $tens * 10 + $ones;
}

// -- where each hand points, in fractions of a full turn clockwise from 12 -----------------------
//
// each one folds the smaller unit in, which is what makes the hands creep rather than jump: the hour
// hand is already a third of the way to the next hour at twenty past.
#[inline]
function hour_turns(Time& $t) : float64
{
    float64 $hours = $t->hour % 12;
    float64 $minutes = $t->minute;

    return $hours / 12.0 + $minutes / 720.0;
}
#[inline]
function minute_turns(Time& $t) : float64
{
    float64 $minutes = $t->minute;
    float64 $seconds = $t->second;

    return $minutes / 60.0 + $seconds / 3600.0;
}
#[inline]
function second_turns(Time& $t) : float64
{
    float64 $seconds = $t->second;

    return $seconds / 60.0;
}
