/*
 * The program.
 *
 * An Echo program is the top-level statements of the entry module's files, in filename order - there is
 * no `main` to declare. Every other file here holds only declarations, so this one is the program and
 * the order does not matter.
 *
 * Two ways to run: with an `HH:MM:SS` argument it draws that one frame and exits, and with none it
 * animates until Ctrl-C. The first is how the picture in the README was made, and the quickest way to
 * see what a change to the drawing did; the second is the clock.
 *
 * Pictures go through `std::io::print` rather than `echo`. `echo` of a string is a raw `_write`,
 * which a Windows console decodes as OEM; `print` is `stdout->write`, and that is the path the
 * standard library makes Unicode on every host. Ctrl-C cannot be trapped, so nothing about the
 * terminal is switched on here that would have to be switched back off - no alternate screen, no
 * hidden cursor. The screen is cleared once, and every frame after that only homes the cursor and
 * overwrites what is there.
 */

// a dial eleven rows in radius, in cells twice as tall as they are wide
clock::Dial $dial = clock::Dial(11.0, 2.0);

clock::Renderer $renderer = clock::Renderer($dial);

// **the order they are added is the order they are drawn**, which is the whole of the compositing rule -
// it used to be the order of four calls in the middle of a function, and it is a list now. each one is a
// class widened to `Renderable` on the way in; the `Dial` each holds is a copy, because a `Dial` owns
// nothing
$renderer->add(clock::Face($dial));
$renderer->add(clock::Hands($dial));
$renderer->add(clock::Readout($dial));

clock::Time $fixed = clock::Time(0, 0, 0);

if (clock::time_from_args(&$fixed)) {
    // no screen clear and no cursor-home dance: one picture, printed where the cursor already is
    std::io::print($renderer->frame(&$fixed));
}
else {
    std::io::print("\x1b[2J");

    while (true) {
        clock::Time $now = clock::now();

        // the cursor-home escape lives here rather than in the renderer: it is what makes two pictures an
        // animation, and a `frame` that emitted it could not hand back one anybody could compare
        string $frame = "\x1b[H";
        $frame->append($renderer->frame(&$now));
        std::io::print($frame);

        // five redraws a second: the second hand lands on its tick promptly without the process spinning
        clock::sleep_ms(200);
    }
}
