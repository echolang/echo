/*
 * A raymarched Mandelbulb the browser can call.
 *
 * `#[target: lib]` is a program with no entry: on wasi it is a reactor. The page
 * fetches the .wasm, calls `_initialize`, then `configure` and `render_rows`.
 * There is no `_start`.
 */

#[module: "mandelbulb_web"]
#[sources: "src/*.eco"]
#[target: lib { name: "mandelbulb" }]
