/*
 * An orbit camera: it sits on a sphere around the origin and looks at it.
 *
 * Yaw turns around the vertical axis, pitch tilts up and down, distance is the
 * sphere's radius. Width follows the canvas aspect, so a square pixel on screen
 * is a square step on the image plane.
 */

use std::math;

struct Camera
{
    Vec3 $eye;
    Vec3 $forward;
    Vec3 $right;
    Vec3 $up;
    float64 $tan_half_fov;
}

function orbit_camera(float64 $yaw_deg, float64 $pitch_deg, float64 $distance) : Camera
{
    float64 $radians = 0.017453292519943295;
    float64 $yaw = $yaw_deg * $radians;
    float64 $pitch = $pitch_deg * $radians;

    Vec3 $eye = Vec3(
        math::cos($pitch) * math::sin($yaw) * $distance,
        math::sin($pitch) * $distance,
        math::cos($pitch) * math::cos($yaw) * $distance
    );
    Vec3 $forward = normalize($eye * -1.0);
    Vec3 $right = normalize(cross($forward, Vec3(0.0, 1.0, 0.0)));
    Vec3 $up = cross($right, $forward);

    return Camera($eye, $forward, $right, $up, 0.5);
}

function ray_direction(const Camera& $c, int32 $x, int32 $y, int32 $width, int32 $height) : Vec3
{
    float64 $w = $width as float64;
    float64 $h = $height as float64;
    float64 $u = ((($x as float64) + 0.5) / $w * 2.0 - 1.0) * ($w / $h) * $c->tan_half_fov;
    float64 $v = (1.0 - (($y as float64) + 0.5) / $h * 2.0) * $c->tan_half_fov;

    return normalize($c->forward + $c->right * $u + $c->up * $v);
}
