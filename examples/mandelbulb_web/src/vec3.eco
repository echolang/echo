/*
 * A 3D vector, by value. The operators are ordinary functions with a funny name,
 * so `$eye + $dir * $t` is two calls the optimizer inlines away.
 */

use std::math;

struct Vec3
{
    float64 $x;
    float64 $y;
    float64 $z;
}

operator (Vec3 $a) + (Vec3 $b) : Vec3
{
    return Vec3($a->x + $b->x, $a->y + $b->y, $a->z + $b->z);
}

operator (Vec3 $a) - (Vec3 $b) : Vec3
{
    return Vec3($a->x - $b->x, $a->y - $b->y, $a->z - $b->z);
}

operator (Vec3 $a) * (float64 $s) : Vec3
{
    return Vec3($a->x * $s, $a->y * $s, $a->z * $s);
}

function dot(Vec3 $a, Vec3 $b) : float64
{
    return $a->x * $b->x + $a->y * $b->y + $a->z * $b->z;
}

function cross(Vec3 $a, Vec3 $b) : Vec3
{
    return Vec3(
        $a->y * $b->z - $a->z * $b->y,
        $a->z * $b->x - $a->x * $b->z,
        $a->x * $b->y - $a->y * $b->x
    );
}

function length(Vec3 $v) : float64
{
    return math::sqrt(dot($v, $v));
}

function normalize(Vec3 $v) : Vec3
{
    float64 $inv = 1.0 / length($v);
    return $v * $inv;
}
