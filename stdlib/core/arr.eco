/**
 * Array utilities.
 *
 * `array<T>` itself is at the root - a sequence is vocabulary you write every line, and so is `$a[$i]`.
 * What lives here is what is built *on* it: things that could be methods but should not be, because they
 * answer a question about arrays rather than about one array.
 *
 * A function goes here rather than on the type when it does not need the type's internals. `merge` below
 * touches no property of either argument, only `count()` and `push()`, so putting it in the struct would
 * grow the surface every reader of `array<T>` has to walk past for no gain in what it can do.
 */

namespace arr;

/**
 * A new array holding `$a`'s elements followed by `$b`'s.
 *
 * Both inputs are `const` borrows, so nothing here consumes or changes them. Elements are **copied** into
 * the result by the ordinary rules - which means a `T` whose copy needs a constructor needs one here too,
 * and that refusal comes from `array<T>::push` exactly as it would at any other call site. There is no
 * rule about copying written into this function.
 *
 * The result is reserved once, up front, so a merge is one allocation rather than a run of doublings.
 *
 * **Indexed rather than `foreach`ed**, and not for style: `iterate()` hands out a cursor over `T&`, so it
 * is not `const` and a `const array<T>&` cannot be iterated at all. Reading through the `const get()` is
 * the only spelling available here, and it is the correct one - copying an element is exactly what this
 * does. A const cursor yielding `const T&` would let the loop read as a loop, and there is not one yet.
 */
function merge<T>(const array<T>& $a, const array<T>& $b) : array<T>
{
    array<T> $out = array<T>();
    $out->reserve($a->count() + $b->count());

    usize $i = 0;

    while ($i < $a->count()) {
        $out->push($a->get($i));
        $i = $i + 1;
    }

    $i = 0;

    while ($i < $b->count()) {
        $out->push($b->get($i));
        $i = $i + 1;
    }

    return $out;
}
