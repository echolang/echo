/**
 * Array utilities.
 *
 * `array<T>` itself is at the root - a sequence is vocabulary you write every line, and so is `$a[$i]`.
 * What lives here is what is built *on* it: things that could be methods but should not be, because they
 * answer a question about arrays rather than about one array.
 *
 * A function goes here rather than on the type when it does not need the type's internals. None of
 * the functions below touches a property of its arguments - `merge` is two `extend` calls, `room` is
 * a constructor and a `reserve`, `extend_from` is `grow_by`, `spare` and `commit` - so putting them in
 * the struct would grow the surface every reader of `array<T>` has to walk past for no gain in what
 * they can do.
 */

namespace arr;

/**
 * A new array holding `$a`'s elements followed by `$b`'s.
 *
 * Both inputs are `const` borrows, so nothing here consumes or changes them. Elements are **copied** into
 * the result by the ordinary rules - which means a `T` whose copy needs a constructor needs one here too,
 * and that refusal comes from `array<T>::extend` exactly as it would at any other call site. There is no
 * rule about copying written into this function.
 *
 * One allocation, reserved up front, and then two `extend` calls - which for an element type that copies
 * as bytes is two `memcpy`s and no loop at all. This used to push element by element through `get()`,
 * paying a copy, a call and a redundant capacity re-check per element; `extend` is where that decision
 * lives now, so a merge and a hand-written append are the same code.
 */
public function merge<T>(const array<T>& $a, const array<T>& $b) : array<T>
{
    // the room is asked for ahead of both appends rather than letting each reserve its own half:
    // `extend` reserves for what it is about to add, so two of them would double once in between
    array<T> $out = room<T>($a->count() + $b->count());

    $out->extend($a);
    $out->extend($b);

    return $out;
}

/**
 * A new empty array with room for `$count` elements already.
 *
 * `array<T>()` followed by `->reserve($count)` says the same thing; this is the spelling for when the
 * size is known at the point the array is created, which is most of the time.
 *
 * A **function** rather than a `constructor(usize)`, and deliberately: `array<int32>(5)` would read as
 * five elements to anyone who has met `vec![0; 5]`, and there is no way to name a constructor. Room for
 * five and a length of five are different things, so the one that is ambiguous is not spelled.
 *
 * `count()` is `0` afterwards. Use `fit` through this if the slack matters.
 */
public function room<T>(usize $count) : array<T>
{
    array<T> $out = array<T>();
    $out->reserve($count);

    return $out;
}

/**
 * Appends `$count` elements read from `$src`, exactly as `$count` appends would, `capacity()` included.
 *
 * The long integer-literal path. `$src` must hold `$count` elements and must not point into `$into`.
 */
public function extend_from<T>(array<T>& $into, ptr<const T> $src, usize $count) : void
{
    if ($count == 0) {
        return;
    }

    $into->grow_by($count);

    const if (mem::is_trivially_copyable<T>()) {
        mem::copy<T>($into->spare(), ptr<T>($src:$), $count);
        $into->commit($count);
    }
    else {
        usize $i = 0;

        while ($i < $count) {
            // you promised `$src` holds `$count` elements
            unsafe {
                $into[] = $src:$[$i];
            }

            $i = $i + 1;
        }
    }
}

/**
 * How many elements the first allocation of a growable sequence should hold.
 *
 * Doubling from zero is zero, so a floor is what stops the first three appends each being
 * their own allocation. Byte-sized `T` gets 8; a `T` bigger than a page gets 1, because the
 * allocation is already the cost. The caller leaves a request above the floor alone.
 *
 * Plain `if`s: `mem::size<T>()` folds in codegen, and `const if` cannot answer a layout
 * query before that.
 *
 * **`#[inline]`**, so `array::reserve` stays a compare and a resize: a call here is a call
 * on every growth.
 */
#[inline]
internal function growth_floor<T>() : usize
{
    usize $floor = 4;

    if (mem::size<T>() == 1) {
        $floor = 8;
    }

    if (mem::size<T>() > 1024) {
        $floor = 1;
    }

    return $floor;
}
