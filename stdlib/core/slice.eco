/**
 * A borrowed window over elements somebody else owns.
 *
 * Two words - an address and an element count - owning nothing, copying for free, keeping nothing
 * alive. It is to `array<T>` what `string::view` is to `string`, and for the same reason: a
 * function that only *reads* elements should not have to care who owns them.
 *
 * Because it owns nothing, a shallow copy is the **correct** copy. It declares no destructor and no
 * copy constructor, so passing one around duplicates two words and aliases the same elements, which
 * is the whole point.
 *
 * The lifetime rule is the pointer chapter's, unchanged: **a slice must not outlive the array it
 * came from**, and growing that array ends the slice just as decisively as destroying it. Nothing
 * enforces this - there is no borrow checker - so it is a rule you keep rather than one you are
 * held to. See docs/collections/arrays.md.
 *
 * Counts and indices are `usize` throughout, matching `mem::`.
 */
public struct slice<T> : contract::iterable<T>, contract::const_iterable<const T>
{
    ptr<T> $data;
    usize $len;

    /**
     * How many elements the window covers.
     */
    const function count() : usize
    {
        return $this->len;
    }

    /**
     * True when the window covers no elements.
     *
     * A branch and two `return`s rather than `return $this->len == 0;` - `string.eco` explains why.
     */
    const function empty() : bool
    {
        if ($this->len > 0) {
            return false;
        }

        return true;
    }

    /**
     * A copy of the element at `$index`.
     *
     * Checked with `assert`, so `echoc build` drops the check - the bargain C's `assert` makes.
     * `$s[$index]` is the same element without the copy.
     */
    const function get(usize $index) : T
    {
        return $this[$index];
    }

    /**
     * A borrow of the element at `$index`, so writing through it writes into the storage.
     *
     * The method form of `$s[$index]`, which is the spelling to prefer - a place needs no name to
     * be bound to before it is useful.
     *
     * Written *through* the element operator, so the bounds rule and its message have one
     * implementation and `$s->at($i)` cannot drift from `$s[$i]`.
     */
    function at(usize $index) : T&
    {
        return &$this[$index];
    }

    /**
     * The same borrow, read-only, for when the window itself is `const`.
     *
     * One overload set told apart by the receiver, exactly as `array<T>::at` is: a mutable window
     * matches the borrow above exactly, a `const` one reaches only this.
     */
    const function at(usize $index) : const T&
    {
        return &$this[$index];
    }

    /**
     * A cursor over this window. `Iter` is inferred to be `slice_iterator<T>` from this return type -
     * a conformance never spells its associated types, it only constrains them.
     */
    function iterate() : slice_iterator<T>
    {
        return slice_iterator<T>($this);
    }

    /**
     * A cursor over the same window, handing out elements it may only read.
     *
     * The read-only half of the protocol, and it needs no cursor of its own: `slice_iterator<const T>`
     * holds a `slice<const T>` and its `current()` returns `const T&`, both by substitution. What
     * `const T` buys over the `const slice<T>` a caller already had is that it is *carried* - the
     * window's own type says the elements are read-only, so it stays true through every function it
     * is handed to, where a const receiver only says it about one call.
     *
     * A `const slice<T>` therefore yields `const` elements rather than being a const *window* over
     * mutable ones. That is a deliberate exception to the per-level rule, matching the read-only
     * element operator below. See docs/memory/pointers.md.
     */
    const function iterate() : slice_iterator<const T>
    {
        return slice_iterator<const T>($this->sub(0, $this->len));
    }

    /**
     * A sub-window, `$count` elements from `$from`.
     *
     * Named `sub` to match `string::view::sub`, which already means exactly this - and because
     * `$s->slice(...)` on a type *called* `slice` reads like a constructor rather than a narrowing.
     *
     * **Two separate checks rather than one on the sum**, so the sum cannot wrap on the way to
     * being checked. `string::view::sub` is written the same way and for the same reason.
     */
    function sub(usize $from, usize $count) : slice<T>
    {
        assert($from <= $this->len, "slice start out of range");
        assert($count <= $this->len - $from, "slice length out of range");

        return slice<T>($this->data:$ + $from, $count);
    }

    /**
     * The same sub-window, read-only, for when the window itself is `const` - `at`'s pairing exactly.
     */
    const function sub(usize $from, usize $count) : slice<const T>
    {
        assert($from <= $this->len, "slice start out of range");
        assert($count <= $this->len - $from, "slice length out of range");

        return slice<const T>($this->data:$ + $from, $count);
    }
}

/**
 * The element contract. `$s[$i]` reads, writes, takes `&` and chains with `->`, all through the
 * borrow this hands back. See docs/collections/slices.md.
 *
 * There is deliberately **no** one-operand `operator (slice<T>& $s)[]`: a slice does not own its
 * storage, so it has nothing to grow. `$s[] = $v` is then an ordinary "no overload accepts these
 * arguments", with no rule anywhere saying which types may append.
 */
operator<T> (slice<T>& $s)[usize $index] : T&
{
    assert($index < $s->len, "slice index out of range");

    // the promotion, discharged by the bound check above it: the window's own contract is that
    // `$data` addresses `$len` live `T`s, and the assert is what turns that into this index
    unsafe {
        return &$s->data:$[$index];
    }
}

/**
 * The same contract over a `const` window, handing back a borrow that only reads.
 *
 * Mirrors `array<T>`'s const element operator rather than reasoning separately about what `const`
 * means for a type that borrows its storage: the two are used interchangeably at call sites, so a
 * `const` one of either yields `const T&`.
 */
operator<T> (const slice<T>& $s)[usize $index] : const T&
{
    assert($index < $s->len, "slice index out of range");

    unsafe {
        return &$s->data:$[$index];
    }
}

/**
 * The cursor `array<T>` and `slice<T>` both iterate through.
 *
 * Owning nothing, so - like `slice<T>` itself - it declares no destructor and no copy constructor: a
 * shallow copy is the correct copy.
 *
 * It lives here rather than beside the contracts it conforms to because it is a concrete type at the
 * root, and `contract` holds interfaces only. A cursor over a window belongs with the window.
 *
 * **It holds the window by value, and that is load-bearing rather than incidental.** The length is
 * then an ordinary local the optimiser can prove loop-invariant, which gives the loop a computable
 * trip count and with it unrolling and vectorisation. A cursor holding an `array<T>&` and asking it
 * `->count()` each turn would force a reload through a pointer nothing can prove unaliased, and the
 * loop would be measurably worse for no gain. See docs/collections/iteration.md.
 *
 * The usual borrow rule applies, unchanged: growing the array ends this window, exactly as it ends
 * every other borrow into it.
 */
public struct slice_iterator<T> : contract::iterator<T>, contract::keyed<usize>
{
    // both fields `private`, which the window above could not be: `slice<T>`'s own two are read by the
    // element operators, and an operator is a free declaration rather than a member of either operand.
    // a cursor has none, so its state is reachable from the four bodies below and nowhere else
    private slice<T> $window;

    // the index one *past* the element `current()` names, so the cursor starts before the first one
    // without needing a signed type or a "have we started" flag
    private usize $pos;

    constructor(slice<T> $window)
    {
        $this->window = $window;
        $this->pos = 0;
    }

    function advance() : bool
    {
        if ($this->pos >= $this->window->count()) {
            return false;
        }

        $this->pos = $this->pos + 1;
        return true;
    }

    /**
     * Indexed **unchecked**, on purpose: `advance()` already established that this element is there,
     * and that is the entire content of "valid after a true advance". Routing this through `->at()`
     * would re-test the bound every step in a debug build, checking something the protocol guarantees.
     */
    function current() : T&
    {
        // unchecked on purpose, and the promotion says so out loud: `advance()` already established
        // that this element is there, which is the entire content of "valid after a true advance"
        unsafe {
            return &$this->window->data:$[$this->pos - 1];
        }
    }

    function key() : usize
    {
        return $this->pos - 1;
    }
}
