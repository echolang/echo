/**
 * String utilities.
 *
 * `string` and `string::view` themselves are at the root - text is vocabulary you write every line.
 * What lives here is the machinery behind them and the tools built on them, which you reach for by
 * name when you need them.
 *
 * **`string` cannot move in here**, and that is a language limitation rather than a choice: it owns the
 * nested type `string::view`, and a nested type under a namespace-qualified owner is not currently
 * spellable - `str::string::view` does not parse. Do not move it without fixing that first.
 */

namespace str;

/**
 * The bytes behind a `string`, and the only thing in the text types that owns heap memory.
 *
 * A class rather than a struct because it is *shared*: two `string`s naming one buffer are two
 * references to one of these, and the count in its heap block is what the copy-on-write gate
 * reads. It is also what frees the bytes, exactly once, when the last of them is gone.
 *
 * `$capacity` counts text bytes and deliberately **does not count the NUL slot**: every allocation
 * here is `$capacity + 1` and every fullness test is `$used <= $capacity`, so the `+ 1` lives in
 * three places instead of a `- 1` living in a dozen.
 *
 * The invariant everything downstream leans on: **`$bytes[$used]` is always 0**. That is what makes
 * `->cstr()` sound with no copy, and what lets a window which stops early be *detected* rather
 * than silently handing a caller bytes past its end.
 *
 * Nothing but `string` should construct one, and that stays a convention rather than a rule - `public`, and
 * it has to be: `string::owner` is a property of this type, so anyone holding a `string` can already name it.
 * Hiding the type while exposing a property of it would be incoherent.
 *
 * **The four mutators below cannot be narrowed either, and the reason is a hole rather than a choice.**
 * `private` on a member is the *owner type* axis, and what these want is the module one - string.eco,
 * format.eco and str.eco all call them - but `internal` is refused on a member, a member having no module
 * of its own. So the shape is what is enforced instead: every mutator is `private` on `string`'s side, so
 * no caller reaches one through the owner it holds.
 */
public class buf
{
    usize $capacity;
    usize $used;
    ptr<uint8> $bytes;

    /**
     * Grows so that at least `$capacity` text bytes fit. Does nothing when they already do.
     *
     * Doubling rather than fitting exactly, so appending in a loop is amortized O(1) instead of
     * O(n²). The `+ 1` is the NUL slot `$capacity` does not count.
     *
     * **This may move the block**, so every window into it is stale afterwards. That is safe only
     * because the caller is always one of `string`'s mutators, and each of those has already run
     * the gate establishing that no other `string` names this buffer. A bare `string::view` handed
     * out earlier is *not* covered - a view holds no reference count by design, and the language
     * has no borrow checker. This is the one place that shows.
     */
    function reserve(usize $capacity) : void
    {
        if ($this->capacity >= $capacity) {
            return;
        }

        usize $grown = $this->capacity * 2;

        if ($grown < $capacity) {
            $grown = $capacity;
        }

        // re-seated through `:$`, because realloc hands back an address rather than writing through
        // the old one
        $this->bytes:$ = mem::realloc<uint8>($this->bytes, $grown + 1);
        $this->capacity = $grown;
    }

    /**
     * Copies `$count` bytes onto the end and re-terminates.
     */
    function append(ptr<const uint8> $src, usize $count) : void
    {
        $this->reserve($this->used + $count);

        // the one place const is dropped in this file. `mem::copy` names one `T` for both sides,
        // and the destination genuinely is writable - it is this buffer's own base
        mem::copy<uint8>($this->bytes:$ + $this->used, ptr<uint8>($src:$), $count);

        $this->used = $this->used + $count;
        $this->bytes:$[$this->used] = 0;
    }

    /**
     * Appends one byte and re-terminates.
     */
    function push(uint8 $byte) : void
    {
        $this->reserve($this->used + 1);

        $this->bytes:$[$this->used] = $byte;
        $this->used = $this->used + 1;
        $this->bytes:$[$this->used] = 0;
    }

    /**
     * Drops the contents and keeps the allocation.
     */
    function clear() : void
    {
        $this->used = 0;
        $this->bytes:$[0] = 0;
    }

    /**
     * Runs when the *last* `string` naming this buffer is gone - not when the first one is.
     */
    destructor()
    {
        mem::free($this->bytes);
    }
}

// **`private` on the block, which belongs to every declaration in it.** `cview` and
// `float` are what this file offers over these two; a C symbol bound here is not a surface,
// and a consumer wanting `strlen` declares its own `extern` rather than borrowing ours
private extern {
    function strlen as c_strlen(ptr<const uint8> $s) : usize;

    // the inverse of `str::from(float64)`, and the reason it is C's rather than this file's: correctly
    // rounded decimal-to-binary conversion is the same hard problem as its inverse, and libc has
    // already solved it on every platform this compiler targets
    function strtod as c_strtod(ptr<const uint8> $s, ptr<ptr<uint8>> $end) : float64;
}

// **the ASCII bytes this namespace compares against, by name.** written out rather than spelled
// `0x2E` at each site for the reason `str::buf`'s `+ 1` lives in three places: a byte compared
// against a number is unreadable, and a name is checkable against the table below where a magic
// number is not.
//
// A constant is its expression copied into every use site, so each of these costs nothing and
// takes its type from where it lands - which is why they are `uint8` here and still fine on the
// right of an `int32` subtraction.
//
// **Split by who reads them, not by what they spell.** The four this file alone compares against are
// `private`; the rest are `internal` because format.eco is written on them too - a spec's letters and
// its digits are the same table. Neither group is a surface: a program spelling `str::CH_DOT` is
// reading this file's implementation, and `'.'->byte(0)` is what it should write instead.
private const uint8 CH_TAB = 9;
private const uint8 CH_LF = 10;
private const uint8 CH_CR = 13;
private const uint8 CH_PLUS = 43;
private const uint8 CH_MINUS = 45;

internal const uint8 CH_SPACE = 32;
internal const uint8 CH_DOT = 46;
internal const uint8 CH_ZERO = 48;
internal const uint8 CH_LT = 60;
internal const uint8 CH_GT = 62;
internal const uint8 CH_UPPER_A = 65;
internal const uint8 CH_UPPER_X = 88;
private const uint8 CH_UPPER_Z = 90;
internal const uint8 CH_CARET = 94;
internal const uint8 CH_LOWER_A = 97;
internal const uint8 CH_B = 98;
internal const uint8 CH_E = 101;
internal const uint8 CH_F = 102;
internal const uint8 CH_O = 111;
internal const uint8 CH_X = 120;

/**
 * Is this byte one of the four ASCII whitespace characters?
 *
 * Bytes are compared with `==` and never with `<`, which is this file's rule as much as
 * `string`'s: integer comparison lowers signed, so `$b >= CH_TAB` is a question about a number
 * that a `uint8` is not.
 *
 * Deliberately ASCII only. There is no Unicode table here and `trim` promises none.
 *
 * `private`: the three `trim` functions are what it is for.
 */
private function space(uint8 $b) : bool
{
    return $b == CH_SPACE || $b == CH_TAB || $b == CH_LF || $b == CH_CR;
}

/**
 * The value of an ASCII digit byte, or `-1` when it is not one.
 *
 * One answer for the three places that read a number out of text - `int`, and a format spec's
 * width and precision. `-1` rather than an optional because every caller is already inside a loop
 * that stops on the first byte that is not a digit.
 *
 * The subtraction widens to `int32` by landing in one, Echo having no cast operator: a `uint8`
 * difference would wrap to 255 for anything below `'0'` and read as a digit that is merely large.
 *
 * `internal` and not `private`, because two of those three places are in format.eco: a format spec's
 * width and its precision are read with this, and one answer to "what number does this byte spell" is
 * the whole point.
 */
internal function digit(uint8 $b) : int32
{
    int32 $wide = $b;
    int32 $digit = $wide - CH_ZERO;

    if ($digit < 0 || $digit > 9) {
        return -1;
    }

    return $digit;
}

/**
 * A window over a NUL-terminated C string, without copying it.
 *
 * The counterpart to `string::view::cstr()`, which goes the other way. Everything C hands back is
 * shaped like this - a bare pointer with the length left implicit in a terminator - so this is the
 * seam every binding crosses on the way in, the way `cstr()` is the one they cross going out.
 *
 * **It borrows.** The bytes belong to whoever allocated them, and the window is valid only while
 * they are. That is the right default for the two callers that matter: an `argv` entry and an
 * environment variable both live as long as the process does, so copying them would be an
 * allocation bought for nothing. Reach for `from` when the bytes are *not* yours to rely on -
 * a buffer you are about to free, or anything behind a `setenv`.
 */
public function cview(ptr<const uint8> $s) : string::view
{
    return string::view($s, c_strlen($s));
}

/**
 * An owning copy of a NUL-terminated C string.
 *
 * `cview` with the bytes taken along, for when the source will not outlive the result.
 *
 * The terminator is the only thing this knows that `from` does not, so that is the whole of
 * what it contributes: `c_strlen` answers the count and the copy is the same one.
 */
public function from(ptr<const uint8> $s) : string
{
    return from($s, c_strlen($s));
}

/**
 * An owning copy of `$count` bytes at `$b`, with no terminator required.
 *
 * `from` for text whose length you already know - a `read` that answered how many bytes it
 * wrote, a slice of a larger buffer. The block is sized up front so the append does not grow it,
 * the bargain `string::clone_reserving` makes.
 */
public function from(ptr<const uint8> $b, usize $count) : string
{
    // `+ 1` is the NUL slot `$capacity` does not count
    buf $owner = buf($count, 0, mem::alloc<uint8>($count + 1));
    $owner->append($b, $count);

    return string(string::view($owner->bytes, $count), $owner);
}

/**
 * `$a` followed by `$b`, as a new string.
 *
 * The free-function spelling of `string::concat`, and the one **string interpolation lowers to**:
 * `"a{$x}b"` becomes `str::concat(str::concat("a", str::from($x)), "b")`. A free function rather
 * than the method because the compiler mints these, and a method call needs its receiver
 * addressed - where two borrowed arguments are what call resolution already knows how to fit.
 *
 * Neither operand is touched, and the result is a fresh buffer sized for both.
 */
#[inline]
public function concat(const string& $a, const string& $b) : string
{
    return $a->concat($b);
}

/**
 * `$text` with leading ASCII whitespace removed.
 *
 * A window, not a copy: the result shares `$text`'s buffer, which is what makes trimming free. Call
 * `->clone()` on it if you want the parent's bytes released.
 */
public function ltrim(const string& $text) : string
{
    usize $n = $text->size();
    usize $i = 0;

    while ($i < $n) {
        if (!space($text->byte($i))) {
            break;
        }

        $i = $i + 1;
    }

    return $text->sub($i, $n - $i);
}

/**
 * `$text` with trailing ASCII whitespace removed. A window, for `ltrim`'s reason.
 */
public function rtrim(const string& $text) : string
{
    usize $n = $text->size();

    while ($n > 0) {
        if (!space($text->byte($n - 1))) {
            break;
        }

        $n = $n - 1;
    }

    return $text->sub(0, $n);
}

/**
 * `$text` with ASCII whitespace removed from both ends. A window, for `ltrim`'s reason.
 */
public function trim(const string& $text) : string
{
    return ltrim(rtrim($text));
}

/**
 * The ASCII lower-case value of `$b`, as an `int32`. Letters A-Z move; everything else is itself.
 *
 * Widened first, which is this file's rule as much as `string`'s: integer comparison lowers signed,
 * so a `uint8` of `0xff` reads as -1 and a range test over two bytes answers nonsense.
 *
 * Deliberately ASCII. `str::lower` is Unicode Default Case Conversion and allocates; a header name,
 * an HTTP token, a hex digit is none of that, and the caller is usually inside a scan that cannot
 * afford a buffer.
 */
private function fold_ascii(uint8 $b) : int32
{
    int32 $wide = $b;

    if ($wide >= CH_UPPER_A) {
        if ($wide <= CH_UPPER_Z) {
            return $wide + 32;
        }
    }

    return $wide;
}

/**
 * Are these the same bytes, ignoring ASCII case?
 *
 * Allocates nothing. `str::lower($a) == str::lower($b)` is the Unicode answer and a pair of
 * buffers; this is the one a protocol that said "case-insensitive" and meant A-Z writes.
 *
 * A `string` reaches it without a cast - `string::view()` is an `#[implicit]` conversion.
 */
public function iequals(string::view $a, string::view $b) : bool
{
    if ($a->size != $b->size) {
        return false;
    }

    usize $i = 0;

    while ($i < $a->size) {
        if (fold_ascii($a->byte($i)) != fold_ascii($b->byte($i))) {
            return false;
        }

        $i = $i + 1;
    }

    return true;
}

/**
 * `$text` cut at every occurrence of `$sep`.
 *
 * Always answers at least one part, and `n` separators give `n + 1` of them - so an empty text
 * splits to one empty part and `",a,"` on `","` gives three. That is the rule that makes
 * `str::join(str::split($t, $s), $s)` give `$t` back, which is the only rule worth promising here.
 *
 * An empty separator would match everywhere and nowhere, so it answers the whole text unsplit
 * rather than one part per byte.
 */
public function split(const string& $text, const string& $sep) : array<string>
{
    array<string> $parts = array<string>();

    if ($sep->empty()) {
        $parts->push($text->sub(0, $text->size()));
        return $parts;
    }

    usize $size = $text->size();
    usize $start = 0;

    while (true) {
        string $rest = $text->sub($start, $size - $start);
        usize $at = $rest->find($sep);

        // `find` answers the haystack's own size when there is no match - there is no `Option`
        // to hand back, and the size is the one value always to hand and never a valid index
        if ($at >= $rest->size()) {
            $parts->push($rest);
            break;
        }

        $parts->push($rest->sub(0, $at));
        $start = $start + $at + $sep->size();
    }

    return $parts;
}

/**
 * Every part of `$parts` in order, with `$sep` between them.
 *
 * The inverse of `split`, and sized in one pass so a long list is one allocation rather than one
 * per part.
 */
public function join(const array<string>& $parts, const string& $sep) : string
{
    usize $count = $parts->count();

    if ($count == 0) {
        return '';
    }

    usize $total = $sep->size() * ($count - 1);
    usize $i = 0;

    while ($i < $count) {
        $total = $total + $parts[$i]->size();
        $i = $i + 1;
    }

    string $out = '';
    $out->reserve($total);

    $i = 0;

    while ($i < $count) {
        if ($i > 0) {
            $out->append($sep);
        }

        $out->append($parts[$i]);
        $i = $i + 1;
    }

    return $out;
}

/**
 * `$text` written `$times` over. `0` answers the empty string.
 */
public function repeat(const string& $text, usize $times) : string
{
    string $out = '';
    $out->reserve($text->size() * $times);

    usize $i = 0;

    while ($i < $times) {
        $out->append($text);
        $i = $i + 1;
    }

    return $out;
}

/**
 * `$text` with `$fill` bytes added on the left until it is `$width` bytes wide.
 *
 * **Bytes, not characters.** A width is what a column of a terminal counts and what a format spec
 * asks for, and neither of those is a codepoint count either - so counting bytes is at least a
 * rule that can be stated. Text already that wide is answered unchanged rather than truncated.
 */
public function lpad(const string& $text, usize $width, uint8 $fill) : string
{
    usize $size = $text->size();

    if ($size >= $width) {
        return $text->sub(0, $size);
    }

    string $out = '';
    $out->reserve($width);

    usize $i = $size;

    while ($i < $width) {
        $out->push($fill);
        $i = $i + 1;
    }

    $out->append($text);
    return $out;
}

/**
 * `$text` with `$fill` bytes added on the right until it is `$width` bytes wide. Bytes, for
 * `lpad`'s reason.
 */
public function rpad(const string& $text, usize $width, uint8 $fill) : string
{
    usize $size = $text->size();

    if ($size >= $width) {
        return $text->sub(0, $size);
    }

    string $out = '';
    $out->reserve($width);
    $out->append($text);

    usize $i = $size;

    while ($i < $width) {
        $out->push($fill);
        $i = $i + 1;
    }

    return $out;
}

// int64's minimum divided by ten, its last digit, and the minimum itself. at file scope because a
// constant is its expression copied into each use site and so cannot be declared inside a body -
// which is the whole difference between a constant and a `const` variable. `private`, since the one
// thing that reads them is `int` below
private const int64 PARSE_INT_FLOOR = -922337203685477580;
private const int64 PARSE_INT_FLOOR_DIGIT = 8;
private const int64 INT64_MIN = -9223372036854775808;

/**
 * The integer `$text` spells, or `null` when it does not spell one.
 *
 * Base ten, an optional leading `+` or `-`, and nothing else - no whitespace, no separators, no
 * trailing characters. `str::trim` first if the text came from a line of input.
 *
 * **The digits accumulate negative**, which is not a stylistic choice: `-9223372036854775808` has
 * no positive counterpart, so accumulating positive and negating at the end cannot parse the one
 * value most likely to be tested. Overflow answers `null` rather than wrapping.
 */
public function int(const string& $text) : int64?
{
    usize $n = $text->size();

    if ($n == 0) {
        return null;
    }

    usize $i = 0;
    bool $negative = false;

    uint8 $first = $text->byte(0);

    if ($first == CH_MINUS) {
        $negative = true;
        $i = 1;
    }
    else if ($first == CH_PLUS) {
        $i = 1;
    }

    // a lone sign is not a number
    if ($i >= $n) {
        return null;
    }

    int64 $value = 0;

    while ($i < $n) {
        int64 $digit = digit($text->byte($i));

        if ($digit < 0) {
            return null;
        }

        if ($value < PARSE_INT_FLOOR) {
            return null;
        }

        if ($value == PARSE_INT_FLOOR && $digit > PARSE_INT_FLOOR_DIGIT) {
            return null;
        }

        $value = $value * 10 - $digit;
        $i = $i + 1;
    }

    if ($negative) {
        return $value;
    }

    // the one value with no positive counterpart, which negating would wrap straight back to
    if ($value == INT64_MIN) {
        return null;
    }

    return -$value;
}

/**
 * The number `$text` spells, or `null` when it does not spell one.
 *
 * Through C's `strtod`, and the whole text has to be consumed - so `"1.5"` parses and `"1.5kg"`
 * does not, which is the difference between this and calling `strtod` yourself. Accepts what
 * `strtod` accepts, `inf` and `nan` included.
 *
 * It clones, always: `strtod` reads to a NUL and a `string` need not have one - a substring shares
 * its parent's buffer and simply stops early. Trading an allocation for that is the honest price
 * of a C boundary.
 */
public function float(const string& $text) : float64?
{
    if ($text->empty()) {
        return null;
    }

    string $owned = $text->clone();

    ptr<uint8> $stop = null;
    float64 $value = c_strtod($owned->cstr(), &$stop);

    if ($stop:$ == null) {
        return null;
    }

    // compared as integers rather than as pointers: `mem::bit_cast` is how an address becomes a
    // number here, and a subtraction of two of them is the length `strtod` consumed
    usize $begin = mem::bit_cast<usize, ptr<const uint8>>($owned->cstr());
    usize $end = mem::bit_cast<usize, ptr<uint8>>($stop);

    // nothing parsed, or something left over
    if ($end - $begin != $owned->size()) {
        return null;
    }

    return $value;
}
