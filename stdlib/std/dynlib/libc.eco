/**
 * The C symbols this namespace binds, in one file.
 *
 * A C symbol may only be declared once per module, so they sit here rather than
 * beside the class that calls them. `internal`: dynlib.eco names them, a consumer
 * does not.
 */

namespace std::dynlib;

#[if: family != windows]
internal extern {
    function dlopen as c_dlopen(ptr<const uint8> $path, int32 $flags) : ptr<uint8>;
    function dlsym as c_dlsym(ptr<uint8> $handle, ptr<const uint8> $name) : ptr<uint8>;
    function dlclose as c_dlclose(ptr<uint8> $handle) : int32;
    function dlerror as c_dlerror() : ptr<uint8>;
}

// RTLD_NOW is 2 on Darwin and on Linux. RTLD_LOCAL is 4 on Darwin and 0 on
// Linux, so NOW|LOCAL is 6 versus 2
#[if: family == darwin]
internal const RTLD_NOW_LOCAL = 6;
#[else]
internal const RTLD_NOW_LOCAL = 2;
#[end]
#[end]

#[if: os == windows]
internal extern {
    function LoadLibraryW as c_LoadLibraryW(ptr<const uint16> $path) : ptr<uint8>;
    function GetProcAddress as c_GetProcAddress(ptr<uint8> $module, ptr<const uint8> $name) : ptr<uint8>;
    function FreeLibrary as c_FreeLibrary(ptr<uint8> $module) : int32;
}
#[end]
