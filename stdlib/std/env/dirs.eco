/**
 * The directories a process is told about.
 *
 * Two of the three are environment variables and cost exactly what reading one costs. The working
 * directory is the exception: `getcwd` writes into a buffer the caller sizes, so it is the one place
 * in this module that allocates, and the one that hands back an owning `std::fs::path`.
 */

namespace std::env;

/**
 * The current working directory.
 *
 * An owning `std::fs::path`, unlike everything else here, and that is forced rather than chosen: the
 * bytes come from a buffer this function allocated, so a view over them would be dangling the moment
 * it was handed back.
 *
 * `getcwd` answers null when the path does not fit rather than saying how much it needs, so an
 * `ERANGE` grows the buffer. Any other errno is the answer. The cap turns a broken `getcwd` into
 * `ENOMEM` instead of a loop that allocates until the machine gives up.
 */
public function cwd() : result<std::fs::path, std::io::ioerror>
{
#[if: os == windows]
    wide_string $buf = wide_string();
    int32 $wide_cap = std::io::PATH_GROW as int32;

    while ($wide_cap <= std::io::WIDE_PATH_MAX as int32) {
        if (!$buf->resize($wide_cap as usize)) {
            return .error(std::io::ioerror(std::io::ENOMEM));
        }

        ptr<uint16> $written = c_wgetcwd($buf->data(), $wide_cap);

        if ($written:$ == null) {
            std::io::ioerror $e = std::io::last_error();

            if ($e->code == std::io::ERANGE) {
                $wide_cap = $wide_cap * 2;
                continue;
            }

            return .error($e);
        }

        string $path = guard wide_to_utf8($buf->data()) else {
            return .error(std::io::wide_error());
        }

        return .ok(std::fs::path($path));
    }

    return .error(std::io::ioerror(std::io::ENOMEM));
#[else]
    usize $capacity = std::io::PATH_GROW;

    while ($capacity <= std::io::PATH_GROW_MAX) {
        ptr<uint8> $raw = mem::alloc<uint8>($capacity);

        if ($raw:$ == null) {
            return .error(std::io::ioerror(std::io::ENOMEM));
        }

        // bound to a local because `:$` needs a place to reach the pointer of, and a call result has
        // no storage - AST::storage_of calls that addressless
        ptr<uint8> $written = c_getcwd($raw, $capacity);

        // the failure grows and retries, so the success below is straight-line. written the other way
        // round, `$path` would be declared inside a branch and moved out of on only that one, which
        // AST::OwnershipPass refuses - it has no way to destroy it on the path that did not return
        if ($written:$ == null) {
            std::io::ioerror $e = std::io::last_error();
            mem::free($raw);

            if ($e->code == std::io::ERANGE) {
                $capacity = $capacity * 2;
                continue;
            }

            return .error($e);
        }

        // the copy is what lets the buffer go - `from` takes the bytes along
        string $path = str::from($raw);
        mem::free($raw);

        return .ok(std::fs::path($path));
    }

    return .error(std::io::ioerror(std::io::ENOMEM));
#[end]
}

/**
 * Sets the working directory. A missing path is a correct program, so this is
 * `status` rather than a die.
 */
public function chdir(const std::fs::path& $path) : status<std::io::ioerror>
{
#[if: os == windows]
    wide_string $wide = try wide_of($path);

    if (c_wchdir($wide->data()) < 0) {
        return .error(std::io::last_error());
    }
#[else]
    if (c_chdir($path->cstr()) < 0) {
        return .error(std::io::last_error());
    }
#[end]

    return .ok;
}

/**
 * The current user's home directory, or null when `HOME` is not set.
 *
 * Nullable because an unset `HOME` has no honest answer. Returning `""` would hand back a path that
 * resolves - to the working directory - and the caller could not tell that from a real one.
 */
public function home() : std::fs::path?
{
#[if: os == windows]
    string::view? $v = var('USERPROFILE');
#[else]
    string::view? $v = var('HOME');
#[end]

    if ($v == null) {
        return null;
    }

    return std::fs::path($v ?? '');
}

/**
 * The directory for temporary files, `/tmp` when `TMPDIR` is not set.
 *
 * Not nullable, because unlike `HOME` there *is* an honest answer when the variable is missing: the
 * path every POSIX system has. Windows answers `TEMP`, then `TMP`, then the current directory -
 * there is no `/tmp`.
 */
public function tmp() : std::fs::path
{
#[if: os == windows]
    return std::fs::path(var('TEMP') ?? var('TMP', '.'));
#[else]
    return std::fs::path(var('TMPDIR', '/tmp'));
#[end]
}
