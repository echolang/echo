/**
 * The process itself: who it is, what it was started with, and how it stops.
 */

namespace std::env;

/**
 * The process id.
 */
#[inline]
public function pid() : int32
{
    return c_getpid();
}

/**
 * How many arguments the program was started with, including the program name at index 0.
 *
 * So a program invoked with no arguments answers 1, the way C's `argc` does.
 */
#[builtin: process_argc]
public function argc() : usize;

/**
 * The raw `argv` block: `$argc` pointers to NUL-terminated strings.
 *
 * The low-level seam `arg` and `args` are built on. **`private`**: those two are what a caller wants -
 * they do the bounds check and hand back a `string::view` - and the block itself is a pointer into a
 * pointer with a count kept somewhere else, which is not a thing to hand anybody. It was `public` only
 * for as long as there were no visibility modifiers to say otherwise.
 */
#[builtin: process_argv]
private function raw_argv() : ptr<ptr<uint8>>;

/**
 * The raw environment block: a null-terminated run of pointers to `KEY=VALUE` strings.
 *
 * The seam `vars` is built on, and the reason this module needs no platform conditionals - the block
 * arrives as the entry point's third argument rather than through `environ`, which is a data symbol
 * an `extern` block has no way to bind and which Darwin does not export under that name anyway.
 *
 * **`internal` and not `private`**, which is the whole difference between this and `raw_argv` above:
 * `var_iterator` walks it, and that lives in vars.eco.
 */
#[builtin: process_envp]
internal function raw_envp() : ptr<ptr<uint8>>;

/**
 * A cursor over the program's arguments, `argv[0]` included.
 *
 * The view `current()` hands back is **stored** rather than computed, and that is the protocol's doing
 * rather than a choice: `contract::iterator` says `current()` returns a `V&`, so there has to be
 * something for the borrow to name. `advance()` overwrites it, so a view taken from one step is stale
 * on the next - copy it if you mean to keep it.
 *
 * The pointer block is held rather than re-read each step for `slice_iterator`'s reason: it cannot
 * change, and reloading it through a global every turn would defeat any hoisting.
 */
public struct arg_iterator : contract::iterator<string::view>, contract::keyed<usize>
{
    // every field `private`, for `slice_iterator`'s reason: no operator is declared over a cursor, so the
    // constructor and the three protocol methods below are the whole of how one is reached
    private ptr<ptr<uint8>> $block;
    private usize $count;

    // the index one *past* the element `current()` names, so the cursor starts before the first one
    // without needing a signed type or a "have we started" flag
    private usize $pos;

    private string::view $current;

    constructor()
    {
        // re-seated through `:$`, because a plain `=` on a pointer property writes *through* it into a
        // pointee that does not exist yet. the form `str::buf::reserve` uses, for the same reason
        $this->block:$ = raw_argv();
        $this->count = argc();
        $this->pos = 0;
        $this->current = string::view(null, 0);
    }

    function advance() : bool
    {
        if ($this->pos >= $this->count) {
            return false;
        }

        $this->current = str::cview($this->block:$[$this->pos]);
        $this->pos = $this->pos + 1;

        return true;
    }

    function current() : string::view&
    {
        return &$this->current;
    }

    function key() : usize
    {
        return $this->pos - 1;
    }
}

/**
 * The argument at `$index`, counting the program name as 0.
 *
 * Checked with `assert`, the bargain `string::view::byte` makes: reading past `argc()` is a mistake
 * in the caller rather than a condition to recover from.
 */
public function arg(usize $index) : string::view
{
    assert($index < argc(), 'argument index out of bounds');

    // bound to a local because `:$` needs a place to reach the pointer of, and a call result has no
    // storage - AST::storage_of calls that addressless
    ptr<ptr<uint8>> $block = raw_argv();

    return str::cview($block:$[$index]);
}

/**
 * A cursor over every argument, for `foreach`. Allocates nothing.
 */
#[inline]
public function args() : arg_iterator
{
    return arg_iterator();
}

/**
 * Every argument, as an array of owning strings.
 *
 * `args()` without the loop, for when the list is the thing you want rather than the walk. The one
 * function in this module that allocates on purpose, so it is a call and not a property: nothing is
 * built unless you ask - and it allocates twice per argument, since each `string` owns a copy of its
 * bytes rather than windowing the block the platform handed `main`.
 *
 * **Reach for `args()` or `arg($i)` when reading is all you need.** Both hand back a `string::view`
 * over the platform's own bytes and allocate nothing at all; this exists for when the arguments have
 * to outlive the walk, be sorted, be kept in a struct - the cases a borrow cannot cover.
 */
public function argv() : array<string>
{
    usize $count = argc();

    array<string> $out = array<string>();
    $out->reserve($count);

    // indexed rather than `foreach`ed, the shape `arr::merge` uses: a cursor buys nothing when the count
    // and the indexed accessor are both already to hand, and the loop reads as what it is
    usize $i = 0;

    while ($i < $count) {
        // through the raw C string rather than the view `arg` builds, the shape `exe`'s fallback uses:
        // `str::from` is the one function that turns bytes nobody owns into bytes this array does,
        // and re-measuring them costs a `strlen` the view had already paid for
        $out[] = str::from(arg($i)->cstr());
        $i = $i + 1;
    }

    return $out;
}

/**
 * The path to the running executable.
 *
 * An owning `string` rather than a view, and that is forced rather than chosen: both platform calls write
 * into a buffer this function allocated, so a window over them would dangle the moment it was handed
 * back. The same reason `cwd` owns its answer.
 *
 * **On a platform this module has not been taught, it falls back to `argv[0]`** - the path as invoked,
 * which is absolute when the program was launched by an absolute path and whatever the caller felt like
 * otherwise. That arm is a fallback rather than a refusal on purpose: a new target should compile with an
 * approximation rather than fail to resolve `exe()` at all.
 *
 * **Under `echoc run` this is `echoc` itself**, and that is the truth rather than a wart: a JIT'd program
 * has no executable of its own, it runs inside the compiler's process, and the platform is answering about
 * the process. Reach for `arg(0)` when what you want is the name the program was invoked under - that one
 * *is* the source file there.
 */
public function exe() : string
{
#[if: os == darwin]
    // `_NSGetExecutablePath` reports the size it needs through the same parameter it reads, so the retry is
    // exact: ask with nothing, be told how much, ask again. A first call sized 0 is the documented way to
    // query, and the second cannot fail for space
    uint32 $needed = 0;
    ptr<uint8> $probe = mem::alloc<uint8>(1);

    c_exe_path($probe, &$needed);
    mem::free($probe);

    ptr<uint8> $raw = mem::alloc<uint8>($needed + 1);
    $raw:$[$needed] = 0;

    if (c_exe_path($raw, &$needed) != 0) {
        mem::free($raw);
        die('_NSGetExecutablePath refused a buffer it asked for');
    }

    string $path = str::from($raw);
    mem::free($raw);

    return $path;
#[elif: os == linux]
    // `readlink` does not terminate what it writes and will not say how much it needed, so the buffer is
    // grown until the answer stops filling it - a result shorter than the buffer is the proof it fit
    usize $capacity = 256;

    // bound to a local because `->` on a literal is not a readable expression - a method call needs
    // something with storage to be the receiver
    string $link = '/proc/self/exe';

    while ($capacity <= 65536) {
        ptr<uint8> $raw = mem::alloc<uint8>($capacity + 1);
        int64 $written = c_readlink($link->cstr(), $raw, $capacity);

        if ($written < 0) {
            mem::free($raw);
            die('readlink("/proc/self/exe") failed');
        }

        if ($written >= $capacity) {
            mem::free($raw);
            $capacity = $capacity * 2;
            continue;
        }

        // the terminator readlink did not write
        $raw:$[$written] = 0;

        string $path = str::from($raw);
        mem::free($raw);

        return $path;
    }

    die('the executable path does not fit in 64 KiB');
#[elif: os == windows]
    // GetModuleFileNameW writes UTF-16. grow until it fits, then WideCharToMultiByte to
    // UTF-8, which is what every Echo `string` is
    uint32 $wide_cap = 256;

    while ($wide_cap <= 32768) {
        ptr<uint16> $wide = mem::alloc<uint16>($wide_cap);
        uint32 $written = c_GetModuleFileNameW(ptr<uint8>(null), $wide, $wide_cap);

        if ($written == 0) {
            mem::free($wide);
            die('GetModuleFileNameW failed');
        }

        if ($written >= $wide_cap) {
            mem::free($wide);
            $wide_cap = $wide_cap * 2;
            continue;
        }

        int32 $utf8_n = c_WideCharToMultiByte(
            CP_UTF8, 0, $wide, $written as int32,
            ptr<uint8>(null), 0, ptr<uint8>(null), ptr<int32>(null));

        if ($utf8_n <= 0) {
            mem::free($wide);
            die('WideCharToMultiByte failed');
        }

        ptr<uint8> $utf8 = mem::alloc<uint8>(($utf8_n + 1) as usize);
        $utf8:$[$utf8_n] = 0;
        c_WideCharToMultiByte(
            CP_UTF8, 0, $wide, $written as int32,
            $utf8, $utf8_n, ptr<uint8>(null), ptr<int32>(null));
        mem::free($wide);

        string $path = str::from($utf8);
        mem::free($utf8);

        return $path;
    }

    die('the executable path does not fit in 32 KiB of UTF-16');
#[else]
    return str::from(arg(0)->cstr());
#[end]
}

/**
 * Stops the program with `$code`, right here.
 *
 * Nothing after the call runs, so no destructor runs either and no `[memory]` report is printed -
 * the same bargain `die` makes, for the same reason: there is no post-teardown moment left when the
 * call is made from the middle of a scope that still owns things. Return out of `main` instead if
 * you want an orderly finish.
 *
 * The exit code is what the shell sees. `0` means success by convention.
 */
#[builtin: exit]
public function exit(int32 $code) : void;
