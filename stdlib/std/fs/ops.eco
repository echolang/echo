/**
 * Filesystem verbs. A path is `std::fs::path`; a string literal still works.
 */

namespace std::fs;

use std::io::ioerror;
use std::io::filemode;

private const uint32 TEMP_TRIES = 10000;

public function open(const path& $path, filemode $mode) : result<std::io::file, ioerror>
{
    return std::io::file::open($path, $mode);
}

public function create(const path& $path) : result<std::io::file, ioerror>
{
    return std::io::file::open($path, .write);
}

/**
 * Creates `$path` and fails if it is already there. Write-only, same bargain as `create`.
 */
public function create_new(const path& $path) : result<std::io::file, ioerror>
{
    return create_new($path, perms: fileperms(std::io::OPEN_MODE));
}

public function create_new(
    const path& $path,
    perms: fileperms $perms
) : result<std::io::file, ioerror>
{
    return std::io::file::open($path, .create_new, perms: $perms);
}

public function append(const path& $path) : result<std::io::file, ioerror>
{
    return std::io::file::open($path, .append);
}

public function readfile(const path& $path) : result<string, ioerror>
{
    std::io::file $f = try std::io::file::open($path, .read);

    return $f->readall();
}

public function writefile(const path& $path, const string& $text) : result<usize, ioerror>
{
    return writefile($path, $text, perms: fileperms(std::io::OPEN_MODE));
}

public function writefile(
    const path& $path,
    const string& $text,
    perms: fileperms $perms
) : result<usize, ioerror>
{
    std::io::file $f = try std::io::file::open($path, .write, perms: $perms);
    usize $n = try $f->write($text);
    try $f->flush();

    return .ok($n);
}

public function exists(const path& $path) : result<bool, ioerror>
{
    bool $ok = guard std::io::access_path($path, std::io::F_OK) else ($e) {
        if ($e->missing()) {
            return .ok(false);
        }

        return .error($e);
    }

    return .ok($ok);
}

public function remove(const path& $path) : result<bool, ioerror>
{
    return std::io::unlink_path($path);
}

public function rename(const path& $from, const path& $to) : result<bool, ioerror>
{
    return std::io::rename_path($from, $to);
}

public function info(const path& $path) : result<fileinfo, ioerror>
{
    return std::io::stat_path($path, true);
}

public function linkinfo(const path& $path) : result<fileinfo, ioerror>
{
    return std::io::stat_path($path, false);
}

public function chmod(const path& $path, fileperms $perms) : result<bool, ioerror>
{
    return std::io::chmod_path($path, $perms);
}

public function realpath(const path& $path) : result<path, ioerror>
{
    string $raw = try std::io::realpath_of($path);

    return .ok(path($raw));
}

public function copy(const path& $from, const path& $to) : result<bool, ioerror>
{
    return std::io::copy_file($from, $to);
}

public function opendir(const path& $path) : result<dir, ioerror>
{
    return dir::open($path);
}

/**
 * Creates `$path`. `recursive: true` creates every missing parent and treats an existing
 * directory as success. `$perms` is the mode a new directory starts with, before the umask.
 */
public function mkdir(
    const path& $path,
    recursive: bool $recursive = false
) : result<bool, ioerror>
{
    return mkdir($path, recursive: $recursive, perms: fileperms(std::io::MKDIR_MODE));
}

public function mkdir(
    const path& $path,
    recursive: bool $recursive = false,
    perms: fileperms $perms
) : result<bool, ioerror>
{
    if (!$recursive) {
        return std::io::mkdir_path($path, $perms->mode());
    }

    if ($path->view()->size == 0 || $path->string() == '.') {
        return .ok(true);
    }

    result<fileinfo, ioerror> $look = info($path);

    if ($look->failed()) {
        ioerror $e = $look->failure();

        if (!$e->missing()) {
            return .error($e);
        }

        path $parent = $path->dirname();

        if ($parent != $path) {
            try std::fs::mkdir($parent, recursive: true, perms: $perms);
        }

        return std::io::mkdir_path($path, $perms->mode());
    }

    fileinfo $here = $look->unwrap();

    if ($here->kind == filekind::directory) {
        return .ok(true);
    }

    return .error(ioerror(std::io::EEXIST));
}

public function rmdir(const path& $path) : result<bool, ioerror>
{
    return std::io::rmdir_path($path);
}

/**
 * Removes `$path` and everything below it. A symlink is unlinked, never followed.
 * A missing path is success.
 */
public function remove_all(const path& $path) : status<ioerror>
{
    fileinfo $look = guard linkinfo($path) else ($e) {
        if ($e->missing()) {
            return .ok;
        }

        return .error($e);
    };

    if ($look->kind == filekind::symlink) {
        result<bool, ioerror> $gone = remove($path);

        if (!$gone->failed()) {
            return .ok;
        }

        result<bool, ioerror> $rd = rmdir($path);

        if (!$rd->failed()) {
            return .ok;
        }

        return .error($gone->failure());
    }

    if ($look->kind != filekind::directory) {
        try remove($path);

        return .ok;
    }

    dir $listing = try opendir($path);

    foreach ($listing as const &$entry) {
        path $child = $entry->path();
        status<ioerror> $gone = remove_all($child);

        if ($gone->failed()) {
            $listing->close();
            return $gone;
        }
    }

    $listing->close();

    try rmdir($path);

    return .ok;
}

/**
 * Writes `$text` to `$path` whole: into a unique temp beside it, then renamed over.
 */
public function replace(const path& $path, const string& $text) : status<ioerror>
{
    path $tmp = try tempfile($path->dirname());

    guard writefile($tmp, $text) else ($e) {
        return drop_tmp($tmp, $e);
    }

    guard std::io::replace_over($tmp, $path) else ($e) {
        return drop_tmp($tmp, $e);
    }

    return .ok;
}

private function drop_tmp(const path& $tmp, ioerror $e) : status<ioerror>
{
    bool $drop = remove($tmp)->or(false);
    return .error($e);
}

public function symlink(const path& $target, const path& $link) : status<ioerror>
{
    return std::io::symlink_path($target, $link);
}

public function hard_link(const path& $from, const path& $to) : status<ioerror>
{
    return std::io::hard_link_path($from, $to);
}

public function readlink(const path& $path) : result<path, ioerror>
{
    string $raw = try std::io::readlink_of($path);

    return .ok(path($raw));
}

public function truncate(const path& $path, int64 $size) : status<ioerror>
{
    return std::io::truncate_path($path, $size);
}

private function exclusive_temp(const path& $dir, as_dir: bool $as_dir) : result<path, ioerror>
{
    int32 $pid = std::env::pid();
    int64 $t = std::time::timestamp::now()->unix_nanos();
    uint32 $n = 0;

    while ($n < TEMP_TRIES) {
        path $p = $dir / "eco-{$pid}-{$t}-{$n}";

        if ($as_dir) {
            guard mkdir($p) else ($e) {
                if ($e->exists()) {
                    $n = $n + 1;
                    continue;
                }

                return .error($e);
            }
        }
        else {
            std::io::file $f = guard create_new($p) else ($e) {
                if ($e->exists()) {
                    $n = $n + 1;
                    continue;
                }

                return .error($e);
            };

            $f->close();
        }

        return .ok($p);
    }

    return .error(ioerror(std::io::EEXIST));
}

/**
 * A unique empty file under `$dir`, created exclusively. The path is returned closed;
 * open it if you need the stream.
 */
public function tempfile(const path& $dir) : result<path, ioerror>
{
    return exclusive_temp($dir, as_dir: false);
}

public function tempfile() : result<path, ioerror>
{
    return tempfile(std::env::tmp());
}

/**
 * A unique empty directory under `$dir`.
 */
public function tempdir(const path& $dir) : result<path, ioerror>
{
    return exclusive_temp($dir, as_dir: true);
}

public function tempdir() : result<path, ioerror>
{
    return tempdir(std::env::tmp());
}

/**
 * An absolute spelling: `cwd()` joined on when this is relative, then `clean()`.
 */
public function abs(const path& $path) : result<path, ioerror>
{
    if ($path->is_absolute()) {
        return .ok($path->clean());
    }

    path $here = try std::env::cwd();

    return .ok(($here / $path)->clean());
}
