/**
 * The read and write windows `file`, `reader`, `writer` and the two pipe ends share.
 *
 * Not a surface. A fill, a flush, a newline scan: one copy, so the types sharing it cannot drift.
 */

namespace std::io;

internal struct readwin
{
    string $buf;
    usize $pos;

    constructor()
    {
        $this->buf = '';
        $this->pos = 0;
    }

    const function pending() : usize
    {
        return $this->buf->size() - $this->pos;
    }

    // the bytes this window holds and nobody has read, moved onto the end of `$out`
    function take_pending(string& $out) : void
    {
        usize $left = $this->pending();

        if ($left > 0) {
            ptr<const uint8> $src = $this->buf->data();
            $out->append($src:$ + $this->pos, $left);
        }

        $this->drop();
    }

    function drop() : void
    {
        $this->buf->clear();
        $this->pos = 0;
    }
}

internal struct writewin
{
    string $buf;

    constructor()
    {
        $this->buf = '';
    }
}

internal function as_usize(isize $n) : usize
{
    if ($n <= 0) {
        return 0;
    }

    usize $out = $n;

    return $out;
}

internal function raw_write_all(raw_end $io, ptr<const uint8> $src, usize $count) : result<usize, ioerror>
{
    usize $done = 0;

    while ($done < $count) {
        isize $got = raw_write($io, $src:$ + $done, $count - $done);

        if ($got <= 0) {
            return .error(last_error());
        }

        $done = $done + as_usize($got);
    }

    return .ok($count);
}

internal function fill_read(raw_end $io, readwin& $w) : result<usize, ioerror>
{
    if ($w->pending() == 0) {
        $w->drop();
    }

    $w->buf->reserve($w->buf->size() + IO_BUF);

    ptr<uint8> $dst = $w->buf->spare();
    usize $room = $w->buf->room();
    isize $got = raw_read($io, $dst, $room);

    if ($got < 0) {
        return .error(last_error());
    }

    usize $n = as_usize($got);
    $w->buf->commit($n);

    return .ok($n);
}

internal function flush_write(raw_end $io, writewin& $w) : result<usize, ioerror>
{
    usize $n = $w->buf->size();

    if ($n == 0) {
        return .ok(0);
    }

    // **clear only after the bytes landed.** a failed write(2) would otherwise forget what never
    // reached the kernel, and file.close / writer.~ throw that result away
    usize $wrote = guard raw_write_all($io, $w->buf->data(), $n) else ($e) {
        return .error($e);
    }

    $w->buf->clear();

    return .ok($wrote);
}

internal function write_to(raw_end $io, writewin& $w, ptr<const uint8> $src, usize $count) : result<usize, ioerror>
{
    if ($count == 0) {
        return .ok(0);
    }

    if ($w->buf->size() == 0 && $count >= IO_BUF) {
        return raw_write_all($io, $src, $count);
    }

    usize $done = 0;

    while ($done < $count) {
        if ($w->buf->room() == 0) {
            usize $flushed = guard flush_write($io, $w) else ($e) {
                return .error($e);
            }

            $w->buf->reserve(IO_BUF);
        }

        usize $space = $w->buf->room();
        usize $take = $space;

        if ($take > $count - $done) {
            $take = $count - $done;
        }

        $w->buf->append($src:$ + $done, $take);
        $done = $done + $take;
    }

    return .ok($count);
}

internal function read_from(raw_end $io, readwin& $w, ptr<uint8> $dst, usize $count) : result<usize, ioerror>
{
    usize $done = 0;

    while ($done < $count) {
        usize $avail = $w->pending();

        if ($avail == 0) {
            usize $need = $count - $done;

            if ($need >= IO_BUF) {
                isize $got = raw_read($io, $dst:$ + $done, $need);

                if ($got < 0) {
                    return .error(last_error());
                }

                if ($got == 0) {
                    break;
                }

                $done = $done + as_usize($got);
                continue;
            }

            usize $got = guard fill_read($io, $w) else ($e) {
                return .error($e);
            }

            if ($got == 0) {
                break;
            }

            $avail = $w->pending();
        }

        usize $take = $avail;

        if ($take > $count - $done) {
            $take = $count - $done;
        }

        ptr<const uint8> $src = $w->buf->data();
        mem::copy<uint8>($dst:$ + $done, ptr<uint8>($src:$ + $w->pos), $take);
        $w->pos = $w->pos + $take;
        $done = $done + $take;
    }

    return .ok($done);
}

// the one CR rule: a line ending is LF, and a CR immediately before it is not part of
// the line. a CR that ended the previous fill is still trailing on `$line` here
internal function without_trailing_cr(const string& $s) : string
{
    usize $n = $s->size();

    if ($n == 0) {
        return $s;
    }

    if ($s->byte($n - 1) != CARRIAGE_RETURN) {
        return $s;
    }

    return $s->sub(0, $n - 1);
}

internal function readline_from(raw_end $io, readwin& $w) : result<string?, ioerror>
{
    string $line = '';
    bool $any = false;

    while (true) {
        usize $i = $w->pos;
        usize $end = $w->buf->size();

        while ($i < $end) {
            if ($w->buf->byte($i) == LINE_FEED) {
                usize $n = $i - $w->pos;

                if ($n > 0) {
                    ptr<const uint8> $src = $w->buf->data();
                    $line->append($src:$ + $w->pos, $n);
                }

                $w->pos = $i + 1;

                return .ok(without_trailing_cr($line));
            }

            $i = $i + 1;
        }

        usize $left = $end - $w->pos;

        if ($left > 0) {
            ptr<const uint8> $src = $w->buf->data();
            $line->append($src:$ + $w->pos, $left);
            $any = true;
        }

        $w->drop();

        usize $got = guard fill_read($io, $w) else ($e) {
            return .error($e);
        }

        if ($got == 0) {
            if ($any) {
                return .ok(without_trailing_cr($line));
            }

            return .ok(null);
        }

        $any = true;
    }
}

internal function readall_from(raw_end $io, readwin& $w) : result<string, ioerror>
{
    string $out = '';
    $w->take_pending($out);
    $out->reserve(IO_BUF);

    while (true) {
        if ($out->room() < IO_BUF) {
            $out->reserve($out->size() + IO_BUF);
        }

        ptr<uint8> $dst = $out->spare();
        usize $room = $out->room();
        isize $got = raw_read($io, $dst, $room);

        if ($got < 0) {
            return .error(last_error());
        }

        if ($got == 0) {
            break;
        }

        $out->commit(as_usize($got));
    }

    return .ok($out);
}

internal function rewind_unread(raw_end $io, readwin& $w) : result<usize, ioerror>
{
    usize $unread = $w->pending();

    if ($unread == 0) {
        $w->drop();

        return .ok(0);
    }

    int64 $delta = $unread;
    int64 $at = raw_seek($io, 0 - $delta, SEEK_CUR);

    if ($at < 0) {
        return .error(last_error());
    }

    $w->drop();

    return .ok(0);
}
