/**
 * A directory as a stream of entries, and the two verbs that make one.
 *
 * `opendir` then `foreach` is the whole of listing. `.` and `..` are skipped.
 * Kind comes from what the listing already knew, not from a second `stat`.
 * There is no recursive walk: one directory, its children, and you recurse.
 */

namespace std::fs;

/**
 * What kind of thing a path names.
 *
 * One answer for a directory listing and for `info`. `unknown` is a listing whose filesystem
 * declined to say - `info` always knows, so it never answers it. `symlink` is the link itself,
 * which only a listing and `linkinfo` can see: `info` follows it. `other` is something that is
 * none of these: a socket, a pipe, a device.
 */
public enum filekind
{
    case unknown;
    case file;
    case directory;
    case symlink;
    case other;
}

/**
 * One child of a directory: a name, a joined path, and what kind of child it is.
 *
 * `path()` is `std::fs::path` join of the opened directory and the name. It is not
 * canonical, and it is not absolute just because you asked: `opendir('foo')`
 * yields `foo/bar`.
 */
public struct dirent
{
    private string $name;
    private path $path;
    private filekind $kind;

    internal constructor(string $name, path $path, filekind $kind)
    {
        $this->name = $name;
        $this->path = $path;
        $this->kind = $kind;
    }

    const function name() : string
    {
        return $this->name;
    }

    const function path() : path
    {
        return $this->path;
    }

    const function kind() : filekind
    {
        return $this->kind;
    }

    const function is_file() : bool
    {
        if ($this->kind == filekind::file) {
            return true;
        }

        return false;
    }

    const function is_directory() : bool
    {
        if ($this->kind == filekind::directory) {
            return true;
        }

        return false;
    }
}

internal function is_dot_name(const string& $name) : bool
{
    if ($name == '.') {
        return true;
    }

    if ($name == '..') {
        return true;
    }

    return false;
}

#[if: os != windows]
internal function kind_from_dtype(uint8 $dt) : filekind
{
    if ($dt == std::io::DT_REG) {
        return filekind::file;
    }

    if ($dt == std::io::DT_DIR) {
        return filekind::directory;
    }

    if ($dt == std::io::DT_LNK) {
        return filekind::symlink;
    }

    if ($dt == std::io::DT_UNKNOWN) {
        return filekind::unknown;
    }

    return filekind::other;
}

// the file-type half of a `stat` mode. `info`'s answer, so never `unknown`
internal function kind_of_mode(uint32 $mode) : filekind
{
    uint32 $type = $mode & std::io::S_IFMT;

    if ($type == std::io::S_IFREG) {
        return filekind::file;
    }

    if ($type == std::io::S_IFDIR) {
        return filekind::directory;
    }

    if ($type == std::io::S_IFLNK) {
        return filekind::symlink;
    }

    return filekind::other;
}
#[end]

#[if: os == windows]
// `$tag` is the reparse tag, read only when the attributes say reparse point. a link is a link; a
// cloud placeholder or a deduplicated file is a reparse point that is still the file it stands for
internal function kind_from_attributes(uint32 $attr, uint32 $tag) : filekind
{
    if (($attr & std::io::FILE_ATTRIBUTE_REPARSE_POINT) != 0) {
        if ($tag == std::io::IO_REPARSE_TAG_SYMLINK || $tag == std::io::IO_REPARSE_TAG_MOUNT_POINT) {
            return filekind::symlink;
        }
    }

    if (($attr & std::io::FILE_ATTRIBUTE_DIRECTORY) != 0) {
        return filekind::directory;
    }

    return filekind::file;
}

#[end]

/**
 * An owned directory stream. Last handle closes it.
 *
 * `iterate()` does not rewind. A second `foreach` over the same `dir` sees
 * whatever the first one did not consume, which for a finished loop is nothing.
 */
public class dir : contract::iterable<dirent>
{
    private ptr<uint8> $handle;
    private path $root;
    private std::io::ioerror? $err;

#[if: os == windows]
    private ptr<uint8> $find;
    private bool $pending;
#[end]

#[if: os == windows]
    private constructor(ptr<uint8> $handle, path $root, ptr<uint8> $find)
    {
        $this->handle:$ = $handle;
        $this->root = $root;
        $this->err = null;
        $this->find:$ = $find;
        $this->pending = true;
    }
#[else]
    private constructor(ptr<uint8> $handle, path $root)
    {
        $this->handle:$ = $handle;
        $this->root = $root;
        $this->err = null;
    }
#[end]

    destructor()
    {
        $this->close();
    }

    static function open(const path& $path) : result<dir, std::io::ioerror>
    {
#[if: os == windows]
        std::env::wide_string $wide = std::env::wide_string();
        if (!$wide->load_utf8($path->string())) {
            return .error(std::io::wide_error());
        }

        uint32 $attr = std::io::c_GetFileAttributesW($wide->data());

        if ($attr == std::io::INVALID_FILE_ATTRIBUTES) {
            return .error(std::io::win32_ioerror());
        }

        if (($attr & std::io::FILE_ATTRIBUTE_DIRECTORY) == 0) {
            return .error(std::io::ioerror(std::io::ENOTDIR));
        }

        std::env::wide_string $pat = std::env::wide_string();
        if (!$pat->load_utf8(($path / '*')->string())) {
            return .error(std::io::wide_error());
        }

        ptr<uint8> $find = mem::alloc<uint8>(std::io::FIND_DATA_BYTES);

        if ($find:$ == null) {
            return .error(std::io::ioerror(std::io::ENOMEM));
        }

        ptr<uint8> $h = std::io::c_FindFirstFileW($pat->data(), $find);

        if (std::io::invalid_handle($h)) {
            mem::free<uint8>($find);
            return .error(std::io::win32_ioerror());
        }

        return .ok(dir($h, $path, $find));
#[else]
        ptr<uint8> $h = std::io::c_opendir($path->cstr());

        if ($h:$ == null) {
            return .error(std::io::last_error());
        }

        return .ok(dir($h, $path));
#[end]
    }

    /**
     * Null unless a `readdir` after a successful open failed. End of the
     * directory is not an error.
     */
    const function error() : std::io::ioerror?
    {
        return $this->err;
    }

    function close() : void
    {
        if ($this->handle:$ == null) {
            return;
        }

#[if: os == windows]
        std::io::c_FindClose($this->handle);

        if ($this->find:$ != null) {
            mem::free<uint8>($this->find);
            $this->find:$ = ptr<uint8>(null);
        }

        $this->pending = false;
#[else]
        std::io::c_closedir($this->handle);
#[end]

        $this->handle:$ = ptr<uint8>(null);
    }

    function iterate() : dir_iterator
    {
        $this->err = null;
        return dir_iterator($this);
    }

    internal function note_error(std::io::ioerror $e) : void
    {
        $this->err = $e;
    }

    internal function pull() : dirent?
    {
        if ($this->handle:$ == null) {
            return null;
        }

#[if: os == windows]
        while (true) {
            if (!$this->pending) {
                if (std::io::c_FindNextFileW($this->handle, $this->find) == 0) {
                    if (std::io::c_GetLastError() != std::io::ERROR_NO_MORE_FILES) {
                        $this->note_error(std::io::win32_ioerror());
                    }

                    return null;
                }
            }

            $this->pending = false;

            ptr<uint32> $attrs = ptr<uint32>($this->find:$);
            uint32 $attr = $attrs:$[0];
            ptr<uint32> $tags = ptr<uint32>($this->find:$ + std::io::FIND_TAG_OFF);
            uint32 $tag = $tags:$[0];
            ptr<uint16> $wname = ptr<uint16>($this->find:$ + std::io::FIND_NAME_OFF);
            string $name = guard std::env::wide_to_utf8($wname) else {
                $this->note_error(std::io::wide_error());
                return null;
            }

            if (is_dot_name($name)) {
                continue;
            }

            return dirent($name, $this->root / $name, kind_from_attributes($attr, $tag));
        }
#[else]
        while (true) {
            ptr<int32> $slot = std::io::c_errno_location();
            $slot:$[0] = 0;

            ptr<uint8> $ent = std::io::c_readdir($this->handle);

            if ($ent:$ == null) {
                int32 $code = $slot:$[0];

                if ($code != 0) {
                    $this->note_error(std::io::ioerror($code));
                }

                return null;
            }

            string $name = str::from($ent:$ + std::io::DIRENT_NAME_OFF);

            if (is_dot_name($name)) {
                continue;
            }

            uint8 $dt = $ent:$[std::io::DIRENT_TYPE_OFF];
            return dirent($name, $this->root / $name, kind_from_dtype($dt));
        }
#[end]
    }
}

/**
 * The cursor a `dir` hands `foreach`. `current()` borrows a field of this
 * value, so there is somewhere to point; `range_iterator` is the same shape.
 */
public struct dir_iterator : contract::iterator<dirent>
{
    private dir $src;
    private dirent $current;
    private bool $done;

    constructor(dir $src)
    {
        $this->src = $src;
        $this->current = dirent('', path(''), filekind::unknown);
        $this->done = false;
    }

    function advance() : bool
    {
        if ($this->done) {
            return false;
        }

        dirent? $next = $this->src->pull();
        dirent $entry = guard $next else {
            $this->done = true;
            return false;
        }

        $this->current = $entry;
        return true;
    }

    function current() : dirent&
    {
        return &$this->current;
    }
}

