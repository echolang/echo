/**
 * Every C symbol this module binds, in one file.
 *
 * A C symbol may only be declared once per module - two `extern` blocks naming `write` with
 * different signatures are two declarations of one thing that nothing checks against each other -
 * so they are gathered here rather than sitting beside the code that calls them. The `c_` prefix
 * is a reader's convention and nothing more.
 *
 * **`internal` on the block, which belongs to every declaration in it.** What a program reaches is
 * `std::io::stdout` and the functions beside it; the syscalls are this module's own business. Not
 * `private`, because that is the file axis and the whole point of this file is that stream.eco calls
 * them - `internal` is the level they always had, said out loud.
 */

namespace std::io;

#[if: family != windows]
internal extern {
    // the raw, unbuffered writes and reads. deliberately **not** `fwrite`/`fread`: a `string` need
    // not be NUL-terminated, its length is always known, and a second layer of buffering under one
    // that already exists is two places for output to be sitting when a program dies
    function write as c_write(int32 $fd, ptr<const uint8> $buf, usize $count) : isize;
    function read as c_read(int32 $fd, ptr<uint8> $buf, usize $count) : isize;

    // `fflush(null)` flushes every stdio stream, which is the one thing this module needs from
    // stdio: the `echo` statement writes through `printf`, and printf is buffered
    function fflush as c_fflush(ptr<uint8> $stream) : int32;

    // C's `open` is variadic: the mode is only consumed when O_CREAT is set. declaring it as a
    // fixed third parameter left the file with mode 0 on Darwin - write through the fd worked,
    // open-for-read then said EACCES
    function open as c_open(ptr<const uint8> $path, int32 $flags, variadic_args $args) : int32;
    function close as c_close(int32 $fd) : int32;
    function lseek as c_lseek(int32 $fd, int64 $offset, int32 $whence) : int64;
    function unlink as c_unlink(ptr<const uint8> $path) : int32;
    function rename as c_rename(ptr<const uint8> $from, ptr<const uint8> $to) : int32;
    function access as c_access(ptr<const uint8> $path, int32 $amode) : int32;
    function strerror as c_strerror(int32 $code) : ptr<uint8>;

    function isatty as c_isatty(int32 $fd) : int32;
    function ioctl as c_ioctl(int32 $fd, usize $request, variadic_args $args) : int32;

    function opendir as c_opendir(ptr<const uint8> $path) : ptr<uint8>;
    function readdir as c_readdir(ptr<uint8> $dir) : ptr<uint8>;
    function closedir as c_closedir(ptr<uint8> $dir) : int32;
    function mkdir as c_mkdir(ptr<const uint8> $path, uint32 $mode) : int32;
    function rmdir as c_rmdir(ptr<const uint8> $path) : int32;

    // `mode_t` is 16 bits on Darwin and 32 elsewhere. a mode never has a bit above 07777, so a
    // `uint32` holding one is the zero-extended value either ABI expects in the register
    function chmod as c_chmod(ptr<const uint8> $path, uint32 $mode) : int32;
    function fchmod as c_fchmod(int32 $fd, uint32 $mode) : int32;
    function ftruncate as c_ftruncate(int32 $fd, int64 $length) : int32;

    // the caller's buffer, never the malloc'd one a null second argument asks for: that one is
    // libc's allocation, and this module frees through `mem::`
    function realpath as c_realpath(ptr<const uint8> $path, ptr<uint8> $resolved) : ptr<uint8>;
}
#[end]

// `struct stat` as Darwin's 64-bit-inode `stat`/`lstat`/`fstat` write it - the only layout those
// symbols have on arm64, and the one `readdir`'s offsets below assume too. 144 bytes. libc writes
// every byte of it, so every field is declared, the padding included
#[if: family == darwin]
internal struct stat_buf
{
    int32 $dev = 0;
    uint16 $mode = 0;
    uint16 $nlink = 0;
    uint64 $ino = 0;
    uint32 $uid = 0;
    uint32 $gid = 0;
    int32 $rdev = 0;
    int32 $pad0 = 0;
    int64 $atime_sec = 0;
    int64 $atime_nsec = 0;
    int64 $mtime_sec = 0;
    int64 $mtime_nsec = 0;
    int64 $ctime_sec = 0;
    int64 $ctime_nsec = 0;
    int64 $birthtime_sec = 0;
    int64 $birthtime_nsec = 0;
    int64 $size = 0;
    int64 $blocks = 0;
    int32 $blksize = 0;
    uint32 $flags = 0;
    uint32 $gen = 0;
    int32 $lspare = 0;
    int64[2] $qspare;

    constructor()
    {
    }
}
#[elif: family == wasi]
// wasi-libc `__struct_stat.h` on wasm32: `long` is 32 bits, so `st_blksize` and each `tv_nsec`
// are an `int32` the next 8-byte field pads after. 144 bytes
internal struct stat_buf
{
    uint64 $dev = 0;
    uint64 $ino = 0;
    uint64 $nlink = 0;
    uint32 $mode = 0;
    uint32 $uid = 0;
    uint32 $gid = 0;
    uint32 $pad0 = 0;
    uint64 $rdev = 0;
    int64 $size = 0;
    int32 $blksize = 0;
    int32 $pad1 = 0;
    int64 $blocks = 0;
    int64 $atime_sec = 0;
    int32 $atime_nsec = 0;
    int32 $atime_pad = 0;
    int64 $mtime_sec = 0;
    int32 $mtime_nsec = 0;
    int32 $mtime_pad = 0;
    int64 $ctime_sec = 0;
    int32 $ctime_nsec = 0;
    int32 $ctime_pad = 0;
    int64[3] $reserved;

    constructor()
    {
    }
}
#[end]

#[if: family == darwin || family == wasi]
internal extern {
    function stat as c_stat(ptr<const uint8> $path, ptr<stat_buf> $out) : int32;
    function lstat as c_lstat(ptr<const uint8> $path, ptr<stat_buf> $out) : int32;
    function fstat as c_fstat(int32 $fd, ptr<stat_buf> $out) : int32;
}
#[end]

#[if: family == darwin]
internal extern {
    // `copyfile_state_t` is an opaque pointer; null asks for none
    function fcopyfile as c_fcopyfile(int32 $from, int32 $to, ptr<uint8> $state, uint32 $flags) : int32;
}
#[end]

// Linux reads file info through `statx` rather than `stat`: `struct stat` is a different layout on
// x86_64 and arm64, and glibc before 2.33 exports no `stat` symbol at all - it was an inline over
// `__xstat`. `struct statx` is the kernel's, one layout on every arch, 256 bytes. The tail is
// declared because the kernel writes it. Named `stat_buf` like the other families' so the code
// that only passes one around is written once
#[if: family == linux]
internal struct stat_buf
{
    uint32 $mask = 0;
    uint32 $blksize = 0;
    uint64 $attributes = 0;
    uint32 $nlink = 0;
    uint32 $uid = 0;
    uint32 $gid = 0;
    uint16 $mode = 0;
    uint16 $spare0 = 0;
    uint64 $ino = 0;
    uint64 $size = 0;
    uint64 $blocks = 0;
    uint64 $attributes_mask = 0;
    int64 $atime_sec = 0;
    uint32 $atime_nsec = 0;
    int32 $atime_pad = 0;
    int64 $btime_sec = 0;
    uint32 $btime_nsec = 0;
    int32 $btime_pad = 0;
    int64 $ctime_sec = 0;
    uint32 $ctime_nsec = 0;
    int32 $ctime_pad = 0;
    int64 $mtime_sec = 0;
    uint32 $mtime_nsec = 0;
    int32 $mtime_pad = 0;
    uint32 $rdev_major = 0;
    uint32 $rdev_minor = 0;
    uint32 $dev_major = 0;
    uint32 $dev_minor = 0;
    uint64 $mnt_id = 0;
    uint32 $dio_mem_align = 0;
    uint32 $dio_offset_align = 0;
    uint64[12] $spare;

    constructor()
    {
    }
}

internal extern {
    function statx as c_statx(
        int32 $dirfd, ptr<const uint8> $path, int32 $flags, uint32 $mask, ptr<stat_buf> $out) : int32;
    function copy_file_range as c_copy_file_range(
        int32 $in, ptr<int64> $in_off, int32 $out, ptr<int64> $out_off, usize $len, uint32 $flags) : isize;
}

internal const int32 AT_FDCWD = -100;
internal const int32 AT_SYMLINK_NOFOLLOW = 256;
internal const int32 AT_EMPTY_PATH = 4096;

// STATX_BASIC_STATS | STATX_BTIME. what the kernel actually filled comes back in `$mask`
internal const uint32 STATX_WANTED = 4095;
internal const uint32 STATX_BTIME = 2048;

// the errors `copy_file_range` answers for "not between these two files", which is what sends
// `copy` back to a read/write loop. Linux numbers - Darwin's ENOSYS is 78 - so they live here,
// beside the one call that can return them
internal const int32 EXDEV = 18;
internal const int32 ENOSYS = 38;
internal const int32 EOPNOTSUPP = 95;
#[end]

#[if: os == windows]
// UCRT: `_write`/`_read` return `int` and take `unsigned int` counts. wrapping
// them keeps the rest of the module on `isize`/`usize` the way POSIX does.
// `O_BINARY` is or'd in `flags_of` - text mode would eat `\n`
internal extern {
    function _write as c_write_raw(int32 $fd, ptr<const uint8> $buf, uint32 $count) : int32;
    function _read as c_read_raw(int32 $fd, ptr<uint8> $buf, uint32 $count) : int32;
    function fflush as c_fflush(ptr<uint8> $stream) : int32;
    function _open as c_open(ptr<const uint8> $path, int32 $flags, variadic_args $args) : int32;
    function _close as c_close(int32 $fd) : int32;
    function _lseeki64 as c_lseek(int32 $fd, int64 $offset, int32 $whence) : int64;
    function _unlink as c_unlink(ptr<const uint8> $path) : int32;
    function rename as c_rename(ptr<const uint8> $from, ptr<const uint8> $to) : int32;
    function _access as c_access(ptr<const uint8> $path, int32 $amode) : int32;
    function strerror as c_strerror(int32 $code) : ptr<uint8>;
    function _errno as c_errno_location() : ptr<int32>;

    // fd → HANDLE. the console APIs below take a handle, and `_write` of UTF-8
    // to that handle is decoded as OEM (850, 437), which is why `c_write` goes
    // through `console_write` first. pinned in the JIT next to `_write` for
    // the same msvcrt-vs-UCRT reason
    function _get_osfhandle as c_get_osfhandle(int32 $fd) : ptr<uint8>;
    function _isatty as c_isatty(int32 $fd) : int32;
}

// layout matches Win32 CONSOLE_SCREEN_BUFFER_INFO: SHORT is int16, WORD is
// uint16, no padding on this compiler. columns() reads srWindow, not dwSize
internal struct console_coord
{
    int16 $x;
    int16 $y;
}

internal struct console_rect
{
    int16 $left;
    int16 $top;
    int16 $right;
    int16 $bottom;
}

internal struct console_screen_buffer_info
{
    console_coord $size;
    console_coord $cursor;
    uint16 $attributes;
    console_rect $window;
    console_coord $max_window;
}

internal extern {
    function GetConsoleMode as c_GetConsoleMode(ptr<uint8> $h, ptr<uint32> $mode) : int32;
    function SetConsoleMode as c_SetConsoleMode(ptr<uint8> $h, uint32 $mode) : int32;
    function WriteConsoleW as c_WriteConsoleW(
        ptr<uint8> $h,
        ptr<uint16> $text,
        uint32 $n,
        ptr<uint32> $written,
        ptr<uint8> $reserved
    ) : int32;
    function GetConsoleScreenBufferInfo as c_GetConsoleScreenBufferInfo(
        ptr<uint8> $h,
        ptr<console_screen_buffer_info> $info
    ) : int32;

    function FindFirstFileW as c_FindFirstFileW(
        ptr<uint16> $pattern, ptr<uint8> $data) : ptr<uint8>;
    function FindNextFileW as c_FindNextFileW(
        ptr<uint8> $h, ptr<uint8> $data) : int32;
    function FindClose as c_FindClose(ptr<uint8> $h) : int32;
    function GetFileAttributesW as c_GetFileAttributesW(ptr<uint16> $path) : uint32;
    function GetLastError as c_GetLastError() : uint32;

    function _wopen as c_wopen(ptr<uint16> $path, int32 $flags, variadic_args $args) : int32;
    function _wunlink as c_wunlink(ptr<uint16> $path) : int32;
    function _wrename as c_wrename(ptr<uint16> $from, ptr<uint16> $to) : int32;
    function _waccess as c_waccess(ptr<uint16> $path, int32 $amode) : int32;
    function _wmkdir as c_wmkdir(ptr<uint16> $path) : int32;
    function _wrmdir as c_wrmdir(ptr<uint16> $path) : int32;

    // file info, `realpath` and `copy`. kernel32, not the CRT, so none of these needs a JIT pin
    function CreateFileW as c_CreateFileW(
        ptr<uint16> $name,
        uint32 $access,
        uint32 $share,
        ptr<uint8> $security,
        uint32 $disposition,
        uint32 $flags,
        ptr<uint8> $template
    ) : ptr<uint8>;
    function CloseHandle as c_CloseHandle(ptr<uint8> $h) : int32;
    function GetFileInformationByHandle as c_GetFileInformationByHandle(
        ptr<uint8> $h, ptr<handle_info> $info) : int32;
    function GetFileInformationByHandleEx as c_GetFileInformationByHandleEx(
        ptr<uint8> $h, int32 $class, ptr<attribute_tag_info> $info, uint32 $size) : int32;
    function GetFinalPathNameByHandleW as c_GetFinalPathNameByHandleW(
        ptr<uint8> $h, ptr<uint16> $path, uint32 $count, uint32 $flags) : uint32;
    function GetFullPathNameW as c_GetFullPathNameW(
        ptr<uint16> $file, uint32 $count, ptr<uint16> $buf, ptr<uint8> $file_part) : uint32;
    function SetFileInformationByHandle as c_SetFileInformationByHandle(
        ptr<uint8> $h, int32 $class, ptr<basic_info> $info, uint32 $size) : int32;
    function CopyFileW as c_CopyFileW(ptr<uint16> $from, ptr<uint16> $to, int32 $fail_if_exists) : int32;
}

// BY_HANDLE_FILE_INFORMATION. a FILETIME is two DWORDs and 4-byte aligned, so it is spelled as
// two `uint32`s - a `uint64` would pad the struct out of shape. 52 bytes
internal struct handle_info
{
    uint32 $attributes = 0;
    uint32 $created_lo = 0;
    uint32 $created_hi = 0;
    uint32 $accessed_lo = 0;
    uint32 $accessed_hi = 0;
    uint32 $written_lo = 0;
    uint32 $written_hi = 0;
    uint32 $volume = 0;
    uint32 $size_hi = 0;
    uint32 $size_lo = 0;
    uint32 $links = 0;
    uint32 $index_hi = 0;
    uint32 $index_lo = 0;

    constructor()
    {
    }
}

// FILE_ATTRIBUTE_TAG_INFO: which kind of reparse point a handle opened without following one is
internal struct attribute_tag_info
{
    uint32 $attributes = 0;
    uint32 $tag = 0;

    constructor()
    {
    }
}

// FILE_BASIC_INFO. times left 0 mean "do not change"; chmod writes only `$attributes`. 40 bytes
internal struct basic_info
{
    int64 $created = 0;
    int64 $accessed = 0;
    int64 $written = 0;
    int64 $changed = 0;
    uint32 $attributes = 0;
    uint32 $pad = 0;

    constructor()
    {
    }
}

// a console is not `_write`. `console_write` answers the byte count it
// displayed, or -1 when `$fd` is a pipe or a file and `_write` should run
internal function c_write(int32 $fd, ptr<const uint8> $buf, usize $count) : isize
{
    isize $n = console_write($fd, $buf, $count);

    if ($n >= 0) {
        return $n;
    }

    return c_write_raw($fd, $buf, $count as uint32) as isize;
}

internal function c_read(int32 $fd, ptr<uint8> $buf, usize $count) : isize
{
    return c_read_raw($fd, $buf, $count as uint32) as isize;
}
#[end]

// errno is a thread-local behind a function, and the function's name is the platform. read the
// int it points at immediately - nothing else in the caller may touch libc first
#[if: family == darwin]
internal extern {
    function __error as c_errno_location() : ptr<int32>;
}
#[elif: family == linux || family == wasi]
internal extern {
    function __errno_location as c_errno_location() : ptr<int32>;
}
#[end]

// `O_*` values are not the same number on Darwin, Linux and Windows. the rest of this module names
// these constants and never the literals, so a flag used on the wrong host is a missing-symbol
// problem at compile time rather than a silent wrong open
#[if: family == darwin]
internal const int32 O_RDONLY = 0;
internal const int32 O_WRONLY = 1;
internal const int32 O_RDWR = 2;
internal const int32 O_APPEND = 8;
internal const int32 O_CREAT = 512;
internal const int32 O_TRUNC = 1024;
internal const int32 O_CLOEXEC = 16777216;
internal const int32 O_BINARY = 0;
#[elif: family == linux]
internal const int32 O_RDONLY = 0;
internal const int32 O_WRONLY = 1;
internal const int32 O_RDWR = 2;
internal const int32 O_CREAT = 64;
internal const int32 O_TRUNC = 512;
internal const int32 O_APPEND = 1024;
internal const int32 O_CLOEXEC = 524288;
internal const int32 O_BINARY = 0;
#[elif: os == windows]
internal const int32 O_RDONLY = 0;
internal const int32 O_WRONLY = 1;
internal const int32 O_RDWR = 2;
internal const int32 O_APPEND = 8;
internal const int32 O_CREAT = 256;
internal const int32 O_TRUNC = 512;
internal const int32 O_CLOEXEC = 0;
internal const int32 O_BINARY = 32768;
#[elif: family == wasi]
// wasi-libc `__header_fcntl.h`. O_RDWR is the two access bits or'd, not 2
internal const int32 O_APPEND = 1;
internal const int32 O_CREAT = 4096;
internal const int32 O_TRUNC = 32768;
internal const int32 O_RDONLY = 67108864;
internal const int32 O_WRONLY = 268435456;
internal const int32 O_RDWR = 335544320;
internal const int32 O_CLOEXEC = 0;
internal const int32 O_BINARY = 0;
#[else]
internal const int32 O_RDONLY = 0;
internal const int32 O_WRONLY = 1;
internal const int32 O_RDWR = 2;
internal const int32 O_CREAT = 64;
internal const int32 O_TRUNC = 512;
internal const int32 O_APPEND = 1024;
internal const int32 O_CLOEXEC = 524288;
internal const int32 O_BINARY = 0;
#[end]

// POSIX numbers on Darwin/Linux/Windows. wasi-libc's `__errno_values.h` is a
// different table (ENOENT is 44, EACCES is 2)
#[if: family == wasi]
internal const int32 EPERM = 63;
internal const int32 ENOENT = 44;
internal const int32 EBADF = 8;
internal const int32 ENOMEM = 48;
internal const int32 EACCES = 2;
internal const int32 EEXIST = 20;
internal const int32 ENOTDIR = 54;
internal const int32 EISDIR = 31;
internal const int32 EINVAL = 28;
#[else]
internal const int32 EPERM = 1;
internal const int32 ENOENT = 2;
internal const int32 EBADF = 9;
internal const int32 ENOMEM = 12;
internal const int32 EACCES = 13;
internal const int32 EEXIST = 17;
internal const int32 ENOTDIR = 20;
internal const int32 EISDIR = 21;
internal const int32 EINVAL = 22;
#[end]

// the file-type half of a mode. the same numbers on Darwin, Linux and wasi-libc
internal const uint32 S_IFMT = 61440;
internal const uint32 S_IFDIR = 16384;
internal const uint32 S_IFREG = 32768;
internal const uint32 S_IFLNK = 40960;

// the permission half: rwx for owner, group and other, then setuid, setgid and sticky
internal const uint32 PERM_BITS = 4095;
internal const uint32 S_IRUSR = 256;
internal const uint32 S_IWUSR = 128;
internal const uint32 S_IXUSR = 64;
internal const uint32 S_IRGRP = 32;
internal const uint32 S_IWGRP = 16;
internal const uint32 S_IXGRP = 8;
internal const uint32 S_IROTH = 4;
internal const uint32 S_IWOTH = 2;
internal const uint32 S_IXOTH = 1;

#[if: family == darwin]
internal const usize PATH_MAX = 1024;
internal const uint32 COPYFILE_DATA = 8;
#[elif: family == linux || family == wasi]
internal const usize PATH_MAX = 4096;
#[end]

internal const int32 SEEK_SET = 0;
internal const int32 SEEK_CUR = 1;
internal const int32 SEEK_END = 2;

internal const int32 F_OK = 0;

// 0666. the umask takes its usual cut
internal const uint32 OPEN_MODE = 438;

// 0777. mkdir's bargain with the umask, matching open's 0666
internal const uint32 MKDIR_MODE = 511;

internal const usize IO_BUF = 8192;

internal const uint8 LINE_FEED = 10;
internal const uint8 CARRIAGE_RETURN = 13;

#[if: family != windows]
internal struct winsize
{
    uint16 $row;
    uint16 $col;
    uint16 $xpixel;
    uint16 $ypixel;
}
#[end]

#[if: family == darwin]
internal const usize TIOCGWINSZ = 1074295912;
#[elif: family == linux]
internal const usize TIOCGWINSZ = 21523;
#[end]

// `struct dirent` is a FAM; Echo has no fixed-size array, so listing copies
// `d_name` at a platform offset rather than declaring the type. ABI-stable
// on every libc this compiler targets, and the listing tests pin the name.
#[if: family == darwin]
internal const usize DIRENT_TYPE_OFF = 20;
internal const usize DIRENT_NAME_OFF = 21;
#[elif: family == linux]
internal const usize DIRENT_TYPE_OFF = 18;
internal const usize DIRENT_NAME_OFF = 19;
#[elif: family == wasi]
// wasi-libc `struct dirent`: ino_t (8) then unsigned char d_type, then d_name[]
internal const usize DIRENT_TYPE_OFF = 8;
internal const usize DIRENT_NAME_OFF = 9;
#[elif: family != windows]
internal const usize DIRENT_TYPE_OFF = 18;
internal const usize DIRENT_NAME_OFF = 19;
#[end]

#[if: family == wasi]
// wasi-libc `__header_dirent.h`: DT_DIR = 3, DT_REG = 4, DT_LNK = 7
internal const uint8 DT_UNKNOWN = 0;
internal const uint8 DT_DIR = 3;
internal const uint8 DT_REG = 4;
internal const uint8 DT_LNK = 7;
#[elif: family != windows]
internal const uint8 DT_UNKNOWN = 0;
internal const uint8 DT_DIR = 4;
internal const uint8 DT_REG = 8;
internal const uint8 DT_LNK = 10;
#[end]

#[if: os == windows]
// WIN32_FIND_DATAW without the `_MAC` tail. `cFileName` is WCHAR[260] at 44. `dwReserved0` at 36
// is the reparse tag, meaningful only when the attributes say reparse point
internal const usize FIND_DATA_BYTES = 592;
internal const usize FIND_NAME_OFF = 44;
internal const usize FIND_TAG_OFF = 36;
internal const uint32 FILE_ATTRIBUTE_READONLY = 1;
internal const uint32 FILE_ATTRIBUTE_DIRECTORY = 16;
internal const uint32 FILE_ATTRIBUTE_NORMAL = 128;
internal const uint32 FILE_ATTRIBUTE_REPARSE_POINT = 1024;
// the two reparse tags that are a link to somewhere else. every other tag - a cloud placeholder,
// a deduplicated file - is the file itself, and answers as one
internal const uint32 IO_REPARSE_TAG_MOUNT_POINT = 2684354563;
internal const uint32 IO_REPARSE_TAG_SYMLINK = 2684354572;
// FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE: asking about a file must not lock it
internal const uint32 FILE_SHARE_ALL = 7;
internal const uint32 OPEN_EXISTING = 3;
// without it CreateFileW refuses a directory
internal const uint32 FILE_FLAG_BACKUP_SEMANTICS = 33554432;
internal const uint32 FILE_FLAG_OPEN_REPARSE_POINT = 2097152;
internal const int32 FILE_ATTRIBUTE_TAG_INFO_CLASS = 9;
internal const int32 FILE_BASIC_INFO_CLASS = 0;
internal const uint32 FILE_WRITE_ATTRIBUTES = 256;
internal const uint32 MAX_PATH = 260;
internal const uint32 INVALID_FILE_ATTRIBUTES = 4294967295;
internal const uint32 ERROR_FILE_NOT_FOUND = 2;
internal const uint32 ERROR_PATH_NOT_FOUND = 3;
internal const uint32 ERROR_ACCESS_DENIED = 5;
internal const uint32 ERROR_NO_MORE_FILES = 18;
internal const uint32 ERROR_ALREADY_EXISTS = 183;
internal const uint32 ERROR_DIRECTORY = 267;
#[end]

/**
 * The `errno` the last failing libc call left, as an `ioerror`.
 *
 * Call this before anything else that might overwrite it.
 */
internal function last_error() : ioerror
{
    ptr<int32> $slot = c_errno_location();
    int32 $code = $slot;

    return ioerror($code);
}

#[if: os == windows]
internal function win32_ioerror() : ioerror
{
    uint32 $w = c_GetLastError();

    if ($w == ERROR_FILE_NOT_FOUND) {
        return ioerror(ENOENT);
    }

    if ($w == ERROR_PATH_NOT_FOUND) {
        return ioerror(ENOENT);
    }

    if ($w == ERROR_DIRECTORY) {
        return ioerror(ENOTDIR);
    }

    if ($w == ERROR_ACCESS_DENIED) {
        return ioerror(EACCES);
    }

    if ($w == ERROR_ALREADY_EXISTS) {
        return ioerror(EEXIST);
    }

    return ioerror(EINVAL);
}

internal function wide_error() : ioerror
{
    uint32 $w = c_GetLastError();

    if ($w == 0) {
        return ioerror(ENOMEM);
    }

    return win32_ioerror();
}
#[end]

internal function open_path(const string& $path, int32 $flags) : result<int32, ioerror>
{
    return open_path($path, $flags, OPEN_MODE);
}

// `$mode` is what a file O_CREAT makes starts with, before the umask
internal function open_path(const string& $path, int32 $flags, uint32 $mode) : result<int32, ioerror>
{
#[if: os == windows]
    std::env::wide_string $wide = std::env::wide_string();
    if (!$wide->load_utf8($path)) {
        return .error(wide_error());
    }

    int32 $fd = c_wopen($wide->data(), $flags, [$mode]);
#[else]
    int32 $fd = c_open($path->cstr(), $flags, [$mode]);
#[end]

    if ($fd < 0) {
        return .error(last_error());
    }

    return .ok($fd);
}

internal function unlink_path(const string& $path) : result<bool, ioerror>
{
#[if: os == windows]
    std::env::wide_string $wide = std::env::wide_string();
    if (!$wide->load_utf8($path)) {
        return .error(wide_error());
    }

    if (c_wunlink($wide->data()) < 0) {
        return .error(last_error());
    }
#[else]
    if (c_unlink($path->cstr()) < 0) {
        return .error(last_error());
    }
#[end]

    return .ok(true);
}

internal function rename_path(const string& $from, const string& $to) : result<bool, ioerror>
{
#[if: os == windows]
    std::env::wide_string $from_w = std::env::wide_string();
    if (!$from_w->load_utf8($from)) {
        return .error(wide_error());
    }

    std::env::wide_string $to_w = std::env::wide_string();
    if (!$to_w->load_utf8($to)) {
        return .error(wide_error());
    }

    if (c_wrename($from_w->data(), $to_w->data()) < 0) {
        return .error(last_error());
    }
#[else]
    if (c_rename($from->cstr(), $to->cstr()) < 0) {
        return .error(last_error());
    }
#[end]

    return .ok(true);
}

internal function access_path(const string& $path, int32 $amode) : result<bool, ioerror>
{
#[if: os == windows]
    std::env::wide_string $wide = std::env::wide_string();
    if (!$wide->load_utf8($path)) {
        return .error(wide_error());
    }

    if (c_waccess($wide->data(), $amode) < 0) {
        return .error(last_error());
    }
#[else]
    if (c_access($path->cstr(), $amode) < 0) {
        return .error(last_error());
    }
#[end]

    return .ok(true);
}

internal function mkdir_path(const string& $path) : result<bool, ioerror>
{
#[if: os == windows]
    std::env::wide_string $wide = std::env::wide_string();
    if (!$wide->load_utf8($path)) {
        return .error(wide_error());
    }

    if (c_wmkdir($wide->data()) < 0) {
        return .error(last_error());
    }
#[else]
    if (c_mkdir($path->cstr(), MKDIR_MODE) < 0) {
        return .error(last_error());
    }
#[end]

    return .ok(true);
}

internal function rmdir_path(const string& $path) : result<bool, ioerror>
{
#[if: os == windows]
    std::env::wide_string $wide = std::env::wide_string();
    if (!$wide->load_utf8($path)) {
        return .error(wide_error());
    }

    if (c_wrmdir($wide->data()) < 0) {
        return .error(last_error());
    }
#[else]
    if (c_rmdir($path->cstr()) < 0) {
        return .error(last_error());
    }
#[end]

    return .ok(true);
}
