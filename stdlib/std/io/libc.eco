/**
 * Every C symbol this module binds, in one file.
 *
 * A C symbol may only be declared once per module - two `extern` blocks naming `write` with
 * different signatures are two declarations of one thing that nothing checks against each other -
 * so they are gathered here rather than sitting beside the code that calls them. The `c_` prefix
 * is a reader's convention and nothing more.
 *
 * **`internal` on the block, which belongs to every declaration in it.** What a program reaches is
 * `std::io::stdout` and the functions beside it; the syscalls are this module's own business. Not
 * `private`, because that is the file axis and the whole point of this file is that stream.eco calls
 * them - `internal` is the level they always had, said out loud.
 */

namespace std::io;

#[if: os != windows]
internal extern {
    // the raw, unbuffered writes and reads. deliberately **not** `fwrite`/`fread`: a `string` need
    // not be NUL-terminated, its length is always known, and a second layer of buffering under one
    // that already exists is two places for output to be sitting when a program dies
    function write as c_write(int32 $fd, ptr<const uint8> $buf, usize $count) : isize;
    function read as c_read(int32 $fd, ptr<uint8> $buf, usize $count) : isize;

    // `fflush(null)` flushes every stdio stream, which is the one thing this module needs from
    // stdio: the `echo` statement writes through `printf`, and printf is buffered
    function fflush as c_fflush(ptr<uint8> $stream) : int32;

    // C's `open` is variadic: the mode is only consumed when O_CREAT is set. declaring it as a
    // fixed third parameter left the file with mode 0 on Darwin - write through the fd worked,
    // open-for-read then said EACCES
    function open as c_open(ptr<const uint8> $path, int32 $flags, variadic_args $args) : int32;
    function close as c_close(int32 $fd) : int32;
    function lseek as c_lseek(int32 $fd, int64 $offset, int32 $whence) : int64;
    function unlink as c_unlink(ptr<const uint8> $path) : int32;
    function rename as c_rename(ptr<const uint8> $from, ptr<const uint8> $to) : int32;
    function access as c_access(ptr<const uint8> $path, int32 $amode) : int32;
    function strerror as c_strerror(int32 $code) : ptr<uint8>;

    function isatty as c_isatty(int32 $fd) : int32;
    function ioctl as c_ioctl(int32 $fd, usize $request, variadic_args $args) : int32;

    function opendir as c_opendir(ptr<const uint8> $path) : ptr<uint8>;
    function readdir as c_readdir(ptr<uint8> $dir) : ptr<uint8>;
    function closedir as c_closedir(ptr<uint8> $dir) : int32;
    function mkdir as c_mkdir(ptr<const uint8> $path, uint32 $mode) : int32;
    function rmdir as c_rmdir(ptr<const uint8> $path) : int32;
}
#[end]

#[if: os == windows]
// UCRT: `_write`/`_read` return `int` and take `unsigned int` counts. wrapping
// them keeps the rest of the module on `isize`/`usize` the way POSIX does.
// `O_BINARY` is or'd in `flags_of` - text mode would eat `\n`
internal extern {
    function _write as c_write_raw(int32 $fd, ptr<const uint8> $buf, uint32 $count) : int32;
    function _read as c_read_raw(int32 $fd, ptr<uint8> $buf, uint32 $count) : int32;
    function fflush as c_fflush(ptr<uint8> $stream) : int32;
    function _open as c_open(ptr<const uint8> $path, int32 $flags, variadic_args $args) : int32;
    function _close as c_close(int32 $fd) : int32;
    function _lseeki64 as c_lseek(int32 $fd, int64 $offset, int32 $whence) : int64;
    function _unlink as c_unlink(ptr<const uint8> $path) : int32;
    function rename as c_rename(ptr<const uint8> $from, ptr<const uint8> $to) : int32;
    function _access as c_access(ptr<const uint8> $path, int32 $amode) : int32;
    function strerror as c_strerror(int32 $code) : ptr<uint8>;
    function _errno as c_errno_location() : ptr<int32>;

    // fd → HANDLE. the console APIs below take a handle, and `_write` of UTF-8
    // to that handle is decoded as OEM (850, 437), which is why `c_write` goes
    // through `console_write` first. pinned in the JIT next to `_write` for
    // the same msvcrt-vs-UCRT reason
    function _get_osfhandle as c_get_osfhandle(int32 $fd) : ptr<uint8>;
    function _isatty as c_isatty(int32 $fd) : int32;
}

// layout matches Win32 CONSOLE_SCREEN_BUFFER_INFO: SHORT is int16, WORD is
// uint16, no padding on this compiler. columns() reads srWindow, not dwSize
internal struct console_coord
{
    int16 $x;
    int16 $y;
}

internal struct console_rect
{
    int16 $left;
    int16 $top;
    int16 $right;
    int16 $bottom;
}

internal struct console_screen_buffer_info
{
    console_coord $size;
    console_coord $cursor;
    uint16 $attributes;
    console_rect $window;
    console_coord $max_window;
}

internal extern {
    function GetConsoleMode as c_GetConsoleMode(ptr<uint8> $h, ptr<uint32> $mode) : int32;
    function SetConsoleMode as c_SetConsoleMode(ptr<uint8> $h, uint32 $mode) : int32;
    function WriteConsoleW as c_WriteConsoleW(
        ptr<uint8> $h,
        ptr<uint16> $text,
        uint32 $n,
        ptr<uint32> $written,
        ptr<uint8> $reserved
    ) : int32;
    function GetConsoleScreenBufferInfo as c_GetConsoleScreenBufferInfo(
        ptr<uint8> $h,
        ptr<console_screen_buffer_info> $info
    ) : int32;

    function FindFirstFileW as c_FindFirstFileW(
        ptr<uint16> $pattern, ptr<uint8> $data) : ptr<uint8>;
    function FindNextFileW as c_FindNextFileW(
        ptr<uint8> $h, ptr<uint8> $data) : int32;
    function FindClose as c_FindClose(ptr<uint8> $h) : int32;
    function GetFileAttributesW as c_GetFileAttributesW(ptr<uint16> $path) : uint32;
    function GetLastError as c_GetLastError() : uint32;

    function _wopen as c_wopen(ptr<uint16> $path, int32 $flags, variadic_args $args) : int32;
    function _wunlink as c_wunlink(ptr<uint16> $path) : int32;
    function _wrename as c_wrename(ptr<uint16> $from, ptr<uint16> $to) : int32;
    function _waccess as c_waccess(ptr<uint16> $path, int32 $amode) : int32;
    function _wmkdir as c_wmkdir(ptr<uint16> $path) : int32;
    function _wrmdir as c_wrmdir(ptr<uint16> $path) : int32;
}

// a console is not `_write`. `console_write` answers the byte count it
// displayed, or -1 when `$fd` is a pipe or a file and `_write` should run
internal function c_write(int32 $fd, ptr<const uint8> $buf, usize $count) : isize
{
    isize $n = console_write($fd, $buf, $count);

    if ($n >= 0) {
        return $n;
    }

    return c_write_raw($fd, $buf, $count as uint32) as isize;
}

internal function c_read(int32 $fd, ptr<uint8> $buf, usize $count) : isize
{
    return c_read_raw($fd, $buf, $count as uint32) as isize;
}
#[end]

// errno is a thread-local behind a function, and the function's name is the platform. read the
// int it points at immediately - nothing else in the caller may touch libc first
#[if: os == darwin]
internal extern {
    function __error as c_errno_location() : ptr<int32>;
}
#[elif: os == linux]
internal extern {
    function __errno_location as c_errno_location() : ptr<int32>;
}
#[end]

// `O_*` values are not the same number on Darwin, Linux and Windows. the rest of this module names
// these constants and never the literals, so a flag used on the wrong host is a missing-symbol
// problem at compile time rather than a silent wrong open
#[if: os == darwin]
internal const int32 O_RDONLY = 0;
internal const int32 O_WRONLY = 1;
internal const int32 O_RDWR = 2;
internal const int32 O_APPEND = 8;
internal const int32 O_CREAT = 512;
internal const int32 O_TRUNC = 1024;
internal const int32 O_CLOEXEC = 16777216;
internal const int32 O_BINARY = 0;
#[elif: os == linux]
internal const int32 O_RDONLY = 0;
internal const int32 O_WRONLY = 1;
internal const int32 O_RDWR = 2;
internal const int32 O_CREAT = 64;
internal const int32 O_TRUNC = 512;
internal const int32 O_APPEND = 1024;
internal const int32 O_CLOEXEC = 524288;
internal const int32 O_BINARY = 0;
#[elif: os == windows]
internal const int32 O_RDONLY = 0;
internal const int32 O_WRONLY = 1;
internal const int32 O_RDWR = 2;
internal const int32 O_APPEND = 8;
internal const int32 O_CREAT = 256;
internal const int32 O_TRUNC = 512;
internal const int32 O_CLOEXEC = 0;
internal const int32 O_BINARY = 32768;
#[else]
internal const int32 O_RDONLY = 0;
internal const int32 O_WRONLY = 1;
internal const int32 O_RDWR = 2;
internal const int32 O_CREAT = 64;
internal const int32 O_TRUNC = 512;
internal const int32 O_APPEND = 1024;
internal const int32 O_CLOEXEC = 524288;
internal const int32 O_BINARY = 0;
#[end]

// these four, and EBADF, agree on every platform this compiler targets
internal const int32 EPERM = 1;
internal const int32 ENOENT = 2;
internal const int32 EBADF = 9;
internal const int32 ENOMEM = 12;
internal const int32 EACCES = 13;
internal const int32 EEXIST = 17;
internal const int32 ENOTDIR = 20;
internal const int32 EINVAL = 22;

internal const int32 SEEK_SET = 0;
internal const int32 SEEK_CUR = 1;
internal const int32 SEEK_END = 2;

internal const int32 F_OK = 0;

// 0666. the umask takes its usual cut
internal const uint32 OPEN_MODE = 438;

// 0777. mkdir's bargain with the umask, matching open's 0666
internal const uint32 MKDIR_MODE = 511;

internal const usize IO_BUF = 8192;

internal const uint8 LINE_FEED = 10;
internal const uint8 CARRIAGE_RETURN = 13;

#[if: os != windows]
internal struct winsize
{
    uint16 $row;
    uint16 $col;
    uint16 $xpixel;
    uint16 $ypixel;
}
#[end]

#[if: os == darwin]
internal const usize TIOCGWINSZ = 1074295912;
#[elif: os == linux]
internal const usize TIOCGWINSZ = 21523;
#[end]

// `struct dirent` is a FAM; Echo has no fixed-size array, so listing copies
// `d_name` at a platform offset rather than declaring the type. ABI-stable
// on every libc this compiler targets, and the listing tests pin the name.
#[if: os == darwin]
internal const usize DIRENT_TYPE_OFF = 20;
internal const usize DIRENT_NAME_OFF = 21;
#[elif: os == linux]
internal const usize DIRENT_TYPE_OFF = 18;
internal const usize DIRENT_NAME_OFF = 19;
#[elif: os != windows]
internal const usize DIRENT_TYPE_OFF = 18;
internal const usize DIRENT_NAME_OFF = 19;
#[end]

#[if: os != windows]
internal const uint8 DT_UNKNOWN = 0;
internal const uint8 DT_DIR = 4;
internal const uint8 DT_REG = 8;
#[end]

#[if: os == windows]
// WIN32_FIND_DATAW without the `_MAC` tail. `cFileName` is WCHAR[260] at 44
internal const usize FIND_DATA_BYTES = 592;
internal const usize FIND_NAME_OFF = 44;
internal const uint32 FILE_ATTRIBUTE_DIRECTORY = 16;
internal const uint32 FILE_ATTRIBUTE_REPARSE_POINT = 1024;
internal const uint32 INVALID_FILE_ATTRIBUTES = 4294967295;
internal const uint32 ERROR_FILE_NOT_FOUND = 2;
internal const uint32 ERROR_PATH_NOT_FOUND = 3;
internal const uint32 ERROR_ACCESS_DENIED = 5;
internal const uint32 ERROR_NO_MORE_FILES = 18;
internal const uint32 ERROR_ALREADY_EXISTS = 183;
internal const uint32 ERROR_DIRECTORY = 267;
#[end]

/**
 * The `errno` the last failing libc call left, as an `ioerror`.
 *
 * Call this before anything else that might overwrite it.
 */
internal function last_error() : ioerror
{
    ptr<int32> $slot = c_errno_location();
    int32 $code = $slot;

    return ioerror($code);
}

#[if: os == windows]
internal function win32_ioerror() : ioerror
{
    uint32 $w = c_GetLastError();

    if ($w == ERROR_FILE_NOT_FOUND) {
        return ioerror(ENOENT);
    }

    if ($w == ERROR_PATH_NOT_FOUND) {
        return ioerror(ENOENT);
    }

    if ($w == ERROR_DIRECTORY) {
        return ioerror(ENOTDIR);
    }

    if ($w == ERROR_ACCESS_DENIED) {
        return ioerror(EACCES);
    }

    if ($w == ERROR_ALREADY_EXISTS) {
        return ioerror(EEXIST);
    }

    return ioerror(EINVAL);
}

internal function wide_error() : ioerror
{
    uint32 $w = c_GetLastError();

    if ($w == 0) {
        return ioerror(ENOMEM);
    }

    return win32_ioerror();
}
#[end]

internal function open_path(const string& $path, int32 $flags) : result<int32, ioerror>
{
#[if: os == windows]
    std::env::wide_string $wide = std::env::wide_string::from_utf8($path);
    if ($wide->empty()) {
        return .error(wide_error());
    }

    int32 $fd = c_wopen($wide->data(), $flags, [OPEN_MODE]);
#[else]
    int32 $fd = c_open($path->cstr(), $flags, [OPEN_MODE]);
#[end]

    if ($fd < 0) {
        return .error(last_error());
    }

    return .ok($fd);
}

internal function unlink_path(const string& $path) : result<bool, ioerror>
{
#[if: os == windows]
    std::env::wide_string $wide = std::env::wide_string::from_utf8($path);
    if ($wide->empty()) {
        return .error(wide_error());
    }

    if (c_wunlink($wide->data()) < 0) {
        return .error(last_error());
    }
#[else]
    if (c_unlink($path->cstr()) < 0) {
        return .error(last_error());
    }
#[end]

    return .ok(true);
}

internal function rename_path(const string& $from, const string& $to) : result<bool, ioerror>
{
#[if: os == windows]
    std::env::wide_string $from_w = std::env::wide_string::from_utf8($from);
    if ($from_w->empty()) {
        return .error(wide_error());
    }

    std::env::wide_string $to_w = std::env::wide_string::from_utf8($to);
    if ($to_w->empty()) {
        return .error(wide_error());
    }

    if (c_wrename($from_w->data(), $to_w->data()) < 0) {
        return .error(last_error());
    }
#[else]
    if (c_rename($from->cstr(), $to->cstr()) < 0) {
        return .error(last_error());
    }
#[end]

    return .ok(true);
}

internal function access_path(const string& $path, int32 $amode) : result<bool, ioerror>
{
#[if: os == windows]
    std::env::wide_string $wide = std::env::wide_string::from_utf8($path);
    if ($wide->empty()) {
        return .error(wide_error());
    }

    if (c_waccess($wide->data(), $amode) < 0) {
        return .error(last_error());
    }
#[else]
    if (c_access($path->cstr(), $amode) < 0) {
        return .error(last_error());
    }
#[end]

    return .ok(true);
}

internal function mkdir_path(const string& $path) : result<bool, ioerror>
{
#[if: os == windows]
    std::env::wide_string $wide = std::env::wide_string::from_utf8($path);
    if ($wide->empty()) {
        return .error(wide_error());
    }

    if (c_wmkdir($wide->data()) < 0) {
        return .error(last_error());
    }
#[else]
    if (c_mkdir($path->cstr(), MKDIR_MODE) < 0) {
        return .error(last_error());
    }
#[end]

    return .ok(true);
}

internal function rmdir_path(const string& $path) : result<bool, ioerror>
{
#[if: os == windows]
    std::env::wide_string $wide = std::env::wide_string::from_utf8($path);
    if ($wide->empty()) {
        return .error(wide_error());
    }

    if (c_wrmdir($wide->data()) < 0) {
        return .error(last_error());
    }
#[else]
    if (c_rmdir($path->cstr()) < 0) {
        return .error(last_error());
    }
#[end]

    return .ok(true);
}
