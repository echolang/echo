/**
 * Caps this module chooses. Kernel numbers and C header values stay in libc.eco.
 */

namespace std::io;

// first size a grow-until-it-fits path buffer starts at, and the cap that turns a stuck
// `getcwd` / `readlink` into `ENOMEM` instead of allocating until the machine gives up
internal const usize PATH_GROW = 256;
internal const usize PATH_GROW_MAX = 65536;

// wchar count for `_wgetcwd` / `GetModuleFileNameW`. 32 KiB of UTF-16 covers a long path
internal const usize WIDE_PATH_MAX = 32768;
