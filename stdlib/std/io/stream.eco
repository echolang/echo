/**
 * A byte stream, named by its file descriptor.
 *
 * Small enough to be a value - one `int32` - which is what makes `std::io::stdout` a constant
 * rather than a function: it is passed, stored and copied like any other number.
 *
 *     std::io::stdout->write('hello');
 *
 *     stream $out = std::io::stdout;
 *     $out->write('hello');
 *
 * **Every write flushes stdio first**, and that is not a performance oversight. The `echo`
 * statement writes scalars through `printf`, which is buffered, and text through `write(2)`, which
 * is not. Without the flush the two interleave wrongly the moment output is a pipe rather than a
 * terminal - which is exactly where anybody notices.
 */

namespace std::io;

public struct stream
{
    // **`private`, which is what the constructor below is for.** the field-wise constructor a struct gets
    // for free is suppressed by a private property, so the one that used to seat this field is written out
    // - identically, so `stream(1)` and a `stream($fd)` over a descriptor of your own both still read as
    // they did. what is closed is `$s->fd = 7`, which re-aimed a stream something else was holding
    private int32 $fd;

    /**
     * A stream over `$fd`. The descriptor is not checked and not owned: closing it is whoever opened it's
     * business, and this type never does.
     */
    constructor(int32 $fd)
    {
        $this->fd = $fd;
    }

    /**
     * The descriptor this stream names.
     */
    const function fd() : int32
    {
        return $this->fd;
    }

    /**
     * Writes `$count` bytes at `$b`, and nothing else - no terminator is read and none is written.
     *
     * The seam every other method here goes through.
     */
    const function write(ptr<const uint8> $b, usize $count) : void
    {
        if ($count == 0) {
            return;
        }

        // stdio first, for the reason in this type's own documentation
        $this->flush();

        // short writes are the normal case on a pipe. fire-and-forget still has to retry them;
        // ignoring a failed write(2) is a different sentence from writing some of the bytes
        result<usize, ioerror> $ignored = raw_write_all($this->fd, $b, $count);
    }

    /**
     * Writes `$text`'s bytes.
     *
     * The window's length, never a terminator: a substring shares its parent's buffer and simply
     * stops early, so `%s` or `strlen` would run off the end of one.
     */
    const function write(const string& $text) : void
    {
        $this->write($text->view()->bytes, $text->size());
    }

    /**
     * Writes `$text` followed by a newline.
     *
     * Two writes rather than one, deliberately: appending the newline to the bytes would mean
     * copying them, and they may be a shared substring with nowhere to put a longer copy.
     *
     * The terminator is `NEWLINE`, not a hardcoded LF: a Windows console treats a lone `\n` as
     * "down one row, same column".
     */
    const function writeline(const string& $text) : void
    {
        $this->write($text);
        $this->write(NEWLINE);
    }

    /**
     * True when this descriptor is a terminal. A pipe, a file, and a closed fd are false.
     * There is no error to recover from: "not a terminal" and "not open" are the same answer.
     */
    const function isatty() : bool
    {
        return c_isatty($this->fd) != 0;
    }

    /**
     * The window width in columns, or 0 when this is not a terminal.
     *
     * On Windows this is the visible window, not the screen-buffer width. `COLUMNS` is a
     * caller policy on top of this, not something the stream reads.
     */
    const function columns() : int32
    {
        if (c_isatty($this->fd) == 0) {
            return 0;
        }

        #[if: os == windows]
        return console_columns($this->fd);
        #[else]
        winsize $ws = winsize(0, 0, 0, 0);

        if (c_ioctl($this->fd, TIOCGWINSZ, [&$ws]) != 0) {
            return 0;
        }

        int32 $col = $ws->col;

        if ($col <= 0) {
            return 0;
        }

        return $col;
        #[end]
    }

    /**
     * Flushes every buffered stdio stream, so anything `echo` has written appears before what this
     * stream writes next.
     */
    const function flush() : void
    {
        c_fflush(null);
    }

    /**
     * The next line, without its newline - or `null` at end of input with nothing read.
     *
     * **Unbuffered: one `read(2)` per byte.** That is slow and it is the only correct choice here.
     * A buffered reader would need somewhere to keep what it read past the newline, and a library
     * module has no mutable state of its own - so the buffer would have to be a value you hold,
     * which is a different type with a different name. It would also over-read, so anything else
     * reading the same descriptor would find its bytes gone.
     *
     * A final line with no newline is answered in full; the `null` is reserved for "there was
     * nothing at all", which is what makes `guard ... else` the right shape to read one with:
     *
     *     string $line = guard std::io::stdin->readline() else { return 0; }
     */
    const function readline() : string?
    {
        str::buf $owner = str::buf(64, 0, mem::alloc<uint8>(65));

        uint8 $byte = 0;
        bool $any = false;

        while (true) {
            isize $got = c_read($this->fd, &$byte, 1);

            if ($got < 1) {
                break;
            }

            $any = true;

            if ($byte == LINE_FEED) {
                break;
            }

            if ($byte == CARRIAGE_RETURN) {
                // CRLF is one ending. a leftover byte has nowhere to live on this
                // type, so a CR that is not followed by LF still ends the line;
                // a stray byte after it is kept on this line rather than dropped
                uint8 $next = 0;
                isize $more = c_read($this->fd, &$next, 1);

                if ($more == 1) {
                    if ($next != LINE_FEED) {
                        $owner->push($next);
                    }
                }

                break;
            }

            $owner->push($byte);
        }

        if (!$any) {
            return null;
        }

        return string(string::view($owner->bytes, $owner->used), $owner);
    }
}

// `writeline` writes this, so a Windows console gets a real newline and a pipe gets the
// same bytes a Windows text file would. `print("foo\n")` still goes through `console_write`'s
// CR-insert on a console; that is the compatibility path for a literal LF, not this constant
#[if: os == windows]
public const NEWLINE = "\r\n";
#[else]
public const NEWLINE = "\n";
#[end]

/**
 * Standard output, file descriptor 1.
 *
 * A **constant**, so it is written without parentheses and can be handed around like the number it
 * is. A constant in Echo is its expression copied into every use site, and this one's expression is
 * `stream(1)` - one `int32`, so copying it is free and there is no shared object to keep alive.
 */
public const stdout = stream(1);

/**
 * Standard error, file descriptor 2. Where diagnostics go, so that piping a program's output
 * somewhere does not swallow them.
 */
public const stderr = stream(2);

/**
 * Standard input, file descriptor 0.
 */
public const stdin = stream(0);
