namespace std::math;

/**
 * The mathematical constants, as compile-time constants.
 *
 * a constant is the expression it was written as, copied into each use site - so these have no storage
 * anywhere and nothing about them is emitted into the stdlib's object. That is the whole reason they can
 * live in a library module at all: a file-scope *variable* here would be parsed, checked and then dropped.
 *
 * every one of these is `float64`, because a float literal is double precision unless it ends in `f`. use
 * the `_F32` spelling where a single-precision value is wanted - `std::math::sqrt(PI)` picks the float64
 * overload and `std::math::sqrt(PI_F32)` the float one, which is the same rule the intrinsics already
 * document rather than a second one for constants.
 */

// ----------------------------------------------------------------------------
// the circle constants
// ----------------------------------------------------------------------------

/**
 * The ratio of a circle's circumference to its diameter.
 */
const float64 PI = 3.141592653589793;
const float PI_F32 = 3.1415927f;

/**
 * Two times PI - a full turn in radians.
 */
const float64 TAU = 6.283185307179586;
const float TAU_F32 = 6.2831855f;

/**
 * Half of PI - a quarter turn in radians.
 */
const float64 HALF_PI = 1.5707963267948966;
const float HALF_PI_F32 = 1.5707964f;

// ----------------------------------------------------------------------------
// exponentials and logarithms
// ----------------------------------------------------------------------------

/**
 * Euler's number, the base of the natural logarithm.
 */
const float64 E = 2.718281828459045;
const float E_F32 = 2.7182817f;

/**
 * The natural logarithm of 2.
 */
const float64 LN_2 = 0.6931471805599453;
const float LN_2_F32 = 0.6931472f;

/**
 * The natural logarithm of 10.
 */
const float64 LN_10 = 2.302585092994046;
const float LN_10_F32 = 2.3025851f;

// ----------------------------------------------------------------------------
// roots
// ----------------------------------------------------------------------------

/**
 * The square root of 2.
 */
const float64 SQRT_2 = 1.4142135623730951;
const float SQRT_2_F32 = 1.4142135f;
