/**
 * A queue between threads. `send` puts a value in; `recv` takes one out. Last
 * drop of the sender closes the stream, and `recv` then returns `null` once
 * the queue is drained.
 *
 * Ends are class handles: copying a sender is another retain of the same
 * object, which is how several producers share one stream. `produce` is the
 * spelling that never leaves a sender on the parent, so the worker finishing
 * is what closes.
 */

namespace std::thread;

// stored as `buffer::$cap`. `channel<T>()` opens at this; `channel<T>(0)` is refused
// rather than becoming a rendezvous
internal const usize UNBOUNDED = 0;

/**
 * What `try_recv` saw. Empty and closed are different, and `T?` cannot say so.
 */
public enum poll<T>
{
    case item(T $value);
    case empty;
    case closed;
}

private struct buffer<T>
{
    array<T> $items;
    bool $closed;
    bool $has_receiver;
    usize $cap;

    // threads asleep on each condition, so a signal goes out only when it can wake someone
    usize $receivers_waiting;
    usize $senders_waiting;

    constructor(usize $cap)
    {
        $this->items = array<T>();
        $this->closed = false;
        $this->has_receiver = true;
        $this->cap = $cap;
        $this->receivers_waiting = 0;
        $this->senders_waiting = 0;
    }
}

// two conditions, not one: a receiver taking a value must wake a sender waiting for room, never
// another receiver that would find the queue empty. one condition shared by both ends did both,
// because signalling the senders woke every receiver too. senders sleep on `$writable`, receivers
// on `$readable`
#[atomic]
private class shared<T>
{
    mutex<buffer<T>> $lock;

    // receivers wait here for a value
    condition $readable;

    // senders wait here for room, on a bounded channel
    condition $writable;

    constructor(usize $cap)
    {
        $this->lock = mutex<buffer<T>>(buffer<T>($cap));
        $this->readable = condition();
        $this->writable = condition();
    }
}

/**
 * The producing end. Last drop closes; `close()` is the named form of the same
 * thing, for a parent that still holds the handle.
 */
#[atomic]
public class sender<T>
{
    private shared<T> $core;

    internal constructor(shared<T> $core)
    {
        $this->core = $core;
    }

    destructor()
    {
        $this->close();
    }

    function close() : void
    {
        {
            locked<buffer<T>> $g = $this->core->lock->lock();
            $g->value->closed = true;
        }

        // a receiver waiting for more, and a sender waiting for room, both have their answer now
        $this->core->readable->notify_all();
        $this->core->writable->notify_all();
    }

    /**
     * Hands `$v` to a waiting receiver. `false` means nobody is listening; `$v`
     * is then destroyed with this call. Blocks while the channel is bounded
     * and full.
     */
    function send(T $v) : bool
    {
        locked<buffer<T>> $g = $this->core->lock->lock();

        while ($g->value->cap != UNBOUNDED && $g->value->items->count() >= $g->value->cap) {
            if ($g->value->closed || !$g->value->has_receiver) {
                return false;
            }

            $g->value->senders_waiting = $g->value->senders_waiting + 1;
            $this->core->writable->wait($g);
            $g->value->senders_waiting = $g->value->senders_waiting - 1;
        }

        if ($g->value->closed || !$g->value->has_receiver) {
            return false;
        }

        $g->value->items[] = mv $v;

        // a receiver that is awake looks at the queue before it sleeps, so only a sleeping one needs this
        if ($g->value->receivers_waiting > 0) {
            $this->core->readable->notify();
        }

        return true;
    }
}

/**
 * The consuming end. `recv` sleeps until a value arrives or the sender side
 * has closed and the queue is empty.
 */
#[atomic]
public class receiver<T>
{
    private shared<T> $core;
    // seated by `produce`, null on a receiver from `channel()`. join before `$core`
    // dies: a class deinit runs this, then drops fields in reverse declaration order
    private handle? $worker;

    internal constructor(shared<T> $core)
    {
        $this->core = $core;
    }

    // `produce` keeps the handle here rather than detaching: last drop of the
    // receiver joins, so `echoc run` cannot unmap under a worker still in teardown
    internal function attach(handle $h) : void
    {
        $this->worker = $h;
    }

    destructor()
    {
        {
            locked<buffer<T>> $g = $this->core->lock->lock();
            $g->value->has_receiver = false;
        }

        // a sender blocked on a full channel answers false now
        $this->core->writable->notify_all();
        $this->core->readable->notify_all();

        handle $h = guard $this->worker else {
            return;
        }

        $h->join();
    }

    function recv() : T?
    {
        locked<buffer<T>> $g = $this->core->lock->lock();

        while (true) {
            if ($g->value->items->count() > 0) {
                T $v = $g->value->items->remove(0);

                // room for a sender blocked on a full channel, and nobody else to tell
                if ($g->value->senders_waiting > 0) {
                    $this->core->writable->notify();
                }

                return $v;
            }

            if ($g->value->closed) {
                return null;
            }

            $g->value->receivers_waiting = $g->value->receivers_waiting + 1;
            $this->core->readable->wait($g);
            $g->value->receivers_waiting = $g->value->receivers_waiting - 1;
        }
    }

    function try_recv() : poll<T>
    {
        locked<buffer<T>> $g = $this->core->lock->lock();

        if ($g->value->items->count() > 0) {
            T $v = $g->value->items->remove(0);

            if ($g->value->senders_waiting > 0) {
                $this->core->writable->notify();
            }

            return .item(mv $v);
        }

        if ($g->value->closed) {
            return .closed;
        }

        return .empty;
    }
}

/**
 * Both ends of one stream. `tx()` and `rx()` take the ends off the pair, so
 * binding them to locals does not leave a sender on `$ch`. A leftover sender
 * there would keep `recv` waiting after the worker had already dropped.
 *
 * `channel<T>()` is unbounded. `channel<T>($cap)` blocks `send` while full.
 * Capacity `0` is refused rather than becoming a rendezvous.
 */
#[unique]
public struct channel<T>
{
    private sender<T>? $sender;
    private receiver<T>? $receiver;

    constructor()
    {
        $this->open(UNBOUNDED);
    }

    constructor(usize $cap)
    {
        if ($cap == 0) {
            die('channel capacity must be at least 1');
        }

        $this->open($cap);
    }

    function tx() : sender<T>
    {
        sender<T> $s = guard $this->sender else {
            die('channel sender already taken');
        }

        $this->sender = null;
        return $s;
    }

    function rx() : receiver<T>
    {
        receiver<T> $r = guard $this->receiver else {
            die('channel receiver already taken');
        }

        $this->receiver = null;
        return $r;
    }

    private function open(usize $cap) : void
    {
        shared<T> $core = shared<T>($cap);
        $this->sender = sender<T>($core);
        $this->receiver = receiver<T>($core);
    }
}

/**
 * Starts `$work` on a new OS thread with the sender as a parameter. When
 * `$work` returns the sender drops and the stream closes, so a `recv` loop
 * on the returned receiver terminates. Failure is "the thread never started".
 */
public function produce<T>(function<void(sender<T>)> $work) : result<receiver<T>, error>
{
    channel<T> $ch = channel<T>();
    sender<T> $tx = $ch->tx();
    receiver<T> $rx = $ch->rx();

    handle $h = guard handle::spawn(function[mv $tx, mv $work]() : void {
        $work($tx);
    }) else ($e) {
        return .error($e);
    }

    $rx->attach($h);
    return .ok($rx);
}
