/**
 * One value that is not there yet. `wait()` joins the worker and copies the slot.
 *
 * There is no `task<void>` — that is a `handle`. A failing computation is a `T` that is
 * itself a `result`, not a second error channel here.
 */

namespace std::thread;

// a heap cell the worker retains independently of the task handle. capturing the task
// itself would keep it alive, so drop would not join. capturing `&$t->slot` is a
// pointer into the object, and the write would be unaccounted storage. this cell is
// an ordinary class: the worker assigns a field, the task reads it after join
#[atomic]
private class box<T>
{
    T? $value;

    constructor()
    {
    }
}

#[atomic]
public class task<T>
{
    private handle? $worker;
    private box<T> $slot;

    // join before the box dies. a class deinit runs this, then drops fields in
    // reverse declaration order — `$slot` first. after join the worker has already
    // dropped its retain, so this drop is the last
    destructor()
    {
        handle $h = guard $this->worker else {
            return;
        }

        $h->join();
    }

    private constructor()
    {
    }

    /**
     * Starts `$work` on a new OS thread and seats the result. Failure is "the thread
     * never started"; what `$work` itself returns is `T`.
     */
    static function spawn(function<T()> $work) : result<task<T>, error>
    {
        task<T> $t = task<T>();
        box<T> $out = box<T>();
        $t->slot = $out;

        handle $h = guard handle::spawn(function[mv $work, mv $out]() : void {
            T $v = $work();
            $out->value = mv $v;
        }) else ($e) {
            return .error($e);
        }

        $t->worker = $h;
        return .ok($t);
    }

    function wait() : T
    {
        handle $h = guard $this->worker else {
            die('task was not started');
        }

        $h->join();

        T $v = guard $this->slot->value else {
            die('task produced no value');
        }

        return $v;
    }
}

/**
 * Starts `$work` on a new OS thread. The written spelling of `task<T>::spawn`.
 *
 * `function<void()>` stays `spawn` → `handle`. This overload is the other type.
 */
public function spawn<T>(function<T()> $work) : result<task<T>, error>
{
    return task<T>::spawn($work);
}
