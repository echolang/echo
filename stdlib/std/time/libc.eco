/**
 * Platform clock and sleep bindings.
 *
 * POSIX is `clock_gettime` / `nanosleep` with a `timespec` that is also this module's duration
 * split, so a clock read and a sleep take the same two words with no conversion. Windows has
 * neither call; the shims below keep those two names so instant.eco, timestamp.eco and sleep.eco
 * never write a platform conditional.
 *
 * `CLOCK_MONOTONIC` rather than `_RAW` on both Unixes: NTP may slew it, it never steps, and that
 * is the clock Go and Rust hand you for measuring. Darwin's value is 6; everyone else uses 1,
 * which is the linux uapi and the id the Windows QPC shim keys on.
 *
 * A C symbol may only be declared once per module, so they live here. `internal`: the rest of
 * `std::time` names them, a consumer does not.
 */

namespace std::time;

/**
 * Echo's duration split: two int64 fields. The C `timespec` libc writes is this shape on
 * Darwin and Linux (`time_t` then 64-bit `long`). Windows has no such type; the shims still
 * write one. WASI's C `timespec` has a 32-bit `tv_nsec` (`long` is 32-bit on wasm32) and
 * `clockid_t` is a pointer, so that row talks to `__wasi_clock_time_get` / a converted
 * `nanosleep` instead of this layout.
 *
 * libc *writes* into it on the POSIX path, so both fields are declared exactly. A binding
 * that only read could leave the tail off; this one cannot.
 */
internal struct timespec
{
    int64 $sec;
    int64 $nsec;
}

#[if: family != windows && family != wasi]
internal extern {
    function clock_gettime as c_clock_gettime(int32 $clock, ptr<timespec> $ts) : int32;
    function nanosleep as c_nanosleep(ptr<timespec> $req, ptr<timespec> $rem) : int32;
}
#[end]

#[if: family == wasi]
// wasm32 `long` is 32 bits. clockid_t is `const struct __clockid *`, not an int, so
// the POSIX `clock_gettime` declaration would pass the id in the wrong register.
private struct wasi_timespec
{
    int64 $sec;
    int32 $nsec;
}

internal extern {
    function __wasi_clock_time_get as c_wasi_clock_time_get(
        uint32 $id, uint64 $precision, ptr<uint64> $out) : uint16;
    function nanosleep as c_wasi_nanosleep(
        ptr<wasi_timespec> $req, ptr<wasi_timespec> $rem) : int32;
}

internal function c_clock_gettime(int32 $clock, ptr<timespec> $ts) : int32
{
    uint64 $ns = 0;
    uint16 $err = c_wasi_clock_time_get($clock as uint32, 1, &$ns);

    if ($err != 0) {
        return -1;
    }

    uint64 $per_sec = NANOS_PER_SEC as uint64;
    $ts->sec = ($ns / $per_sec) as int64;
    $ts->nsec = ($ns % $per_sec) as int64;
    return 0;
}

internal function c_nanosleep(ptr<timespec> $req, ptr<timespec> $rem) : int32
{
    wasi_timespec $wreq = wasi_timespec($req->sec, $req->nsec as int32);
    wasi_timespec $wrem = wasi_timespec(0, 0);
    int32 $rc = c_wasi_nanosleep(&$wreq, &$wrem);
    $rem->sec = $wrem->sec;
    $rem->nsec = $wrem->nsec as int64;
    return $rc;
}
#[end]

internal const int32 CLOCK_REALTIME = 0;

#[if: family == darwin]
internal const int32 CLOCK_MONOTONIC = 6;
#[else]
internal const int32 CLOCK_MONOTONIC = 1;
#[end]

#[if: os == windows]
internal extern {
    function QueryPerformanceCounter as c_QueryPerformanceCounter(ptr<int64> $count) : int32;
    function QueryPerformanceFrequency as c_QueryPerformanceFrequency(ptr<int64> $freq) : int32;
    function GetSystemTimePreciseAsFileTime as c_GetSystemTimePreciseAsFileTime(ptr<uint64> $time) : void;
    function Sleep as c_Sleep(uint32 $ms) : void;
}

internal const int64 FILETIME_EPOCH_DELTA_SECS = 11644473600;
internal const int64 FILETIME_TICKS_PER_SEC = 10000000;
internal const int64 FILETIME_NANOS_PER_TICK = 100;
internal const int64 SLEEP_CHUNK_MS = 4000000000;

private function read_qpf() : int64
{
    int64 $f = 0;
    c_QueryPerformanceFrequency(&$f);

    if ($f == 0) {
        die('QueryPerformanceFrequency returned 0');
    }

    return $f;
}

// QPF is boot-constant. The static is lazy, once, and thread-safe: the language rule, not
// a comment. A dummy field so the type has a constructor; nothing constructs one.
private struct qpc
{
    int32 $pad;

    static int64 $freq = read_qpf();
}

internal function c_clock_gettime(int32 $clock, ptr<timespec> $ts) : int32
{
    if ($clock == CLOCK_MONOTONIC) {
        int64 $count = 0;
        c_QueryPerformanceCounter(&$count);

        int64 $f = qpc::$freq;
        $ts->sec = $count / $f;
        $ts->nsec = (($count % $f) * NANOS_PER_SEC) / $f;
        return 0;
    }

    uint64 $ticks = 0;
    c_GetSystemTimePreciseAsFileTime(&$ticks);

    uint64 $per_sec = FILETIME_TICKS_PER_SEC as uint64;
    int64 $secs_1601 = ($ticks / $per_sec) as int64;
    int64 $subsec = ($ticks % $per_sec) as int64;
    $ts->sec = $secs_1601 - FILETIME_EPOCH_DELTA_SECS;
    $ts->nsec = $subsec * FILETIME_NANOS_PER_TICK;
    return 0;
}

internal function c_nanosleep(ptr<timespec> $req, ptr<timespec> $rem) : int32
{
    int64 $ms = $req->sec * MILLIS_PER_SEC + ($req->nsec + NANOS_PER_MILLI - 1) / NANOS_PER_MILLI;

    if ($ms < 0) {
        $ms = 0;
    }

    while ($ms > 0) {
        int64 $chunk = $ms;

        if ($chunk > SLEEP_CHUNK_MS) {
            $chunk = SLEEP_CHUNK_MS;
        }

        c_Sleep($chunk as uint32);
        $ms = $ms - $chunk;
    }

    $rem->sec = 0;
    $rem->nsec = 0;
    return 0;
}
#[end]
