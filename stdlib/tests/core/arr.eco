#[group: "core"]
test room_is_empty_with_capacity
{
    $a = arr::room<int32>(16);
    assert($a->empty());
    assert($a->capacity() >= 16);
}

#[group: "core"]
test merge_copies_both_sides
{
    $a = [1, 2];
    $b = [3, 4];
    $c = arr::merge($a, $b);
    assert($c->count() == 4);
    assert($c[0] == 1);
    assert($c[3] == 4);
    assert($a->count() == 2);
    assert($b->count() == 2);
}

#[group: "core"]
test extend_from_copies_a_buffer
{
    $src = [1, 2, 3];
    $dst = array<int32>();
    arr::extend_from($dst, $src->data(), $src->count());
    assert($dst->count() == 3);
    assert($dst[2] == 3);
    arr::extend_from($dst, $src->data(), 0);
    assert($dst->count() == 3);

    $owning = ['a', 'b'];
    $into = array<string>();
    arr::extend_from($into, $owning->data(), $owning->count());
    assert($into[1] == 'b');
}
