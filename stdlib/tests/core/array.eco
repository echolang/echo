#[group: "core"]
test an_empty_array_has_no_elements
{
    $a = array<int32>();
    assert($a->empty());
    assert($a->count() == 0);
    assert($a->capacity() == 0);
}

#[group: "core"]
test a_literal_is_an_array
{
    $a = [1, 2, 3];
    assert($a->count() == 3);
    assert($a[0] == 1);
    assert($a[2] == 3);
}

#[group: "core"]
test append_grows_the_count
{
    $a = array<int32>();
    $a[] = 1;
    $a->push(2);
    assert($a->count() == 2);
    assert($a[1] == 2);
}

#[group: "core"]
test reserve_makes_room_without_changing_count
{
    $a = array<int32>();
    $a->reserve(64);
    assert($a->empty());
    assert($a->capacity() >= 64);
}

#[group: "core"]
test pop_hands_the_last_element_back
{
    $a = [1, 2, 3];
    assert($a->pop() == 3);
    assert($a->count() == 2);
    assert($a[1] == 2);
}

#[group: "core"]
test get_and_at_read_an_index
{
    $a = [10, 20, 30];
    assert($a->get(1) == 20);
    assert($a->at(1) == 20);
    $a[1] = 21;
    assert($a[1] == 21);
}

#[group: "core"]
test clear_drops_the_elements_and_keeps_capacity
{
    $a = [1, 2, 3];
    $a->reserve(16);
    usize $cap = $a->capacity();
    $a->clear();
    assert($a->empty());
    assert($a->capacity() == $cap);
}

#[group: "core"]
test truncate_shortens
{
    $a = [1, 2, 3, 4];
    $a->truncate(2);
    assert($a->count() == 2);
    assert($a[1] == 2);
}

#[group: "core"]
test extend_appends_another_array
{
    $a = [1, 2];
    $b = [3, 4];
    $a->extend($b);
    assert($a->count() == 4);
    assert($a[3] == 4);
    assert($b->count() == 2);
}

#[group: "core"]
test clone_is_an_independent_copy
{
    $a = [1, 2];
    $b = $a->clone();
    $b[] = 3;
    assert($a->count() == 2);
    assert($b->count() == 3);
}

#[group: "core"]
test a_copy_duplicates_the_elements
{
    $a = [1, 2];
    $b = $a;
    $b[0] = 9;
    assert($a[0] == 1);
    assert($b[0] == 9);
}

#[group: "core"]
test remove_shifts_the_tail_down
{
    $a = [1, 2, 3, 4];
    assert($a->remove(1) == 2);
    assert($a->count() == 3);
    assert($a[1] == 3);
}

#[group: "core"]
test pluck_swaps_with_the_last
{
    $a = [1, 2, 3, 4];
    assert($a->pluck(1) == 2);
    assert($a->count() == 3);
}

#[group: "core"]
test sort_orders_comparable_elements
{
    $a = [3, 1, 2];
    $a->sort();
    assert($a[0] == 1);
    assert($a[1] == 2);
    assert($a[2] == 3);
}

#[group: "core"]
test foreach_walks_the_elements
{
    $a = [1, 2, 3];
    int32 $sum = 0;
    foreach ($a as const &$n) {
        $sum = $sum + $n;
    }
    assert($sum == 6);
}

#[group: "core"]
test sub_is_a_window
{
    $a = [1, 2, 3, 4];
    slice<int32> $s = $a->sub(1, 2);
    assert($s->count() == 2);
    assert($s[0] == 2);
    assert($s[1] == 3);
}

#[group: "core"]
test fit_sizes_exactly
{
    $a = array<int32>();
    $a->fit(5);
    assert($a->capacity() == 5);
    assert($a->empty());
}

#[group: "core"]
test shrink_gives_spare_capacity_back
{
    $a = array<int32>();
    $a->reserve(32);
    $a[] = 1;
    $a->shrink();
    assert($a->capacity() == 1);
}

#[group: "core"]
test slot_borrows_the_new_end
{
    $a = array<int32>();
    int32& $n = $a->slot();
    $n = 7;
    assert($a->count() == 1);
    assert($a[0] == 7);
}

#[group: "core"]
test take_from_moves_elements_across
{
    $a = [1, 2];
    $b = [3];
    $b->take_from($a);
    assert($a->empty());
    assert($b->count() == 3);
    assert($b[2] == 2);
}

#[group: "core"]
test an_array_frees_its_storage
{
    usize $before = mem::live_allocations();
    {
        $a = [1, 2, 3];
        $a[] = 4;
    }
    assert(mem::live_allocations() == $before);
}

#[tests: expects death]
#[group: "core"]
test at_dies_out_of_bounds
{
    $a = [1];
    echo $a->at(5);
}
