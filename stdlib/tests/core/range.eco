#[group: "core"]
test an_exclusive_range_stops_before_the_end
{
    int32 $n = 0;
    foreach (0 .. 4 as const &$i) {
        $n = $n + 1;
        assert($i >= 0);
        assert($i < 4);
    }
    assert($n == 4);
}

#[group: "core"]
test an_inclusive_range_includes_the_end
{
    int32 $last = -1;
    int32 $n = 0;
    foreach (1 ..= 3 as const &$i) {
        $last = $i;
        $n = $n + 1;
    }
    assert($n == 3);
    assert($last == 3);
}

#[group: "core"]
test an_empty_range_yields_nothing
{
    int32 $n = 0;
    foreach (5 .. 5 as const &$i) {
        $n = $n + 1;
        echo $i;
    }
    assert($n == 0);
}

#[group: "core"]
test a_range_is_a_value
{
    range<int32> $r = 0 .. 3;
    int32 $n = 0;
    foreach ($r as const &$i) {
        $n = $n + 1;
    }
    assert($n == 3);
}
