#[group: "core"]
test a_slice_indexes_its_window
{
    $a = [1, 2, 3, 4];
    slice<int32> $s = $a->sub(1, 2);
    assert(!$s->empty());
    assert($s->count() == 2);
    assert($s->get(0) == 2);
    assert($s[1] == 3);
}

#[group: "core"]
test a_slice_sub_narrows_further
{
    $a = [1, 2, 3, 4, 5];
    slice<int32> $s = $a->sub(1, 3)->sub(1, 1);
    assert($s->count() == 1);
    assert($s[0] == 3);
}

#[group: "core"]
test writing_through_a_slice_writes_the_array
{
    $a = [1, 2, 3];
    slice<int32> $s = $a->sub();
    $s[1] = 9;
    assert($a[1] == 9);
}

#[group: "core"]
test foreach_walks_a_slice
{
    $a = [1, 2, 3];
    int32 $sum = 0;
    foreach ($a->sub() as const &$n) {
        $sum = $sum + $n;
    }
    assert($sum == 6);
}

#[group: "core"]
test sort_orders_a_slice
{
    $a = [3, 1, 2];
    $a->sub()->sort();
    assert($a[0] == 1);
    assert($a[2] == 3);
}

#[tests: expects death]
#[group: "core"]
test slice_at_dies_out_of_bounds
{
    $a = [1];
    slice<int32> $s = $a->sub();
    echo $s->at(3);
}
