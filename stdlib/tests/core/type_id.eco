#[group: "core"]
test the_same_type_is_the_same_id
{
    assert(type_id<int32>() == type_id<int32>());
}

#[group: "core"]
test different_types_differ
{
    assert(type_id<int32>() != type_id<int64>());
    assert(type_id<string>() != type_id<int32>());
}

#[group: "core"]
test generic_instances_are_distinct
{
    assert(type_id<array<int32>>() != type_id<array<string>>());
}
