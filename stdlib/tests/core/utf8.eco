#[group: "core"]
test ascii_is_utf8
{
    assert(str::is_utf8('hello'));
    assert(str::is_utf8(''));
}

#[group: "core"]
test multi_byte_scalars_are_utf8
{
    assert(str::is_utf8('é'));
    assert(str::is_utf8('€'));
    assert(str::is_utf8("\u{1F600}"));
}

#[group: "core"]
test a_stray_continuation_is_not_utf8
{
    string $raw = '';
    $raw->push(128);
    assert(!str::is_utf8($raw));
}

#[group: "core"]
test a_truncated_sequence_is_not_utf8
{
    string $raw = '';
    $raw->push(226);
    assert(!str::is_utf8($raw));
}

#[group: "core"]
test an_overlong_encoding_is_not_utf8
{
    string $raw = '';
    $raw->push(192);
    $raw->push(128);
    assert(!str::is_utf8($raw));
}

#[group: "core"]
test a_too_high_lead_is_not_utf8
{
    string $raw = '';
    $raw->push(248);
    assert(!str::is_utf8($raw));
}

#[group: "core"]
test boundary_backs_up_to_the_character
{
    string $e = 'é';
    assert(str::boundary($e, 0) == 0);
    assert(str::boundary($e, 1) == 0);
    assert(str::boundary($e, 2) == 2);
    assert(str::boundary($e, 99) == 2);
}

#[group: "core"]
test chars_walks_scalars_and_raw_bytes
{
    $p = str::chars('ab');
    assert($p->count() == 2);
    assert($p->at(0) == 'a');

    string $raw = 'a';
    $raw->push(128);
    $q = str::chars($raw);
    assert($q->count() == 2);
}

#[group: "core"]
test chars_of_empty_is_empty
{
    assert(str::chars('')->count() == 0);
}
