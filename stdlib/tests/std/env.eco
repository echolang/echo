#[group: "std"]
test argc_is_at_least_one
{
    assert(std::env::argc() > 0);
}

#[group: "std"]
test arg_zero_is_the_program
{
    string::view $zero = std::env::arg(0);
    assert(!$zero->empty());
}

#[group: "std"]
test argv_matches_argc
{
    assert(std::env::argv()->count() == std::env::argc());
}

#[group: "std"]
test cwd_is_absolute
{
    std::fs::path $cwd = guard std::env::cwd();
    assert($cwd->is_absolute());
}

#[group: "std"]
test var_of_a_missing_key_is_null
{
    assert(std::env::var('ECHO_STDLIB_TEST_NO_SUCH_VAR') == null);
    assert(!std::env::has('ECHO_STDLIB_TEST_NO_SUCH_VAR'));
}

#[group: "std"]
test pid_is_positive
{
    assert(std::env::pid() > 0);
}

#[group: "std"]
test var_fallback
{
    assert(std::env::var('ECHO_STDLIB_TEST_NO_SUCH_VAR', 'fallback') == 'fallback');
}

#[group: "std"]
test tmp_is_absolute
{
    assert(std::env::tmp()->is_absolute());
}

#[group: "std"]
test home_is_a_path_or_missing
{
    std::fs::path? $home = std::env::home();
    if ($home != null) {
        std::fs::path $p = $home ?? std::fs::path('.');
        assert($p->is_absolute() || $p->string() == '.');
    }
}

#[group: "std"]
test exe_is_absolute
{
    std::fs::path $exe = guard std::env::exe();
    assert($exe->is_absolute());
}

#[group: "std"]
test args_iterator
{
    usize $n = 0;
    foreach (std::env::args() as $i => const &$a) {
        $n = $n + 1;
        if ($i == 0) {
            assert(!$a->empty());
        }
    }
    assert($n == std::env::argc());
}

#[group: "std"]
test vars_iterator_yields_pairs
{
    usize $n = 0;
    foreach (std::env::vars() as $k => const &$v) {
        $n = $n + 1;
        assert(!$k->empty());
        if ($n > 3) {
            break;
        }
    }
    assert($n > 0);
}

#[group: "std"]
test chdir_round_trips
{
    std::fs::path $here = guard std::env::cwd();
    std::fs::path $tmp = guard std::fs::tempdir();
    guard std::env::chdir($tmp);
    std::fs::path $now = guard std::env::cwd();
    assert($now->is_absolute());
    guard std::env::chdir($here);
    guard std::fs::remove_all($tmp);
}
