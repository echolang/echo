#[if: os != wasi]

#[group: "signal"]
test nothing_is_caught_at_start
{
    std::env::signal::reset();
    assert(!std::env::signal::caught());
    assert(std::env::signal::last() == null);
    assert(std::env::signal::take() == null);
}

#[group: "signal"]
test a_trapped_raise_is_recorded
{
    std::env::signal::reset();
    guard std::env::signal::trap();
    guard std::env::signal::raise(std::env::signal::terminate);

    assert(std::env::signal::caught());
    assert(std::env::signal::caught(std::env::signal::terminate));
    assert(!std::env::signal::caught(std::env::signal::interrupt));

    std::env::signal $last = guard std::env::signal::last();
    assert($last == std::env::signal::terminate);

    std::env::signal $taken = guard std::env::signal::take();
    assert($taken == std::env::signal::terminate);
    assert(!std::env::signal::caught());
}

#[group: "signal"]
test take_goes_in_kind_order
{
    std::env::signal::reset();
    guard std::env::signal::trap();
    guard std::env::signal::raise(std::env::signal::terminate);
    guard std::env::signal::raise(std::env::signal::interrupt);

    std::env::signal $first = guard std::env::signal::take();
    std::env::signal $second = guard std::env::signal::take();
    assert($first == std::env::signal::interrupt);
    assert($second == std::env::signal::terminate);
    assert(std::env::signal::take() == null);
}

#[group: "signal"]
test taking_does_not_forget_the_last_one
{
    std::env::signal::reset();
    guard std::env::signal::trap();
    guard std::env::signal::raise(std::env::signal::interrupt);

    std::env::signal $taken = guard std::env::signal::take();
    assert($taken == std::env::signal::interrupt);

    std::env::signal $last = guard std::env::signal::last();
    assert($last == std::env::signal::interrupt);
}

#[group: "signal"]
test reset_forgets_pending_and_last
{
    guard std::env::signal::trap();
    guard std::env::signal::raise(std::env::signal::interrupt);
    std::env::signal::reset();

    assert(!std::env::signal::caught());
    assert(std::env::signal::last() == null);
}

#[group: "signal"]
test a_second_arrival_of_one_kind_is_one_pending
{
    std::env::signal::reset();
    guard std::env::signal::trap();
    guard std::env::signal::raise(std::env::signal::interrupt);
    guard std::env::signal::raise(std::env::signal::interrupt);

    std::env::signal $taken = guard std::env::signal::take();
    assert($taken == std::env::signal::interrupt);
    assert(std::env::signal::take() == null);
}

#[group: "signal"]
test wait_takes_a_pending_signal
{
    std::env::signal::reset();
    guard std::env::signal::trap();
    guard std::env::signal::raise(std::env::signal::interrupt);

    std::env::signal $k = std::env::signal::wait(poll: std::time::duration::millis(5));
    assert($k == std::env::signal::interrupt);
    assert(!std::env::signal::caught());
}

#[if: threads]

#[atomic]
class Go
{
    atomic<int32> $n;

    constructor()
    {
        $this->n = atomic<int32>(0);
    }

    function set() : void
    {
        $this->n->store(1);
    }

    const function ready() : bool
    {
        return $this->n->load() != 0;
    }
}

#[group: "signal"]
test wait_blocks_until_a_raise
{
    std::env::signal::reset();
    guard std::env::signal::trap();

    Go $go = Go();
    std::thread::handle $h = guard std::thread::spawn(function() : void {
        while (!$go->ready()) {
            std::time::sleep(std::time::duration::millis(1));
        }

        std::time::sleep(std::time::duration::millis(20));
        guard std::env::signal::raise(std::env::signal::terminate);
    });

    $go->set();
    std::env::signal $k = std::env::signal::wait(poll: std::time::duration::millis(5));
    assert($k == std::env::signal::terminate);
    $h->join();
}

#[end]

#[group: "signal"]
test kinds_have_their_shell_names
{
    assert(std::env::signal::interrupt->name() == 'SIGINT');
    assert(std::env::signal::terminate->name() == 'SIGTERM');
    assert(std::env::signal::hangup->name() == 'SIGHUP');
    assert(std::env::signal::user1->name() == 'SIGUSR1');
    assert(std::env::signal::user2->name() == 'SIGUSR2');
    assert(std::env::signal::all()->count() == 5);
}

#[if: os == windows]

#[group: "signal"]
test windows_has_no_hangup
{
    std::env::signal::reset();
    array<std::env::signal> $hup = [std::env::signal::hangup];
    status<std::env::signal_error> $s = std::env::signal::trap($hup);
    assert($s->failed());
    assert($s->failure()->message() == 'SIGHUP does not exist on this platform');
    assert(!std::env::signal::caught());

    status<std::env::signal_error> $r = std::env::signal::raise(std::env::signal::user1);
    assert($r->failed());
    assert(!std::env::signal::caught());
}

#[tests: expects death]
#[group: "signal"]
test a_failed_trap_leaves_dispositions_alone
{
    array<std::env::signal> $all = std::env::signal::all();
    status<std::env::signal_error> $s = std::env::signal::trap($all);
    assert($s->failed());
    guard std::env::signal::raise(std::env::signal::interrupt);
}

#[else]

#[group: "signal"]
test hangup_and_the_user_signals_are_trapped
{
    std::env::signal::reset();
    array<std::env::signal> $three = [
        std::env::signal::hangup,
        std::env::signal::user1,
        std::env::signal::user2,
    ];
    guard std::env::signal::trap($three);
    guard std::env::signal::raise(std::env::signal::user2);
    guard std::env::signal::raise(std::env::signal::hangup);

    std::env::signal $first = guard std::env::signal::take();
    std::env::signal $second = guard std::env::signal::take();
    assert($first == std::env::signal::hangup);
    assert($second == std::env::signal::user2);
    assert(!std::env::signal::caught(std::env::signal::user1));
}

#[end]

#[end]
