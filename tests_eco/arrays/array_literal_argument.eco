// an array literal in an argument position. it fills storage, so it has to name it - and where the
// author named none, the compiler does: a declaration is hoisted ahead of the statement, the appends
// go with it, and what reaches the parameter is that declaration's name (todo/A13c)
//
// so the literal is never a *temporary*. it stays `t_addressless` in AST::storage_of, which is what
// keeps "a literal fills storage" true of every position; only where the storage comes from changed

function total(array<int32> $a) : int32 { return $a[0] + $a[1] + $a[2]; }
function totalb(array<int32>& $a) : int32 { return $a[0] + $a[1] + $a[2]; }

// by value: the hoisted declaration is copied into the parameter, through the copy constructor
echo total([1, 2, 3]);

// by borrow: an ordinary place, so an ordinary t_borrow - none of the temporary machinery is involved
echo totalb([10, 20, 30]);

// two in one statement, which is what the hoist names are numbered for
function both(array<int32>& $a, array<int32>& $b) : int32 { return $a[0] + $b[0]; }
echo both([7, 0, 0], [100, 0, 0]);
