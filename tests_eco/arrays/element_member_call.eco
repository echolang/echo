// **a method call on an element.** `$a[0]->x` reads a property through MemberAccessNode, which
// resolves late - but a method call resolves its candidates from the receiver's *type*, and an
// element has none until AST::OperatorRewriter attaches the contract mid-fixpoint. so a member call
// on an undetermined receiver is now kept pending rather than reported, which is the standing every
// other unsettled call already had
array<int32> $src = [5, 6, 7];

array<slice<int32>> $views = [];
$views[] = $src->sub();
$views[] = $src->sub(1, 2);

echo $views[0]->count();
echo $views[1]->count();

// and chained: an element of an element
echo $views[0][2];
echo $views[1][0];

// the same over a type whose methods come from the stdlib
array<string> $names = [];
$names[] = "hello";
$names[] = "hi";

echo $names[0]->size();
echo $names[1]->size();
