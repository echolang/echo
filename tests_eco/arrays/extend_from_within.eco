// the self-append, spelled explicitly. `$a->extend($a)` is refused - one array cannot be both the
// `inout` receiver and a `read` source of one call - and this is the same intent said unambiguously,
// naming *which* range to repeat

array<int32> $a = array<int32>();
$a[] = 1;
$a[] = 2;
$a[] = 3;

// double it
$a->extend(0, $a->count());
foreach ($a as $v) { echo $v; }
echo $a->count();

// repeat one element
$a->extend(1, 1);
echo $a->get($a->count() - 1);

// an owning element type takes the element loop rather than the memcpy, and each element gets its
// own copy
array<string> $s = array<string>();
$s[] = "x";
$s[] = "y";
$s->extend(0, 2);
foreach ($s as $t) { echo $t; }

// a zero-length request allocates nothing and appends nothing
usize $before = $s->count();
$s->extend(0, 0);
echo $s->count() - $before;
