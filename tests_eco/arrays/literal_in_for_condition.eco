// the for condition is the same hole as while: `$__lit` above the loop sees `$i` from before the first step

function has3(array<int32> $xs) : bool
{
    return $xs[0] == 3;
}

function first(array<int32> $xs) : int32
{
    return $xs[0];
}

int32 $n = 0;

for (int32 $i = 0; !has3([$i]); $i++) {
    $n = $n + 1;

    if ($n > 10) {
        echo 'stuck';
        return;
    }
}

echo $n;

int32 $j = 0;
int32 $steps = 0;

for ($j = 0; $j < 3; $j = first([$j + 1])) {
    $steps = $steps + 1;

    if ($steps > 10) {
        echo 'stuck step';
        return;
    }
}

echo $j;
echo $steps;
