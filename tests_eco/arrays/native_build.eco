// the only case that exercises make_exec, and it is not another view of `run`: `build` defaults to
// release, where every bounds `assert` in the element contract elides. so this pins that an array
// works with the checks compiled out, which is the configuration a shipped program has
Array<int32> $a = [3, 1, 2];

$a[] = 4;
$a[0] = 30;

int32 $sum = 0;
usize $i = 0;

while ($i < $a->count()) {
    $sum = $sum + $a[$i];
    $i = $i + 1;
}

echo $sum;
echo $a->count();
