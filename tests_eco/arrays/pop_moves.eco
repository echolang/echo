// `pop` hands the last element over. a temporary seated with `$a[] =` and a `pop` into a local
// are both transfers, so Item's copy constructor does not run. `$a[] = mv $x` is the matching
// move-in; arrays/push_moves is that at `push`

struct Item
{
    int32 $n;

    constructor(int32 $n)
    {
        $this->n = $n;
    }

    constructor(const Item& $other)
    {
        echo 'copy';
        $this->n = $other->n;
    }

    destructor()
    {
        echo $this->n;
    }
}

{
    array<Item> $items = array<Item>();
    $items[] = Item(1);
    $items[] = Item(2);
    echo 'pop';
    Item $out = $items->pop();
    echo $out->n;
    echo $items->count();
    echo $items[0]->n;
}

echo 'done';
