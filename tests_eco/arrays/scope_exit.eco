// the destructor is an ordinary call in the tree, appended at the end of the scope that owns the
// array - so `-ar` shows it and the type checker validates it, exactly as it does for any other
// owning type. nothing about scope exit is array-specific
{
    array<int32> $inner = [1, 2, 3];
    echo $inner->count();
}

array<int32> $outer = [9];
echo $outer[0];
