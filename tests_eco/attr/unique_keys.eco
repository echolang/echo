public struct Route
{
    public string $path;
    public function<int32()> $call;
}

#[http::get: "/a"]
public function a() : int32
{
    return 1;
}

#[http::get: "/b"]
public function b() : int32
{
    return 2;
}

int32 $sum = 0;
foreach (attr::of<Route>("http::get", "path") as const &$row) {
    $sum = $sum + $row->call();
    echo $row->path;
}
echo $sum;
