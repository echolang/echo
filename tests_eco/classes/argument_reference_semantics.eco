// what a function does to its argument depends on the storage class alone. the two `twice` have
// identical bodies: writing through the class parameter reaches the caller's object, writing
// through the struct parameter reaches a copy the callee owns.
//
// they are also two overloads - a class and a struct of the same shape are distinct types

class CPoint
{
    float32 $x;
    float32 $y;
}

struct SPoint
{
    float32 $x;
    float32 $y;
}

function twice(CPoint $point) : void
{
    $point->x = $point->x * 2;
    $point->y = $point->y * 2;
}

function twice(SPoint $point) : void
{
    $point->x = $point->x * 2;
    $point->y = $point->y * 2;
}

$cpoint = CPoint(42, 69);
$spoint = SPoint(42, 69);

twice($cpoint);
twice($spoint);

// the class was mutated in place
echo $cpoint->x;
echo $cpoint->y;

// the struct was not - the callee doubled its own copy
echo $spoint->x;
echo $spoint->y;
