// `ref_count` is the one builtin that is both generic and takes an argument. its parameter is a
// *borrow*: a by-value class parameter is +1, so the answer would be one too high at every call -
// which is exactly the question the caller is asking
#[builtin: "ref_count"]
function ref_count<T>(T& $handle) : usize;

class Handle { int32 $x; }

// a null handle owns nothing, so the count is 0. that is what lets a copy-on-write check read as one
// condition: static bytes with no owner are not uniquely owned either, so they clone before mutating
Handle $none = null;
echo ref_count($none);

$a = Handle(1);
echo ref_count($a);

$b = $a;
echo ref_count($a);
