// **the whole shape is static**, so a struct of scalars is *one* printf with one vararg per leaf - not
// one call per line. this is the only assertion that the buffer works at all: without it the feature
// degrades silently to a call per leaf and every other golden still passes

struct Wide
{
    int32 $a;
    int32 $b;
    int32 $c;
    int32 $d;

    constructor(int32 $a, int32 $b, int32 $c, int32 $d)
    {
        $this->a = $a;
        $this->b = $b;
        $this->c = $c;
        $this->d = $d;
    }
}

dprint(Wide(1, 2, 3, 4));
