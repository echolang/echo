enum Node
{
    case leaf(int32 $n);
    indirect case box(Node $inner);
}

function read(const Node& $n) : int32
{
    return match ($n) {
        Node::leaf($v) => $v,
        Node::box($inner) => read($inner),
    };
}

Node $a = .box(.leaf(1));
Node $b = $a;

match ($b) {
    Node::box($inner) => {
        match ($inner) {
            Node::leaf($v) => {
                $v = 9;
            },
            else => {},
        };
    },
    else => {},
};

echo read($a);
echo read($b);
