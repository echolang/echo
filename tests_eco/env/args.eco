// the argument surface, over an `args:` line - all four spellings of it, agreeing.
//
// `arg(0)` is the program's own name and is a path that differs per machine and per run mode, so what is
// asserted about it is a shape rather than a value. Everything after it is the case's own.

echo std::env::argc();

// the program name: under `run` the source file, under `build` the linked binary
echo std::env::arg(0)->ends('.eco');

// indexed
echo std::env::arg(1);
echo std::env::arg(2);

// the cursor - and its key contract, which is what makes the index available
foreach (std::env::args() as $i => $a) {
    echo $i;
}

// materialized, and agreeing with the indexed reads. `array<string>` and not `array<string::view>`: this
// one *owns* its arguments, so they outlive the walk above - which is the whole reason to pay for it
array<string> $all = std::env::argv();
echo $all->count();

// through `->view()`, because the two sides are different types now: an owning `string` compared against
// the `string::view` `arg()` hands back. that is the cost of owning them, and it is one call
echo $all[1]->view()->equals(std::env::arg(1));
echo $all[2]->view()->equals(std::env::arg(2));

// and they own their bytes rather than windowing argv's: the block the platform handed `main` is not
// where these live, which is the whole difference from `args()` above
echo mem::live_allocations() > 0;
