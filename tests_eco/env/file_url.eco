// `file_url` is a string transform: backslash to slash, a third slash for a drive
// path, percent-encoding for anything that is not unreserved / `/` / `:`.

string $a = guard std::fs::path('/tmp/fixture.txt')->file_url();
echo $a;
string $b = guard std::fs::path('/tmp/First Last/x')->file_url();
echo $b;
echo std::fs::path('foo')->file_url() == null;
echo std::fs::path('')->file_url() == null;
