// the windows arm of join uses a backslash, and still treats a trailing
// slash as already separated. --target-os picks the arm without native-linking.

echo std::fs::path('foo')->join('bar')->string();
echo std::fs::path('foo/')->join('bar')->string();
echo std::fs::path("foo\u{5C}")->join('bar')->string();
echo std::fs::path('')->join('bar')->string();
