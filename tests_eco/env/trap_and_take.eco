// a trapped signal is recorded rather than acted on, and read back from ordinary code. interrupt and
// terminate are the two every platform has, so this case runs on all three hosts
use std::env;

echo env::signal::caught();

guard env::signal::trap() else ($e) {
    die($e->message());
}

guard env::signal::raise(.terminate) else ($e) {
    die($e->message());
}
guard env::signal::raise(.interrupt) else ($e) {
    die($e->message());
}

echo env::signal::caught();
echo env::signal::caught(.terminate);

env::signal $last = guard env::signal::last();
echo $last->name();

while (env::signal::caught()) {
    env::signal $k = guard env::signal::take();
    echo $k->name();
}

echo env::signal::caught();
