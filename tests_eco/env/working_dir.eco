// `cwd` is the one function in this module that allocates: `getcwd` writes into a buffer the
// caller sizes, so the bytes are ours and an owning `std::fs::path` is the only honest return type.
//
// the path itself differs per machine, so what is asserted is its shape - and the count, which is **two**
// rather than one: a `path` holds a `string`, and that string owns a `str::buf`, so there is its heap
// block and the byte buffer inside it. The scratch buffer the growth loop allocated is *not* among
// them, which is the thing worth pinning - it is freed on both the success and the retry path.

std::fs::path $cwd = std::env::cwd();

echo $cwd->string()->size() > 0;
#[if: os == windows]
echo $cwd->view()->byte(1) == 58;
#[else]
echo $cwd->is_absolute();
#[end]

echo mem::live_allocations();
