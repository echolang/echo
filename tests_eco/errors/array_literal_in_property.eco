// a property's default initializer is not walked by any pass below the parser - AST::OwnershipPass
// and AST::PointerAdjuster have no arm for a type declaration either - so an array literal there is
// never expanded, and it is the ordinary conversion rule that rejects it. `[unknown]` in the message
// is the literal being honest: it has no type of its own, the destination supplies one, and a
// property initializer is not a destination the expansion can reach
struct Doc
{
    array<int32> $body = [1, 2];
}

echo 1;
