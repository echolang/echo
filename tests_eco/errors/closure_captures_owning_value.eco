// capture is by value, and copying an owning value is a whole taxonomy - a retain, a copy constructor,
// or nothing that exists. a closure's environment is torn down uniformly precisely *because* it holds
// no owner, so admitting one here would leak it

struct Buffer
{
    usize $len;

    destructor()
    {
        echo 1;
    }
}

function outer() : usize
{
    Buffer $b = Buffer(3);

    function<usize()> $f = function() : usize { return $b->len; };

    return $f();
}

echo outer();
