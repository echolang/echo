// a capture is read where it lives, in the frame the closure is created in. two frames out is not
// reachable from *this* closure's creation site - the enclosing closure would have to capture it and
// hand it on

function outer() : int32
{
    int32 $n = 5;

    function<int32()> $f = function() : int32 {
        function<int32()> $g = function() : int32 { return $n; };
        return $g();
    };

    return $f();
}

echo outer();
