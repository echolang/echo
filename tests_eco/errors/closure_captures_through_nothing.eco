// the outer list is closed and empty, so it cannot hand `$n` through to the inner closure

function outer() : int32
{
    int32 $n = 5;

    function<int32()> $f = function[]() : int32 {
        function<int32()> $g = function() : int32 { return $n; };
        return $g();
    };

    return $f();
}

echo outer();
