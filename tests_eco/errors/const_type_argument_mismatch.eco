// the other direction of the same rule: a parameter spelling `bag<const T>` substitutes to
// `bag<const int32>`, which is a different type from the `bag<int32>` handed to it. refused, and the
// two types are named - which is the whole reason the const is kept in a type argument rather than
// stripped into a binding that then fails to fit its own argument

struct bag<T>
{
    T $v;
}

function unwrap_const<T>(bag<const T> $b) : T
{
    return $b->v;
}

bag<int32> $open = bag<int32>(2);

echo unwrap_const($open);
