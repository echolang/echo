// two identically-shaped copy constructors are an ordinary duplicate signature, reported at the
// second one's own `constructor` keyword - the copy-constructor slot adds no diagnostic of its own

struct Box
{
    usize $tag;

    constructor(usize $t)
    {
        $this->tag = $t;
    }

    constructor(Box& $other)
    {
        $this->tag = $other->tag;
    }

    constructor(Box& $another)
    {
        $this->tag = $another->tag;
    }

    destructor()
    {
        echo $this->tag;
    }
}
