// `Box&` beside `const Box&` are two distinct signatures, so they are not a duplicate declaration -
// but both are the copy constructor, and a type has one. nothing would decide which of them an
// implicit `$b = $a` meant, so it needs its own diagnostic

struct Box
{
    usize $tag;

    constructor(usize $t)
    {
        $this->tag = $t;
    }

    constructor(Box& $other)
    {
        $this->tag = $other->tag;
    }

    constructor(const Box& $another)
    {
        $this->tag = $another->tag;
    }

    destructor()
    {
        echo $this->tag;
    }
}
