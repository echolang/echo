struct Low { int32 $n; }
struct High { int32 $n; }
struct Other { int32 $n; }

function f(High $h) : int32 { return $h->n; }
function f(Other $o) : int32 { return $o->n + 100; }

extension High
{
    #[implicit]
    public static function from(Low $l) : High
    {
        return High($l->n);
    }
}

extension Other
{
    #[implicit]
    public static function from(Low $l) : Other
    {
        return Other($l->n);
    }
}

echo f(Low(3));
