// a constructor writing a field of its own `$this` owes no teardown, because `$this` is a fresh
// zero-filled slot. that holds for the *first* write only, so a second write to the same owning
// field is rejected rather than leaking what the first one built

struct Inner
{
    usize $tag;

    constructor(usize $t)
    {
        $this->tag = $t;
    }

    destructor()
    {
        echo $this->tag;
    }
}

struct Outer
{
    Inner $inner;

    constructor(usize $t)
    {
        $this->inner = Inner($t);
        $this->inner = Inner($t + 1);
    }
}

$a = Outer(5);
