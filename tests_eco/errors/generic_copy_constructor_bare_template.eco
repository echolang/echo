// inside `struct Box<T>`, the unqualified name `Box` resolves to the *template*, which is not a type
// any value has - so `Box& $other` is not the borrow of `Box<T>` and is not the copy constructor.
// reported at the parameter, rather than later at a call site that fails to copy

struct Box<T>
{
    usize $tag;
    ptr<T> $slot;

    constructor(usize $t, ptr<T> $s)
    {
        $this->tag = $t;
        $this->slot:$ = $s;
    }

    constructor(Box& $other)
    {
        $this->tag = $other->tag;
        $this->slot:$ = $other->slot;
    }

    destructor()
    {
        echo $this->tag;
    }
}
