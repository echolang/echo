// the conversion rule compares the declared return type with the parameter type exactly, and on a
// generic owner the declaration still mentions `T` - so it would be accepted and then never fire.
// refused at the declaration instead. see the todo this diagnostic points at
// spelled `Window`/`Bag` rather than `Slice`/`Array`, which the stdlib now declares in the root
// namespace - the refusal is about a generic owner, not about these two types
struct Window<T> { ptr<T> $at; }

struct Bag<T>
{
    ptr<T> $at;

    #[implicit]
    function window() : Window<T> { return Window<T>($this->at); }
}

echo 1;
