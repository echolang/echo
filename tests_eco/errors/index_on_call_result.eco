// a call result is a value, not a place, and only a place can be indexed - there is no storage to
// take the element's address in. it used to abort the compiler on a shunting-yard assert, because a
// `[` no postfix chain claimed parses as an array literal and lands as a second operand
function make() : Array<int32>
{
    Array<int32> $a = [1, 2];
    return $a;
}

echo make()[0];
