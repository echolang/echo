// a vtable needs one body per requirement, and a generic class only gets bodies per *call site* - so
// storing an instantiation as an interface would reference symbols nothing emits. the constraint path
// works for a generic today, which is what makes this a hole rather than a wall

interface Sized<T>
{
    function first() : T;
}

class Bag<E> : Sized<E>
{
    E $item;

    function first() : E {
        return $this->item;
    }
}

$bag = Bag<int32>(7);
Sized<int32> $erased = $bag;
