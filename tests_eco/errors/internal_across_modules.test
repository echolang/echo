modules: errors/lib_internal_surface
expect: fail

# **the default is the module**, so a consumer is refused every name the library did not write `public` on
# while its stated surface stays callable. the label is the declaration in the *library's* file - the
# token names its own file, so a cross-module span no longer falls back to the consumer
