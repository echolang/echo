// a member is read from an address, and a value nobody stored has none. for a class it is also the
// question of who releases the intermediate, so the answer is to bind it to a variable first

struct Inner { int32 $tag; }

struct Outer
{
    Inner $in;
    function get() : Inner { return $this->in; }
}

$o = Outer(Inner(5));
echo $o->get()->tag;
