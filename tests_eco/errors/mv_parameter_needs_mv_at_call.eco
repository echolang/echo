// a `mv` parameter given a place the caller did not mark. the annotation exists so that a call
// which hands ownership away is visible as one in the source

struct Buffer
{
    ptr<uint8> $data;

    destructor()
    {
        mem::free($this->data);
    }
}

function consume(mv Buffer $b) : void {}

$a = Buffer(mem::alloc<uint8>(1));
consume($a);
