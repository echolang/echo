// `[` is consumed by the postfix chain, which binds tighter than every binary operator by
// construction and never reaches the shunting yard - so a number here would be stored and compared
// against nothing
struct Bag { ptr<int32> $at; }

operator(45, left) (Bag& $b)[usize $i] : int32&
{
    unsafe { return &$b->at:$[$i]; }
}

echo 1;
