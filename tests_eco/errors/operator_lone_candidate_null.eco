// `$p == null` is a BinaryExprNode (`binary_has_builtin_meaning` answers true for identity
// against a written null), so TypeChecker reports AST::binary_operand_refusal at the `==`.
// a declared `operator ==` on a different type must not change that sentence, and must not
// name `Point`

struct Point { int32 $x; }
struct P { int32 $v; }

operator (Point $a) == (Point $b) : bool
{
    return $a->x == $b->x;
}

$p = P(1);

echo $p == null;
