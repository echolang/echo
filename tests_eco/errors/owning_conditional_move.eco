// moved on one branch and not the other. the merge leaves the variable unset, so nothing would
// destroy the value on the branch that kept it - and there is no runtime drop flag. rejected
// rather than leaked

struct Buffer
{
    ptr<uint8> $data;

    destructor()
    {
        mem::free($this->data);
    }
}

function consume(mv Buffer $b) : void {}

$a = Buffer(mem::alloc<uint8>(1));

if (true) {
    consume(mv $a);
}
