// an implicit copy of a type whose owning leaf is a raw pointer: both copies would point at one
// allocation and both destructors would free it. rejected, naming `mv`

struct Buffer
{
    ptr<uint8> $data;

    destructor()
    {
        mem::free($this->data);
    }
}

$a = Buffer(mem::alloc<uint8>(1));
$b = $a;
