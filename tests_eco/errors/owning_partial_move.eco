// moving one field out and leaving the rest is rejected: the analysis is keyed on a whole variable,
// and it would also have to answer what the destructor of a partly-moved struct does

struct Buffer
{
    ptr<uint8> $data;

    destructor()
    {
        mem::free($this->data);
    }
}

struct Document
{
    Buffer $body;
    usize $version;
}

$d = Document(Buffer(mem::alloc<uint8>(1)), 1);
$b = mv $d->body;
