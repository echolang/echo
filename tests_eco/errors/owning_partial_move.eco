// moving one field out and leaving the rest is rejected - ownership is tracked per variable, and a
// partly-moved struct has no answer for what its destructor does

struct Buffer
{
    ptr<uint8> $data;

    destructor()
    {
        mem::free($this->data);
    }
}

struct Document
{
    Buffer $body;
    usize $version;
}

$d = Document(Buffer(mem::alloc<uint8>(1)), 1);
$b = mv $d->body;
