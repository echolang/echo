// a user destructor cannot run over a hole: leftover fields are not what it describes

struct Buffer
{
    ptr<uint8> $data;

    destructor()
    {
        mem::free($this->data);
    }
}

struct Document
{
    Buffer $body;
    usize $version;

    destructor()
    {
    }
}

$d = Document(Buffer(mem::alloc<uint8>(1)), 1);
$b = mv $d->body;
