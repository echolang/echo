modules: errors/lib_file_private
expect: fail

# `private` on a declaration is the *file* and not the module: a second file of the same module is refused,
# while the declarations beside it that said nothing - and so belong to the module - are reached. four
# spellings of the same name are each refused where they are written: a type, a constructor call, a function
# call and a constant
