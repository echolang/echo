// only a borrow parameter auto-borrows. a `ptr<T>` parameter can be null, so taking an address
// is a decision the caller should be able to see in the source
// (book/concept/pointers_and_refs_v2.md, "Passing to functions")
function maybe_inc(ptr<int> $x) : void {
    $x = $x + 1;
}

$a = 5;
maybe_inc($a);
