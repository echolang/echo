// how C's variadic convention unpacks a struct is platform specific, so a struct is refused rather
// than half-supported. a `string` is one of these, which is why `->cstr()` is the way across
struct Point
{
    int32 $x;
    int32 $y;
}

extern {
    function snprintf as c_snprintf(
        ptr<uint8> $out, usize $size, ptr<const uint8> $format, variadic_args $args) : int32;
}

ptr<uint8> $buf = mem::alloc<uint8>(16);
string $format = '%d';
Point $p = Point(1, 2);

c_snprintf($buf, 16, $format->cstr(), [$p, $format]);
