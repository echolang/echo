// reading an element of a container returned by value works (tests_eco/arrays/index_on_call_result);
// writing one does not. the bytes are destroyed at the end of the statement, so nothing would ever read
// what was written - the same answer, from the same rule, that errors/write_to_member_of_temporary gives
// for a field
function make() : array<int32>
{
    array<int32> $a = [1, 2];
    return $a;
}

make()[0] = 5;
