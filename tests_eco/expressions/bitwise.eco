// `& | << >>`, the four that joined `^`. errors/bitwise_on_a_float is the refusal half.
//
// two things are the point of this case. **`>>` is the one bitwise operator that is not sign-agnostic**,
// so it reads AST::binary_operation_type the way `/ % < >` do - arithmetic over a signed operand, logical
// over an unsigned one. And AST::const_fold and ExprCodegen::gen_binary_expr have to agree about every one
// of them, or a `const if` takes one arm and the `if` beside it takes the other

int32 $a = 12;
int32 $b = 10;

echo $a & $b;
echo $a | $b;
echo $a << 2;
echo $a >> 2;

// **arithmetic**: the sign bit is replicated, so this stays negative
int32 $neg = -16;
echo $neg >> 2;

// **logical**: the same bit pattern in an unsigned type brings in zeroes instead. these two lines are the
// whole reason `>>` reads the operation's signedness rather than emitting one spelling
uint32 $wide = 4294967280;
uint32 $two = 2;
echo $wide >> $two;

// narrow and unsigned, so a sign extension anywhere would show
uint8 $byte = 255;
echo $byte & 15;
echo $byte >> 4;

// ---- **a shift count is a count, and it gets no vote** - AST::binary_reconciles_operands
//
// every other binary operator reconciles its two sides through AST::common_numeric_type, and a shift used
// to as well. so the *count's* declared type decided both the width and the signedness of the shift: the
// three lines below answered 1073741820, -4 and 219902325555200 - the first two being the same shift
// written two ways and disagreeing, and the third having left `uint8` altogether

int32 $signed_count = 2;

// an unsigned count must not make an arithmetic shift a logical one. both are -4 or the rule is not a rule
echo $neg >> $two;
echo $neg >> $signed_count;

// and a wider count must not widen the operand. this is a uint8 shift that wrapped, not an int64 one that
// did not - `200 << 3` is 1600, which is 64 in a uint8
uint8 $small = 200;
int64 $wide_count = 3;

echo $small << $wide_count;

// precedence, straight from C and already in AST::op_precedence: shift binds tighter than `&`, `&`
// tighter than `^`, `^` tighter than `|`. so this is `1 | (2 ^ (4 & 12))` = `1 | (2 ^ 4)` = `1 | 6`
echo 1 | 2 ^ 4 & 12;

// and `1 << 3` before the `&`, so `8 & 12`
echo 1 << 3 & 12;

// **the same operands, folded and then emitted.** one answer, or the case fails
const if ((12 & 10) == 8 && (12 | 10) == 14 && (12 << 2) == 48 && (12 >> 2) == 3) {
    echo 100;
}
else {
    echo 200;
}

if (($a & $b) == 8 && ($a | $b) == 14 && ($a << 2) == 48 && ($a >> 2) == 3) {
    echo 100;
}
else {
    echo 200;
}

// a signed fold has to keep the sign too, which is fold_arithmetic's `ashr` branch
const if ((-16 >> 2) == -4) {
    echo 100;
}
else {
    echo 200;
}

// a `const` declaration folds through all four
const int32 MASK = (0xFF & 0x3C) | (1 << 6);
echo MASK;
