// every integer width accepts literals up to its real maximum, including the 64-bit ones
uint64 $max_u64 = 18446744073709551615;
int64 $min_i64 = -9223372036854775807;
uint32 $max_u32 = 4294967295;
uint16 $max_u16 = 65535;
uint8 $max_u8 = 255;

echo $max_u64;
echo $min_i64;
echo $max_u32;
echo $max_u16;
echo $max_u8;

// a small literal in a 64-bit position
uint64 $count = 4;
echo $count;
