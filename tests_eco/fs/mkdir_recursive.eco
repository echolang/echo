string $pid = str::from(std::env::pid());
string $root = std::fs::join(std::env::tmp(), "echo-mkdir-r-{$pid}")->string();
string $deep = std::fs::join($root, 'a')->join('b')->string();

bool $m = guard std::fs::mkdir($deep, recursive: true);
echo $m;

bool $again = guard std::fs::mkdir($deep, recursive: true);
echo $again;

bool $dot = guard std::fs::mkdir('.', recursive: true);
echo $dot;

bool $empty = guard std::fs::mkdir('', recursive: true);
echo $empty;

string $file = std::fs::join($root, 'as-file')->string();
guard std::fs::writefile($file, 'x');
result<bool, std::io::ioerror> $through = std::fs::mkdir(std::fs::join($file, 'child'), recursive: true);
echo $through->failed();

guard std::fs::remove_all(std::fs::path($root));
bool $here = guard std::fs::exists($root);
echo $here;
