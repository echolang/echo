// a value with no storage may answer a borrow parameter: the compiler mints a slot for it that lives
// exactly as long as the call. the minimal shape of the rule - before it, `inc(41)` reported that no
// overload accepted these arguments, because the borrow rank refused anything that was not a place

function inc(int32& $x) : int32
{
    $x = $x + 1;
    return $x;
}

// a literal
echo inc(41);

// an arithmetic result, which is the same thing one node deeper
echo inc(20 + 21);

// and a place, which still takes the ordinary borrow and is unchanged by any of it
int32 $named = 41;
echo inc($named);
echo $named;
