// an overloaded &name in a match arm takes the match's unified type as its
// destination - the same hole ReturnParser used to have
function add(int32 $n) : int32
{
    return $n + 1;
}

function add(float64 $n) : float64
{
    return $n + 1.0;
}

function sub(int32 $n) : int32
{
    return $n - 1;
}

enum Side
{
    case left;
    case right;
}

function pick(Side $s) : extern function<int32(int32)>
{
    return match ($s) {
        Side::left  => &add,
        Side::right => &sub,
    };
}

extern function<int32(int32)> $f = pick(Side::left);

echo $f(41);
