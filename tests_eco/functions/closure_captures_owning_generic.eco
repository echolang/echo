// the type is only known to own something after monomorphization: Box<int32> has a
// destructor because Box<T> does, and the captured variable is not typed Box<int32>
// until the fixpoint has settled the call. a written copy constructor is what makes
// the capture a copy rather than CannotCopy

struct Box<T>
{
    T $value;

    constructor(T $v)
    {
        $this->value = $v;
    }

    constructor(Box<T>& $other)
    {
        $this->value = $other->value;
    }

    destructor()
    {
        echo 1;
    }

    function get() : T
    {
        return $this->value;
    }
}

function outer() : int32
{
    $b = Box<int32>(5);
    function<int32()> $f = function() : int32 { return $b->get(); };

    return $f();
}

echo outer();
