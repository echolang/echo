// a capture two frames out is handed through the enclosing closure: the outer captures the local,
// the inner captures the outer environment's property

function outer() : int32
{
    int32 $n = 5;

    function<int32()> $f = function() : int32 {
        function<int32()> $g = function() : int32 { return $n; };
        return $g();
    };

    return $f();
}

echo outer();
