// an `extern { }` block binds C symbols. the C name comes first, and `as` renames it for Echo
// callers - the symbol is what reaches the linker, the Echo name is what call sites use
extern {
    function malloc as raw_alloc(usize $bytes) : ptr<uint8>;
    function free as raw_free(ptr<uint8> $p) : void;
    function abs as c_abs(int32 $value) : int32;
}

// a renamed symbol, called under its Echo name
ptr<uint8> $buf = raw_alloc(4);
$buf:$[0] = 65;
$buf:$[1] = 66;
echo $buf:$[0];
echo $buf:$[1];
raw_free($buf);

// a plain C function, and a call statement that discards its result
echo c_abs(-42);
c_abs(-1);

echo 1;
