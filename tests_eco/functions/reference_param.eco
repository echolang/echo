// a borrow parameter auto-borrows its argument, so the callee mutates the caller's variable.
// a bare variable and an explicit `&$a` behave the same

function inc(int &$x) : void {
    $x = $x + 1;
}

$a = 5;

// bare variable: coerced to its address
inc($a);
echo $a;

// explicit address-of: identical effect
inc(&$a);
echo $a;
