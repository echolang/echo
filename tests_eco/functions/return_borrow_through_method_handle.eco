// visu Entities.get: a method returns a class handle the receiver still holds.
// returning a projection through a local copy of that handle is not a dangle

class Store
{
    public int32 $n;

    public constructor(int32 $n)
    {
        $this->n = $n;
    }

    public function slot() : int32&
    {
        return $this->n;
    }
}

class World
{
    public Store $store;

    public constructor(Store $store)
    {
        $this->store = $store;
    }

    public function view() : Store
    {
        return $this->store;
    }

    public function get() : int32&
    {
        Store $view = $this->view();
        return $view->slot();
    }
}

World $w = World(Store(3));
int32& $n = $w->get();
$n = 9;
echo $w->store->n;
