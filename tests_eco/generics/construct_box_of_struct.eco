// a struct has no class handle, so it enters a `T : class` factory wrapped in
// `rc<T>`. that is a class; seat an already-built T

struct YetAnotherOne
{
    float64 $n;
}

function make<T : class, A>(A $arg) : T
{
    return T($arg);
}

$c = make<rc<YetAnotherOne>>(YetAnotherOne(3.14));
echo $c->value->n;

$d = rc<YetAnotherOne>(YetAnotherOne(2.5));
echo $d->value->n;
