// a generic's copy constructor needs no instantiation logic of its own. the copy call the ownership
// pass inserts names the *template's* declaration, and the receiver `Box<T>&` binds T from the type of
// the value being copied - so the next monomorphizer round rewires it to the instance, exactly as it
// does for the drop that calls the template's destructor.
//
// that is the reason the ownership pass runs inside the monomorphizer's fixpoint rather than after it:
// inserting a copy *creates* a generic call site.
//
// two instantiations, so the goldens would show it if one of them collapsed onto the other

struct Box<T>
{
    usize $tag;
    ptr<T> $slot;

    constructor(usize $t, ptr<T> $s)
    {
        $this->tag = $t;
        $this->slot:$ = $s;
    }

    constructor(Box<T>& $other)
    {
        echo 700;
        $this->tag = $other->tag + 1;
        $this->slot:$ = mem::alloc<T>(1);
    }

    destructor()
    {
        echo $this->tag;
        mem::free<T>($this->slot);
    }
}

$i = Box<int32>(10, mem::alloc<int32>(1));
$f = Box<float64>(20, mem::alloc<float64>(1));

$i_copy = $i;
$f_copy = $f;

echo 99;
