// a generic's copy constructor needs no instantiation logic of its own: the inserted copy call names
// the *template's* declaration, the receiver `Box<T>&` binds T from the value being copied, and the
// next monomorphizer round rewires it to the instance - the same path a drop takes.
//
// two instantiations, so the goldens show it if one collapses onto the other

struct Box<T>
{
    usize $tag;
    ptr<T> $slot;

    constructor(usize $t, ptr<T> $s)
    {
        $this->tag = $t;
        $this->slot:$ = $s;
    }

    constructor(Box<T>& $other)
    {
        echo 700;
        $this->tag = $other->tag + 1;
        $this->slot:$ = mem::alloc<T>(1);
    }

    destructor()
    {
        echo $this->tag;
        mem::free<T>($this->slot);
    }
}

$i = Box<int32>(10, mem::alloc<int32>(1));
$f = Box<float64>(20, mem::alloc<float64>(1));

$i_copy = $i;
$f_copy = $f;

echo 99;
