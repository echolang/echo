// a custom constructor on a *generic* struct: every instance clones the body with its own `$this`,
// so the two instantiations below write into separate storage

struct Box<T> {
    T $value;
    T $backup;

    constructor(T $v) {
        $this->value = $v;
        $this->backup = $v;
    }
}

$a = Box<int32>(5);
echo $a->value;
echo $a->backup;

// a second instantiation, writing into its own $this
$b = Box<float64>(2.5);
echo $b->value;
echo $b->backup;
