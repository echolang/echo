public class Box<T>
{
    public array<T> $items;

    public constructor(const array<T>& $items)
    {
        $this->items = $items;
    }

    public function again() : Box<T>
    {
        return $this;
    }
}

function size<T>(const array<T>& $v) : usize
{
    return $v->count();
}

function boxed<T>(const array<T>& $v) : Box<T>
{
    return Box<T>($v);
}

function keys<K, V>(const map<K, V>& $m) : usize
{
    return $m->count();
}

function pair<T>(const array<T>& $v, T $extra) : usize
{
    return $v->count() + ($extra as usize);
}

// a literal alone binds T from its elements, as `$a = [3, 1]` would declare it
echo size([3, 1]);
echo keys(['a' => 1, 'b' => 2]);

// and the body around it is still owned: a chain on a returned class beside it needs a temporary
echo boxed([3, 1])->again()->again()->items->count();

// a typed argument decides T; the literal is filled at it. `pair([1, 2], $big)` is the
// defer pin: T is int64 from `$big`, not int32 from the list's first element
int64 $big = 5000000000;
echo pair([1, 2], 3);
echo pair([1, 2], $big);
echo pair([], $big);
echo size([$big, 1]);
echo size([[1, 2]]);

// in an overload set the literal's shape picks: a list is never a map, a result or a status
function kind<T>(const array<T>& $v) : string
{
    return 'list';
}

function kind<K, V>(const map<K, V>& $m) : string
{
    return 'map';
}

function kind<T, E>(const result<T, E>& $r) : string
{
    return 'result';
}

function kind<E>(const status<E>& $s) : string
{
    return 'status';
}

echo kind([3, 1]);
echo kind(['a' => 1]);
