// a literal in a generic body is typed where the *template* is parsed, where the expected type is
// the unsubstituted T - so it falls back to int32. cloning substitutes the declared return type to
// float64 but the literal is untouched, and codegen emitted `ret i32 0` from a double-returning
// function. the fix is not in the monomorphizer: a return simply had no destination to fit, for
// generics and plain functions alike, so it now fits the declared type at codegen like every other
// destination does. the shape is `mem::alloc<T>(usize) : ptr<T>` - T appears only in the return

function zero_of<T>(int32 $ignored) : T
{
    return 0;
}

// the same instance boundary with a non-literal that needs a widening conversion
function widened<T>(int32 $v) : T
{
    return $v;
}

int32 $a = zero_of<int32>(1);
float64 $b = zero_of<float64>(1);

echo $a;
echo $b;

int64 $c = widened<int64>(7);
float64 $d = widened<float64>(7);

echo $c;
echo $d;
