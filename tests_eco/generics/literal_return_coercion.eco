// a literal in a generic body is typed where the *template* is parsed, against an unsubstituted T,
// so it falls back to int32 and cloning leaves it alone. each instance fits it to the substituted
// return type at codegen, like any other destination. the shape is `mem::alloc<T>(usize) : ptr<T>`,
// where T appears only in the return

function zero_of<T>(int32 $ignored) : T
{
    return 0;
}

// the same instance boundary with a non-literal that needs a widening conversion
function widened<T>(int32 $v) : T
{
    return $v;
}

int32 $a = zero_of<int32>(1);
float64 $b = zero_of<float64>(1);

echo $a;
echo $b;

int64 $c = widened<int64>(7);
float64 $d = widened<float64>(7);

echo $c;
echo $d;
