// a literal in a generic body has no concrete type to be typed against, since T says nothing until
// it is substituted. it is typed on its own (int32) and fitted at its destination once the instance
// exists - the same rule as the return case (literal_return_coercion.eco)

// through a pointer: the assignment writes into the pointee, so the expected type is T itself
function poke<T>(ptr<T> $v) : void
{
    $v = 42;
}

// a declaration whose slot is the bare type parameter
function make<T>() : T
{
    T $x = 42;
    return $x;
}

// a bool literal takes the same path - it is typed once the instance exists. what it may *become*
// there is narrower than a number's: `T = bool` is the only instance this compiles for, because a
// bool is not a width and a written `true` names no number. errors/literal_at_bool_destination is
// the refusal, and it is the same one `int32 $k = true;` gets outside a generic
function truthy<T>() : T
{
    T $x = true;
    return $x;
}

int32 $a = 1;
float64 $b = 2.5;
uint8 $c = 3;

poke(&$a);
poke(&$b);
poke(&$c);

echo $a;
echo $b;
echo $c;

echo make<int32>();
echo make<float64>();
echo make<uint8>();

echo truthy<bool>();
