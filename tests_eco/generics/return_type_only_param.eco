// a generic whose type parameter appears ONLY in the return type - the shape of
// `mem::alloc<T>(usize) : ptr<T>`. the arguments are identical across the two instantiations, so
// the mangled name has to fold in the instantiation arguments to keep them apart
function reinterpret<T>(ptr<uint8> $p) : ptr<T>
{
    return ptr<T>($p:$);
}

int32 $value = 424242;
ptr<uint8> $raw = ptr<uint8>(&$value);

ptr<int32> $as_int = reinterpret<int32>($raw);
ptr<uint8> $as_byte = reinterpret<uint8>($raw);

// the whole int32 through one instance, and its low byte through the other.
// 424242 is 0x67932, so the low byte is 0x32 - 50
echo $as_int;
echo $as_byte;
