// `hash::of` is an overload set rather than a `contract::`, because a primitive cannot declare a
// conformance - so an interface constraint would refuse `map<int32, V>`, the first map anybody writes
//
// the goldened **string** hashes are what pin the FNV constants. they are canonical FNV-1a 64 values and
// can be checked against any other implementation; note the compiler's own `fnv1a64`, which hashes module
// cache keys, carries a basis one digit short of the real one - the two are unrelated uses that never
// compare a value, so this file spells the canonical constants
//
// the **integer** values are not canonical anything - they are `hash::mix`, a SplitMix64 finalizer, and the
// only claims made about them are the ones asserted below: equal numbers agree, unequal ones do not

// **the property the whole design exists for**: the same text in two different buffers hashes the same.
// byte-hashing a `string` would hash its heap pointer, and these two would land in different buckets while
// `==` said they were equal - the one way a hash table breaks that nothing else catches
string $literal = 'hello';
string $built = '';
$built->append('hello');

echo hash::of($literal);
echo hash::of($built);
echo $literal == $built;

// a substring hashes as its own text rather than as its parent's
string $big = 'xxhelloxx';
echo hash::of($big->sub(2, 5));

// and a view agrees with the string that owns it
echo hash::of($literal->window);

// a different text, so a different hash
echo hash::of('world');

// ---- the integer overloads. usize and isize are their own primitives, not spellings of uint64/int64

echo hash::of(1);

int64 $i64 = 1;
usize $u = 1;
uint8 $b8 = 1;

// **an integer is hashed by value, not by width.** all five of these hold the number 1, so all five agree -
// they widen to one `uint64` before `mix` ever sees them. A map has one key type, so nothing inside one can
// observe the difference either way; what this pins is that the rule is *value*, deliberately, rather than
// the byte-count artefact walking bytes used to produce
echo hash::of($i64);
echo hash::of($u);
echo hash::of($b8);
echo hash::of(true);

// and signedness still separates what it should: the same 32 bits, read as two different numbers. the
// widening sign-extends one and not the other, so these must not collide
int32 $minus_one = -1;
uint32 $all_ones = 4294967295;

echo hash::of($minus_one) == hash::of($all_ones);

// two different numbers of the same width, which is the only thing a map actually needs
echo hash::of(1) == hash::of(2);

// ---- floats normalize zero, because +0.0 and -0.0 compare equal and do not share their bytes

float64 $pz = 0.0;
float64 $nz = -0.0;

echo hash::of($pz) == hash::of($nz);

float32 $pz32 = 0.0;
float32 $nz32 = -0.0;

echo hash::of($pz32) == hash::of($nz32);

// ---- combine is not commutative, so a pair and its reverse do not collide

echo hash::combine(hash::of(1), hash::of(2)) == hash::combine(hash::of(2), hash::of(1));

// ---- of_bytes is the explicit spelling, for a type that *is* its bytes

struct point { int32 $x; int32 $y; }

point $p = point(3, 4);
point $q = point(3, 4);

echo hash::of_bytes<point>($p) == hash::of_bytes<point>($q);
