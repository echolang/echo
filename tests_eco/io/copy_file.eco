// copy replaces what was there, carries the permission bits, and refuses a directory and itself
string $tmp = str::from(std::env::tmp());
string $pid = str::from(std::env::pid());
string $from = std::fs::join($tmp, "echo-io-copy-from-{$pid}.txt")->string();
string $to = std::fs::join($tmp, "echo-io-copy-to-{$pid}.txt")->string();

usize $w1 = guard std::fs::writefile($from, 'the new contents') else ($e) {
    echo $e->message();
    return 1;
}

// a longer file already at the destination: what is left of it must not survive the copy
usize $w2 = guard std::fs::writefile($to, 'an older and much longer set of contents') else ($e) {
    echo $e->message();
    return 1;
}

// rwx------ : 0700, which no umask produces on its own
bool $set = guard std::fs::chmod($from, std::fs::fileperms(0x1c0)) else ($e) {
    echo $e->message();
    return 1;
}

bool $copied = guard std::fs::copy($from, $to) else ($e) {
    echo $e->message();
    return 1;
}

string $read = guard std::fs::readfile($to) else ($e) {
    echo $e->message();
    return 1;
}

echo $read;

std::fs::fileinfo $i = guard std::fs::info($to) else ($e) {
    echo $e->message();
    return 1;
}

echo $i->perms->owner_writable();

// a directory is not a file to copy
result<bool, std::io::ioerror> $dir = std::fs::copy($tmp, $to);
echo $dir->failed();

// and a file copied onto itself is refused rather than truncated to nothing
result<bool, std::io::ioerror> $self = std::fs::copy($from, $from);
echo $self->failed();

string $still = guard std::fs::readfile($from) else ($e) {
    echo $e->message();
    return 1;
}

echo $still;

std::fs::remove($from);
std::fs::remove($to);
