string $name = 'echo-io-notdir-';
$name->append(str::from(std::env::pid()));
$name->append('.txt');
string $path = std::fs::join(std::env::tmp(), $name)->string();

usize $w = guard std::fs::writefile($path, 'x') else ($e) {
    echo $e->message();
    return 1;
}

std::fs::dir $d = guard std::fs::opendir($path) else ($e) {
    echo $e->missing();
    echo $e->not_a_directory();

    bool $rm = guard std::fs::remove($path) else ($err) {
        echo $err->message();
        return 1;
    }

    return 0;
}

echo 'opened';

bool $gone = guard std::fs::remove($path) else ($e) {
    echo $e->message();
    return 1;
}
