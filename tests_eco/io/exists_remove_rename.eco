string $dir = '';
$dir->append(str::from(std::env::tmp()));
$dir->append(std::env::DS);

string $a = $dir;
$a->append('echo-io-ren-a-');
$a->append(str::from(std::env::pid()));
$a->append('.txt');

string $b = $dir;
$b->append('echo-io-ren-b-');
$b->append(str::from(std::env::pid()));
$b->append('.txt');

function present(const string& $path) : bool
{
    bool $here = guard std::io::exists($path) else ($e) {
        echo $e->message();
        return false;
    }

    return $here;
}

echo present($a);

usize $w = guard std::io::writefile($a, 'moved') else ($e) {
    echo $e->message();
    return 1;
}

echo $w;
echo present($a);
echo present($b);

bool $ren = guard std::io::rename($a, $b) else ($e) {
    echo $e->message();
    return 1;
}

echo present($a);
echo present($b);

string $body = guard std::io::readfile($b) else ($e) {
    echo $e->message();
    return 1;
}

echo $body;

bool $rm = guard std::io::remove($b) else ($e) {
    echo $e->message();
    return 1;
}

echo present($b);
