string $name = 'echo-io-foreach-closed-';
$name->append(str::from(std::env::pid()));
$name->append('.txt');
string $path = std::fs::join(std::env::tmp(), $name)->string();

usize $w = guard std::fs::writefile($path, 'one\ntwo') else ($e) {
    echo $e->message();
    return 1;
}

std::io::file $f = guard std::fs::open($path, .read) else ($e) {
    echo $e->message();
    return 1;
}

$f->close();

int32 $n = 0;

foreach ($f as $line) {
    $n = $n + 1;
}

echo $n;

std::io::ioerror $err = guard $f->error() else {
    echo 0;
    echo 0;

    bool $gone = guard std::fs::remove($path) else ($e) {
        echo $e->message();
        return 1;
    }

    return 1;
}

echo 1;
echo $err->missing();

bool $rm = guard std::fs::remove($path) else ($e) {
    echo $e->message();
    return 1;
}
