string $name = 'echo-io-foreach-empty-';
$name->append(str::from(std::env::pid()));
$name->append('.txt');
string $path = std::fs::join(std::env::tmp(), $name)->string();

usize $w = guard std::fs::writefile($path, '') else ($e) {
    echo $e->message();
    return 1;
}

std::io::file $f = guard std::fs::open($path, .read) else ($e) {
    echo $e->message();
    return 1;
}

int32 $n = 0;

foreach ($f as $line) {
    $n = $n + 1;
    echo $line;
}

echo $n;

$f->close();

bool $rm = guard std::fs::remove($path) else ($e) {
    echo $e->message();
    return 1;
}
