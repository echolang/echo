string $name = 'echo-io-foreach-';
$name->append(str::from(std::env::pid()));
$name->append('.txt');
string $path = std::fs::join(std::env::tmp(), $name)->string();

usize $w = guard std::fs::writefile($path, 'one\ntwo\nthree') else ($e) {
    echo $e->message();
    return 1;
}

std::io::file $f = guard std::fs::open($path, .read) else ($e) {
    echo $e->message();
    return 1;
}

foreach ($f as $n => $line) {
    echo $n;
    echo $line;
}

echo $f->error() == null;

$f->close();

bool $rm = guard std::fs::remove($path) else ($e) {
    echo $e->message();
    return 1;
}
