// several lines in one write, then readline in a loop - the case one syscall per byte makes unusable

string $path = '';
$path->append(str::from(std::env::tmp()));
$path->append(std::env::DS);
$path->append('echo-io-lines-');
$path->append(str::from(std::env::pid()));
$path->append('.txt');

usize $w = guard std::io::writefile($path, 'one\ntwo\nthree') else ($e) {
    echo $e->message();
    return 1;
}

echo $w;

file $f = guard std::io::open($path, .read) else ($e) {
    echo $e->message();
    return 1;
}

string? $a = guard $f->readline() else ($e) {
    echo $e->message();
    return 1;
}

echo $a ?? 'null';

string? $b = guard $f->readline() else ($e) {
    echo $e->message();
    return 1;
}

echo $b ?? 'null';

string? $c = guard $f->readline() else ($e) {
    echo $e->message();
    return 1;
}

echo $c ?? 'null';

string? $d = guard $f->readline() else ($e) {
    echo $e->message();
    return 1;
}

if ($d == null) {
    echo 'eof';
}

$f->close();

bool $rm = guard std::io::remove($path) else ($e) {
    echo $e->message();
    return 1;
}

