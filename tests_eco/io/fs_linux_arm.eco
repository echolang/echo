// the linux arm of `std::io`'s file info, copy, chmod and realpath, lowered on whatever machine runs
// the suite. pin_fs is never called, so a host that is not linux never has to resolve these symbols
function pin_fs(std::io::file $f) : void
{
    result<std::fs::fileinfo, std::io::ioerror> $a = std::fs::info('a');
    result<std::fs::fileinfo, std::io::ioerror> $b = std::fs::linkinfo('a');
    result<std::fs::fileinfo, std::io::ioerror> $c = $f->info();
    result<bool, std::io::ioerror> $d = std::fs::chmod('a', std::fs::fileperms(420));
    result<std::fs::path, std::io::ioerror> $e = std::fs::realpath('a');
    result<bool, std::io::ioerror> $g = std::fs::copy('a', 'b');
}
