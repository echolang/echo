flags: --target-os linux
# Linux file info and copy go through syscall(), never a libc wrapper for statx / copy_file_range

--- OUT --->
--- IR --->
CHECK: declare i64 @syscall(
CHECK-NOT: declare i32 @statx(
CHECK: declare i32 @chmod(
CHECK: declare ptr @realpath(
CHECK: declare i32 @ftruncate(
CHECK: declare i32 @fchmod(
CHECK-NOT: declare i64 @copy_file_range(
