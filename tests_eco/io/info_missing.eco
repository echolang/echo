// every one of the new verbs answers a missing path the same way: ENOENT, `missing()`
string $dir = str::from(std::env::tmp());
string $pid = str::from(std::env::pid());
string $gone = std::fs::join($dir, "echo-io-not-there-{$pid}")->string();
string $to = std::fs::join($dir, "echo-io-copy-of-nothing-{$pid}")->string();

result<std::fs::fileinfo, std::io::ioerror> $a = std::fs::info($gone);
echo $a->failure()->missing();

result<std::fs::fileinfo, std::io::ioerror> $b = std::fs::linkinfo($gone);
echo $b->failure()->missing();

result<std::fs::path, std::io::ioerror> $c = std::fs::realpath($gone);
echo $c->failure()->missing();

result<bool, std::io::ioerror> $d = std::fs::copy($gone, $to);
echo $d->failure()->missing();

// and a failed copy made nothing at the destination
result<bool, std::io::ioerror> $made = std::fs::exists($to);
echo $made->unwrap();

result<bool, std::io::ioerror> $f = std::fs::chmod($gone, std::fs::fileperms(0x1a4));
echo $f->failure()->missing();
