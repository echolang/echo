// linux arm64 kernel `stat` is 128 bytes (`asm-generic/stat.h`). the IR type in
// the .test is that layout. pin_fs is never called, so a host that is not linux
// never has to resolve these symbols

function pin_fs(std::io::file $f) : void
{
    result<std::io::fileinfo, std::io::ioerror> $a = std::io::info('a');
    result<std::io::fileinfo, std::io::ioerror> $b = $f->info();
}
