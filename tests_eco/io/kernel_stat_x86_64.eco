// linux x86_64 kernel `stat` is 144 bytes. the IR type in the .test is that layout.
// pin_fs is never called, so a host that is not linux never has to resolve these symbols

function pin_fs(std::io::file $f) : void
{
    result<std::fs::fileinfo, std::io::ioerror> $a = std::fs::info('a');
    result<std::fs::fileinfo, std::io::ioerror> $b = $f->info();
}
