// `info` follows a symlink and `linkinfo` does not, and a listing reports the link as one.
// Windows CI cannot create a symlink without a privilege, so that host pins follow/realpath/listing
// on the file

string $tmp = str::from(std::env::tmp());
string $pid = str::from(std::env::pid());
string $dir = std::fs::join($tmp, "echo-io-links-{$pid}")->string();

bool $made = guard std::fs::mkdir($dir) else ($e) {
    echo $e->message();
    return 1;
}

string $target = std::fs::join($dir, 'target.txt')->string();
string $link = std::fs::join($dir, 'link.txt')->string();

usize $w = guard std::fs::writefile($target, 'twelve bytes') else ($e) {
    echo $e->message();
    return 1;
}

#[if: os != windows]
guard std::fs::symlink($target, $link) else ($e) {
    echo $e->message();
    return 1;
}

std::fs::fileinfo $through = guard std::fs::info($link) else ($e) {
    echo $e->message();
    return 1;
}

std::fs::fileinfo $itself = guard std::fs::linkinfo($link) else ($e) {
    echo $e->message();
    return 1;
}

echo $through->kind == std::fs::filekind::file;
echo $through->size;
echo $itself->kind == std::fs::filekind::symlink;

std::fs::path $a = guard std::fs::realpath($link) else ($e) {
    echo $e->message();
    return 1;
}

std::fs::path $b = guard std::fs::realpath($target) else ($e) {
    echo $e->message();
    return 1;
}

echo $a == $b;

std::fs::dir $d = guard std::fs::opendir($dir) else ($e) {
    echo $e->message();
    return 1;
}

usize $links = 0;
usize $files = 0;

foreach ($d as $ent) {
    if ($ent->kind() == std::fs::filekind::symlink) {
        $links = $links + 1;
    }

    if ($ent->is_file()) {
        $files = $files + 1;
    }
}

echo $links;
echo $files;

std::fs::remove($link);
#[else]
std::fs::fileinfo $through = guard std::fs::info($target) else ($e) {
    echo $e->message();
    return 1;
}

echo $through->kind == std::fs::filekind::file;
echo $through->size;
echo 1;

std::fs::path $a = guard std::fs::realpath($target) else ($e) {
    echo $e->message();
    return 1;
}

std::fs::path $b = guard std::fs::realpath($target) else ($e) {
    echo $e->message();
    return 1;
}

echo $a == $b;

std::fs::dir $d = guard std::fs::opendir($dir) else ($e) {
    echo $e->message();
    return 1;
}

usize $files = 0;

foreach ($d as $ent) {
    if ($ent->is_file()) {
        $files = $files + 1;
    }
}

echo 1;
echo $files;
#[end]

std::fs::remove($target);
std::fs::rmdir($dir);
