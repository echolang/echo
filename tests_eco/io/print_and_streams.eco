// `std::io::stdout` is a *constant*, so it is written without parentheses, can be copied into a
// variable and handed around - a constant is its expression cloned into each use site, and this
// one's expression is `stream(1)`
std::io::stdout->write('written');
std::io::stdout->write_line(' and a line');

stream $out = std::io::stdout;
$out->write_line('through a copy');

std::io::print('print');
std::io::println(' then println');

// stderr is reachable the same way. the corpus merges both streams, so this lands in order
std::io::eprintln('to stderr');
std::io::stderr->write_line('and again');

// interpolation is how a value becomes the `string` these take
int32 $dice = 4;
int32 $total = 17;
std::io::println("{$total} on {$dice} dice");
