// realpath asks the filesystem: `x/..` is the directory `x` sits in, and the answer is absolute
string $tmp = str::from(std::env::tmp());
string $pid = str::from(std::env::pid());
string $sub = std::fs::join($tmp, "echo-io-real-{$pid}")->string();

bool $made = guard std::fs::mkdir($sub) else ($e) {
    echo $e->message();
    return 1;
}

std::fs::path $up = guard std::fs::realpath($sub / '..') else ($e) {
    echo $e->message();
    return 1;
}

std::fs::path $base = guard std::fs::realpath($tmp) else ($e) {
    echo $e->message();
    return 1;
}

echo $up == $base;
echo $base->is_absolute();

std::fs::rmdir($sub);
