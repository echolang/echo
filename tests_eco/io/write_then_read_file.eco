// writefile / readfile is the whole-file door

string $path = '';
$path->append(str::from(std::env::tmp_dir()));
$path->append('/echo-io-roundtrip-');
$path->append(str::from(std::env::pid()));
$path->append('.txt');

usize $n = guard std::io::writefile($path, 'hello world') else ($e) {
    echo $e->message();
    return 1;
}

echo $n;

string $body = guard std::io::readfile($path) else ($e) {
    echo $e->message();
    return 1;
}

echo $body;

usize $rm = guard std::io::remove($path) else ($e) {
    echo $e->message();
    return 1;
}

echo $rm;
echo std::io::exists($path);
