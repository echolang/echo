// writefile / readfile is the whole-file door

string $path = '';
$path->append(str::from(std::env::tmp()));
$path->append(std::env::DS);
$path->append('echo-io-roundtrip-');
$path->append(str::from(std::env::pid()));
$path->append('.txt');

usize $n = guard std::io::writefile($path, 'hello world') else ($e) {
    echo $e->message();
    return 1;
}

echo $n;

string $body = guard std::io::readfile($path) else ($e) {
    echo $e->message();
    return 1;
}

echo $body;

bool $rm = guard std::io::remove($path) else ($e) {
    echo $e->message();
    return 1;
}

bool $gone = guard std::io::exists($path) else ($e) {
    echo $e->message();
    return 1;
}

echo $gone;
