// a by-value binding nothing writes is bound `const V&` instead - indistinguishable for any program
// that keeps the "do not mutate the collection while iterating" contract, and the only place the
// difference is visible at all is the resolved AST
$a = array<int32>();
$a[] = 1;

// never written -> elided to a borrow
foreach ($a as $reader) {
    echo $reader;
}

// written -> a real copy, and the array is left alone
foreach ($a as $writer) {
    $writer = 9;
}
