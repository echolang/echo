// **every key in one bucket.** `clash`'s `hash::of` returns a constant, so the probe walks the whole table
// on every lookup - which is the only way to exercise linear probing, tombstone reuse and rehash under
// complete collision. a map that is correct here is correct for a merely unlucky hash

{
    map<clash, int32> $m = map<clash, int32>();

    int32 $i = 0;

    while ($i < 60) {
        $m->set(clash($i), $i * 2);
        $i = $i + 1;
    }

    echo $m->count();

    // every one of them still findable after the rehashes the growth ran - and a rehash needs neither the
    // hasher nor `==`, so this is also what pins that it re-seats by the *stored* hash
    int32 $found = 0;
    $i = 0;

    while ($i < 60) {
        if ($m->has(clash($i))) {
            $found = $found + 1;
        }

        $i = $i + 1;
    }

    echo $found;
    echo $m->get(clash(0));
    echo $m->get(clash(59));

    // remove every other one, then look the rest up *through* the tombstones they left
    $i = 0;

    while ($i < 60) {
        $m->remove(clash($i));
        $i = $i + 2;
    }

    echo $m->count();

    $found = 0;
    $i = 1;

    while ($i < 60) {
        if ($m->has(clash($i))) {
            $found = $found + 1;
        }

        $i = $i + 2;
    }

    echo $found;

    // and none of the removed ones comes back
    $found = 0;
    $i = 0;

    while ($i < 60) {
        if ($m->has(clash($i))) {
            $found = $found + 1;
        }

        $i = $i + 2;
    }

    echo $found;

    // re-inserting reuses the tombstones rather than growing
    usize $before = $m->capacity();

    $i = 0;

    while ($i < 60) {
        $m->set(clash($i), $i);
        $i = $i + 2;
    }

    echo $m->count();
    echo $m->capacity() == $before;
}

assert(mem::live_allocations() == 0, 'the table gave its three buffers back');

// ---- growth over an ordinary hash: 1000 keys, and the load factor held

{
    map<int32, int32> $m = map<int32, int32>();

    int32 $i = 0;

    while ($i < 1000) {
        $m->set($i, $i + 1);
        $i = $i + 1;
    }

    echo $m->count();

    int32 $sum = 0;
    $i = 0;

    while ($i < 1000) {
        $sum = $sum + $m->get($i);
        $i = $i + 1;
    }

    echo $sum;

    // slots stay above four thirds of the entries, which is the load factor stated as an assertion
    echo $m->capacity() * 3 >= $m->count() * 4;
}

assert(mem::live_allocations() == 0, 'and again');

// ---- churn must reclaim tombstones at the same capacity rather than doubling for them

{
    map<int32, int32> $m = map<int32, int32>();

    int32 $i = 0;

    while ($i < 3000) {
        $m->set($i % 4, $i);
        $m->remove($i % 4);
        $i = $i + 1;
    }

    echo $m->count();

    // **8**, the floor. without the same-capacity re-seat in `grow` this is a table of thousands of slots
    echo $m->capacity();
}

assert(mem::live_allocations() == 0, 'nothing held on to');
echo mem::live_allocations();
