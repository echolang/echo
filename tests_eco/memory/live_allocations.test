--- IR --->
# the counter: mutable, so linkonce_odr rather than an ODR *constant* like a typeinfo, and zero to start.
# first, because a module prints its globals ahead of its definitions
CHECK: @__eco_alloc_live = linkonce_odr global i64 0

# the seam's own symbols, defined here rather than linked - the whole runtime is emitted
CHECK: define linkonce_odr ptr @__eco_alloc(i64 %size)

# a failed allocation is not an allocation, so the count sits behind a null check on the *result*
CHECK: alloc.count:
CHECK: store i64 %live.next, ptr @__eco_alloc_live

# and the four-way split that keeps a refused realloc from reading as a free
CHECK: define linkonce_odr ptr @__eco_realloc(ptr %block, i64 %size)
CHECK: realloc.grew:
CHECK: realloc.shrank:
CHECK: realloc.gave_back
CHECK: realloc.released:
