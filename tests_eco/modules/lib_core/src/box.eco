namespace modcore;

// a generic declared in one module and instantiated from two others, which is the case that used to put a
// library's object code at the mercy of its consumers: the instance is cloned into *this* module because
// the template lives here, while the type it is instantiated with is declared somewhere else entirely
public struct Box<T>
{
    T $value;

    function get() : T
    {
        return $this->value;
    }
}

public function doubled(int32 $n) : int32
{
    return $n * 2;
}

// `#[inline]` asks for the body to be copied into every unit that calls it, which is the same treatment a
// generic instance gets - AST::FunctionEmission::t_odr_shared. Declared beside `doubled` above so a test can
// assert the two against each other: same module, same shape, different placement
#[inline]
public function tripled(int32 $n) : int32
{
    return $n * 3;
}
