namespace modgeom;

struct Point
{
    int32 $x;
    int32 $y;

    function sum() : int32
    {
        return $this->x + $this->y;
    }
}

// reaches into the module this one depends on, both for a plain function and for the generic
function boxed_x(Point $p) : int32
{
    modcore::Box<int32> $b = modcore::Box<int32>($p->x);
    return modcore::doubled($b->get());
}
