// a call is a statement on its own, qualified or not, and a non-void result may be discarded
float64 $root = std::math::sqrt(16.0);
echo $root;

// as a bare statement, result discarded
std::math::sqrt(9.0);

// the same for a plain unqualified call
function twice(int32 $x) : int32
{
    return $x * 2;
}

twice(21);

echo 1;
