// the standard library is a module like any other, so a program can be compiled without it.
// what this gives up is `die`, `assert` and the `mem::` / `std::math::` namespaces - everything the
// compiler itself provides is still here: primitives, structs, methods, control flow
struct Counter
{
    int32 $value;

    function bump(int32 $by) : int32
    {
        $this->value = $this->value + $by;
        return $this->value;
    }
}

$c = Counter(0);
echo $c->bump(2);
echo $c->bump(5);
