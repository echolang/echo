// a guard over a temporary result moves the payload into the binding. a guard over a live local
// still copies, which is tests_eco/nullability/unwrappable_binding_copies in this shape

struct Probe
{
    array<int64> $xs;

    constructor(array<int64> $xs)
    {
        $this->xs = mv $xs;
    }

    constructor(const Probe& $other)
    {
        echo 'copy';
        $this->xs = $other->xs;
    }
}

function make() : result<Probe, string>
{
    array<int64> $xs = [1, 2, 3];
    return .ok(Probe(mv $xs));
}

function viaGuard() : Probe
{
    Probe $p = guard make() else ($e) {
        die($e);
    }
    return $p;
}

Probe $a = viaGuard();
echo $a->xs->count();

result<Probe, string> $held = make();
Probe $b = guard $held else ($e) {
    die($e);
}
echo $b->xs->count();
