// a constructor whose body is an implicit guard still gets `return $this` on the success path,
// and still stops on the absent one. the field-wise constructor is `box(int32)`, so the
// written one takes `int32?` and the call site names that

struct box
{
    int32 $v;

    constructor(int32? $n)
    {
        int32 $x = guard $n;
        $this->v = $x;
    }
}

int32? $n = 3;
echo box($n)->v;

int32? $gone = null;
echo box($gone)->v;
