// the shapes an `operator<T>` declaration can take, and how they resolve against each other
struct Bag<T> { ptr<T> $at; }

// a constrained parameter - the ordinary type-parameter grammar, nothing operator-specific
operator<T: numeric> (Bag<T>& $b)[usize $i] : T&
{
    unsafe { return &$b->at:$[$i]; }
}

// **a concrete overload beats the template.** the ordinary matching rule (a concrete candidate wins
// over a generic one), so specializing an element contract needs no new mechanism
operator (Bag<int32>& $b)[usize $i] : int32&
{
    echo 111;
    unsafe { return &$b->at:$[$i]; }
}

// two parameters, both bound from operands
struct Table<K, V> { ptr<K> $keys; ptr<V> $values; }

operator<K, V> (Table<K, V>& $t)[usize $i] : V&
{
    unsafe { return &$t->values:$[$i]; }
}

int32 $x = 5;
$bi = Bag<int32>(&$x);
echo $bi[0];

float64 $y = 2.5;
$bf = Bag<float64>(&$y);
echo $bf[0];

int32 $k = 1;
float64 $v = 8.5;
$t = Table<int32, float64>(&$k, &$v);
echo $t[0];
