// integer `**` is exponentiation by squaring, at the operation's own type. `2 ** 40` used to
// round-trip through llvm.pow and land in i32, so the top bits vanished

int32 $square = 2 ** 10;
int32 $cube = 3 ** 3;
int32 $unit = 5 ** 0;

echo $square;
echo $cube;
echo $unit;

int64 $base = 2;
int64 $exp = 40;
echo $base ** $exp;

uint64 $ubase = 3;
uint64 $uexp = 5;
echo $ubase ** $uexp;

// a runtime exponent, so the loop is in the IR rather than folded to a constant
function raise(int32 $base, int32 $exp) : int32
{
    return $base ** $exp;
}

echo raise(2, 10);
