--- IR --->
CHECK: define i32 @main(

# up to the `(` on purpose: `llvm.pow.f64` is a prefix of the broken `llvm.pow.f64.f64`, so a check
# that stopped at the type would pass either way and assert nothing
CHECK: call double @llvm.pow.f64(double
CHECK: call double @llvm.pow.f64(double
CHECK: call double @llvm.pow.f64(double

# the int64 case: the result lands in the operation's own type, so nothing here narrows to i32.
# spelled as the absence of `to i32` rather than a positive check on the width, because a directive
# is a plain substring and the register numbers in `fptosi double %9 to i64` are not stable
CHECK: call double @llvm.pow.f64(double
CHECK-NOT: to i32
CHECK: call double @llvm.pow.f64(double

# the uint64 case, converted unsigned in both directions
CHECK-NOT: fptosi
CHECK: fptoui double
CHECK-NOT: llvm.pow.f64.f64
