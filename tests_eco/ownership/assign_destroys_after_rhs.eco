// the drop for an assignment target runs *after* the right-hand side, not ahead of the statement -
// `replace($a)` borrows the old value while the new one is being built.
//
// the `echo 500` inside replace pins the order, and the tag pins that the read saw a live value: the
// destructor zeroes `$tag`, so an early teardown would make replace compute 0 + 10 rather than
// 1 + 10

struct Buffer
{
    usize $tag;
    ptr<uint8> $data;

    destructor()
    {
        echo $this->tag;
        $this->tag = 0;
        mem::free($this->data);
    }
}

function replace(Buffer& $old) : Buffer
{
    echo 500;
    return Buffer($old->tag + 10, mem::alloc<uint8>(1));
}

$a = Buffer(1, mem::alloc<uint8>(1));
$a = replace($a);
echo 99;
