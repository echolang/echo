// `function take(mv $this)` consumes the whole receiver. `$h` is unset after `$h->take()`

struct Item
{
    int32 $n;

    constructor(int32 $n)
    {
        $this->n = $n;
    }

    constructor(const Item& $other)
    {
        echo 'copy';
        $this->n = $other->n;
    }

    destructor()
    {
        echo $this->n;
    }
}

struct Holder
{
    Item $item;

    function take(mv $this) : Item
    {
        return $this->item;
    }
}

Holder $h = Holder(Item(1));
Item $x = $h->take();
echo $x->n;
echo 'done';
