// an `if` whose every arm returns leaves no reachable code after it, so the drops that count are
// the ones before each `return` and none are appended at scope exit

struct Buffer
{
    usize $tag;
    ptr<uint8> $data;

    destructor()
    {
        echo $this->tag;
        mem::free($this->data);
    }
}

function pick(int32 $x) : int32
{
    Buffer $b = Buffer(7, mem::alloc<uint8>(1));

    if ($x > 0) {
        return 1;
    } else {
        return 2;
    }
}

// the same shape one level down: a loop body that always returns has no back edge to the header
function first(int32 $n) : int32
{
    Buffer $b = Buffer(8, mem::alloc<uint8>(1));

    int32 $i = 0;
    while ($i < $n) {
        return $i;
    }

    return 99;
}

echo pick(1);
echo pick(0);
echo first(3);
echo first(0);

echo 0;
