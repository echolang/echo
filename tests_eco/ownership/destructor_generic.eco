// a generic struct's destructor is instantiated per concrete type: the drop names the *template's*
// destructor and the receiver `Box<T>&` binds T from the local's type. two instantiations, two
// destructor bodies

struct Box<T>
{
    usize $tag;
    ptr<T> $slot;

    destructor()
    {
        echo $this->tag;
        mem::free<T>($this->slot);
    }
}

$i = Box<int32>(1, mem::alloc<int32>(1));
$f = Box<float64>(2, mem::alloc<float64>(1));

echo 0;
