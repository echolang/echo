// a returned local is moved, not copied - including a constructor's `$this`, which is a body-local
// of value type with an implicit `return $this`. exactly one destructor line per buffer

struct Buffer
{
    usize $tag;
    ptr<uint8> $data;

    destructor()
    {
        echo $this->tag;
        mem::free($this->data);
    }
}

function make(usize $tag) : Buffer
{
    // built here, handed back: neither the constructor's `$this` nor this local is destroyed
    $b = Buffer($tag, mem::alloc<uint8>(4));
    return $b;
}

$x = make(7);
echo 0;
