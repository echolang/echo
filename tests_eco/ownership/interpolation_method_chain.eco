// calendar golden dump: `"… {$d->weekday()->number()} …"` in a file-scope loop. weekday()
// returns a by-value enum, number() borrows it, and the hole is str::from of that chain
// inside a multi-piece interpolation. binding `$wd` first was the workaround

enum Weekday : uint8
{
    case monday = 1;
    case tuesday = 2;
    case wednesday = 3;

    const function number() : int32
    {
        return $this->value() as int32;
    }
}

struct Date
{
    int32 $day = 1;

    constructor(int32 $d)
    {
        $this->day = $d;
    }

    const function weekday() : Weekday
    {
        return Weekday::monday;
    }
}

int32 $i = 0;
while ($i < 3) {
    Date $d = Date($i);
    echo "i={$i} wd={$d->weekday()->number()}";
    $i = $i + 1;
}
