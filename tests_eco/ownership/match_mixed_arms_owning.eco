// a match with mixed arms: one place, one computed. all-place arms are saved by yields_a_place;
// one place plus one constructor sets all_places = false and the place arm was a borrowed
// payload with no copy. the string in the payload is heap-owning, so a missing retain is
// visible in the count rather than a no-op on a null handle

class Named
{
    string $id;

    constructor()
    {
        string $built = '';
        $built->append('cooked');
        $built->append('/terrain/sandy_rocks_02/albedo');
        $this->id = $built;
    }
}

enum Slot
{
    case some(Named $n);
    case none;
}

function idOf(Slot $s) : string
{
    return match ($s) {
        Slot::some($n) => $n->id,
        else => '',
    };
}

// the json::Value::clone shape: a computed arm beside a place arm of the whole value
class Items
{
    int32 $n;

    destructor()
    {
        echo 900;
    }
}

enum Value
{
    case list(Items $items);
    case empty;
}

function cloneOf(Value $v) : Value
{
    return match ($v) {
        Value::list($items) => Value::list($items),
        else => $v,
    };
}

Named $named = Named();
Slot $full = Slot::some($named);
echo mem::refs($named->id->owner);

{
    string $got = idOf($full);
    echo mem::refs($named->id->owner);
    echo $got;
}

echo mem::refs($named->id->owner);

{
    Items $items = Items(4);
    Value $v = Value::list($items);
    echo mem::refs($items);
    Value $copy = cloneOf($v);
    echo mem::refs($items);
}

echo 99;
echo mem::live_allocations() > 0;
