// `$h->item = mv $next` is a whole-value transfer into a field: the old payload is destroyed, the
// source is emptied, and Item's copy constructor does not run. a method that takes `mv Item` and
// seats it is the same transfer, written once at the call

struct Item
{
    int32 $n;

    constructor(int32 $n)
    {
        $this->n = $n;
    }

    constructor(const Item& $other)
    {
        echo 'copy';
        $this->n = $other->n;
    }

    destructor()
    {
        echo $this->n;
    }
}

struct Holder
{
    Item $item;

    function replace(mv Item $next) : void
    {
        $this->item = mv $next;
    }
}

{
    Holder $h = Holder(Item(1));
    Item $next = Item(2);
    echo 'replace';
    $h->item = mv $next;
    echo 'held';
    echo $h->item->n;
}

echo 'method';

{
    Holder $h = Holder(Item(3));
    $h->replace(Item(4));
    echo $h->item->n;
}

echo 'done';
