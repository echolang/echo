// `mv $h->item` transfers the payload; Holder has no user destructor, so the hole is skipped
// at scope end. Item's copy constructor does not run

struct Item
{
    int32 $n;

    constructor(int32 $n)
    {
        $this->n = $n;
    }

    constructor(const Item& $other)
    {
        echo 'copy';
        $this->n = $other->n;
    }

    destructor()
    {
        echo $this->n;
    }
}

struct Holder
{
    Item $item;
    int32 $tag;
}

Holder $h = Holder(Item(1), 7);
Item $x = mv $h->item;
echo $x->n;
echo $h->tag;
echo 'done';
