// the same miss with no `??`: keeping the chain result in a `string?` still has to copy the
// field, because the chain is not a place and arrive_value of it moves a computed value that
// was never retained

class Holder
{
    string $id;

    constructor()
    {
        string $built = '';
        $built->append('cooked');
        $built->append('/terrain/sandy_rocks_02/albedo');
        $this->id = $built;
    }
}

Holder $h = Holder();
echo mem::refs($h->id->owner);

{
    Holder? $maybe = $h;
    string? $kept = $maybe?->id;
    echo mem::refs($h->id->owner);
}

echo mem::refs($h->id->owner);
echo $h->id;
echo mem::live_allocations() > 0;
