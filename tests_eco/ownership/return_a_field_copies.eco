// `return $h->item` of a destructor-free holder is a move: the payload leaves, the remainder
// drops on the return unwind, Item's copy constructor does not run

struct Item
{
    int32 $n;

    constructor(int32 $n)
    {
        $this->n = $n;
    }

    constructor(const Item& $other)
    {
        echo 'copy';
        $this->n = $other->n;
    }

    destructor()
    {
        echo $this->n;
    }
}

struct Holder
{
    Item $item;
}

function take_item() : Item
{
    Holder $h = Holder(Item(1));
    return $h->item;
}

{
    Item $out = take_item();
    echo $out->n;
}

echo 'done';
