// `#[unique]` as a field: construction seats the constructor result, and a later `mv` replaces
// it. copying is refused, so both writes have to be transfers. unique_destructor_as_field is
// construction only

#[unique]
struct Handle
{
    usize $tag;
    ptr<uint8> $data;

    destructor()
    {
        echo $this->tag;
        mem::free($this->data);
    }
}

struct Wrap
{
    Handle $inner;
}

{
    Wrap $w = Wrap(Handle(1, mem::alloc<uint8>(1)));
    Handle $next = Handle(2, mem::alloc<uint8>(1));
    echo 'replace';
    $w->inner = mv $next;
    echo 'held';
}

echo 'done';
