// the six comparisons available on an address. all of them go through `:$`, because they ask
// about the address rather than about the value at it - `$p == $q` is a different question
// (book/concept/pointers_and_refs_v2.md, "Pointer arithmetic").
//
// the adjacent storage is a struct's two int32 fields, at offset 0 and 4

struct Pair {
    int $a;
    int $b;
}

$s = Pair(1, 1);

ptr<int> $p = &$s->a;
ptr<int> $q = $p:$ + 1;

echo ($p:$ == $q:$);
echo ($p:$ != $q:$);
echo ($p:$ < $q:$);
echo ($p:$ > $q:$);
echo ($p:$ <= $q:$);
echo ($p:$ >= $q:$);

// an address equals itself, which is the boundary of the strict comparisons
echo ($p:$ == $p:$);
echo ($p:$ <= $p:$);
echo ($p:$ < $p:$);

// the values are equal while the addresses are not
echo ($p == $q);
echo ($p:$ == $q:$);
