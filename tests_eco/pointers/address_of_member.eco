// `&` applies to any expression that denotes storage, not just a bare variable - here a
// struct field, borrowed explicitly and then implicitly at a call

struct Point {
    int $x;
    int $y;
}

$p = Point(1, 2);

// borrow the field, then write through the borrow
int& $r = &$p->x;
$r = 42;

echo $p->x;
echo $p->y;

// a borrow parameter borrows a field implicitly, the same as it does a variable
function bump(int &$v) : void {
    $v = $v + 1;
}

bump($p->y);
echo $p->y;
