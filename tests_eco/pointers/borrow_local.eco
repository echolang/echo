// a borrow declared as a local. `int& $r = &$var` binds the reference to $var's storage; from
// then on reading $r reads $var and writing $r writes $var, with no explicit deref

$var = 10;

int& $r = &$var;

// reads auto-deref
echo $r;

// writes go through, into $var
$r = 20;
echo $var;
echo $r;
