// the lexer decides between bitwise-and and reference by the character right after `&`, so
// `int &$x` and `int & $x` arrive as different tokens - but in type position a following `&`
// can only be a borrow, so both spell the same parameter

function inc_tight(int &$x) : void {
    $x = $x + 1;
}

function inc_spaced(int & $x) : void {
    $x = $x + 1;
}

$a = 5;
inc_tight($a);
echo $a;

inc_spaced($a);
echo $a;
