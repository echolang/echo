// a function may return a borrow, and the caller may write through what comes back. how far
// the returned expression is read follows the declared return type, so the same body returns
// the address for an `int&` signature and the pointee for an `int` one

function pick(int &$x) : int& {
    return $x;
}

$a = 5;

// the borrow that comes back still refers to $a
int& $r = pick($a);
$r = 42;
echo $a;

// and reading through it is a plain read, so this is 42 rather than an address
echo $r;

// picking twice hands back the same storage both times
int& $again = pick($a);
$again = 7;
echo $a;
echo ($r:$ == $again:$);

// a value return from the same borrow parameter reads through instead
function read(int &$x) : int {
    return $x;
}

echo read($a);
