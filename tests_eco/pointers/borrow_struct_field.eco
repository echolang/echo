// a struct property may be a borrow: the synthesized constructor *binds* it rather than writing
// through it, and from there the field reads, writes and re-seats like any other pointer place
// (book/concept/pointers_and_refs_v2.md, "Binding, writing, and re-seating")

struct Holder {
    int& $target;
    int $count;
}

$v = 7;
$h = Holder(&$v, 1);

// reading the property auto-derefs, like reading any other pointer place
echo $h->target;

// writing through it reaches $v, because the field holds $v's address
$h->target = 99;
echo $v;

// the neighbouring value property is untouched by any of it
echo $h->count;

// and re-seating the field points it somewhere else, leaving $v alone
$other = 5;
$h->target:$ = &$other;
$h->target = 42;
echo $v;
echo $other;
