// `ptr<U>(addr)` reinterprets an address as pointing at a different type. it takes an address,
// so its argument is almost always a `:$` expression. no alignment or size checking is done -
// this is the sharpest tool in the chapter

$n = 0;
ptr<int> $ints = &$n;

// the same memory, viewed as bytes
ptr<uint8> $bytes = ptr<uint8>($ints:$);
$bytes:$[0] = 255;

echo $n;

// a borrow widens to a nullable pointer implicitly - it only discards the non-null guarantee
$a = 5;
int& $r = &$a;
ptr<int> $p = $r:$;
$p = 8;
echo $a;

// the narrowing back asserts non-nullness, so it has to be written out
int& $back = int&($p:$);
$back = 12;
echo $a;
