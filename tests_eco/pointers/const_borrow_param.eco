// `const int32& $r` is the read-only borrow, the form for a parameter that only looks at its
// argument (book/concept/pointers_and_refs_v2.md, "Const"). a mutable borrow satisfies it -
// adding const to the pointee is a weakening - while dropping the const again is not

function show(const int& $r) : void {
    echo $r;
}

$a = 5;

// the implicit borrow at the call site, and the explicit address, both satisfy it
show($a);
show(&$a);

// a mutable borrow converts to the read-only form
int& $r = &$a;
show($r);

// a nullable pointer does not, though: the const is independent of the nullability, and
// narrowing to a non-null borrow still has to be written out
ptr<int> $p = &$a;
unsafe {
    show(int&($p:$));
}

// a const borrow local reads through exactly like a mutable one
const int& $view = &$a;
echo $view;

// and it follows the storage: it is a borrow, not a copy
$a = 9;
echo $view;

// the const is on the pointee, so the two spellings remain distinct types even though one
// converts to the other
echo ($view:$ == $r:$);
