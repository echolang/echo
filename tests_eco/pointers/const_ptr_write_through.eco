// a `const ptr<int32>` promises only that it keeps pointing where it was seated, so writing
// *through* it is allowed - const sits per pointer level, and only the slot is frozen
// (book/concept/pointers_and_refs_v2.md, "Const")
$a = 1;

const ptr<int> $p = &$a;

$p = 5;

// the write landed in $a, because $p was never a copy of it
echo $a;
echo $p;

// the const pointee is the other half of the pair: that one may be re-seated, but not written
const int $c = 1;
const int $d = 2;

const int& $view = &$c;

$view:$ = &$d;

echo $view;
