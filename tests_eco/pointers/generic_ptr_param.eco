// the counterpart to generic_decay.eco: a `ptr<T>` parameter opts out of the decay, so the
// pointer survives into the instance (book/concept/pointers_and_refs_v2.md, "Pointers and
// generics"). the decay is top-level only, so a `ptr<ptr<int32>>` argument binds T=ptr<int32>
// and is a different instance from the shallow one

function first<T>(ptr<T> $v) : T {
    return $v;
}

$a = 7;
ptr<int> $p = &$a;

// T is int32 here: the parameter asked for the pointer, so nothing decayed
echo first($p);

// a level deeper T is ptr<int32>, a different instance: what comes back is the caller's
// ptr<int>, so it is bound rather than echoed - echo has no format for an address
ptr<ptr<int>> $pp = &$p;
ptr<int> $inner = first($pp);

// and it is $p's own pointer, so writing through it reaches $a
$inner = 11;
echo $a;
echo ($inner:$ == $p:$);

// the value form still decays, so this shares nothing with the two above
function box<T>(T $v) : T {
    return $v;
}

echo box($p);
echo box($a);
