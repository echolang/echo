// `->` reaches through a pointer to any depth - unlike a plain read, which is exactly one
// auto-deref. there is no `.` versus `->` distinction: a struct value and a pointer to one are
// accessed the same way (book/concept/pointers_and_refs_v2.md, "Structs and classes")

struct Point {
    int $x;
    int $y;
}

$pt = Point(1, 2);

ptr<Point> $p = &$pt;
ptr<ptr<Point>> $pp = &$p;
ptr<ptr<ptr<Point>>> $ppp = &$pp;

// every depth names the same field
echo $p->x;
echo $pp->x;
echo $ppp->x;

// and writing through any of them reaches the one Point
$p->x = 10;
echo $pt->x;

$pp->y = 20;
echo $pt->y;

$ppp->x = 30;
echo $pt->x;

// the pointer object itself has no members - `$p->x` is the pointee's field, never the
// pointer's. the address is what `:$` is for, and it is unaffected by any of the writes
echo ($p:$ == &$pt);
