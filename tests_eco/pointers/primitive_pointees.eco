// every primitive family read and written through a borrow, not just int32. each write is a
// literal, so the type it is given is the *pointee's*

// bool
$b = true;
bool& $br = &$b;
echo $br;
$br = false;
echo $b;

// float64 - written from a float literal and then from an int one, which still lands as a double
$f = 1.5;
float64& $fr = &$f;
echo $fr;
$fr = 2.5;
echo $f;
$fr = 3;
echo $f;

// float32
float32 $g = 0.25;
float32& $gr = &$g;
echo $gr;
$gr = 0.75;
echo $g;

// uint8 - the write stores one byte, not four
uint8 $u = 3;
uint8& $ur = &$u;
echo $ur;
$ur = 200;
echo $u;

// int64
int64 $l = 1;
int64& $lr = &$l;
$lr = 5000000000;
echo $l;

// int32
int32 $i = 7;
int32& $ir = &$i;
echo $ir;
$ir = 9;
echo $i;
