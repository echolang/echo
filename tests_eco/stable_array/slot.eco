// `slot()` and `&$a[]` are the place you store. filling field by field writes into the block
struct Point { int32 $x; int32 $y; }

stable_array<Point> $a = [];

$a->slot()->x = 1;
$a->slot()->x = 3;

echo $a->at(0)->x;
echo $a->at(1)->x;

$a->at(1)->x = 30;
echo $a[1]->x;
echo $a->count();

Point& $p = &$a[];
$p->x = 9;
$p->y = 4;
echo $a[2]->x + $a[2]->y;
