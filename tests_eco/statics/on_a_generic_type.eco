// **a static on a generic type binds its owner's parameters from the owner the call site named**, and
// nothing else can say what they are: a method reads them off its receiver, and a static has none.
// `outcome<T, E>::ok` mentions E nowhere in its signature, so without the owner as a substitution seed
// the instantiation is undecidable - and undecidable is reported by nobody, so the call would be
// emitted nowhere at all
//
// spelled `outcome` rather than `result`, which the standard library now owns at the root - and the shape
// below is the one `result<T, E>` deliberately is not: a struct with a flag, whose synthesized copy and
// teardown reach both payloads whichever one is live. see stdlib/core/result.eco
struct outcome<T, E> {
    public T $value;
    public E $error;
    public bool $is_ok;

    static function ok(T $v, E $blank) : outcome<T, E> {
        return outcome<T, E>($v, $blank, true);
    }

    static function error(T $blank, E $e) : outcome<T, E> {
        return outcome<T, E>($blank, $e, false);
    }
}

$a = outcome<int32, int64>::ok(42, 0);
echo $a->value;
echo $a->is_ok;

$b = outcome<int32, int64>::error(0, 7);
echo $b->error;
echo $b->is_ok;

// a second instantiation is distinct storage and a distinct symbol, mangled through the owner segment
$c = outcome<bool, int32>::ok(true, 0);
echo $c->value;
