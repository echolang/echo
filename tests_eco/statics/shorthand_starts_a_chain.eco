// a leading dot may start a -> chain: the destination names the owner of the first call

struct Point
{
    float64 $x;

    static function origin() : Point
    {
        return Point(0.0);
    }

    function shifted(float64 $by) : Point
    {
        return Point($this->x + $by);
    }
}

function draw(Point $p) : float64
{
    return $p->x;
}

echo draw(.origin()->shifted(1.5));

struct Box
{
    Point $p;
}

function take(Box $b) : float64
{
    return $b->p->x;
}

echo take(Box(.origin()));
