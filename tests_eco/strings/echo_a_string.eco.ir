# `echo` of a string is a length-counted write(2), never a printf. that matters because the bytes are
# not NUL-terminated in general - a substring shares its owner's buffer and simply stops early, and a
# `%s` would run off the end of one

CHECK: define i32 @main()

# stdout is buffered and the write is not, so the flush is what keeps a string in order with the
# printf that every other `echo` still emits
CHECK: call i32 @fflush(ptr null)
CHECK: call i64 @write(i32 1, ptr

# the trailing newline is written separately rather than appended to the bytes - there is nowhere to
# put a longer copy when the bytes may be a shared substring
CHECK: @echo.nl

# the primitive path is untouched: `echo 42` still goes through the printf table
CHECK: call i32 (ptr, ...) @printf

CHECK: ret i32 0
