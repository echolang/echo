class local_buf { usize $capacity; usize $used; ptr<uint8> $bytes; }

#[core: "string"]
struct string
{
    #[core: "string_view"]
    struct view { ptr<const uint8> $bytes; usize $size; }

    string::view $window;
    local_buf $owner;

    // marked, not named: the compiler finds the conversion by the attribute, never by the spelling
    #[implicit]
    function view() : string::view { return $this->window; }
    function size() : usize { return $this->window->size; }
}

// a literal *is* a string: it lowers to a constant - static bytes, a length, and a null owner - so
// nothing is allocated and nothing is retained. `$size` is the *decoded* byte count
$a = 'hey';
echo $a;
echo $a->size();

// the escapes decode: three bytes, not four
$e = "a\nb";
echo $e->size();
