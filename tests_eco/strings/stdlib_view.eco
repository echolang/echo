// `string::view` is the borrowed half: two words, owning nothing, costing no reference count. it is
// where every read operation actually lives, and `string` delegates to it

// a `string` binds to a view parameter with nothing written at the call site - the #[implicit]
// conversion the stdlib declares
function show(string::view $v) : void { echo $v->size; }

$owned = 'hello world';
show($owned);

// ...and the whole read surface is on the view itself
$v = $owned->view();
echo $v->size;
echo $v->byte(0);
echo $v->empty();
echo $v->chars();
echo $v->starts($owned->view());

// a sub-view narrows without touching a reference count, because there is none to touch
string::view $tail = $v->sub(6, 5);
echo $tail;
echo $tail->size;

// a method takes the address of its receiver, and a call result has none - so the compiler binds one,
// which is why this reads the way it looks whether or not the substring is given a name first
$piece = $owned->sub(6, 5);
echo $tail->equals($piece->view());
echo $tail->equals($owned->sub(6, 5)->view());

// an overload taking the owning type still wins outright: a declared conversion ranks below every
// built-in one
function which(string::view $v) : void { echo 1; }
function which(string $s) : void { echo 2; }
which($owned);
