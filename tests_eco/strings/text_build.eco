// unique growable text: append, reserve, take into a string. a short take seats
// INLINE bytes and allocates nothing. reserve past INLINE, then take, plants a buf
{
    str::text $empty = str::text();
    string $none = $empty->take();

    echo $none->empty();
    echo mem::live_allocations();
}

{
    str::text $r = str::text();
    $r->reserve(8);
    echo mem::live_allocations();
    echo $r->capacity() == string::INLINE;
}

str::text $t = str::text();

echo $t->empty();
echo $t->size();
echo $t->capacity() == string::INLINE;

$t->append('hello');
$t->push(32);
$t->append('world');

echo $t->size();

string $short = $t->take();

echo $t->empty();
echo $t->capacity() == string::INLINE;
echo mem::live_allocations();
echo mem::refs($short->owner);

// take copied: a write into the builder must not change $short
$t->append('XXXXX');
echo $short;
echo $t->take();

$short = '';
echo mem::live_allocations();

str::text $big = str::text();
$big->reserve(32);
$big->append('0123456789abcdef');
$big->push(33);

echo $big->capacity() >= 32;
echo $big->size();

string $long = $big->take();

echo $long;
echo mem::live_allocations();
echo mem::refs($long->owner);

$long = '';
echo mem::live_allocations();
