// multi-piece interpolation seeds str::text and take()s a string. one hole stays str::from.
// take() plants a class box over the live block, so live_allocations is 2 even for a
// short result. a string-seed fallback would seat INLINE bytes and answer 0
{
    int32 $k = 3;
    string $built = "a{$k}b";
    echo $built;
    echo mem::live_allocations();
}
echo mem::live_allocations();

int32 $n = 3;
string $name = 'Ronon';

echo "{$name} is {$n}";
echo "{$n}";

array<string> $parts = ['a', 'b', 'c'];
echo str::join($parts, '|');
