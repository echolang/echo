# the string type is declared *in the program*, exactly as its sibling view_conversion does and for the
# same reason: two `#[core: string]` declarations in one program is a located error
stdlib: off

--- OUT --->
5
2
4
--- RAST --->
# **one bind, two temporaries.** the literal is bound first because the conversion reads through it, and
# the conversion's result is bound second because `show` borrows *that*. the release of the literal's
# owner is last, so it runs after the call rather than before it
CHECK: tempbind<void>(vardecl<type<string>>($__temp1) = literal<string>("'hello'"); vardecl<type<string::view>>($__temp2) = call view(addrof<string&>(varref<string>(var($__temp1))))
CHECK: call show(addrof<string::view&>(varref<string::view>(var($__temp2))))
CHECK: release(ma<local_buf>(varref<string>(var($__temp1))->owner))

# a by-value parameter needs only the receiver's temporary: the view travels as a plain two-word value
CHECK: call showv(tempbind<string::view>(vardecl<type<string>>($__temp3) = literal<string>("'hi'")

# and a place needs no receiver temporary at all - `$owned` already has storage, so the only one minted
# is for the borrow of the conversion's result
CHECK: tempbind<void>(vardecl<type<string::view>>($__temp4) = call view(addrof<string&>(varref<string>(var($owned))))
--- IR --->
CHECK: define i32 @main(

# the literal is still a constant with a null owner, so the release the ownership pass wrapped it in is a
# null-guarded no-op and no reference count moves. that is the property that would silently regress if the
# conversion ever went through the copy path
CHECK: store %string { %view { ptr @str, i64 5 }, ptr null }
CHECK-NOT: strong.inc
CHECK: ret i32 0
