// a constructor taking one non-nullable borrow of its own type *is* the copy constructor: the
// ownership pass calls it wherever a place arrives at a destination - a declaration, an argument, a
// return - instead of rejecting the copy.
//
// every copy adds one to the tag, so the goldens count the calls: three copies, four values, four
// destructions

struct Box
{
    usize $tag;
    ptr<uint8> $data;

    constructor(usize $t)
    {
        $this->tag = $t;
        $this->data:$ = mem::alloc<uint8>(1);
    }

    constructor(Box& $other)
    {
        $this->tag = $other->tag + 1;
        $this->data:$ = mem::alloc<uint8>(1);
    }

    destructor()
    {
        echo $this->tag;
        mem::free($this->data);
    }
}

// a by-value parameter is a destination: the caller's value stays live, the callee's copy is destroyed
// at the end of the body it was handed to
function read(Box $taken) : void
{
    echo 800;
}

// and so is a return of something the function does not own - `$src` is a borrow, so handing back a
// value means duplicating it
function duplicate(Box& $src) : Box
{
    return $src;
}

$a = Box(10);

$b = $a;
read($a);
$c = duplicate($a);

echo 99;
