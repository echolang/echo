// `const Foo&` is recognised as the copy constructor too, and is the more honest spelling: a copy
// only reads its source. the implicit copy the ownership pass builds still fits it, since a borrow
// of a mutable value converts to a borrow of a const one

struct Box
{
    usize $tag;

    constructor(usize $t)
    {
        $this->tag = $t;
    }

    constructor(const Box& $other)
    {
        echo 700;
        $this->tag = $other->tag + 1;
    }

    destructor()
    {
        echo $this->tag;
    }
}

$a = Box(10);
$b = $a;
echo 99;
