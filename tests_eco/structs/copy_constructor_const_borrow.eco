// `const Foo&` is recognised too, and is the more honest spelling: a copy reads its source. const is
// dropped on both sides of the recognition comparison, and the plain `Foo&` receiver the ownership pass
// builds still fits, because a borrow of a mutable value converts to a borrow of a const one already

struct Box
{
    usize $tag;

    constructor(usize $t)
    {
        $this->tag = $t;
    }

    constructor(const Box& $other)
    {
        echo 700;
        $this->tag = $other->tag + 1;
    }

    destructor()
    {
        echo $this->tag;
    }
}

$a = Box(10);
$b = $a;
echo 99;
