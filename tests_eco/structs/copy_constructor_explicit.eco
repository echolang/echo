// `Box($a)` written by hand and `$b = $a` reach the *same declaration* - the explicit call by
// ordinary overload resolution, the implicit one through the copy-constructor slot - so there is
// only ever one way a value is copied

struct Box
{
    usize $tag;

    constructor(usize $t)
    {
        $this->tag = $t;
    }

    constructor(Box& $other)
    {
        echo 700;
        $this->tag = $other->tag + 1;
    }

    destructor()
    {
        echo $this->tag;
    }
}

$a = Box(10);

$explicit = Box($a);
$implicit = $a;

echo 99;
