// `Box($a)` written by hand and `$b = $a` are the *same declaration*, which is the whole argument for
// recognising a constructor rather than adding a spelling for copies: there is one way to copy a value,
// so the two cannot drift apart.
//
// asserted rather than assumed. the explicit call already worked before any of this existed - it is an
// ordinary overload resolution - so a second construction path would have been easy to add without
// noticing

struct Box
{
    usize $tag;

    constructor(usize $t)
    {
        $this->tag = $t;
    }

    constructor(Box& $other)
    {
        echo 700;
        $this->tag = $other->tag + 1;
    }

    destructor()
    {
        echo $this->tag;
    }
}

$a = Box(10);

$explicit = Box($a);
$implicit = $a;

echo 99;
