// a copy of a struct whose field is itself copyable. nothing recurses on its own - `Outer` and
// `Plain` each *write* what copying their owning field means - and both spellings reach `Inner`'s
// copy constructor: an explicit `Inner($other->inner)`, and a plain field read arriving at a
// destination.
//
// a write to a field of the enclosing constructor's own `$this` is that field's first write, so no
// old value is torn down here

struct Inner
{
    usize $tag;

    constructor(usize $t)
    {
        $this->tag = $t;
    }

    constructor(Inner& $other)
    {
        echo 300;
        $this->tag = $other->tag + 1;
    }

    destructor()
    {
        echo $this->tag;
    }
}

struct Outer
{
    Inner $inner;

    constructor(usize $t)
    {
        $this->inner = Inner($t);
    }

    constructor(Outer& $other)
    {
        echo 700;
        $this->inner = Inner($other->inner);
    }
}

struct Plain
{
    Inner $inner;

    constructor(usize $t)
    {
        $this->inner = Inner($t);
    }

    constructor(Plain& $other)
    {
        echo 900;
        // no explicit copy written: the field read is an ordinary place arriving at a destination, so
        // Inner's own copy constructor answers for it
        $this->inner = $other->inner;
    }
}

$a = Outer(10);
$b = $a;

$c = Plain(20);
$d = $c;

echo 99;
