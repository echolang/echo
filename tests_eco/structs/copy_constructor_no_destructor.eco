// a copy constructor is honoured whether or not the type owns anything: `Point` has no destructor,
// and `$b = $a` still calls it. a type with neither is still copied as bytes, with nothing inserted

struct Point
{
    int32 $x;
    int32 $y;

    constructor(int32 $x, int32 $y)
    {
        $this->x = $x;
        $this->y = $y;
    }

    constructor(Point& $other)
    {
        echo 700;
        $this->x = $other->x;
        $this->y = $other->y;
    }
}

struct Bare
{
    int32 $x;
}

$a = Point(3, 4);
$b = $a;
echo $b->x;
echo $b->y;

// no copy constructor, nothing owned: a plain copy, with no call and no diagnostic
$c = Bare(5);
$d = $c;
echo $d->x;
