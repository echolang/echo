// assignment order with no copy involved: the right-hand side is a fresh construction, and the
// target's old value is torn down after it has been built, not before

struct Box
{
    usize $tag;

    constructor(usize $t)
    {
        echo $t;
        $this->tag = $t;
    }

    destructor()
    {
        echo $this->tag;
    }
}

$a = Box(1);
$a = Box(2);
echo 99;
