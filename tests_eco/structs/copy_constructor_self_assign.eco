// `$a = $a` on an owning type, where the order is observable: copy first (700), then tear the old
// value down (10), then store. the destructor zeroes `$tag`, so a teardown running first would make
// the copy read 0 and the last line 1 rather than 11

struct Box
{
    usize $tag;

    constructor(usize $t)
    {
        $this->tag = $t;
    }

    constructor(Box& $other)
    {
        echo 700;
        $this->tag = $other->tag + 1;
    }

    destructor()
    {
        echo $this->tag;
        $this->tag = 0;
    }
}

$a = Box(10);
$a = $a;
echo 99;
