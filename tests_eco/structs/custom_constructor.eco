// a user-written constructor deletes the implicit memberwise one. named args bind to
// the constructor's parameters, not to fields

struct Point {
    int32 $x;
    int32 $y;

    constructor(int32 $v) {
        $this->x = $v;
        $this->y = $v * 2;
    }
}

Point $a = Point(3);
echo $a->x;
echo $a->y;

struct Counter {
    int32 $total;

    constructor(int32 $start, int32 $step) {
        int32 $sum = $start;
        $sum = $sum + $step;
        $this->total = $sum;
        $this->total = $this->total + 1;
    }
}

Counter $c = Counter(10, 5);
echo $c->total;
