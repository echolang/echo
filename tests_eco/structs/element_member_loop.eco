// element members written and read back inside `while` loops: the pointer's type is inferred from
// `mem::alloc<Point>`, the index is a loop variable rather than a constant, and the second loop
// walks the block backwards - so the element address is recomputed per iteration
struct Point {
    float $x;
    float $y;
}

$data = mem::alloc<Point>(5);

$i = 0;
while ($i < 5) {
    $data:$[$i]->x = $i * 1.0f;
    $data:$[$i]->y = $i * 2.0f;
    $i++;
}

while ($i > 0) {
    $i--;
    echo $data:$[$i]->x;
    echo $data:$[$i]->y;
}

mem::free($data);
