// widening a field read out of an element follows the *field's* signedness, which llvm's lowered
// type cannot tell apart: a uint8 zero-extends where an int8 sign-extends
struct Flags {
    uint8 $a;
    int8 $b;
}

ptr<Flags> $f = mem::alloc<Flags>(1);

$f:$[0]->a = 200;
$f:$[0]->b = 0 - 56;

int32 $wide_unsigned = $f:$[0]->a;
int32 $wide_signed = $f:$[0]->b;

echo $wide_unsigned;
echo $wide_signed;

mem::free($f);
