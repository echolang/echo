// a member reached through an *element* of a heap array is an ordinary place: read, written,
// stepped and borrowed like a field of a plain local
struct Point {
    int32 $x;
    float64 $y;
}

ptr<Point> $items = mem::alloc<Point>(2);

$items:$[0]->x = 1;
$items:$[0]->y = 2.5;
$items:$[1]->x = 3;
$items:$[1]->y = 4.5;

echo $items:$[0]->x;
echo $items:$[0]->y;
echo $items:$[1]->x;
echo $items:$[1]->y;

// the field's type reaches the expression, so the int32 is cast to float64
echo $items:$[0]->x * 2.5;

// the step is typed from the field it moves
$items:$[0]->x++;
echo $items:$[0]->x;

// the borrow spelling is the same storage, not a copy
unsafe {
    Point& $it = &$items:$[1];
    $it->x = 30;
    echo $items:$[1]->x;
}

mem::free($items);
