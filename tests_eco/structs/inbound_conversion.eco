// a library type may declare that a primitive converts *to it*. the conversion is a static of
// the destination, marked `#[implicit]`, and the call site writes nothing

struct Quantity
{
    int64 $n;

    #[implicit]
    static function from(int32 $n) : Quantity
    {
        return Quantity($n);
    }
}

function put(Quantity $q) : void
{
    echo $q->n;
}

put(7);
