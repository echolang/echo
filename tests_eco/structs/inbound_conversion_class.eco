// inbound constructs the destination, so a class that allocates is allowed. outbound still
// refuses a return that needs destruction

class Quantity
{
    int64 $n;

    #[implicit]
    static function from(int32 $n) : Quantity
    {
        return Quantity($n);
    }
}

function put(Quantity $q) : void
{
    echo $q->n;
}

put(7);
