// a written copy constructor still runs `init`

class Handle
{
    int32 $n;
}

struct Counts
{
    static int32 $n = 0;

    public static function bump() : int32
    {
        Counts::$n = Counts::$n + 1;
        return Counts::$n;
    }
}

struct Tagged
{
    int32 $id;
    int32 $stamp;

    constructor(int32 $id)
    {
        $this->id = $id;
    }

    constructor(const Tagged& $other)
    {
        $this->id = $other->id;
    }

    init
    {
        $this->stamp = Counts::bump();
    }
}

Tagged $a = Tagged(1);
echo $a->stamp;
Tagged $b = $a;
echo $b->stamp;
Tagged $c = Tagged($a);
echo $c->stamp;
echo $a->stamp;
echo $c->id;
