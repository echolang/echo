// member functions on a struct. a method is an ordinary function whose first parameter is `$this`,
// typed as the non-nullable borrow `Point&` - so a mutating method writes through the caller's
// storage rather than into a copy

struct Point
{
    int32 $x;
    int32 $y;

    function sum() : int32
    {
        return $this->x + $this->y;
    }

    function shift(int32 $by) : void
    {
        $this->x = $this->x + $by;
        $this->y = $this->y + $by;
    }
}

$p = Point(3, 4);
echo $p->sum();

// a call in statement position, discarding the result
$p->shift(10);
echo $p->sum();

// the write landed in $p's own storage, not in a copy the method took
echo $p->x;
echo $p->y;

// the field-wise constructor and plain member reads still work alongside
$q = Point(1, 2);
echo $q->sum();
echo $p->sum();
