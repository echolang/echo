// a default mentioning T is a parameter default on the template. Box<Inner>() instantiates first,
// then re-clones Inner() from the instance. Inner() is itself memberwise of nothing required
// besides $x's default, so T() is a real call after binding

struct Inner
{
    int32 $x = 7;
}

struct Box<T>
{
    T $v = T();
}

Box<Inner> $b = Box<Inner>();
echo $b->v->x;
