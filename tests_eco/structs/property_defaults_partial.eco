// mixed defaults: the implicit constructor takes every public field, and field defaults
// become parameter defaults. a user constructor deletes that and still runs field defaults first

struct Mixed
{
    int32 $a = 1;
    int32 $b;
}

Mixed $m = Mixed($b: 7);
echo $m->a;
echo $m->b;

struct Gate
{
    int32 $id = 1;
    int32 $chevrons;

    constructor(int32 $chevrons)
    {
        $this->chevrons = $chevrons;
    }
}

Gate $g = Gate(7);
echo $g->id;
echo $g->chevrons;
