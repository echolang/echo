// close() is the named form of last-sender-drop. recv drains what was sent, then null

use std::thread;

thread::channel<int32> $ch = thread::channel<int32>();
thread::sender<int32> $tx = $ch->tx();
thread::receiver<int32> $rx = $ch->rx();
$tx->send(5);
$tx->close();

int32 $v = guard $rx->recv() else {
    die('drained too soon');
}

echo $v;
echo $rx->recv() == null;
