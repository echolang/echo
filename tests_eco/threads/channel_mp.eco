// several threads holding the same sender. last drop of that object still closes

use std::thread;

thread::channel<int32> $ch = thread::channel<int32>();
thread::sender<int32> $tx = $ch->tx;

thread::handle $a = guard thread::spawn(function() : void {
    $tx->send(1);
}) else ($e) {
    die($e->message());
}

thread::handle $b = guard thread::spawn(function() : void {
    $tx->send(2);
}) else ($e) {
    die($e->message());
}

$a->join();
$b->join();
$tx->close();

int32 $sum = 0;

while (true) {
    int32 $v = guard $ch->rx->recv() else {
        break;
    }

    $sum = $sum + $v;
}

echo $sum;
