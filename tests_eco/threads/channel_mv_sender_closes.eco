// taking the ends empties the pair. mv of that sender into a worker is the last
// retain, so join then recv-until-null sees closed rather than waiting on a
// sender the pair still held

use std::thread;

thread::channel<int32> $ch = thread::channel<int32>();
thread::sender<int32> $tx = $ch->tx();
thread::receiver<int32> $rx = $ch->rx();

thread::handle $h = guard thread::spawn(function[mv $tx]() : void {
    $tx->send(1);
    $tx->send(2);
    $tx->send(3);
}) else ($e) {
    die($e->message());
}

$h->join();

int32 $sum = 0;

while (true) {
    int32 $v = guard $rx->recv() else {
        break;
    }

    $sum = $sum + $v;
}

echo $sum;
