// an alias of an interface is a constraint like the interface, and an alias owner reaches nested types
interface Gate
{
    function address() : string;
}

type Portal = Gate;

struct Planet
{
    struct Moon
    {
        int32 $n;
    }

    int32 $id;
}

type World = Planet;

class Abydos : Gate
{
    function address() : string { return '27-07-15-32-12-30'; }
}

function dial<G : Portal>(G& $g) : void
{
    echo $g->address();
}

dial(Abydos());

World::Moon $m = World::Moon(4);
echo $m->n;
