// widening an integer in a declaration goes through the one shared conversion, so the
// extension follows the *source's* signedness: unsigned zero-extends, signed sign-extends.
// this path used to handle only float/double, so a narrow integer was stored straight into
// the wide slot and read back with whatever else occupied those bytes

uint8 $small = 200;
uint32 $wide = $small;
echo $wide;

int8 $negative = -5;
int32 $widened = $negative;
echo $widened;

// narrowing truncates
int32 $big = 300;
int8 $narrow = $big;
echo $narrow;
