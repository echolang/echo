// widening an integer in a declaration follows the *source's* signedness: unsigned
// zero-extends, signed sign-extends. narrowing truncates

uint8 $small = 200;
uint32 $wide = $small;
echo $wide;

int8 $negative = -5;
int32 $widened = $negative;
echo $widened;

// narrowing truncates
int32 $big = 300;
int8 $narrow = $big;
echo $narrow;
